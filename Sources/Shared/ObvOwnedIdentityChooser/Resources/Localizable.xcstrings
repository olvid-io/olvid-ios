        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này nằm trên một máy chủ khác nên không thể được chọn ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此个人资料位于其他服务器上，因此无法在此处选择。"
          }
        }
