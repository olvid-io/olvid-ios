    "PROFILES_ON_A_DIFFERENT_SERVER_CANNOT_BE_USED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Profile befinden sich auf einem anderen Server und können nicht verwendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following profiles are on a different server and cannot be used."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los siguientes perfiles están en un servidor diferente y no se pueden usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils suivants se trouvent sur un autre serveur et ne peuvent pas être utilisés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I seguenti profili si trovano su un server diverso e non possono essere utilizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のプロフィールは別のサーバー上にあるため、使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 프로필은 다른 서버에 있어 사용할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniższe profile znajdują się na innym serwerze i nie można ich użyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis a seguir estão em um servidor diferente e não podem ser usados."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis seguintes encontram-se num servidor diferente e não podem ser utilizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующие профили находятся на другом сервере и не могут быть использованы."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aşağıdaki profiller farklı bir sunucuda olduğundan kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступні профілі розташовані на іншому сервері й не можуть бути використані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hồ sơ sau đây nằm trên một máy chủ khác và không thể được sử dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下个人资料位于其他服务器上，无法使用。"
          }
        }
      }
    },
    "PROFILE_ON_A_DIFFERENT_SERVER_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil befindet sich auf einem anderen Server und kann hier nicht ausgewählt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile is on a different server, so it cannot be selected here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil está en un servidor diferente, por lo que no se puede seleccionar aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil se trouve sur un autre serveur : il ne peut donc pas être sélectionné ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo profilo si trova su un server diverso, quindi non può essere selezionato qui."
