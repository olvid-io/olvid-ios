        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필은 다른 서버에 있어 여기서 선택할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten profil znajduje się na innym serwerze, więc nie można go tu wybrać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil está em um servidor diferente, portanto não pode ser selecionado aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil encontra-se num servidor diferente, pelo que não pode ser selecionado aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот профиль находится на другом сервере, поэтому его нельзя выбрать здесь."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil farklı bir sunucuda olduğundan burada seçilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей профіль розташований на іншому сервері, тому його не можна вибрати тут."
