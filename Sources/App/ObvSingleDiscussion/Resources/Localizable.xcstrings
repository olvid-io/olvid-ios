    "CANNOT_CHECK_WHETHER_MESSAGES_CAN_BE_FORWARDED" : {
      "comment" : "Explanation in the alert refusing a forward, when whether the messages may go could not be established at all.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es konnte nicht geprüft werden, ob diese Nachrichten weitergeleitet werden können. Bitte versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whether these messages can be forwarded could not be checked. Please try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido comprobar si estos mensajes se pueden reenviar. Inténtalo de nuevo."
