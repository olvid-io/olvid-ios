    "NOTHING_CAN_BE_DELETED" : {
      "comment" : "Title of the alert shown when not one kind of deletion is open for the messages the reader has chosen.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Nachrichten können nicht gelöscht werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These messages cannot be deleted"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos mensajes no se pueden eliminar"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces messages ne peuvent pas être supprimés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi messaggi non possono essere eliminati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのメッセージは削除できません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 메시지는 삭제할 수 없습니다"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można usunąć tych wiadomości"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas mensagens não podem ser excluídas"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas mensagens não podem ser eliminadas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эти сообщения нельзя удалить"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu mesajlar silinemez"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ці повідомлення не можна видалити"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể xoá những tin nhắn này"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法删除这些消息"
          }
        }
      }
    },
    "NOTHING_CAN_BE_DELETED_EXPLANATION" : {
      "comment" : "Body of that alert. It names the one cause anybody is likely to meet rather than claiming to be exhaustive.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestens eine davon kann noch nicht gelöscht werden. Meist liegt es an einem Standort, den Sie noch teilen: Beenden Sie die Freigabe, oder wählen Sie andere Nachrichten aus."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "At least one of them cannot be deleted yet. A location you are still sharing is the usual reason: stop sharing it, or choose other messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al menos uno de ellos aún no se puede eliminar. Lo habitual es que sea una ubicación que sigues compartiendo: deja de compartirla o elige otros mensajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'un d'eux au moins ne peut pas encore être supprimé. Une position que vous partagez toujours en est la raison la plus fréquente : arrêtez le partage, ou choisissez d'autres messages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almeno uno di essi non può ancora essere eliminato. Di solito il motivo è una posizione che stai ancora condividendo: interrompi la condivisione oppure scegli altri messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "少なくとも 1 件はまだ削除できません。共有中の位置情報が原因であることがほとんどです。共有を停止するか、別のメッセージを選択してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 중 하나 이상은 아직 삭제할 수 없습니다. 대개 아직 공유 중인 위치가 원인입니다. 공유를 중지하거나 다른 메시지를 선택하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Co najmniej jednej z nich nie można jeszcze usunąć. Najczęstszym powodem jest lokalizacja, którą nadal udostępniasz: zakończ jej udostępnianie lub wybierz inne wiadomości."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo menos uma delas ainda não pode ser excluída. O motivo mais comum é uma localização que você ainda está compartilhando: pare de compartilhá-la ou escolha outras mensagens."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pelo menos uma delas ainda não pode ser eliminada. O motivo mais comum é uma localização que ainda está a partilhar: pare a partilha ou escolha outras mensagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "По крайней мере одно из них пока нельзя удалить. Обычно причина в геопозиции, которой вы всё ещё делитесь: остановите её передачу или выберите другие сообщения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bunlardan en az biri henüz silinemiyor. Bunun en yaygın nedeni hâlâ paylaştığınız bir konumdur: paylaşımı durdurun veya başka mesajlar seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принаймні одне з них поки не можна видалити. Зазвичай причина — геопозиція, якою ви досі ділитеся: припиніть надсилання або виберіть інші повідомлення."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ít nhất một trong số đó chưa thể xoá. Nguyên nhân thường gặp là một vị trí bạn vẫn đang chia sẻ: hãy ngừng chia sẻ, hoặc chọn tin nhắn khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中至少有一条暂时无法删除。通常是因为你仍在共享位置：请停止共享，或改选其他消息。"
          }
        }
      }
    },
