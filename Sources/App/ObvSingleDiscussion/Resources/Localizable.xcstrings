    "RIGHT_CLICK_ON_A_REACTION_TO_SHOW_MORE_OPTIONS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke mit der rechten Maustaste auf eine beliebige Reaktion, um weitere Optionen anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Right click any reaction for more options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsado cualquier reacción para ver más opciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez une réaction pour plus d’options."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca con il tasto destro su qualsiasi reazione per altre opzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リアクションを右クリックすると、さらに多くのオプションが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 많은 옵션을 보려면 반응에 마우스 오른쪽 버튼을 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em qualquer reação para ver mais opções."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito em qualquer reação para ver mais opções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Щелкните правой кнопкой мыши любой реакцией, чтобы увидеть больше опций."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клацніть правою кнопкою миші будь-яку реакцію для отримання додаткових опцій."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "右键单击任何表情符号，以查看更多选项。"
          }
        }
      }
    },
