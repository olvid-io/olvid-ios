    "AT_MOST_COUNT_MESSAGES_MAY_BE_FORWARDED_AT_ONCE_%lld" : {
      "comment" : "Message of that alert. The number is the most that may be forwarded in one go.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können höchstens %lld Nachrichten auf einmal weiterleiten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can forward up to %lld messages at a time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes reenviar como máximo %lld mensajes a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez transférer au maximum %lld messages à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi inoltrare al massimo %lld messaggi alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一度に転送できるメッセージは最大 %lld 件です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한 번에 최대 %lld개의 메시지를 전달할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz przekazać dalej maksymalnie %lld wiadomości naraz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode encaminhar no máximo %lld mensagens por vez."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode reencaminhar no máximo %lld mensagens de cada vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За один раз можно переслать не более %lld сообщений."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı anda en fazla %lld mesaj iletebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За один раз можна переслати щонайбільше %lld повідомлень."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn có thể chuyển tiếp tối đa %lld tin nhắn mỗi lần."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次最多可转发 %lld 条消息。"
          }
        }
