        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらのメッセージを転送できるかどうかを確認できませんでした。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
