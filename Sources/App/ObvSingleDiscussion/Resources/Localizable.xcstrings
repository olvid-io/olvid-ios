    "DOUBLE_CLICK_A_MESSAGE_TO_ADD_A_REACTION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppeltippen Sie eine Nachricht, um darauf zu reagieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double click a message to react."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic en un mensaje para reaccionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez deux fois sur un message pour réagir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca due volte un messaggio per reagire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージをダブルタップしてリアクションを追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 두 번 탭하여 반응을 추가하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes em uma mensagem para reagir."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque duas vezes numa mensagem para reagir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дважды нажмите на сообщение, чтобы отреагировать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Двічі клацніть повідомлення, щоб відреагувати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双击消息以进行反应。"
          }
        }
      }
    },
