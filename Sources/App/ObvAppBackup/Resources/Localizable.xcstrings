    "WE_COULD_NOT_ACTIVATE_BACKUPS_PLEASE_TRY_AGAIN": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten Ihre Backups nicht aktivieren. Bitte versuchen Sie es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not activate your backups. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos activar tus copias de seguridad. Por favor, inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas réussi à activer vos sauvegardes. Veuillez essayer à nouveau plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti ad attivare i tuoi backup. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの有効化に失敗しました。後ほど再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 활성화할 수 없습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar seus backups. Tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar as suas cópias de segurança. Tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось активировать ваши резервные копии. Пожалуйста, попробуйте еще раз позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
