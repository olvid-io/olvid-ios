    "RESET_BUTTON_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die aktuelle Konfiguration der Gerätesicherung auf den Ausgangszustand zurück. Folgende Schritte werden ausgeführt:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resets this device backup configuration back to its initial state. The following steps will be performed:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura la configuración de copia de seguridad de este dispositivo a su estado inicial. Se realizarán los siguientes pasos:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réinitialise la configuration de sauvegarde de cet appareil à son état initial. Les étapes suivantes seront effectuées :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina la configurazione del backup di questo dispositivo al suo stato iniziale. Verranno eseguite le seguenti operazioni:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのバックアップ設定を初期状態に戻します。以下の手順が実行されます:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치의 백업 구성을 초기 상태로 재설정합니다. 다음 단계가 수행됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca konfigurację kopii zapasowych tego urządzenia do stanu początkowego. Zostaną wykonane następujące kroki:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura a configuração de backup deste dispositivo ao seu estado inicial. As seguintes etapas serão executadas:"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura a configuração de cópia de segurança deste dispositivo para o seu estado inicial. Serão executados os seguintes passos:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сбрасывает конфигурацию резервного копирования этого устройства до исходного состояния. Будут выполнены следующие шаги:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazın yedekleme yapılandırmasını ilk durumuna sıfırlar. Şu adımlar gerçekleştirilir:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидає конфігурацію резервного копіювання цього пристрою до початкового стану. Будуть виконані наступні кроки:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục cấu hình sao lưu của thiết bị này về trạng thái ban đầu. Các bước sau sẽ được thực hiện:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此设备的备份配置重置为初始状态。将执行以下步骤："
          }
        }
      }
    },
    "RESET_BUTTON_EXPLANATION_EXPLANATION_STEP_1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Geräte-Backup-Schlüssel löschen (und bei Existenz aus dem iCloud-Schlüsselbund entfernen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete this device backup key (and remove it from the iCloud keychain if it exists)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar esta copia de seguridad de dispositivo (y eliminarla del llavero de iCloud si existe)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime la clé de sauvegarde de cet appareil (y compris du trousseau iCloud si elle s'y trouve)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina questa chiave di backup del dispositivo (e rimuovila dal Portachiavi iCloud se esiste)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのバックアップキーを削除します（存在する場合は、iCloudキーチェーンからも削除します）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치의 백업 키를 삭제합니다(존재하는 경우 iCloud 키체인에서 제거합니다)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie klucza kopii zapasowej tego urządzenia (także z pęku kluczy iCloud, jeśli się tam znajduje)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua a chave de backup deste dispositivo (e remova-a do Keychain do iCloud, se existir)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar a chave de backup deste dispositivo (e removê-la do iCloud Keychain, caso exista)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить ключ резервной копии этого устройства (и удалить его из Keychain iCloud, если он там есть)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazın yedekleme anahtarını siler (varsa iCloud Anahtar Zinciri'nden de kaldırır)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити ключ резервної копії цього пристрою (та видалити його з брелка iCloud, якщо він існує)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa khóa sao lưu của thiết bị này (và xóa khỏi iCloud Keychain nếu có)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此设备的备份密钥（如果存在，则将其从 iCloud 钥匙链中移除）"
          }
        }
      }
    },
    "RESET_BUTTON_EXPLANATION_EXPLANATION_STEP_2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lösche alle verschlüsselten Backups, die von diesem Gerät in der Cloud erstellt wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete all the encrypted backups made by this device from the cloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar todas las copias de seguridad encriptadas realizadas por este dispositivo desde la nube."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime toutes les sauvegardes chiffrées effectuées par cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina tutti i backup crittografati effettuati da questo dispositivo dal cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスによって作成されたすべての暗号化されたバックアップをクラウドから削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에서 생성된 모든 암호화된 백업 파일을 클라우드에서 삭제합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięcie z chmury wszystkich zaszyfrowanych kopii zapasowych utworzonych przez to urządzenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclua todos os backups criptografados criados por este dispositivo na nuvem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apagar todas as cópias de segurança encriptadas criadas por este dispositivo na nuvem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить все зашифрованные резервные копии, созданные этим устройством в облаке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazın oluşturduğu tüm şifreli yedekleri buluttan siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити всі зашифровані резервні копії, створені цим пристроєм у хмарі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xóa tất cả bản sao lưu được mã hóa do thiết bị này tạo trên đám mây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "删除此设备在云端所做的所有加密备份。"
          }
        }
      }
    },
