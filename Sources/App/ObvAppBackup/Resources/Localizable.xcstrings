    "ICLOUD_KEYCHAIN_INFORMATION_[LEARN_MORE](_)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der iCloud-Schlüsselbund schützt Ihre Informationen mit End-to-End-Verschlüsselung. [Mehr erfahren…](_)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Keychain protects your information with end-to-end encryption. [Learn more…](_)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Llavero de iCloud protege tu información con cifrado de extremo a extremo. [Más información…](_)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trousseau iCloud protège vos informations par un chiffrement de bout en bout. [En savoir plus…](_)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Portachiavi iCloud protegge le tue informazioni con la crittografia end-to-end. [Scopri di più…](_)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Keychain は、エンドツーエンドの暗号化であなたの情報を保護します。[詳細はこちら](_)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 키체인은 종단 간 암호화를 통해 사용자의 정보를 보호합니다. [자세히 알아보기…](_)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pęk kluczy iCloud chroni twoje dane za pomocą szyfrowania end-to-end. [Więcej informacji…](_)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud Keychain protege suas informações com criptografia de ponta a ponta. [Saiba mais…](_)"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud Keychain protege as suas informações com encriptação de ponta a ponta. [Saiba mais…](_)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключница iCloud защищает вашу информацию сквозным шифрованием. [Узнать больше…](_)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Anahtar Zinciri, bilgilerinizi uçtan uca şifrelemeyle korur. [Daha fazla bilgi…](_)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключі iCloud захищають вашу інформацію за допомогою наскріпного шифрування. [Дізнатися більше…](_)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Keychain bảo vệ thông tin của bạn bằng cách sử dụng mã hóa đầu cuối. [Tìm hiểu thêm…](_)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 钥匙串使用端到端加密来保护您的信息。[了解更多…](_)"
          }
        }
      }
    },
