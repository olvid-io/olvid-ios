    "SINCE_YOU_HAVE_A_MULTIDEVICE_SUBSRIPTION_ALL_YOUR_PREVIOUS_DEVICES_WILL_STAY_ACTIVE_YOU_CAN_RESTORE_YOUR_PROFILE_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfekt! Du kannst dein Profil %@ sicher wiederherstellen. Alle deine vorherigen Geräte funktionieren wie zuvor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfect! You can safely restore your profile %@. All your previous devices will continue to work as before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Perfecto! Puedes restaurar tu perfil %@ de forma segura. Todos tus dispositivos anteriores seguirán funcionando como antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parfait ! Vous pouvez restaurer votre profil %@. Tous vos appareils précédents continueront de fonctionner comme avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfetto! Puoi ripristinare in sicurezza il tuo profilo %@. Tutti i tuoi dispositivi precedenti continueranno a funzionare come prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完璧です！プロフィール %@ を安全に復元できます。以前使用していたすべてのデバイスは、これまで通り引き続き動作します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완벽합니다! 이제 프로필 %@을 안전하게 복원할 수 있습니다. 기존에 사용하던 모든 장치는 이전과 동일하게 작동합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Świetnie! Możesz bezpiecznie przywrócić swój profil %@. Wszystkie twoje dotychczasowe urządzenia będą działać tak jak wcześniej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ótimo! Você pode restaurar seu perfil com segurança %@. Todos os seus dispositivos anteriores continuarão funcionando como antes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Excelente! Pode restaurar o seu perfil %@ com segurança. Todos os seus dispositivos anteriores continuarão a funcionar como antes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отлично! Вы можете безопасно восстановить свой профиль %@. Все ваши предыдущие устройства будут продолжать работать как и прежде."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Harika! %@ adlı profilinizi güvenle geri yükleyebilirsiniz. Önceki tüm cihazlarınız eskisi gibi çalışmaya devam edecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чудово! Ви можете безпечно відновити свій профіль %@. Усі ваші попередні пристрої продовжуватимуть працювати як і раніше."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuyệt vời! Bạn có thể khôi phục hồ sơ %@ của mình một cách an toàn. Tất cả các thiết bị trước đây của bạn sẽ tiếp tục hoạt động như bình thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "太好了！您可以安全地恢复您的个人资料 %@。您之前的所有设备将继续像以前一样正常工作。"
          }
        }
      }
    },
