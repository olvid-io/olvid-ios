    "BACKUP_MODE_BODY_KEYCHAIN": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf diesem Gerät vorhandenen Profile werden automatisch gesichert. Die Backups werden verschlüsselt und dann auf den Servern von Olvid gespeichert. Der Verschlüsselungsschlüssel wird im iCloud-Schlüsselbund gespeichert und auf all Ihren Geräten synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profiles present on this device are automatically backed up. Backups are encrypted and then stored on Olvid's servers. The encryption key is saved in the iCloud keychain and synchronized across your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles presentes en este dispositivo se respaldan automáticamente. Los respaldos están encriptados y luego se almacenan en los servidores de Olvid. La clave de encriptación se guarda en el llavero de iCloud y se sincroniza entre tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils présents sur cet appareil sont sauvegardés automatiquement. Les sauvegardes sont chiffrées puis stockées sur les serveurs d'Olvid. La clé de chiffrement est enregistrée dans le trousseau iCloud et synchronisée entre vos différents appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili presenti su questo dispositivo vengono automaticamente salvati in backup. I backup sono crittografati e poi archiviati sui server di Olvid. La chiave di crittografia viene salvata nel portachiavi iCloud e sincronizzata su tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されているプロファイルは自動的にバックアップされます。バックアップは暗号化され、Olvidのサーバーに保存されます。暗号化キーはiCloudキーチェーンに保存され、すべてのデバイス間で同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 있는 프로필은 자동으로 백업됩니다. 백업은 암호화된 후 Olvid 서버에 저장됩니다. 암호화 키는 iCloud 키체인에 저장되어 모든 기기에서 동기화됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zapasowe profili z tego urządzenia są tworzone automatycznie. Są one szyfrowane, a następnie przechowywane na serwerach Olvid. Klucz szyfrowania jest zapisywany w pęku kluczy iCloud i synchronizowany między twoimi urządzeniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis presentes neste dispositivo são automaticamente salvos em backup. Os backups são criptografados e armazenados nos servidores da Olvid. A chave de criptografia é salva no chaveiro do iCloud e sincronizada em todos os seus dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis presentes neste dispositivo são automaticamente guardados em cópia de segurança. As cópias de segurança são encriptadas e, em seguida, armazenadas nos servidores da Olvid. A chave de encriptação é guardada no iCloud Keychain e sincronizada entre os seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили, присутствующие на этом устройстве, автоматически резервируются. Резервные копии зашифровываются и затем хранятся на серверах Olvid. Ключ шифрования сохраняется в iCloud Keychain и синхронизируется между вашими устройствами."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki profiller otomatik olarak yedeklenir. Yedekler şifrelenir ve ardından Olvid'in sunucularında saklanır. Şifreleme anahtarı iCloud Anahtar Zinciri'ne kaydedilir ve cihazlarınız arasında eşzamanlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі, присутні на цьому пристрої, автоматично резервно копіюються. Резервні копії зашифровані та зберігаються на серверах Olvid. Ключ шифрування зберігається в iCloud Keychain і синхронізується між вашими пристроями."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hồ sơ có trên thiết bị này sẽ được sao lưu tự động. Bản sao lưu được mã hóa và lưu trữ trên máy chủ của Olvid. Khóa mã hóa được lưu trong iCloud Keychain và đồng bộ hóa trên tất cả các thiết bị của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的个人资料将自动备份。备份内容经过加密后存储在 Olvid 的服务器上。加密密钥保存在 iCloud 钥匙串中，并在您的所有设备上同步。"
          }
        }
      }
    },
    "BACKUP_MODE_BODY_MANUAL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf diesem Gerät vorhandenen Profile werden automatisch gesichert. Die Backups werden verschlüsselt und dann auf den Servern von Olvid gespeichert. Sie müssen den Verschlüsselungsschlüssel aufschreiben und sicher aufbewahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profiles present on this device are automatically backed up. Backups are encrypted and then stored on Olvid's servers. You will have to write down the encryption key and keep it in a safe place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles presentes en este dispositivo se respaldan automáticamente. Los respaldos están encriptados y luego se almacenan en los servidores de Olvid. Deberás anotar la clave de encriptación y guardarla en un lugar seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils présents sur cet appareil sont sauvegardés automatiquement. Les sauvegardes sont chiffrées puis stockées sur les serveurs d'Olvid. Vous devrez noter la clé de chiffrement et la conserver en lieu sûr."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili presenti su questo dispositivo vengono automaticamente salvati su backup. I backup sono crittografati e poi memorizzati sui server di Olvid. Dovrai annotare la chiave di crittografia e conservarla in un luogo sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されているプロファイルは自動的にバックアップされます。バックアップは暗号化され、Olvidのサーバーに保存されます。暗号化キーを記録し、安全な場所に保管してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에 있는 프로필은 자동으로 백업됩니다. 백업은 암호화된 후 Olvid 서버에 저장됩니다. 암호화 키를 기록하여 안전한 곳에 보관해야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zapasowe profili z tego urządzenia są tworzone automatycznie. Są one szyfrowane, a następnie przechowywane na serwerach Olvid. Musisz zapisać klucz szyfrowania i przechowywać go w bezpiecznym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis presentes neste dispositivo são automaticamente salvos. Os backups são criptografados e armazenados nos servidores da Olvid. Você precisará anotar a chave de criptografia e guardá-la em um local seguro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis presentes neste dispositivo são automaticamente guardados como cópia de segurança. As cópias de segurança são encriptadas e, em seguida, armazenadas nos servidores da Olvid. Terá de anotar a chave de encriptação e guardá-la num local seguro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили, присутствующие на этом устройстве, автоматически резервируются. Резервные копии шифруются и затем хранятся на серверах Olvid. Вам потребуется записать ключ шифрования и хранить его в безопасном месте."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki profiller otomatik olarak yedeklenir. Yedekler şifrelenir ve ardından Olvid'in sunucularında saklanır. Şifreleme anahtarını not edip güvenli bir yerde saklamanız gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі, присутні на цьому пристрої, автоматично резервно копіюються. Резервні копії шифруються, а потім зберігаються на серверах Olvid. Вам потрібно записати ключ шифрування та зберігати його в безпечному місці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hồ sơ có trên thiết bị này sẽ được sao lưu tự động. Bản sao lưu được mã hóa và lưu trữ trên máy chủ của Olvid. Bạn cần ghi lại khóa mã hóa và lưu giữ ở nơi an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的个人资料将自动备份。备份将被加密，然后存储在 Olvid 的服务器上。您需要记下加密密钥并将其保存在安全的地方。"
          }
        }
      }
    },
    "BACKUP_MODE_BODY_NO_BACKUP": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die auf diesem Gerät vorhandenen Profile werden niemals gesichert. Der Verlust des Zugriffs auf dieses Gerät kann daher zum endgültigen Verlust der Profile führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profiles present on this device are never backed up. Consequently, losing access to this device may result in the definitive loss of the profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los perfiles presentes en este dispositivo nunca se respaldan. En consecuencia, perder el acceso a este dispositivo podría resultar en la pérdida definitiva de los perfiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils présents sur cet appareil ne sont jamais sauvegardés. La perte d'accès à cet appareil peut donc entraîner une perte définitive des profils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I profili presenti su questo dispositivo non vengono mai salvati su backup. Di conseguenza, la perdita di accesso a questo dispositivo potrebbe comportare la perdita definitiva dei profili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスに保存されているプロファイルはバックアップされません。そのため、このデバイスへのアクセスを失うと、プロファイルが完全に失われる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치에 저장된 프로필은 백업되지 않습니다. 따라서 장치에 대한 접근 권한을 잃으면 프로필이 영구적으로 삭제될 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zapasowe profili z tego urządzenia nigdy nie są tworzone. W związku z tym utrata dostępu do tego urządzenia może oznaczać bezpowrotną utratę profili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis presentes neste dispositivo nunca são salvos em backup. Portanto, perder o acesso a este dispositivo pode resultar na perda definitiva dos perfis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os perfis presentes neste dispositivo nunca são guardados em cópia de segurança. Consequentemente, perder o acesso a este dispositivo pode resultar na perda definitiva dos perfis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Профили, хранящиеся на этом устройстве, не резервируются. Следовательно, потеря доступа к этому устройству может привести к безвозвратной потере профилей."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki profiller hiçbir zaman yedeklenmez. Bu nedenle, bu cihaza erişiminizi kaybederseniz profilleriniz kalıcı olarak kaybolabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Профілі, що зберігаються на цьому пристрої, ніколи не резервуються. Відповідно, втрата доступу до цього пристрою може призвести до безповоротної втрати профілів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các hồ sơ có trên thiết bị này sẽ không bao giờ được sao lưu. Do đó, việc mất quyền truy cập vào thiết bị này có thể dẫn đến việc mất vĩnh viễn các hồ sơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备上的资料永远不会备份。因此，如果丢失了对该设备的访问权限，可能会导致资料永久丢失。"
          }
        }
      }
    },
