    "MULTIPLE_DEVICE_HINT_NO_SUBSCRIPTION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Olvid auf mehreren Geräten. Du kannst dein Konto ohne Schlüssel von deinen anderen Geräten wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Olvid on multiple devices. You can restore your account without a key from your other devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Olvid en varios dispositivos. Puedes restaurar tu cuenta sin una clave desde tus otros dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Olvid sur plusieurs appareils. Vous pourrez restaurer votre compte, sans clé, depuis vos autres appareils. "
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Olvid su più dispositivi. Puoi ripristinare il tuo account senza una chiave dai tuoi altri dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のデバイスでOlvidを使用できます。他のデバイスからキーを使用せずにアカウントを復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 기기에서 Olvid를 사용하세요. 다른 기기에서 키 없이 계정을 복구할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj Olvid na wielu urządzeniach. Możesz przywrócić swoje konto bez klucza z innych urządzeń."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Olvid em vários dispositivos. Você pode restaurar sua conta sem a chave a partir de seus outros dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Olvid em vários dispositivos. Pode recuperar a sua conta sem a chave a partir dos seus outros dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте Olvid на нескольких устройствах. Вы можете восстановить свою учетную запись без ключа с других ваших устройств."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid'i birden fazla cihazda kullanın. Hesabınızı diğer cihazlarınızdan anahtar olmadan geri yükleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте Olvid на декількох пристроях. Ви можете відновити свій обліковий запис без ключа з ваших інших пристроїв."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sử dụng Olvid trên nhiều thiết bị. Bạn có thể khôi phục tài khoản của mình mà không cần sử dụng mã từ các thiết bị khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在多个设备上使用 Olvid。您可以从其他设备恢复您的帐户，而无需使用密钥。"
          }
        }
      }
    },
