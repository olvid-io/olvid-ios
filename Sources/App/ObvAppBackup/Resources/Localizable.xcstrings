        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Llavero de iCloud protege tu información con cifrado de extremo a extremo. [Más información…](_)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le trousseau iCloud protège vos informations par un chiffrement de bout en bout. [En savoir plus…](_)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Portachiavi iCloud protegge le tue informazioni con la crittografia end-to-end. [Scopri di più…](_)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Keychain は、エンドツーエンドの暗号化であなたの情報を保護します。[詳細はこちら](_)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 키체인은 종단 간 암호화를 통해 사용자의 정보를 보호합니다. [자세히 알아보기…](_)"
          }
        },
        "pt-BR": {
          "stringUnit": {
