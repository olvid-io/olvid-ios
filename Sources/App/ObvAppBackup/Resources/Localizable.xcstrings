    "ERASE_AND_GENERATE_COMPROMISED_KEY_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie glauben, dass dieser Geräte-Backup-Schlüssel gestohlen oder kompromittiert wurde, aber noch nicht ausgenutzt wurde, können Sie ihn löschen und einen neuen generieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you believe this device backup key was stolen or compromised, but not yet exploited, you can erase it and generate a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cree que la clave de respaldo de este dispositivo ha sido robada o comprometida, pero aún no explotada, puede borrarla y generar una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous pensez que la clé de sauvegarde de cet appareil a été volée ou compromise, mais pas encore exploitée, vous pouvez la supprimer et en générer une nouvelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ritieni che la chiave di backup di questo dispositivo sia stata rubata o compromessa, ma non ancora sfruttata, puoi cancellarla e generarne una nuova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのバックアップキーが盗まれたり、不正にアクセスされたりしたが、まだ悪用されていないと思われる場合は、このキーを消去して新しいキーを生成することができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 백업 키가 도난당하거나 유출되었을 가능성이 있지만 아직 악용되지는 않았다고 생각되면, 해당 키를 삭제하고 새 키를 생성할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você acredita que a chave de backup deste dispositivo foi roubada ou comprometida, mas ainda não foi utilizada, você pode apagá-la e gerar uma nova."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se suspeitar que a chave de cópia de segurança deste dispositivo foi roubada ou comprometida, mas ainda não utilizada, pode apagá-la e gerar uma nova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы считаете, что ключ резервной копии этого устройства был украден или скомпрометирован, но еще не использован, вы можете стереть его и сгенерировать новый."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви вважаєте, що ключ резервної копії цього пристрою було викрадено або скомпрометовано, але ще не використано, ви можете стерти його та згенерувати новий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您认为此设备的备份密钥被盗用或遭到破坏，但尚未被恶意利用，您可以将其清除并生成新的密钥。"
          }
        }
      }
    },
