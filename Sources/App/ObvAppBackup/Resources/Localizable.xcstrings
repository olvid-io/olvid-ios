    "PROFILE_RESTORATION_FAILED_BODY_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte versuchen Sie es erneut. Sollte das Problem weiterhin bestehen, senden Sie uns bitte die folgende Fehlermeldung an [%@](mailto:%@). Wir werden unser Bestes tun, um Ihnen zu helfen!"
