    "ERASE_AND_GENERATE_NEW_KEY_CONFIRMATION_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie den Schlüssel löschen und einen neuen generieren möchten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you wish to erase and generate a new key?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas borrar y generar una nueva clave?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez-vous vouloir effacer et générer une nouvelle clé ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler cancellare e generare una nuova chiave?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当に削除して、新しいキーを生成しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기존 키를 삭제하고 새 키를 생성하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz wymazać klucz i wygenerować nowy?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem certeza de que deseja apagar e gerar uma nova chave?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que pretende apagar e gerar uma nova chave?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите стереть и сгенерировать новый ключ?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarı silip yenisini oluşturmak istediğinizden emin misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
