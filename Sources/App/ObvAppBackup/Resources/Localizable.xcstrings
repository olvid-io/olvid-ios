    "CHOOSE_BETWEEN_MANUAL_AND_ICLOUD_BACKUPS_DURING_ONBOARDING": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig werden Backups automatisch verwaltet. Bitte erkunden Sie die erweiterten Einstellungen, um eine andere Option auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, backups will be managed automatically. Please explore the advanced settings to choose another option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, las copias de seguridad se gestionarán automáticamente. Consulta la configuración avanzada para elegir otra opción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, vos sauvegardes seront effectuées automatiquement. Pour choisir une autre option, rendez-vous dans les paramètres avancés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita, i backup saranno gestiti automaticamente. Esplora le impostazioni avanzate per scegliere un'altra opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは、バックアップは自動的に管理されます。別のオプションを選択するには、詳細設定をご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 백업은 자동으로 관리됩니다. 다른 옵션을 선택하려면 고급 설정을 확인하십시오."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie kopie zapasowe będą zarządzane automatycznie. Aby wybrać inną opcję, przejdź do ustawień zaawansowanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, os backups serão gerenciados automaticamente. Explore as configurações avançadas para escolher outra opção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por predefinição, as cópias de segurança serão geridas automaticamente. Consulte as definições avançadas para escolher outra opção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию, резервные копии будут управляться автоматически. Пожалуйста, изучите расширенные настройки, чтобы выбрать другой вариант."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak yedeklemeler otomatik olarak yönetilir. Başka bir seçenek belirlemek için lütfen gelişmiş ayarlara göz atın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За замовчуванням, резервні копії керуватимуться автоматично. Будь ласка, перегляньте розширені налаштування, щоб вибрати інший варіант."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo mặc định, bản sao lưu sẽ được quản lý tự động. Vui lòng khám phá các cài đặt nâng cao để chọn tùy chọn khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下，备份将自动管理。请探索高级设置，以选择其他选项。"
          }
        }
      }
    },
    "CHOOSE_BETWEEN_MANUAL_AND_ICLOUD_BACKUPS_WHILE_MIGRATING": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig werden Backups automatisch erstellt (Sie müssen keinen Backup-Schlüssel mehr notieren). Bitte erkunden Sie die erweiterten Einstellungen, um eine andere Option auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "By default, backups will be automatically performed (no need to write a backup key down anymore). Please explore the advanced settings to choose another option."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por defecto, las copias de seguridad se realizarán automáticamente (ya no es necesario anotar una clave de copia de seguridad). Consulta la configuración avanzada para elegir otra opción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut, vos sauvegardes seront effectuées automatiquement (plus besoin de noter de clé sauvegarde). Pour choisir une autre option, rendez-vous dans les paramètres avancés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per impostazione predefinita, i backup verranno eseguiti automaticamente (non è più necessario memorizzare una chiave di backup). Esplora le impostazioni avanzate per scegliere un'altra opzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトでは、バックアップが自動的に実行されます（バックアップキーをメモする必要はなくなります）。別のオプションを選択するには、詳細設定をご覧ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본적으로 백업이 자동으로 수행됩니다(더 이상 백업 키를 적어둘 필요가 없습니다). 다른 옵션을 선택하려면 고급 설정을 살펴보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Domyślnie kopie zapasowe będą tworzone automatycznie (nie trzeba już zapisywać klucza kopii zapasowej). Aby wybrać inną opcję, przejdź do ustawień zaawansowanych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por padrão, os backups serão realizados automaticamente (não será mais necessário anotar a chave de backup). Explore as configurações avançadas para escolher outra opção."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por predefinição, as cópias de segurança serão efetuadas automaticamente (já não é necessário guardar a chave de cópia de segurança). Explore as definições avançadas para escolher outra opção."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию резервные копии будут создаваться автоматически (больше не нужно записывать ключ резервной копии). Пожалуйста, изучите расширенные настройки, чтобы выбрать другой вариант."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan olarak yedeklemeler otomatik olarak yapılır (artık bir yedekleme anahtarı not etmenize gerek yok). Başka bir seçenek belirlemek için lütfen gelişmiş ayarlara göz atın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За замовчуванням, резервні копії будуть виконуватися автоматично (не потрібно більше записувати ключ резервної копії). Будь ласка, перегляньте розширені налаштування, щоб вибрати інший варіант."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo mặc định, các bản sao lưu sẽ được thực hiện tự động (bạn không cần phải ghi nhớ khóa sao lưu nữa). Vui lòng khám phá các cài đặt nâng cao để chọn một tùy chọn khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认情况下，系统会自动执行备份（无需再手动记录备份密钥）。请在高级设置中选择其他选项。"
          }
        }
      }
    },
    "CONFIRM_RESET_ALL_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher? Dieser Vorgang kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure? This operation is irreversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro? Esta operación es irreversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Êtes-vous sûr ? Cette opération est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro? Questa operazione è irreversibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よろしいですか？この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말로 하시겠습니까? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na pewno? Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza? Essa ação não pode ser desfeita."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza? Esta ação é irreversível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены? Это действие необратимо."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені? Ця дія незворотна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc không? Hành động này không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定吗？此操作不可撤销。"
          }
        }
      }
    },
