    "THIS_BACKUP_KEY_WILL_BE_REQUIRED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Schlüssel wird benötigt, wenn Sie die Profile dieses Geräts auf ein Gerät ohne Zugriff auf den iCloud-Schlüsselbund wiederherstellen möchten oder dauerhaft den Zugriff auf Ihr iCloud-Konto verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This key will be required if you wish to restore the profiles of this device onto a device without access to iCloud Keychain or if you permanently lose access to your iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta clave será necesaria si deseas restaurar los perfiles de este dispositivo en un dispositivo que no tenga acceso a iCloud Keychain o si pierdes permanentemente el acceso a tu cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette clé sera nécessaire si vous voulez restaurer les profils de cet appareil  sur un appareil n’ayant pas accès au trousseau iCloud, ou si vous perdez définitivement accès à votre compte iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa chiave sarà richiesta se desideri ripristinare i profili di questo dispositivo su un dispositivo senza accesso a iCloud Keychain o se perdi permanentemente l'accesso al tuo account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスのプロフィールを iCloud Keychain にアクセスできないデバイスに復元する場合、または iCloud アカウントへのアクセスを完全に失った場合に、このキーが必要になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud 키체인에 접근할 수 없거나 iCloud 계정을 영구적으로 사용할 수 없게 된 기기에 이 기기의 프로필을 복원하려는 경우 이 키가 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten klucz będzie potrzebny, jeśli zechcesz przywrócić profile z tego urządzenia na urządzeniu bez dostępu do pęku kluczy iCloud lub jeśli trwale utracisz dostęp do swojego konta iCloud."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave será necessária se você quiser restaurar os perfis deste dispositivo em um dispositivo que não tenha acesso ao iCloud Keychain ou se você perder permanentemente o acesso à sua conta do iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta chave será necessária se pretender restaurar os perfis deste dispositivo num dispositivo sem acesso ao iCloud Keychain ou se perder permanentemente o acesso à sua conta iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот ключ потребуется, если вы хотите восстановить профили этого устройства на устройстве без доступа к iCloud Keychain или если вы навсегда потеряете доступ к своей учетной записи iCloud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki profilleri iCloud Anahtar Zinciri'ne erişimi olmayan bir cihaza geri yüklemek isterseniz veya iCloud hesabınıza erişiminizi kalıcı olarak kaybederseniz bu anahtar gerekecektir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей ключ знадобиться, якщо ви хочете відновити профілі цього пристрою на пристрої без доступу до iCloud Keychain або якщо ви назавжди втратите доступ до свого облікового запису iCloud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa này sẽ được yêu cầu nếu bạn muốn khôi phục các cài đặt của thiết bị này lên một thiết bị khác không có quyền truy cập vào iCloud Keychain hoặc nếu bạn mất quyền truy cập vĩnh viễn vào tài khoản iCloud của mình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您希望将此设备的个人资料还原到无法访问 iCloud 钥匙链的设备上，或者永久丢失对 iCloud 帐户的访问权限，则需要此密钥。"
          }
        }
      }
    },
