    "YOU_CAN_CHOOSE_ACTIVE_DEVICE_AFTER_RESTORATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach der Wiederherstellung können Sie in Ihren Profileinstellungen auswählen, welches Gerät aktiv bleiben soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After the restoration, you will be able to choose which device to keep active from your profile settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la restauración, podrás elegir qué dispositivo mantener activo desde la configuración de tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la restauration, vous pourrez choisir quel appareil garder actif depuis les réglages de votre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopo il ripristino, potrai scegliere quale dispositivo mantenere attivo dalle impostazioni del tuo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元後、プロフィール設定から、アクティブな状態に保持するデバイスを選択できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원 후에는 프로필 설정에서 활성 상태로 유지할 장치를 선택할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a restauração, você poderá escolher qual dispositivo manter ativo nas configurações do seu perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Após a restauração, poderá escolher qual dispositivo manter ativo nas definições do seu perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После восстановления вы сможете выбрать, какое устройство оставить активным, в настройках вашего профиля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після відновлення ви зможете вибрати, який пристрій залишити активним, у налаштуваннях профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复完成后，您可以在个人资料设置中选择要保持活跃的设备。"
          }
        }
      }
    },
    "YOU_REQUESTED_THE_RESTORATION_OF_AN_OLD_BACKUP": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
