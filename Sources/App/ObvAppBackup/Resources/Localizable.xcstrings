    "BACKUP_MODE_BODY_KEYCHAIN" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die auf diesem Gerät vorhandenen Profile werden automatisch gesichert. Die Backups werden verschlüsselt und dann auf den Servern von Olvid gespeichert. Der Verschlüsselungsschlüssel wird im iCloud-Schlüsselbund gespeichert und auf all Ihren Geräten synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The profiles present on this device are automatically backed up. Backups are encrypted and then stored on Olvid's servers. The encryption key is saved in the iCloud keychain and synchronized across your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles presentes en este dispositivo se respaldan automáticamente. Los respaldos están encriptados y luego se almacenan en los servidores de Olvid. La clave de encriptación se guarda en el llavero de iCloud y se sincroniza entre tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils présents sur cet appareil sont sauvegardés automatiquement. Les sauvegardes sont chiffrées puis stockées sur les serveurs d'Olvid. La clé de chiffrement est enregistrée dans le trousseau iCloud et synchronisée entre vos différents appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili presenti su questo dispositivo vengono automaticamente salvati in backup. I backup sono crittografati e poi archiviati sui server di Olvid. La chiave di crittografia viene salvata nel portachiavi iCloud e sincronizzata su tutti i tuoi dispositivi."
          }
        }
      }
    },
    "BACKUP_MODE_BODY_MANUAL" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die auf diesem Gerät vorhandenen Profile werden automatisch gesichert. Die Backups werden verschlüsselt und dann auf den Servern von Olvid gespeichert. Sie müssen den Verschlüsselungsschlüssel aufschreiben und sicher aufbewahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The profiles present on this device are automatically backed up. Backups are encrypted and then stored on Olvid's servers. You will have to write down the encryption key and keep it in a safe place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles presentes en este dispositivo se respaldan automáticamente. Los respaldos están encriptados y luego se almacenan en los servidores de Olvid. Deberás anotar la clave de encriptación y guardarla en un lugar seguro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils présents sur cet appareil sont sauvegardés automatiquement. Les sauvegardes sont chiffrées puis stockées sur les serveurs d'Olvid. Vous devrez noter la clé de chiffrement et la conserver en lieu sûr."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili presenti su questo dispositivo vengono automaticamente salvati su backup. I backup sono crittografati e poi memorizzati sui server di Olvid. Dovrai annotare la chiave di crittografia e conservarla in un luogo sicuro."
          }
        }
      }
    },
    "BACKUP_MODE_BODY_NO_BACKUP" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die auf diesem Gerät vorhandenen Profile werden niemals gesichert. Der Verlust des Zugriffs auf dieses Gerät kann daher zum endgültigen Verlust der Profile führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The profiles present on this device are never backed up. Consequently, losing access to this device may result in the definitive loss of the profiles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles presentes en este dispositivo nunca se respaldan. En consecuencia, perder el acceso a este dispositivo podría resultar en la pérdida definitiva de los perfiles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les profils présents sur cet appareil ne sont jamais sauvegardés. La perte d'accès à cet appareil peut donc entraîner une perte définitive des profils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I profili presenti su questo dispositivo non vengono mai salvati su backup. Di conseguenza, la perdita di accesso a questo dispositivo potrebbe comportare la perdita definitiva dei profili."
          }
        }
      }
    },
