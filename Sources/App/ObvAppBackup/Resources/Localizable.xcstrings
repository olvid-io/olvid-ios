    "PROFILE_RESTORATION_FAILED_BODY_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte versuchen Sie es erneut. Sollte das Problem weiterhin bestehen, senden Sie uns bitte die folgende Fehlermeldung an [%@](mailto:%@). Wir werden unser Bestes tun, um Ihnen zu helfen!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please try again. If the problem persists, please send the following error to [%@](mailto:%@). We will do our best to help you out!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, inténtalo de nuevo. Si el problema persiste, envía el siguiente error a [%@](mailto:%@). Haremos todo lo posible para ayudarte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez essayer à nouveau. Si le problème persiste, n'hésitez pas à envoyer l'erreur ci-dessous à [%@](mailto:%@). Nous ferons tout notre possible pour vous aider !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di riprovare. Se il problema persiste, inviare il seguente errore a [%@](mailto:%@). Faremo del nostro meglio per aiutarla!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度お試しください。問題が解決しない場合は、以下のエラーメッセージを[%@](mailto:%@)宛てにお送りください。問題解決できるよう最善を尽くします！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 시도해 주세요. 문제가 계속되면 다음 오류를 [%@](mailto:%@)로 보내주세요. 최선을 다해 도와드리겠습니다!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spróbuj ponownie. Jeśli problem będzie się powtarzał, wyślij poniższy błąd na adres [%@](mailto:%@). Zrobimy wszystko, co w naszej mocy, aby pomóc!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, tente novamente. Se o problema persistir, envie a seguinte mensagem de erro para [%@](mailto:%@). Faremos o possível para ajudar!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, tente novamente. Se o problema persistir, envie a seguinte mensagem de erro para [%@](mailto:%@). Faremos o nosso melhor para ajudar!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, попробуйте еще раз. Если проблема не исчезнет, отправьте следующее сообщение об ошибке по адресу [%@](mailto:%@). Мы сделаем все возможное, чтобы вам помочь!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen tekrar deneyin. Sorun devam ederse aşağıdaki hatayı [%@](mailto:%@) adresine gönderin. Size yardımcı olmak için elimizden geleni yapacağız!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, спробуйте ще раз. Якщо проблема не зникає, надішліть наступну помилку на адресу [%@](mailto:%@). Ми докладемо всіх зусиль, щоб вам допомогти!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng thử lại. Nếu sự cố vẫn tiếp diễn, vui lòng gửi thông báo lỗi sau đến [%@](mailto:%@). Chúng tôi sẽ cố gắng hết sức để hỗ trợ bạn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后再试。如果问题仍然存在，请将以下错误信息发送到[%@](mailto:%@)。我们会尽力帮助您！"
          }
        }
      }
    },
