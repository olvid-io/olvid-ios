    "YOUR_BACKUP_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Backups können Sie Ihre Profile und Kontakte wiederherstellen, selbst wenn Sie den Zugriff auf Ihr Gerät verlieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups allow to restore your profiles and contacts even if you lose access to your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad permiten restaurar tus perfiles y contactos incluso si pierdes el acceso a tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarder permet de restaurer vos profils et contacts même si vous perdez  l’accès à votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup permettono di ripristinare i tuoi profili e contatti anche in caso di perdita di accesso al dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ機能を使用すると、デバイスへのアクセスを失った場合でも、プロフィールや連絡先を復元できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 통해 기기를 분실하더라도 프로필과 연락처를 복원할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zapasowe pozwalają przywrócić twoje profile i kontakty, nawet jeśli utracisz dostęp do urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups permitem restaurar seus perfis e contatos, mesmo que você perca o acesso ao seu dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias de segurança permitem restaurar os seus perfis e contactos, mesmo que perca o acesso ao seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии позволяют восстановить ваши профили и контакты, даже если вы потеряете доступ к устройству."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler, cihazınıza erişiminizi kaybetseniz bile profillerinizi ve kişilerinizi geri yüklemenizi sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії дозволяють відновити ваші профілі та контакти, навіть якщо ви втратите доступ до свого пристрою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng sao lưu cho phép bạn khôi phục hồ sơ và danh bạ của mình ngay cả khi bạn không còn quyền truy cập vào thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份功能可让您恢复个人资料和联系人，即使您无法访问您的设备。"
          }
        }
      }
    },
    "YOUR_BACKUP_WARNING": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beachten Sie, dass Nachrichten und Anhänge **nicht gesichert** werden und **nicht wiederhergestellt** werden können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please note that messages and attachments are **not backed up** and will **not be restored**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que los mensajes y archivos adjuntos **no se respaldan** y **no se restaurarán**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention, les messages et pièces jointes ne sont **pas sauvegardés** et ne seront **pas restaurés**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di notare che messaggi e allegati **non vengono salvati** e **non saranno ripristinati**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージと添付ファイルは**バックアップされず**、**復元もされません**のでご注意ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지와 첨부 파일은 **백업되지 않으며** **복원되지 않습니다**. 이 점을 유념해 주시기 바랍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamiętaj, że wiadomości i załączniki **nie są objęte kopią zapasową** i **nie zostaną przywrócone**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, observe que mensagens e anexos **não são salvos em backup** e **não serão restaurados**."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha em atenção que as mensagens e anexos **não são guardados em cópia de segurança** e **não serão restaurados**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обратите внимание, что сообщения и вложения **не сохраняются** и **не будут восстановлены**."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen mesajların ve eklerin **yedeklenmediğini** ve **geri yüklenmeyeceğini** unutmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, зверніть увагу, що повідомлення та вкладення **не зберігаються** та **не будуть відновлені**."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin lưu ý rằng tin nhắn và tệp đính kèm **không được sao lưu** và **sẽ không được khôi phục**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请注意，消息和附件**不会备份**，因此**无法恢复**。"
          }
        }
      }
    },
