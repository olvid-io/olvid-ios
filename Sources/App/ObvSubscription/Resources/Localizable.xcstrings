    "MESSAGE_SUBSCRIPTION_REQUIRED_CALL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Olvid-Abo ist erforderlich, um sichere Audio- und Videoanrufe zu tätigen.\n\nAnrufe entgegennehmen ist immer kostenlos.\n\nBesuchen Sie Ihr Profil, um Ihren Tarif zu prüfen oder ein Abo abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An Olvid subscription is required to make secure audio and video calls.\n\nReceiving calls is always free.\n\nVisit your profile to check your plan or subscribe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere una suscripción a Olvid para realizar llamadas de audio y video seguras.\n\nRecibir llamadas siempre es gratuito.\n\nVisita tu perfil para consultar tu plan o suscribirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abonnement Olvid est nécessaire pour passer des appels audio et vidéo sécurisés.\n\nRecevoir des appels reste toujours gratuit.\n\nConsultez votre profil pour vérifier votre forfait ou vous abonner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un abbonamento Olvid è necessario per effettuare chiamate audio e video sicure.\n\nRicevere chiamate è sempre gratuito.\n\nVisita il tuo profilo per controllare il tuo piano o abbonarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な音声およびビデオ通話を行うには、Olvidのサブスクリプションが必要です。\n\n通話の受信は常に無料です。\n\nプロフィールにアクセスして、プランを確認するか、サブスクリプションに登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 오디오 및 비디오 통화를 하려면 Olvid 구독이 필요합니다.\n\n전화 수신은 항상 무료입니다.\n\n프로필을 방문하여 요금제를 확인하거나 구독하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma assinatura Olvid é necessária para fazer chamadas de áudio e vídeo seguras.\n\nReceber chamadas é sempre gratuito.\n\nVisite seu perfil para verificar seu plano ou assinar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária uma subscrição Olvid para efetuar chamadas de áudio e vídeo seguras.\n\nReceber chamadas é sempre gratuito.\n\nVisite o seu perfil para verificar o seu plano ou subscrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для совершения защищенных аудио- и видеозвонков требуется подписка Olvid.\n\nПрием звонков всегда бесплатный.\n\nПосетите свой профиль, чтобы проверить свой тарифный план или оформить подписку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для здійснення безпечних аудіо- та відеодзвінків необхідна підписка Olvid.\n\nПрийом дзвінків завжди безкоштовний.\n\nВідвідайте свій профіль, щоб перевірити свій план або оформити підписку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要进行安全的音频和视频通话，您需要订阅 Olvid 服务。\n\n接收来电始终是免费的。\n\n请访问您的个人资料，查看您的订阅计划或进行订阅。"
          }
        }
      }
    },
    "MESSAGE_SUBSCRIPTION_REQUIRED_GENERIC": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angeforderte Funktion erfordert ein Abonnement.\n\nBesuchen Sie Ihr Profil, um Ihren Tarif zu prüfen oder ein Abo abzuschließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The requested feature requires a subscription.\n\nVisit your profile to check your plan or subscribe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La función solicitada requiere una suscripción.\n\nVisita tu perfil para consultar tu plan o suscribirte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonctionnalité demandée nécessite un abonnement.\n\nConsultez votre profil pour vérifier votre forfait ou vous abonner."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La funzionalità richiesta necessita di un abbonamento.\n\nVisita il tuo profilo per controllare il tuo piano o abbonarti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご希望の機能はサブスクリプションが必要です。\nプロフィールページでプランを確認するか、サブスクリプションにお申し込みください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청하신 기능은 구독이 필요합니다.\n\n프로필에서 구독 계획을 확인하거나 구독하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recurso solicitado exige uma assinatura.\n\nAcesse seu perfil para verificar seu plano ou assinar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A funcionalidade solicitada requer uma subscrição.\n\nVisite o seu perfil para verificar o seu plano ou subscrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашиваемая функция требует подписки.\n\nПосетите свой профиль, чтобы проверить свой тарифный план или оформить подписку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитана функція вимагає підписки.\n\nВідвідайте свій профіль, щоб перевірити свій план або оформити підписку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您请求的功能需要订阅。\n\n请访问您的个人资料，查看您的套餐或订阅。"
          }
        }
      }
    },
