      }
    },
    "MARKETING_CAPSULE_SUBTITLE_SECURE_CALLS": {
      "comment": "Subtitle text for a marketing capsule view with the \"Secure Calls\" marketing capsule type.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führe kristallklare Sprach- und pixelgenaue Videoanrufe – vollständig Ende-zu-Ende-verschlüsselt. Rufe jeden Olvid-Nutzer an, auch ohne Olvid+."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make end-to-end encrypted voice and video calls. Call any Olvid user, even without Olvid+."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Realiza llamadas de voz cristalinas y videollamadas en calidad perfecta, totalmente cifradas de extremo a extremo. Llama a cualquier usuario de Olvid, incluso sin Olvid+."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez des appels vocaux et vidéos chiffrés de bout en bout. Appelez n’importe quel utilisateur Olvid, même sans Olvid+."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effettua chiamate vocali cristalline e videochiamate in qualità perfetta, completamente crittografate end-to-end. Chiama qualsiasi utente Olvid, anche senza Olvid+."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エンドツーエンド暗号化された音声およびビデオ通話をしましょう。Olvid+を契約していなくても、他のOlvidユーザーなら誰にでも電話できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종단 간 암호화된 음성 및 영상 통화를 합니다. Olvid+를 구독하지 않아도 모든 Olvid 사용자와 통화할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça chamadas de voz e vídeo com criptografia de ponta a ponta. Ligue para qualquer usuário do Olvid, mesmo sem o Olvid+."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça chamadas de voz e vídeo com encriptação de ponta a ponta. Ligue para qualquer utilizador do Olvid, mesmo que não tenha o Olvid+."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Совершайте сквозные зашифрованные голосовые и видеозвонки. Звоните любому пользователю Olvid, даже без Olvid+."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Здійснюйте кінцево-зашифровані голосові та відеодзвінки. Телефонуйте будь-якому користувачу Olvid, навіть без Olvid+."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进行端到端加密的语音和视频通话。可以呼叫任何 Olvid 用户，即使他们没有订阅 Olvid+。"
          }
        }
      }
    },
    "MARKETING_CAPSULE_SUBTITLE_SUPPORT": {
      "comment": "Subtitle for a marketing capsule view with the \"Support\" kind.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid ist so konzipiert, dass es niemals auf deine Daten zugreift. Dein Abo unterstützt ein nachhaltiges und ehrliches Modell – Olvid bleibt für alle kostenlos, ohne Werbung oder versteckte Kosten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription supports a sustainable, honest model—keeping Olvid free for all, without ads or hidden costs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid está diseñado para nunca acceder a tus datos. Tu suscripción apoya un modelo sostenible y honesto, manteniendo Olvid gratis para todos, sin anuncios ni costes ocultos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid est conçue pour ne jamais accéder à vos données. Votre abonnement soutient un modèle durable et honnête, qui permet à Olvid de rester gratuite pour tous, sans publicité ni coûts cachés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid è progettato per non accedere mai ai tuoi dati. Il tuo abbonamento sostiene un modello sostenibile e onesto, mantenendo Olvid gratuito per tutti, senza pubblicità o costi nascosti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様のサブスクリプションは、持続可能で公正なモデルを支援し、Olvidをすべての人にとって無料で、広告や隠れた費用なしで利用できるようにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 구독은 지속 가능하고 투명한 모델을 지원하여 Olvid이 광고나 숨겨진 비용 없이 모든 사용자에게 무료로 제공될 수 있도록 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua assinatura apoia um modelo sustentável e transparente, garantindo que o Olvid continue gratuito para todos, sem anúncios ou custos ocultos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua subscrição apoia um modelo sustentável e honesto, permitindo que o Olvid continue a ser gratuito para todos, sem anúncios ou custos ocultos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша подписка поддерживает устойчивую и честную модель — позволяя Olvid оставаться бесплатным для всех, без рекламы и скрытых платежей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша підписка підтримує сталу та чесну модель—допомагаючи Olvid залишатися безкоштовним для всіх, без реклами чи прихованих витрат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的订阅支持一种可持续且透明的模式，让 Olvid 始终保持免费，没有广告或隐藏费用。"
          }
        }
      }
    },
