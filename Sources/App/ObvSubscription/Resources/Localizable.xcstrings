    "MARKETING_CAPSULE_SUBTITLE_FAMILY" : {
      "comment" : "Subtitle for a marketing capsule with the \"Family\" marketing capsule type.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte die Apple-Familienfreigabe ein und gib fünf Familienmitgliedern Zugang zu Olvid+."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set up Apple Family Sharing and gift Olvid+ to five of your family members."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura el Compartir en familia de Apple y dale acceso a Olvid+ a cinco miembros de tu familia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurez le Partage familial Apple et offrez Olvid+ à cinq membres de votre famille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configura la condivisione familiare Apple e dai accesso a Olvid+ a cinque membri della tua famiglia."
          }
        }
      }
    },
    "MARKETING_CAPSULE_SUBTITLE_MULTIDEVICE" : {
      "comment" : "Subtitle for a marketing capsule view that describes a feature related to multiple devices.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutze Olvid überall und jederzeit. Deine Nachrichten sind auf allen Geräten synchronisiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your messages stay in sync across all your devices."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Olvid en cualquier lugar y momento. Tus mensajes siempre sincronizados en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos messages sont synchronisés entre tous vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Olvid ovunque, in qualsiasi momento. I tuoi messaggi sono sempre sincronizzati su tutti i dispositivi."
          }
        }
      }
    },
    "MARKETING_CAPSULE_SUBTITLE_SECURE_CALLS" : {
      "comment" : "Subtitle text for a marketing capsule view with the \"Secure Calls\" marketing capsule type.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führe kristallklare Sprach- und pixelgenaue Videoanrufe – vollständig Ende-zu-Ende-verschlüsselt. Rufe jeden Olvid-Nutzer an, auch ohne Olvid+."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make end-to-end encrypted voice and video calls. Call any Olvid user, even without Olvid+."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Realiza llamadas de voz cristalinas y videollamadas en calidad perfecta, totalmente cifradas de extremo a extremo. Llama a cualquier usuario de Olvid, incluso sin Olvid+."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez des appels vocaux et vidéos chiffrés de bout en bout. Appelez n’importe quel utilisateur Olvid, même sans Olvid+."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effettua chiamate vocali cristalline e videochiamate in qualità perfetta, completamente crittografate end-to-end. Chiama qualsiasi utente Olvid, anche senza Olvid+."
          }
        }
      }
    },
    "MARKETING_CAPSULE_SUBTITLE_SUPPORT" : {
      "comment" : "Subtitle for a marketing capsule view with the \"Support\" kind.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid ist so konzipiert, dass es niemals auf deine Daten zugreift. Dein Abo unterstützt ein nachhaltiges und ehrliches Modell – Olvid bleibt für alle kostenlos, ohne Werbung oder versteckte Kosten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your subscription supports a sustainable, honest model—keeping Olvid free for all, without ads or hidden costs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid está diseñado para nunca acceder a tus datos. Tu suscripción apoya un modelo sostenible y honesto, manteniendo Olvid gratis para todos, sin anuncios ni costes ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid est conçue pour ne jamais accéder à vos données. Votre abonnement soutient un modèle durable et honnête, qui permet à Olvid de rester gratuite pour tous, sans publicité ni coûts cachés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid è progettato per non accedere mai ai tuoi dati. Il tuo abbonamento sostiene un modello sostenibile e onesto, mantenendo Olvid gratuito per tutti, senza pubblicità o costi nascosti."
          }
        }
      }
    },
