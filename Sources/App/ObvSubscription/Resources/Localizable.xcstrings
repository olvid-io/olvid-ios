    "CONTENT_UNAVAILABLE_VIEW_DESCRIPTION_ON_EMPTY_PRODUCTS": {
      "comment": "A description displayed below the title of a view that indicates that there are no products to display.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Abonnementliste konnte nicht geladen werden. Überprüfen Sie Ihre Internetverbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t load the list of subscriptions. Check your internet connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido cargar la lista de suscripciones. Revisa tu conexión a Internet e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de charger la liste des abonnements. Vérifiez votre connexion internet et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile caricare l’elenco degli abbonamenti. Controlla la connessione a Internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購読リストの読み込みに失敗しました。インターネット接続を確認して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 목록을 불러올 수 없습니다. 인터넷 연결을 확인하고 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a lista de assinaturas. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar a lista de subscrições. Verifique a sua ligação à Internet e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось загрузить список подписок. Проверьте подключение к интернету и попробуйте еще раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завантажити список підписок. Перевірте підключення до Інтернету та спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法加载订阅列表。请检查您的网络连接，然后重试。"
          }
        }
      }
    },
