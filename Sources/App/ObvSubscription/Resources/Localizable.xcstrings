    "SUBSCRIBE_VIA_EMAIL_DESCRIPTION" : {
      "comment" : "A description displayed below the title of the screen allowing to send an email to Olvid's support.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In-App-Abonnements für Olvid werden auf Ihrer OS-Version derzeit nicht unterstützt. Falls ein Update nicht möglich ist, kontaktieren Sie uns – wir helfen Ihnen gerne weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In-App Subscriptions for Olvid are not currently supported on your OS version. If you’re unable to update your device, please contact us—we’re here to help you find the best solution."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las suscripciones dentro de la app de Olvid no están soportadas actualmente en tu versión de OS. Si no puedes actualizar tu dispositivo, contáctanos: estaremos encantados de ayudarte."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les abonnements intégrés Olvid ne sont pas pris en charge sur votre version d’OS. Si vous ne pouvez pas mettre à jour votre appareil, contactez-nous : nous vous aiderons à trouver une solution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli abbonamenti in-app di Olvid non sono attualmente supportati sulla tua versione di OS. Se non puoi aggiornare il dispositivo, contattaci: saremo felici di aiutarti."
          }
        }
      }
    },
    "SUBSCRIBE_VIA_EMAIL_INFO_BODY" : {
      "comment" : "Body of the email that appears when they try to subscribe via email on an iOS 16 device.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo Olvid-Team,\n\nich kann auf meinem Gerät keine In-App-Abonnements abschließen. Könnten Sie mir eine Lösung aufzeigen? Vielen Dank für Ihre Unterstützung!\n\nMit freundlichen Grüßen,"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello Olvid Team,\n\nI’m unable to access In-App Subscriptions on my device. Could you guide me on how to subscribe?\nThank you for your support!\n\nBest regards"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola equipo de Olvid,\n\nNo puedo acceder a las suscripciones dentro de la app desde mi dispositivo. ¿Podrían indicarme cómo suscribirme?\n\n¡Gracias por su ayuda!\n\nUn cordial saludo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour l’équipe Olvid,\n\nJe n’arrive pas à accéder aux abonnements intégrés depuis mon appareil. Pourriez-vous m’indiquer comment procéder ?\n\nMerci pour votre aide !\n\nCordialement"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao team Olvid,\n\nNon riesco ad accedere agli abbonamenti in-app dal mio dispositivo. Potreste indicarmi come procedere?\n\nGrazie per il vostro supporto!\n\nCordiali saluti,"
          }
        }
      }
    },
