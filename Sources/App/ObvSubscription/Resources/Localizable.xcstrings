    "START_FREE_TRIAL_ACTIVATED_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr kostenloser 30-Tage-Testzeitraum ist aktiv. Nutzen Sie sichere Audio- und Videoanrufe ohne Sorgen—am Ende der Testphase entstehen keine Kosten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your free 30-day trial is active. Explore secure audio and video calls with peace of mind—no charges will apply when the trial ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratuita de 30 días está activa. Disfruta de llamadas de audio y video seguras con total tranquilidad—no se aplicarán cargos al finalizar la prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre essai gratuit de 30 jours est activé. Découvrez les appels audio et vidéo sécurisés en toute sérénité—aucun frais ne sera appliqué à la fin de l'essai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prova gratuita di 30 giorni è attiva. Esplora chiamate audio e video sicure con tranquillità—nessun addebito sarà applicato alla fine della prova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無料の30日間のトライアル期間中です。安全な音声およびビデオ通話をお試しください。トライアル期間終了後も、追加料金は発生しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 무료 평가판이 활성화되었습니다. 안심하고 안전한 오디오 및 비디오 통화를 사용해 보세요. 평가판이 종료되면 요금이 부과되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu período de teste gratuito de 30 dias está ativo. Explore chamadas de áudio e vídeo seguras com total tranquilidade – nenhuma cobrança será aplicada quando o período de teste terminar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu período de teste gratuito de 30 dias está ativo. Explore chamadas de áudio e vídeo seguras com total tranquilidade – não serão aplicadas cobranças quando o período de teste terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша бесплатная 30-дневная пробная версия активна. Попробуйте безопасные аудио- и видеозвонки, не беспокоясь о платежах – с вас не будет списано ни копейки по окончании пробного периода."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша безкоштовна 30-денна пробна версія активна. Досліджуйте безпечні аудіо- та відеодзвінки з упевненістю — плата не стягуватиметься після закінчення пробного періоду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 30 天免费试用期已激活。安心体验安全可靠的语音和视频通话功能，试用期结束后不会产生任何费用。"
          }
        }
      }
    },
    "START_FREE_TRIAL_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Genießen Sie sichere Audio- und Videoanrufe 30 Tage lang kostenlos. Keine Zahlung erforderlich—Ihr Testzeitraum endet einfach nach 30 Tagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enjoy secure audio and video calls for free with a 30-day trial. No payment required—your trial will simply expire after 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disfruta de llamadas de audio y video seguras de forma gratuita con una prueba de 30 días. No se requiere pago—tu prueba simplemente expirará después de 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profitez d'appels audio et vidéo sécurisés gratuitement avec un essai de 30 jours. Aucun paiement requis—votre essai expirera simplement après 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Goditi chiamate audio e video sicure gratuitamente con una prova di 30 giorni. Nessun pagamento richiesto—la prova scadrà semplicemente dopo 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間の無料トライアルで、安全な音声・ビデオ通話をお楽しみください。お支払いは不要です。トライアル期間は30日で自動的に終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 무료 체험으로 안전한 오디오 및 비디오 통화를 즐기세요. 결제는 필요하지 않으며, 체험 기간은 30일 후에 자동으로 종료됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aproveite chamadas de áudio e vídeo seguras e gratuitas com um período de avaliação de 30 dias. Nenhum pagamento é necessário – seu período de avaliação simplesmente terminará após 30 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desfrute de chamadas de áudio e vídeo seguras e gratuitas com um período de teste de 30 dias. Não é necessário efetuar qualquer pagamento – o seu período de teste terminará automaticamente após 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наслаждайтесь безопасными аудио- и видеозвонками бесплатно в течение 30-дневного пробного периода. Оплата не требуется – ваша пробная версия просто истечет через 30 дней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Насолоджуйтесь безпечними аудіо- та відеодзвінками безкоштовно протягом 30-денної пробної версії. Платіж не потрібен – ваша пробна версія просто закінчиться через 30 днів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "享受 30 天免费试用期，即可免费进行安全的音频和视频通话。无需支付任何费用，试用期结束后，您的账户将自动停止使用。"
          }
        }
      }
    },
    "STORE_PRODUCTS_TASK_FAILURE_DESCRIPTION": {
      "comment": "A description displayed when the fetching of the store products fails.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verfügbaren Abonnements konnten nicht geladen werden. Überprüfen Sie Ihre Internetverbindung und versuchen Sie es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We couldn’t load the available subscriptions. Please check your internet connection and try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hemos podido cargar las suscripciones disponibles. Verifica tu conexión a Internet e inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n’avons pas pu charger les abonnements disponibles. Vérifiez votre connexion internet et réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a caricare gli abbonamenti disponibili. Verifica la connessione a Internet e riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能なサブスクリプションを読み込めませんでした。インターネット接続を確認し、後で再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 가능한 구독을 불러올 수 없습니다. 인터넷 연결 상태를 확인하고 나중에 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as assinaturas disponíveis. Verifique sua conexão com a internet e tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível carregar as subscrições disponíveis. Verifique a sua ligação à Internet e tente novamente mais tarde."
