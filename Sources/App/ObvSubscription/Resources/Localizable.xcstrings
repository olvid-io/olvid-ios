    "MARKETING_CAPSULE_SUBTITLE_FAMILY": {
      "comment": "Subtitle for a marketing capsule with the \"Family\" marketing capsule type.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte die Apple-Familienfreigabe ein und gib fünf Familienmitgliedern Zugang zu Olvid+."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up Apple Family Sharing and gift Olvid+ to five of your family members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el Compartir en familia de Apple y dale acceso a Olvid+ a cinco miembros de tu familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez le Partage familial Apple et offrez Olvid+ à cinq membres de votre famille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la condivisione familiare Apple e dai accesso a Olvid+ a cinque membri della tua famiglia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのファミリー共有を設定し、ご家族のお好きな5人にOlvid+をプレゼントしましょう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing을 설정하고 가족 구성원 다섯 명에게 Olvid+를 선물하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o Compartilhamento Familiar da Apple e ofereça o Olvid+ a cinco membros da sua família."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o Apple Family Sharing e ofereça o Olvid+ a cinco membros da sua família."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте «Семейный доступ» Apple и подарите Olvid+ пятерым членам вашей семьи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте «Family Sharing» від Apple та подаруйте Olvid+ п’ятьом членам вашої родини."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 Apple 家庭共享，并将 Olvid+ 赠送给您的五位家庭成员。"
          }
        }
      }
    },
    "MARKETING_CAPSULE_SUBTITLE_MULTIDEVICE": {
      "comment": "Subtitle for a marketing capsule view that describes a feature related to multiple devices.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze Olvid überall und jederzeit. Deine Nachrichten sind auf allen Geräten synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your messages stay in sync across all your devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Olvid en cualquier lugar y momento. Tus mensajes siempre sincronizados en todos tus dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos messages sont synchronisés entre tous vos appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Olvid ovunque, in qualsiasi momento. I tuoi messaggi sono sempre sincronizzati su tutti i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのデバイスでメッセージが常に同期されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여러 기기에서 메시지를 동기화하여 사용할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas mensagens permanecem sincronizadas em todos os seus dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas mensagens permanecem sincronizadas em todos os seus dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши сообщения синхронизируются на всех ваших устройствах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші повідомлення синхронізуються на всіх ваших пристроях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的消息会在所有设备上保持同步。"
          }
