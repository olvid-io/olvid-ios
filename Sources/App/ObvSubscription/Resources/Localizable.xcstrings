    "CONTENT_UNAVAILABLE_VIEW_DESCRIPTION_ON_EMPTY_PRODUCTS" : {
      "comment" : "A description displayed below the title of a view that indicates that there are no products to display.",
      "isCommentAutoGenerated" : true,
