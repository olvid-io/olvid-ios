    "TIP_OLVID_PLUS_MESSAGE_FAMILY": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte Apple Family Sharing ein und schenke Olvid+ an fünf Familienmitglieder. Jeder erhält Multi-Device-Zugriff und sichere Anrufe & Videoanrufe—Privatsphäre für die ganze Familie!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up Apple Family Sharing and gift Olvid+ to five family members. Everyone gets multi-device access and secure calls & video—privacy for the whole family!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura el Compartir en familia de Apple y regala Olvid+ a cinco miembros de tu familia. Todos tendrán acceso multi-dispositivo y llamadas y videollamadas seguras—privacidad para toda la familia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurez le partage familial Apple et offrez Olvid+ à cinq membres de votre famille. Tout le monde bénéficie de l’accès multi-appareils et des appels audio et vidéo sécurisés—la confidentialité pour toute la famille !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura la Condivisione famiglia Apple e regala Olvid+ a cinque membri della tua famiglia. Tutti ottengono l’accesso multi-dispositivo e chiamate audio e video sicure—privacy per tutta la famiglia!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleのファミリー共有を設定し、5人の家族にOlvid+をプレゼントしましょう。全員がマルチデバイスアクセスと安全な通話およびビデオ通話を利用できるようになり、家族全体のプライバシーが保護されます！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Family Sharing을 설정하고 Olvid+를 다섯 명의 가족 구성원에게 선물하세요. 모든 사용자가 다중 기기 액세스와 안전한 통화 및 비디오 기능을 통해 가족 전체의 개인 정보 보호를 누릴 수 있습니다!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o Compartilhamento em Família da Apple e ofereça o Olvid+ para cinco membros da família. Todos terão acesso em vários dispositivos e chamadas e videochamadas seguras – privacidade para toda a família!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure o Apple Family Sharing e ofereça o Olvid+ a cinco membros da sua família. Todos terão acesso multi-dispositivo e chamadas e videochamadas seguras – privacidade para toda a família!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройте «Семейный доступ» Apple и подарите Olvid+ пятерым членам семьи. Все получат доступ на нескольких устройствах и безопасные звонки и видеосвязь – конфиденциальность для всей семьи!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштуйте Apple Family Sharing та подаруйте Olvid+ п’ятьом членам сім’ї. Усі отримають доступ на кількох пристроях та безпечні дзвінки й відео – конфіденційність для всієї родини!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置 Apple 家庭共享，并将 Olvid+ 赠送给五位家庭成员。每个人都可以享受多设备访问、安全的通话和视频功能，为整个家庭提供隐私保护！"
          }
        }
      }
    },
    "TIP_OLVID_PLUS_MESSAGE_MULTIDEVICE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade auf Olvid+ und freischalten Sie den Multi-Device-Zugriff. Ihre Nachrichten bleiben auf allen Geräten synchronisiert—so sind Sie immer verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upgrade to Olvid+ and unlock multi-device access. Your messages stay in sync across all your devices—so you’re always connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualiza a Olvid+ y desbloquea el acceso multi-dispositivo. Tus mensajes se mantienen sincronizados en todos tus dispositivos—para que siempre estés conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez à Olvid+ et débloquez l’accès multi-appareils. Vos messages sont synchronisés entre tous vos appareils—pour rester toujours connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna a Olvid+ e sblocca l’accesso multi-dispositivo. I tuoi messaggi rimangono sincronizzati su tutti i tuoi dispositivi—così sei sempre connesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+にアップグレードして、複数のデバイスでのアクセスを可能にします。メッセージはすべてのデバイス間で同期されるため、常に接続された状態を保てます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+로 업그레이드하여 멀티 디바이스 액세스를 잠금 해제하세요. 모든 디바이스에서 메시지가 동기화되어 항상 연결 상태를 유지할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça um upgrade para o Olvid+ e desbloqueie o acesso em vários dispositivos. Suas mensagens permanecem sincronizadas em todos os seus dispositivos, para que você esteja sempre conectado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma atualização para o Olvid+ e desbloqueie o acesso em vários dispositivos. As suas mensagens permanecem sincronizadas em todos os seus dispositivos, para que esteja sempre conectado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновитесь до Olvid+ и разблокируйте доступ на нескольких устройствах. Ваши сообщения будут синхронизироваться на всех ваших устройствах, чтобы вы всегда оставались на связи."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновіться до Olvid+ та відкрийте доступ до мультидевайсу. Ваші повідомлення залишаються синхронізованими на всіх ваших пристроях, тож ви завжди на зв’язку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "升级到 Olvid+ 并解锁多设备访问功能。您的消息将在所有设备上保持同步，让您始终保持连接。"
          }
        }
      }
    },
    "TIP_OLVID_PLUS_MESSAGE_SECURE_CALLS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Olvid+ können Sie Ende-zu-Ende-verschlüsselte Sprach- und Videoanrufe tätigen. Erreichen Sie jeden Olvid-Nutzer sicher – ganz gleich, ob er Olvid+ hat oder nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+ lets you make end-to-end encrypted voice and video calls. Reach any Olvid user securely, whether they have Olvid+ or not."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+ te permite hacer llamadas de voz y video con cifrado de extremo a extremo. Conéctate de forma segura con cualquier usuario de Olvid, tenga Olvid+ o no."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+ vous permet de passer des appels vocaux et vidéo chiffrés de bout en bout. Communiquez en toute sécurité avec tout utilisateur Olvid, qu’il ait Olvid+ ou non."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+ ti permette di effettuare chiamate vocali e video crittografate end-to-end. Raggiungi qualsiasi utente Olvid in modo sicuro, che abbia Olvid+ o no."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+を使用すると、エンドツーエンドで暗号化された音声およびビデオ通話ができます。Olvid+を使用しているかどうかにかかわらず、すべてのOlvidユーザーに安全に連絡できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+를 사용하면 종단 간 암호화된 음성 및 화상 통화를 할 수 있습니다. Olvid+를 사용하든 사용하지 않든 모든 Olvid 사용자와 안전하게 통신하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid+ permite que você faça chamadas de voz e vídeo criptografadas de ponta a ponta. Entre em contato com qualquer usuário do Olvid de forma segura, mesmo que ele tenha ou não o Olvid+."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid+ permite que faça chamadas de voz e vídeo com encriptação de ponta a ponta. Contacte qualquer utilizador do Olvid de forma segura, quer tenha o Olvid+ ou não."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+ позволяет совершать сквозные зашифрованные голосовые и видеозвонки. Свяжитесь с любым пользователем Olvid безопасно, независимо от того, установлена у него версия Olvid+ или нет."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+ дозволяє здійснювати зашифровані кінце-кінцем голосові та відеодзвінки. Зв’яжіться з будь-яким користувачем Olvid безпечно, незалежно від того, чи встановлено у нього Olvid+ чи ні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+ 允许您进行端到端加密的语音和视频通话。无论对方是否使用 Olvid+，您都可以安全地与任何 Olvid 用户联系。"
          }
        }
      }
    },
    "TIP_OLVID_PLUS_MESSAGE_SUPPORT": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freischalten Sie Multi-Device-Zugriff und sichere Anrufe mit Olvid+. Ihr Abo unterstützt ein nachhaltiges, ehrliches Modell—Olvid bleibt für alle kostenlos, ohne Werbung oder versteckte Kosten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock multi-device access and secure calls with Olvid+. Your subscription supports a sustainable, honest model—keeping Olvid free for all, without ads or hidden costs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea el acceso multi-dispositivo y las llamadas seguras con Olvid+. Tu suscripción apoya un modelo sostenible y honesto—manteniendo Olvid gratuito para todos, sin anuncios ni costes ocultos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débloquez l’accès multi-appareils et les appels sécurisés avec Olvid+. Votre abonnement soutient un modèle durable et honnête, qui permet à Olvid de rester gratuite pour tous, sans publicité ni coûts cachés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca l’accesso multi-dispositivo e le chiamate sicure con Olvid+. Il tuo abbonamento sostiene un modello sostenibile e onesto—mantenendo Olvid gratuito per tutti, senza pubblicità o costi nascosti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+にアップグレードして、マルチデバイスアクセスや安全な通話を有効にしましょう。お客様のサブスクリプションは、持続可能で透明性の高いモデルをサポートし、広告や隠れた費用なしで、Olvidをすべての人に無料で提供し続けます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid+를 구독하여 여러 기기에서 편리하게 접속하고 안전한 통화를 즐기세요. 구독료는 지속 가능한 운영 모델을 지원하며, Olvid는 광고나 숨겨진 비용 없이 모든 사용자에게 무료로 제공됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o acesso em vários dispositivos e garanta chamadas seguras com o Olvid+. Sua assinatura apoia um modelo sustentável e transparente, mantendo o Olvid gratuito para todos, sem anúncios ou custos ocultos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie o acesso multi-dispositivo e as chamadas seguras com o Olvid+. A sua subscrição apoia um modelo sustentável e transparente, mantendo o Olvid gratuito para todos, sem anúncios ou custos ocultos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разблокируйте многоустройственный доступ и безопасные звонки с Olvid+. Ваша подписка поддерживает устойчивую и честную модель — сохраняя Olvid бесплатным для всех, без рекламы и скрытых платежей."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розблокуйте доступ на багатьох пристроях та безпечні дзвінки з Olvid+. Ваша підписка підтримує стабільну та чесну модель—допомагаючи Olvid залишатися безкоштовним для всіх, без реклами чи прихованих витрат."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解锁多设备访问和安全通话功能，使用 Olvid+。您的订阅支持可持续且透明的模式，让 Olvid 始终保持免费，且没有广告或隐藏费用。"
          }
        }
      }
    },
