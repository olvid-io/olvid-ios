    "Please hold on, we're working hard in the background to get everything ready for you!": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte haben Sie einen Moment Geduld, wir arbeiten intensiv daran, alles für Sie vorzubereiten!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please hold on, we're working hard to get everything ready for you!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, espere, estamos trabajando arduamente para tener todo listo para usted."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez patienter, nous travaillons dur pour tout préparer pour vous !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per favore, abbi pazienza, stiamo lavorando sodo per preparare tutto per te!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "しばらくお待ちください。皆様にご利用いただけるよう、準備を進めております！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시만 기다려 주세요. 모든 준비를 마치기 위해 열심히 노력하고 있습니다!"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prosimy o chwilę cierpliwości — intensywnie pracujemy, aby wszystko dla ciebie przygotować!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, aguarde. Estamos trabalhando para deixar tudo pronto para você!"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, tenha paciência, estamos a trabalhar arduamente para ter tudo pronto para si!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, подождите, мы усердно работаем над тем, чтобы все было готово для вас!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lütfen bekleyin, her şeyi sizin için hazırlamak üzere yoğun şekilde çalışıyoruz!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, зачекайте, ми наполегливо працюємо, щоб все було готово для вас!"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xin vui lòng đợi một chút, chúng tôi đang nỗ lực để chuẩn bị mọi thứ cho bạn!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍等，我们正在努力为您准备好所有内容！"
          }
        }
      }
    },
