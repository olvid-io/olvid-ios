    "YOUR_PROFILE_IS_INACTIVE_ON_THIS_DEVICE_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Profil ist auf diesem Gerät derzeit inaktiv. Sie können keine Nachrichten senden oder empfangen. Tippen Sie unten, um Ihre Reaktivierungsoptionen anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile is currently inactive on this device. You won’t be able to send or receive messages. Tap below to see your reactivation options."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil está inactivo en este dispositivo. No podrás enviar ni recibir mensajes. Pulsa abajo para ver tus opciones de reactivación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil est actuellement inactif sur cet appareil. Vous ne pouvez ni envoyer ni recevoir de messages. Appuyez ci-dessous pour consulter les options de réactivation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo è attualmente inattivo su questo dispositivo. Non potrai inviare o ricevere messaggi. Tocca qui sotto per visualizzare le opzioni di riattivazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは、現在プロフィールが非アクティブになっています。メッセージの送受信はできません。再アクティブ化の方法については、以下をタップしてご確認ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 이 장치에서 프로필이 비활성화되어 있습니다. 메시지를 보내거나 받을 수 없습니다. 아래를 탭하여 프로필을 다시 활성화하는 방법을 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu perfil está inativo neste dispositivo. Você não poderá enviar ou receber mensagens. Toque abaixo para ver as opções de reativação."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu perfil está atualmente inativo neste dispositivo. Não poderá enviar ou receber mensagens. Toque abaixo para ver as opções de reativação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время ваш профиль неактивен на этом устройстве. Вы не сможете отправлять или получать сообщения. Нажмите ниже, чтобы узнать о доступных вариантах повторной активации."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш профіль наразі неактивний на цьому пристрої. Ви не зможете надсилати чи отримувати повідомлення. Торкніться нижче, щоб переглянути варіанти повторної активації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您当前的个人资料在此设备上处于非活跃状态。您将无法发送或接收消息。点击下方查看您的重新激活选项。"
          }
        }
      }
    },
