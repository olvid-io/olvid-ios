    "UPCOMING_DEVICE_DEACTIVATION_ADVICE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können auswählen, welche Geräte aktiv bleiben sollen, oder **Olvid+** abonnieren, damit alle Ihre Geräte aktiv bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose which devices to keep active, or subscribe to **Olvid+** to keep all your devices active."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes elegir qué dispositivos mantener activos o suscribirte a **Olvid+** para mantener todos tus dispositivos activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez choisir quel appareil doit rester actif, ou souscrire à **Olvid+** pour conserver tous vos appareils actifs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scegliere quali dispositivi mantenere attivi oppure puoi sottoscrivere un abbonamento **Olvid+** per mantenere attivi tutti i tuoi dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブにしておくデバイスを選択するか、**Olvid+**に登録して、すべてのデバイスをアクティブにすることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 상태로 유지할 장치를 선택하거나 **Olvid+**를 구독하여 모든 장치를 활성 상태로 유지할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wybrać, które urządzenia mają pozostać aktywne, lub wykupić subskrypcję **Olvid+**, aby wszystkie twoje urządzenia pozostały aktywne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode escolher quais dispositivos manter ativos ou assinar o **Olvid+** para manter todos os seus dispositivos ativos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode escolher quais dispositivos manter ativos ou subscrever o **Olvid+** para manter todos os seus dispositivos ativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете выбрать, какие устройства держать в активном состоянии, или оформить подписку **Olvid+**, чтобы все ваши устройства оставались активными."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hangi cihazların etkin kalacağını seçebilir veya tüm cihazlarınızı etkin tutmak için **Olvid+** abonesi olabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете вибрати, які пристрої залишати активними, або підписатися на **Olvid+**, щоб усі ваші пристрої були активні."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể chọn thiết bị nào cần giữ ở chế độ hoạt động hoặc đăng ký **Olvid+** để tất cả các thiết bị của bạn luôn hoạt động."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以选择要保持活跃状态的设备，或者订阅 **Olvid+** 以保持所有设备处于活跃状态。"
          }
        }
      }
    },
    "UPCOMING_DEVICE_DEACTIVATION_MESSAGE_OTHER_DEVICE_%@": {
      "comment": "A message that informs the user that a device is about to expire.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines Ihrer Geräte wird in **weniger als %@** deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One of your devices will be deactivated in **less than %@**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno de tus dispositivos se desactivará en **menos de %@**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un de vos appareils sera désactivé dans **moins de %@**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno dei tuoi dispositivi verrà disattivato tra **meno di %@**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いずれかのデバイスは、**あと %@ 以内**で無効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 기기 중 하나가 **%@ 이내**에 비활성화됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno z twoich urządzeń zostanie dezaktywowane za **mniej niż %@**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dos seus dispositivos será desativado em **menos de %@**."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dos seus dispositivos será desativado em **menos de %@**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно из ваших устройств будет отключено менее чем через %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cihazlarınızdan biri **en fazla %@ içinde** devre dışı bırakılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один з ваших пристроїв буде деактивовано менш ніж за **%@**."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một trong các thiết bị của bạn sẽ bị ngừng hoạt động trong vòng **dưới %@**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的其中一个设备将在**不到 %@**的时间内停用。"
          }
        }
      }
    },
