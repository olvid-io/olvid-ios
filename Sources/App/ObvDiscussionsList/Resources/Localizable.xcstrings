            "value": "귀하의 기기 중 하나가 **%@ 이내**에 비활성화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dos seus dispositivos será desativado em **menos de %@**."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Um dos seus dispositivos será desativado em **menos de %@**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно из ваших устройств будет отключено менее чем через %@."
