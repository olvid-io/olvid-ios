    "SNACK_BAR_BODY_IOS_VERSION_WILL_BE_UNSUPPORTED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Unterstützung für Ihre iOS-Version wird bald eingestellt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Support for your iOS version will soon be dropped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El soporte para tu versión de iOS dejará de estar disponible pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le support pour votre version d'iOS sera bientôt abandonné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il supporto per la tua versione di iOS verrà presto interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お使いのiOSバージョンへの対応は、近日中に終了します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곧 귀하의 iOS 버전 지원이 중단됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja wersja systemu iOS wkrótce przestanie być obsługiwana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O suporte para sua versão do iOS será descontinuado em breve."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O suporte para a sua versão do iOS será descontinuado em breve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поддержка вашей версии iOS скоро будет прекращена."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS sürümünüz için destek yakında sona erecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підтримка вашої версії iOS незабаром буде припинена."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng sẽ sớm ngừng hỗ trợ phiên bản iOS hiện tại của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们很快将停止对您所使用的 iOS 版本的支持。"
          }
        }
      }
    },
