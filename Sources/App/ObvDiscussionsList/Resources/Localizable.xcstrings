    "ARE_YOU_SURE_YOU_WANT_TO_DELETE_THESE_%lld_DISCUSSIONS_FROM_THIS_DEVICE": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Möchten Sie alle Nachrichten der ausgewählten Konversation von diesem Gerät löschen? Diese Aktion ist unwiderruflich."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Möchten Sie alle Nachrichten der %lld ausgewählten Konversationen von diesem Gerät löschen? Diese Aktion ist unwiderruflich."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Do you wish to delete all the messages of the selected discussion from this device? This action is irreversible."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Do you wish to delete all the messages of the %lld selected discussions from this device? This action is irreversible."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Deseas eliminar todos los mensajes de la conversación seleccionada de este dispositivo? Esta acción es irreversible."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "¿Deseas eliminar todos los mensajes de las %lld conversaciones seleccionadas de este dispositivo? Esta acción es irreversible."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Voulez-vous supprimer tous les messages de la discussion sélectionnée de cet appareil ? Attention, cette opération est irréversible."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Voulez-vous supprimer de cet appareil tous les messages des %lld discussions sélectionnées ? Attention, cette opération est irréversible."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vuoi eliminare tutti i messaggi della discussione selezionata da questo dispositivo? Questa azione è irreversibile."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Vuoi eliminare tutti i messaggi delle %lld discussioni selezionate da questo dispositivo? Questa azione è irreversibile."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "選択した会話のすべてのメッセージをこのデバイスから削除しますか？この操作は取り消せません。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "選択した%lld件の会話のすべてのメッセージをこのデバイスから削除しますか？この操作は取り消せません。"
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "선택한 대화의 모든 메시지를 이 장치에서 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "선택한 %lld개의 대화의 모든 메시지를 이 장치에서 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Czy chcesz usunąć z tego urządzenia wszystkie wiadomości z wybranej dyskusji? Tej czynności nie można cofnąć."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Czy chcesz usunąć z tego urządzenia wszystkie wiadomości z %lld wybranej dyskusji? Tej czynności nie można cofnąć."
                }
              },
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Czy chcesz usunąć z tego urządzenia wszystkie wiadomości z %lld wybranych dyskusji? Tej czynności nie można cofnąć."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Czy chcesz usunąć z tego urządzenia wszystkie wiadomości z %lld wybranych dyskusji? Tej czynności nie można cofnąć."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Você deseja excluir todas as mensagens da conversa selecionada deste dispositivo? Esta ação é irreversível."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Você deseja excluir todas as mensagens das %lld conversas selecionadas deste dispositivo? Esta ação é irreversível."
                }
              }
            }
          }
