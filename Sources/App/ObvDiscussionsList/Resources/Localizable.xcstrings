    "SNACK_BAR_DETAILS_BODY_GRANT_PERMISSION_TO_RECORD": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Anruf entgegenzunehmen, muss Olvid Zugriff auf das Mikrofon haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To received a call, you need to allow Olvid to access the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir una llamada, debes permitir que Olvid acceda al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des appels, vous devez autoriser Olvid à accéder au micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere una chiamata, devi permettere a Olvid di accedere al microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話を受信するには、Olvidがマイクにアクセスできるように許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화를 받으려면 Olvid가 마이크에 접근할 수 있도록 허용해야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby odbierać połączenia, musisz zezwolić aplikacji Olvid na dostęp do mikrofonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber chamadas, você precisa permitir que o Olvid acesse o microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber chamadas, tem de permitir que a Olvid aceda ao microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы принимать звонки, необходимо разрешить Olvid доступ к микрофону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama alabilmek için Olvid'in mikrofona erişmesine izin vermeniz gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб приймати дзвінки, потрібно дозволити Olvid доступ до мікрофона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để nhận cuộc gọi, bạn cần cho phép Olvid truy cập vào micro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接收来电，您需要允许 Olvid 访问麦克风。"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_GRANT_PERMISSION_TO_RECORD_IN_SETTINGS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Anruf entgegenzunehmen, müssen Sie Olvid Zugriff auf das Mikrofon gewähren. Damit Sie nie wieder einen Anruf verpassen, gehen Sie bitte zu den Einstellungen und erteilen Sie Olvid Zugriff auf das Mikrofon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To received a call, you need to allow Olvid to access the microphone. To never miss a call again, please go to Settings and grant Olvid access to the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir llamadas, debes permitir que Olvid acceda al micrófono. Para no perderte nunca más una llamada, por favor, ve a Ajustes y concede a Olvid acceso al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des appels, vous devez autoriser Olvid à accéder au micro. Pour ne plus rater d'appel, allez dans les Réglages et autorisez l'accès au micro pour Olvid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere chiamate, devi permettere a Olvid di accedere al microfono. Per non perdere mai più una chiamata, vai su Impostazioni e concedi l'accesso al microfono a Olvid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話を受信するには、Olvidにマイクへのアクセスを許可する必要があります。二度と通話を見逃さないように、設定に移動してOlvidにマイクへのアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화를 받으려면 Olvid가 마이크에 접근할 수 있도록 허용해야 합니다. 다시는 전화를 놓치지 않으려면 설정으로 이동하여 Olvid가 마이크에 접근하도록 허용하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby odbierać połączenia, musisz zezwolić aplikacji Olvid na dostęp do mikrofonu. Aby nie przegapić już żadnego połączenia, przejdź do Ustawień i zezwól aplikacji Olvid na dostęp do mikrofonu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber chamadas, você precisa permitir que o Olvid acesse o microfone. Para nunca mais perder uma chamada, vá em Configurações e conceda ao Olvid acesso ao microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber chamadas, precisa de autorizar o Olvid a aceder ao microfone. Para nunca mais perder uma chamada, vá às Definições e conceda ao Olvid acesso ao microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы принимать звонки, необходимо разрешить Olvid доступ к микрофону. Чтобы больше никогда не пропустить звонок, перейдите в Настройки и предоставьте Olvid доступ к микрофону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama alabilmek için Olvid'in mikrofona erişmesine izin vermeniz gerekir. Bir daha hiçbir aramayı kaçırmamak için lütfen Ayarlar'a gidip Olvid'e mikrofon erişimi verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб приймати дзвінки, Olvid потребує доступу до мікрофона. Щоб більше ніколи не пропустити дзвінок, будь ласка, перейдіть у Налаштування та надайте Olvid доступ до мікрофона."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để có thể nhận cuộc gọi, bạn cần cấp quyền cho Olvid truy cập vào micro. Để không bỏ lỡ bất kỳ cuộc gọi nào, vui lòng vào Cài đặt và cấp quyền cho Olvid truy cập vào micro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接收来电，您需要允许 Olvid 访问麦克风。为了不再错过任何来电，请前往“设置”并授予 Olvid 访问麦克风的权限。"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_NEW_APP_VERSION_AVAILABLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Version von Olvid ist im App Store verfügbar. Du verpasst tolle neue Funktionen 🤓! Wir empfehlen dir, jetzt zu aktualisieren 🚀."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version of Olvid is available from the App Store. You are missing out amazing new features 🤓! We recommend you upgrade now 🚀."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una nueva versión de Olvid disponible en la App Store. ¡Te estás perdiendo nuevas funciones increíbles 🤩! Recomendamos que la actualices ahora 🚀."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle version d'Olvid est disponible dès maintenant sur l'App Store. Pour ne pas rater les dernières nouveautés d'Olvid 🤓, nous vous recommandons de mettre à jour maintenant 🚀."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una nuova versione di Olvid sull'App Store. Ti stai perdendo incredibili nuove funzionalità ✨! Ti consigliamo di aggiornare ora 🚀."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App StoreにOlvidの新しいバージョンが公開されています。素晴らしい新機能をご利用になっていない可能性があります🤓！今すぐアップデートすることをお勧めします🚀。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 Olvid의 새 버전이 출시되었습니다. 놓치고 있는 놀라운 새로운 기능들이 있습니다! 지금 바로 업데이트하는 것을 추천합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowa wersja Olvid jest dostępna w App Store. Omijają cię niesamowite nowe funkcje 🤓! Zalecamy uaktualnienie już teraz 🚀."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova versão do Olvid está disponível na App Store. Você está perdendo recursos incríveis! Recomendamos que você atualize agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova versão do Olvid está disponível na App Store. Está a perder novas funcionalidades incríveis! Recomendamos que faça o upgrade agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна новая версия Olvid в App Store. Вы пропускаете множество новых интересных функций 🤓! Мы рекомендуем обновиться сейчас 🚀."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid'in yeni bir sürümü App Store'da mevcut. Harika yeni özellikleri kaçırıyorsunuz 🤓! Hemen güncellemenizi öneririz 🚀."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна нова версія Olvid в App Store. Ви пропускаєте дивовижні нові функції 🤩! Рекомендуємо оновитися зараз 🚀."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phiên bản mới của Olvid đã có trên App Store. Bạn đang bỏ lỡ những tính năng mới tuyệt vời! Chúng tôi khuyên bạn nên cập nhật ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid 的新版本已在 App Store 上提供。您错过了许多令人惊叹的新功能！我们建议您立即升级。"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_TITLE_GRANT_PERMISSION_TO_RECORD": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast einen Anruf verpasst, da Olvid keinen Zugriff auf das Mikrofon hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You missed a call because Olvid is not allowed to access the microphone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdiste una llamada porque Olvid no tiene permiso para acceder al micrófono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez raté un appel car Olvid n'a pas accès au micro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai perso una chiamata perché Olvid non ha il permesso di accedere al microfono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidがマイクへのアクセスを許可されていないため、着信に気づきませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid이 마이크에 접근할 수 없어서 전화가 연결되지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz nieodebrane połączenie, ponieważ Olvid nie ma dostępu do mikrofonu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você perdeu uma chamada porque o Olvid não tem permissão para acessar o microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdeu uma chamada porque o Olvid não tem permissão para aceder ao microfone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пропустили вызов, потому что Olvid не имеет доступа к микрофону"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid'in mikrofona erişim izni olmadığı için bir aramayı kaçırdınız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви пропустили дзвінок, оскільки Olvid не має дозволу на доступ до мікрофона"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã bỏ lỡ một cuộc gọi vì Olvid không được phép truy cập vào micro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您错过了来电，因为 Olvid 没有被授予访问麦克风的权限"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_TITLE_GRANT_PERMISSION_TO_RECORD_IN_SETTINGS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast einen Anruf verpasst, da Olvid nicht auf das Mikrofon zugreifen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You missed a call because Olvid is not allowed to access the microphone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdiste una llamada porque Olvid no tiene permiso para acceder al micrófono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez raté un appel car Olvid n'a pas accès au micro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai perso una chiamata perché Olvid non ha il permesso di accedere al microfono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid がマイクへのアクセスを許可されていないため、着信を逃しました"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid가 마이크에 접근할 수 없어서 전화가 연결되지 않았습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz nieodebrane połączenie, ponieważ Olvid nie ma dostępu do mikrofonu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você perdeu uma chamada porque o Olvid não tem permissão para acessar o microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdeu uma chamada porque o Olvid não tem permissão para aceder ao microfone"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пропустили вызов, потому что у Olvid нет доступа к микрофону"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid'in mikrofona erişim izni olmadığı için bir aramayı kaçırdınız"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви пропустили дзвінок, оскільки Olvid не має дозволу на доступ до мікрофона"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã bỏ lỡ cuộc gọi vì Olvid không được phép truy cập vào micro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您错过了来电，因为 Olvid 没有被授予访问麦克风的权限"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_TITLE_NEW_APP_VERSION_AVAILABLE": {
