        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 메시지가 도착하면 알림을 받아 대화 내용을 놓치지 않도록 하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymuj powiadomienia o nowych wiadomościach, aby nie przegapić żadnej rozmowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja notificado quando novas mensagens chegarem para não perder nenhuma conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Seja notificado quando chegarem novas mensagens para não perder nenhuma conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте уведомления о новых сообщениях, чтобы не пропустить ни одного разговора."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni mesajlar geldiğinde bildirim alın, hiçbir sohbeti kaçırmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте сповіщення про нові повідомлення, щоб не пропустити жодної розмови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận thông báo khi có tin nhắn mới để bạn không bỏ lỡ bất kỳ cuộc trò chuyện nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当有新消息到达时接收通知，确保不错过任何对话。"
          }
        }
      }
    },
