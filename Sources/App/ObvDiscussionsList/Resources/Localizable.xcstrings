    "TIP_REQUEST_NOTIFICATIONS_AUTHORIZATION_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalte Benachrichtigungen, wenn neue Nachrichten eintreffen, damit du kein Gespräch verpasst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get notified when new messages arrive so you never miss a conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe avisos cuando lleguen nuevos mensajes para no perderte ninguna conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Soyez notifié à l'arrivée de nouveaux messages pour ne manquer aucune conversation."
          }
        },
        "it": {
          "stringUnit": {
