    "TIP_REMEMBER_TO_WRITE_DOWN_BACKUP_KEY_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Backup-Schlüssel ist wichtig, um deine Profile wiederherzustellen, falls du den Zugriff auf dieses Gerät verlierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your backup key is essential for restoring your profiles if you lose access to this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de respaldo es esencial para restaurar tus perfiles si pierdes el acceso a este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé de sauvegarde sera essentielle pour restaurer votre profil si vous perdez l’accès à cet appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua chiave di backup è essenziale per ripristinare i tuoi profili in caso di smarrimento o perdita di accesso a questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスへのアクセスを失った場合、バックアップキーはプロファイルを復元するために不可欠です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 접근할 수 없게 되면 프로필을 복원하는 데 백업 키가 필수적입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua chave de backup é essencial para restaurar seus perfis caso você perca o acesso a este dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua chave de backup é essencial para restaurar os seus perfis caso perca o acesso a este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ резервного копирования необходим для восстановления ваших профилей в случае потери доступа к этому устройству."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ключ резервної копії є важливим для відновлення ваших профілів, якщо ви втратите доступ до цього пристрою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您无法再访问此设备，您的备份密钥对于恢复您的个人资料至关重要。"
          }
        }
      }
    },
    "TIP_REMEMBER_TO_WRITE_DOWN_BACKUP_KEY_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergiss nicht, deinen Backup-Schlüssel aufzuschreiben 📝"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don’t forget to write down your backup key 😇"
          }
        },
        "es": {
