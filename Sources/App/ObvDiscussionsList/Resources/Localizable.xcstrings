    "TIP_SETUP_NEW_BACKUPS_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Backups können Sie Ihre Profile wiederherstellen, falls Sie den Zugriff auf dieses Gerät verlieren. Die neue Erfahrung ist einfacher denn je 😉 und kann in wenigen Sekunden eingerichtet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backups allow to restore your profiles if you lose access to this device. The new experience is easier than ever 😉, and can be setup in a few seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad permiten restaurar tus perfiles si pierdes el acceso a este dispositivo. La nueva experiencia es más fácil que nunca 🤩, y se puede configurar en unos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes vous permettent de restaurer vos profils si vous perdez l’accès à cet appareil. La nouvelle expérience est plus simple que jamais 😉 et peut être configurée en quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I backup ti permettono di ripristinare i tuoi profili in caso di smarrimento o perdita di accesso a questo dispositivo. La nuova esperienza è più semplice che mai 😉, e può essere configurata in pochi secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ機能を使用すると、このデバイスへのアクセスを失った場合でも、プロフィールを復元できます。新しい機能はこれまで以上に使いやすくなっており、数秒で設定できます😉。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 사용하면 이 장치에 접근할 수 없게 되더라도 프로필을 복원할 수 있습니다. 새로운 기능은 이전보다 훨씬 간편하며 몇 초 만에 설정할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopie zapasowe pozwalają przywrócić twoje profile, jeśli utracisz dostęp do tego urządzenia. Nowe rozwiązanie jest prostsze niż kiedykolwiek 😉 i można je skonfigurować w kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os backups permitem restaurar seus perfis caso você perca o acesso a este dispositivo. A nova experiência é mais fácil do que nunca 😉 e pode ser configurada em poucos segundos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As cópias de segurança permitem restaurar os seus perfis caso perca o acesso a este dispositivo. A nova experiência é mais simples do que nunca 😉 e pode ser configurada em poucos segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервные копии позволяют восстановить ваши профили, если вы потеряете доступ к этому устройству. Новый опыт стал проще, чем когда-либо 😉, и его можно настроить за несколько секунд."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekler, bu cihaza erişiminizi kaybederseniz profillerinizi geri yüklemenizi sağlar. Yeni deneyim her zamankinden daha kolay 😉 ve birkaç saniyede ayarlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервні копії дозволяють відновити ваші профілі, якщо ви втратите доступ до цього пристрою. Новий досвід є простішим, ніж будь-коли 😉, і може бути налаштований за лічені секунди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tính năng sao lưu cho phép bạn khôi phục hồ sơ của mình nếu bạn không còn quyền truy cập vào thiết bị này. Trải nghiệm mới dễ dàng hơn bao giờ hết 😉 và có thể được thiết lập chỉ trong vài giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份功能可让您在无法访问此设备时恢复您的个人资料。新的体验比以往任何时候都更容易，并且可以在几秒钟内设置完成。😉"
          }
        }
      }
    },
