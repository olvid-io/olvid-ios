    "TIP_REQUEST_NOTIFICATIONS_AUTHORIZATION_BUTTON_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen erlauben"
          }
        },
        "en": {
