    "TIP_REMEMBER_TO_WRITE_DOWN_BACKUP_KEY_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Backup-Schlüssel ist wichtig, um deine Profile wiederherzustellen, falls du den Zugriff auf dieses Gerät verlierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your backup key is essential for restoring your profiles if you lose access to this device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de respaldo es esencial para restaurar tus perfiles si pierdes el acceso a este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé de sauvegarde sera essentielle pour restaurer votre profil si vous perdez l’accès à cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave di backup è essenziale per ripristinare i tuoi profili in caso di smarrimento o perdita di accesso a questo dispositivo."
          }
        }
      }
    },
    "TIP_REMEMBER_TO_WRITE_DOWN_BACKUP_KEY_TITLE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergiss nicht, deinen Backup-Schlüssel aufzuschreiben 📝"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t forget to write down your backup key 😇"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No olvides anotar tu clave de respaldo 📝"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’oubliez pas de noter votre clé de sauvegarde 😇"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non dimenticare di annotare la tua chiave di backup 📝"
          }
        }
      }
    },
    "TIP_SETUP_NEW_BACKUPS_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Backups können Sie Ihre Profile wiederherstellen, falls Sie den Zugriff auf dieses Gerät verlieren. Die neue Erfahrung ist einfacher denn je 😉 und kann in wenigen Sekunden eingerichtet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Backups allow to restore your profiles if you lose access to this device. The new experience is easier than ever 😉, and can be setup in a few seconds."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las copias de seguridad permiten restaurar tus perfiles si pierdes el acceso a este dispositivo. La nueva experiencia es más fácil que nunca 🤩, y se puede configurar en unos segundos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les sauvegardes vous permettent de restaurer vos profils si vous perdez l’accès à cet appareil. La nouvelle expérience est plus simple que jamais 😉 et peut être configurée en quelques secondes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I backup ti permettono di ripristinare i tuoi profili in caso di smarrimento o perdita di accesso a questo dispositivo. La nuova esperienza è più semplice che mai 😉, e può essere configurata in pochi secondi."
          }
        }
      }
    },
    "TIP_SETUP_NEW_BACKUPS_TITLE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verliere nicht den Zugriff auf deine Profile!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don’t lose access to your profiles!"
          }
        },
        "es" : {
