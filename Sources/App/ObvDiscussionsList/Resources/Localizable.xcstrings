{
  "sourceLanguage": "en",
  "strings": {
    "ABOUT_ARCHIVED_DISCUSSIONS_MESSAGE_AUTOMATIC_UNARCHIVING_FALSE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Diskussion bleibt archiviert, bis Sie sie manuell wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived discussion stay archived until you decide to manually unarchive it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversación archivada permanecerá archivada hasta que decidas desarchivarla manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion archivée reste archivée jusqu'à ce que vous décidiez de la désarchiver manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una discussione archiviata rimane archiviata finché non decidi di ripristinarla manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブされたチャットは、手動でアーカイブを解除するまでアーカイブされたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 대화는 사용자가 직접 보관 해제할 때까지 보관된 상태로 유지됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowana dyskusja pozostaje w archiwum, dopóki ręcznie nie cofniesz jej archiwizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa arquivada permanece arquivada até que você decida desativar manualmente o arquivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa arquivada permanece arquivada até que decida reativá-la manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заархивированные обсуждения остаются заархивированными, пока вы не решите вручную их разархивировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenen bir sohbet, siz elle arşivden çıkarana kadar arşivde kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заархівована дискусія залишається заархівованою, доки ви не розархівуєте її вручну."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cuộc trò chuyện đã lưu trữ sẽ vẫn ở trạng thái lưu trữ cho đến khi bạn quyết định khôi phục nó theo cách thủ công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档的对话将保持归档状态，直到您手动取消归档为止。"
          }
        }
      }
    },
    "ABOUT_ARCHIVED_DISCUSSIONS_MESSAGE_AUTOMATIC_UNARCHIVING_TRUE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Diskussion wird automatisch wiederhergestellt, wenn in dieser Diskussion eine Benachrichtigung empfangen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived discussion will be automatically unarchived when a notification is received in this discussion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversación archivada se desarchivará automáticamente cuando se reciba una notificación en esta conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion archivée sera automatiquement désarchivée lors de la réception d’une notification dans cette discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una discussione archiviata verrà automaticamente riattivata quando si riceve una notifica in questa discussione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブされたチャットでは、そのチャットで通知を受信すると、自動的にアーカイブが解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 대화에서 알림이 수신되면 자동으로 보관 해제됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiwizacja dyskusji zostanie automatycznie cofnięta po otrzymaniu w niej powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa arquivada será automaticamente desarquivada quando uma notificação for recebida nessa conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa arquivada será automaticamente desativada quando for recebida uma notificação nessa conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически разархивированный архивный чат при получении уведомления в этом чате."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arşivlenen bir sohbet, o sohbette bir bildirim alındığında otomatik olarak arşivden çıkarılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заархівована дискусія буде автоматично розблокована, коли буде отримано сповіщення в цій дискусії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cuộc trò chuyện đã lưu trữ sẽ tự động được khôi phục khi nhận được thông báo trong cuộc trò chuyện đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当此对话中收到通知时，已归档的对话将自动取消归档。"
          }
        }
      }
    },
