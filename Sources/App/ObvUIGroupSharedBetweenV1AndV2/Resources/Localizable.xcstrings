    "THE_REMAINING_%lld_MUST_ACCEPT_THE_GROUP_INVITATION_BEFORE_YOU_CAN_ADD_THEM": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die verbleibende Person muss die Gruppen-Einladung annehmen, bevor du sie einladen kannst."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die verbleibenden %lld Personen müssen die Gruppen-Einladung annehmen, bevor du sie einladen kannst."
