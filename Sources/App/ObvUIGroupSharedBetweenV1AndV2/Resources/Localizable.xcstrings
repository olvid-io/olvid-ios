    "GROUP_UPDATE_IN_PROGRESS_EXPLANATION_BODY": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Update dieser Gruppe ist gerade im Gange. Bitte warte, bis es abgeschlossen ist, bevor du weitere Änderungen vornimmst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An update of this group is in progress. Please wait until it is done to make further modifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está actualizando este grupo. Por favor, espere a que termine para realizar más modificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une mise à jour du groupe est en cours. Merci de patienter jusqu'à son terme pour faire de nouvelles modifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un aggiornamento di questo gruppo è in corso. Si prega di attendere il completamento prima di apportare ulteriori modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループの更新作業中です。完了するまで、他の変更は行わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹의 업데이트가 진행 중입니다. 다른 변경 사항을 적용하기 전에 업데이트가 완료될 때까지 기다려 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma atualização deste grupo está em andamento. Por favor, aguarde até que seja concluída para fazer mais alterações."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma atualização deste grupo está em andamento. Por favor, aguarde até que seja concluída para fazer mais alterações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновление этой группы выполняется. Пожалуйста, дождитесь завершения, прежде чем вносить какие-либо изменения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оновлення цієї групи в процесі. Будь ласка, зачекайте, поки воно не завершиться, перш ніж вносити подальші зміни."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此群组正在更新中。请等待更新完成后再进行其他修改。"
          }
        }
      }
    },
