              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El siguiente miembro del grupo aún no está en tus contactos, pero puedes invitarlo con un solo toque ☝️. Solo necesitará aceptar tu invitación, no es necesario intercambiar códigos 😉."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los siguientes %lld miembros del grupo aún no están en tus contactos, pero puedes invitarlos con un solo toque ☝️. Solo necesitarán aceptar tu invitación, no es necesario intercambiar códigos 😉."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Le membre du groupe ci-dessous ne fait pas encore partie de vos contacts, mais vous l’y inviter facilement ☝️. Il lui suffira d’accepter votre invitation, sans besoin d’échanger de code 😉."
