    "THE_FOLLOWING_%lld_GROUP_MEMBERS_ARE_NOT_YET_PART_OF_YOUR_CONTACTS_AND_MUST_ACCEPT_GROUP_INVITATION": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Das folgende Gruppenmitglied ist nicht Teil Ihrer Kontakte. Sobald es die Gruppeneinladung annimmt, können Sie es mit einem Tippen einladen, Ihren Kontakten hinzuzufügen ☝️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die folgenden %lld Gruppenmitglieder sind nicht Teil Ihrer Kontakte. Sobald sie die Gruppeneinladung annimmt, können Sie sie mit einem Tippen einladen, Ihren Kontakten hinzuzufügen ☝️."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The following group member is not part of your contacts. Once they accept the group invitation, you will be able to invite them to join your contacts in one tap ☝️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The following %lld group members are not part of your contacts. Once they accept the group invitation, you will be able to invite them to join your contacts in one tap ☝️."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "El siguiente miembro del grupo no está en tus contactos. Una vez que acepte la invitación al grupo, podrás invitarlo a unirse a tus contactos con un solo toque ☝️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Los siguientes %lld miembros del grupo no están en tus contactos. Una vez que acepten la invitación al grupo, podrás invitarlos a unirse a tus contactos con un solo toque ☝️."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Le membre du groupe ci-dessous ne fait pas partie de vos contacts. Lorsqu’il aura accepté l’invitation au groupe, vous pourrez facilement l’inviter à rejoindre vos contact ✌️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Les %lld membres du groupe ci-dessous ne font pas partie de vos contacts. Lorsqu’ils auront accepté l’invitation au groupe, vous pourrez facilement les inviter à rejoindre vos contact ✌️."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Il seguente membro del gruppo non è tra i tuoi contatti. Una volta che avrà accettato l'invito al gruppo, potrai invitarlo ad aggiungere ai tuoi contatti con un semplice tocco ☝️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "I seguenti %lld membri del gruppo non sono tra i tuoi contatti. Una volta che avranno accettato l'invito al gruppo, potrai invitarli ad aggiungere ai tuoi contatti con un semplice tocco ☝️."
                }
              }
            }
          }
        }
      }
    },
    "THE_FOLLOWING_%lld_GROUP_MEMBERS_ARE_NOT_YET_PART_OF_YOUR_CONTACTS_BUT_YOU_CAN_INVITE_THEM": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Das folgende Gruppenmitglied ist noch nicht Teil deiner Kontakte, aber du kannst es mit einem Tippen einladen ☝️. Es muss lediglich deine Einladung akzeptieren, ein Austausch von Codes ist nicht erforderlich 😉."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Die folgenden %lld Gruppenmitglieder sind noch nicht Teil deiner Kontakte, aber du kannst sie mit einem Tippen einladen ☝️. Sie müssen lediglich deine Einladung akzeptieren, ein Austausch von Codes ist nicht erforderlich 😉."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The following group member is not part of your contacts yet, but you can invite them in one tap ☝️. They will just need to accept your invitation, no need to exchange codes 😉."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "The following %lld group members are not part of your contacts yet, but you can invite them in one tap ☝️. They will just need to accept your invitation, no need to exchange codes 😉."
                }
              }
            }
          }
        },
        "es": {
