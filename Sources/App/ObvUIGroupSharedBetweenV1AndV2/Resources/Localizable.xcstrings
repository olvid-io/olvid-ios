    "%lld_OF_THE_GROUP_MEMBERS_ARE_NOT_PART_OF_YOUR_CONTACTS_BUT_YOU_CANNOT_INVITE_THEM_UNTIL_THEY_ACCEPT_THE_GROUP_INVITATION": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Eines der Gruppenmitglieder ist nicht in Ihren Kontakten. Sobald sie die Gruppenmitgliedschaft annehmen, können Sie sie mit einem Tippen ☝️ zu Ihren Kontakten hinzufügen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld der Gruppenmitglieder sind nicht in Ihren Kontakten. Sobald sie die Gruppenmitgliedschaft annehmen, können Sie sie mit einem Tippen ☝️ zu Ihren Kontakten hinzufügen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "One of the group members is not part of your contacts. Once they accept the group invitation, you will be able to invite them to join your contacts in one tap ☝️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld of the group members are not part of your contacts. Once they accept the group invitation, you will be able to invite them to join your contacts in one tap ☝️."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uno de los miembros del grupo no está en tus contactos. Una vez que acepten la invitación al grupo, podrás invitarlos a unirse a tus contactos con un solo toque ☝️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld de los miembros del grupo no están en tus contactos. Una vez que acepten la invitación al grupo, podrás invitarlos a unirse a tus contactos con un solo toque ☝️."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un des membres du groupe ne fait pas partie de vos contacts. Lorsqu’il aura accepté l’invitation au groupe, vous pourrez facilement l’inviter à rejoindre vos contact ✌️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld des membres du groupe ne font pas partie de vos contacts. Lorsqu’ils auront accepté l’invitation au groupe, vous pourrez facilement les inviter à rejoindre vos contact ✌️."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uno dei membri del gruppo non è tra i tuoi contatti. Una volta che accetterà l'invito al gruppo, potrai invitarlo ad aggiungersi ai tuoi contatti con un semplice tocco ☝️."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld dei membri del gruppo non sono tra i tuoi contatti. Una volta che avranno accettato l'invito al gruppo, potrai invitarli ad aggiungersi ai tuoi contatti con un semplice tocco ☝️."
                }
              }
            }
          }
        }
      }
    },
    "%lld_OF_THE_GROUP_MEMBERS_ARE_NOT_PART_OF_YOUR_CONTACTS_BUT_YOU_CAN_INVITE_THEM": {
