    "AT_LEAST_ONE_UNHIDDEN_PROFILE_MUST_EXIST_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du musst mindestens ein sichtbares Profil haben. Da dies dein einziges Profil ist, kannst du es nicht ausblenden. Du kannst jedoch ein neues Profil erstellen und es erneut versuchen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You must have at least one visible profile. Since this profile is the only one you have, you cannot hide it. Nonetheless, you can create a new profile and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Debes tener al menos un perfil visible. Dado que este perfil es el único que tienes, no puedes ocultarlo. Sin embargo, puedes crear un nuevo perfil e intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous devez toujours avoir au moins un profil visible. Comme ce profil est le seul que vous ayez, vous ne pouvez pas le masquer. Vous pouvez néanmoins créer un nouveau profil et essayer à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devi avere almeno un profilo visibile. Poiché questo è l'unico profilo che hai, non puoi nasconderlo. Puoi comunque crearne uno nuovo e riprovare."
          }
        }
      }
    },
    "AT_LEAST_ONE_UNHIDDEN_PROFILE_MUST_EXIST_TITLE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
