    "AT_LEAST_ONE_UNHIDDEN_PROFILE_MUST_EXIST_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du musst mindestens ein sichtbares Profil haben. Da dies dein einziges Profil ist, kannst du es nicht ausblenden. Du kannst jedoch ein neues Profil erstellen und es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You must have at least one visible profile. Since this profile is the only one you have, you cannot hide it. Nonetheless, you can create a new profile and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Debes tener al menos un perfil visible. Dado que este perfil es el único que tienes, no puedes ocultarlo. Sin embargo, puedes crear un nuevo perfil e intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devez toujours avoir au moins un profil visible. Comme ce profil est le seul que vous ayez, vous ne pouvez pas le masquer. Vous pouvez néanmoins créer un nouveau profil et essayer à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Devi avere almeno un profilo visibile. Poiché questo è l'unico profilo che hai, non puoi nasconderlo. Puoi comunque crearne uno nuovo e riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも1つは表示されているプロフィールが必要です。このプロフィールが唯一のプロフィールであるため、非表示にすることはできません。代わりに新しいプロフィールを作成して、再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최소한 하나 이상의 프로필이 표시되어야 합니다. 이 프로필이 현재 유일한 프로필이므로 숨길 수 없습니다. 새 프로필을 만들고 다시 시도해 보세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisa ter pelo menos um perfil visível. Como este é o único perfil que você tem, não é possível ocultá-lo. No entanto, você pode criar um novo perfil e tentar novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem de ter pelo menos um perfil visível. Como este é o único perfil que tem, não pode ocultá-lo. No entanto, pode criar um novo perfil e tentar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У вас должен быть хотя бы один видимый профиль. Поскольку этот профиль — единственный, которым вы располагаете, вы не можете его скрыть. Тем не менее, вы можете создать новый профиль и попробовать снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам потрібно мати хоча б один видимий профіль. Оскільки цей профіль є єдиним, який у вас є, ви не можете його приховати. Проте ви можете створити новий профіль та спробувати ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您必须至少有一个可见的个人资料。由于此个人资料是您唯一的个人资料，因此您无法隐藏它。但是，您可以创建一个新的个人资料，然后再次尝试。"
          }
        }
      }
    },
