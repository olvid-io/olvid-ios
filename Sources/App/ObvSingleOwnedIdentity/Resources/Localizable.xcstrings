    "UNHIDE_OWNED_IDENTITY_ALERT_MESSAGE": {
      "comment": "The message in the alert that appears when a user taps the \"Unhide\" button in the \"Unhide this identity\" menu item.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind kurz davor, ein Profil wieder anzuzeigen. Wenn Sie dies tun, wird das Profil systematisch im Profilwechsler angezeigt, ohne dass ein spezielles Passwort erforderlich ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are about to unhide a profile. If you do so, the profile will be systematically shown in the profile switcher, with no need for a specific password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás a punto de mostrar un perfil oculto. Si lo haces, el perfil se mostrará sistemáticamente en el selector de perfiles, sin necesidad de una contraseña específica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes sur le point de démasquer un profil. Si vous confirmez, ce profil sera sytématiquement visible, sans mot de passe spécifique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai per rendere visibile un profilo. In tal caso, il profilo verrà mostrato sistematicamente nel selettore profili, senza la necessità di una password specifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロフィールを非表示解除します。非表示解除すると、特定のパスワードなしで、プロフィールスイッチャーに常に表示されるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필을 다시 보이게 하려고 합니다. 이렇게 하면 프로필 전환기에 프로필이 표시되며, 특정 비밀번호를 입력할 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está prestes a tornar um perfil visível novamente. Ao fazer isso, o perfil será exibido sistematicamente no seletor de perfis, sem a necessidade de uma senha específica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está prestes a tornar um perfil visível. Ao fazê-lo, o perfil será apresentado sistematicamente no seletor de perfis, sem necessidade de uma palavra-passe específica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы собираетесь скрыть профиль. Если вы это сделаете, профиль будет систематически отображаться в переключателе профилей, без необходимости использования пароля."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви збираєтесь зробити профіль видимим. Якщо ви це зробите, профіль буде систематично відображатися в перемикачі профілів, без потреби в конкретному паролі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您即将取消隐藏一个个人资料。如果这样做，该个人资料将系统地显示在个人资料切换器中，无需特定的密码。"
          }
        }
      }
    },
