    "ALERT_FOR_EDITING_NICKNAME_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Spitzname ist nur für dich sichtbar und ermöglicht es dir, deine Profile leicht voneinander zu unterscheiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your nickname is for your eyes only and allows you to easily distinguish your profiles from each other."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu apodo es solo para tus ojos y te permite distinguir fácilmente tus perfiles entre sí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre pseudo n'est visible que par vous et vous permet de facilement distinguer vos profils les uns des autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo soprannome è visibile solo a te e ti permette di distinguere facilmente i tuoi profili."
          }
        }
      }
    },
