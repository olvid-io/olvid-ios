    "ALERT_FOR_EDITING_NICKNAME_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Spitzname ist nur für dich sichtbar und ermöglicht es dir, deine Profile leicht voneinander zu unterscheiden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your nickname is for your eyes only and allows you to easily distinguish your profiles from each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu apodo es solo para tus ojos y te permite distinguir fácilmente tus perfiles entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre pseudo n'est visible que par vous et vous permet de facilement distinguer vos profils les uns des autres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo soprannome è visibile solo a te e ti permette di distinguere facilmente i tuoi profili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ニックネームはあなただけが見ることができ、複数のプロフィールを簡単に区別するのに役立ちます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 닉네임은 귀하만을 위한 것이며, 여러 프로필을 쉽게 구별하는 데 도움이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu apelido é apenas para você e permite que você distinga facilmente seus diferentes perfis."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu apelido é apenas para uso pessoal e permite-lhe distinguir facilmente os seus diferentes perfis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ник виден только вам и позволяет легко различать ваши профили."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше ім'я користувача призначене лише для вас і дозволяє легко розрізняти ваші профілі між собою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的昵称仅供您自己使用，可帮助您轻松区分不同的个人资料。"
          }
        }
      }
    },
