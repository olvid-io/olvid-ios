    "OWNED_DEVICE_DISCOVERY_SERVER_QUERY_MULTIDEVICE_AVAILABLE_BODY" : {
      "comment" : "Description of a screen that appears when a user is prompted to choose between reactivating their currently connected device or one of their other devices, and the server confirms that multi-device support is available.",
