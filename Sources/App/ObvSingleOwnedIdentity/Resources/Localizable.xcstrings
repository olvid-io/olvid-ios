    "INACTIVE_PROFILE_EXPLANATION_ON_MY_PROFILE_VIEW": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Profil ist auf diesem Gerät nicht aktiv, du kannst es aber jetzt reaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile is not active on this device but you can reactivate it now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil no está activo en este dispositivo, pero puedes reactivarlo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil est inactif sur cet appareil mais vous pouvez le réactiver maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo non è attivo su questo dispositivo, ma puoi riattivarlo ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスではプロフィールがアクティブになっていませんが、今すぐ再アクティブ化できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서는 프로필이 활성화되어 있지 않지만, 지금 다시 활성화할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu perfil não está ativo neste dispositivo, mas você pode reativá-lo agora."
          }
        },
        "pt-PT": {
