    "UNHIDE_OWNED_IDENTITY_ALERT_MESSAGE" : {
      "comment" : "The message in the alert that appears when a user taps the \"Unhide\" button in the \"Unhide this identity\" menu item.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie sind kurz davor, ein Profil wieder anzuzeigen. Wenn Sie dies tun, wird das Profil systematisch im Profilwechsler angezeigt, ohne dass ein spezielles Passwort erforderlich ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You are about to unhide a profile. If you do so, the profile will be systematically shown in the profile switcher, with no need for a specific password."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás a punto de mostrar un perfil oculto. Si lo haces, el perfil se mostrará sistemáticamente en el selector de perfiles, sin necesidad de una contraseña específica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes sur le point de démasquer un profil. Si vous confirmez, ce profil sera sytématiquement visible, sans mot de passe spécifique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai per rendere visibile un profilo. In tal caso, il profilo verrà mostrato sistematicamente nel selettore profili, senza la necessità di una password specifica."
          }
        }
      }
    },
