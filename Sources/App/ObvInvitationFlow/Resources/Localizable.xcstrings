    "VIDEO_CAPTURE_RESTRICTED_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid kann aufgrund von Gerätebeschränkungen nicht auf die Kamera zugreifen. Um QR-Codes zu scannen, überprüfen Sie die Einstellungen Ihres Geräts und stellen Sie sicher, dass dieser App der Zugriff auf die Kamera erlaubt ist."
