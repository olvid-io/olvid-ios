    "VIDEO_CAPTURE_DENIED_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid kann nicht auf die Kamera zugreifen. Um QR-Codes zu scannen, aktivieren Sie den Kamera-Zugriff in Ihren Geräteeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid cannot access the camera. To scan QR codes, enable camera access in your device settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid no puede acceder a la cámara. Para escanear códigos QR, habilita el acceso a la cámara en la configuración de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid n'a pas accès à la caméra. Pour scanner des codes QR, activez l'accès à la caméra dans les paramètres de votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid non può accedere alla fotocamera. Per scansionare i codici QR, abilita l'accesso alla fotocamera nelle impostazioni del tuo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidはカメラにアクセスできません。QRコードをスキャンするには、デバイスの設定でカメラへのアクセスを有効にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid이 카메라에 접근할 수 없습니다. QR 코드를 스캔하려면 장치 설정에서 카메라 접근 권한을 활성화하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid não tem permissão para acessar a câmera. Para escanear códigos QR, ative o acesso à câmera nas configurações do seu dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid não consegue aceder à câmara. Para digitalizar códigos QR, ative o acesso à câmara nas definições do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не может получить доступ к камере. Чтобы сканировать QR-коды, включите доступ к камере в настройках вашего устройства."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не може отримати доступ до камери. Щоб сканувати QR-коди, увімкніть доступ до камери в налаштуваннях пристрою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid 无法访问相机。要扫描二维码，请在设备设置中启用相机访问权限。"
          }
        }
      }
    },
    "VIDEO_CAPTURE_DENIED_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera-Zugriff verweigert"
          }
        },
