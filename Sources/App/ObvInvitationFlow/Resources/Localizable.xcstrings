    "CONTENT_UNAVAILABLE_YET_VIEW_DESCRIPTION_CONTACTS_LIST_DESCRIPTION" : {
      "comment" : "A description displayed below the title of a view that indicates that there is no content to display yet.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid fügt niemanden ohne Ihre Zustimmung hinzu. Sie entscheiden, wen Sie einladen – persönlich oder aus der Ferne. Tippen Sie auf „Neuer Kontakt“, um zu beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid doesn’t add anyone without your choice. You decide who to invite—either in person or remotely. Tap ‘New contact’ to start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid no agregará a nadie sin tu elección. Tú decides a quién invitar, ya sea en persona o de forma remota. Toca ‘Nuevo contacto’ para comenzar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid n’ajoute aucun contact sans votre accord. Vous décidez qui inviter, en personne ou à distance. Appuyez sur « Nouveau contact » pour commencer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid non aggiunge nessuno senza la tua scelta. Decidi tu chi invitare, di persona o da remoto. Tocca \"Nuovo contatto\" per iniziare."
          }
        }
      }
    },
