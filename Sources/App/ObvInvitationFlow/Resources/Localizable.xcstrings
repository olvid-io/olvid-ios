    "CONTENT_UNAVAILABLE_YET_VIEW_DESCRIPTION_CONTACTS_LIST_DESCRIPTION": {
      "comment": "A description displayed below the title of a view that indicates that there is no content to display yet.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid fügt niemanden ohne Ihre Zustimmung hinzu. Sie entscheiden, wen Sie einladen – persönlich oder aus der Ferne. Tippen Sie auf „Neuer Kontakt“, um zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid doesn’t add anyone without your choice. You decide who to invite—either in person or remotely. Tap ‘New contact’ to start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid no agregará a nadie sin tu elección. Tú decides a quién invitar, ya sea en persona o de forma remota. Toca ‘Nuevo contacto’ para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid n’ajoute aucun contact sans votre accord. Vous décidez qui inviter, en personne ou à distance. Appuyez sur « Nouveau contact » pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid non aggiunge nessuno senza la tua scelta. Decidi tu chi invitare, di persona o da remoto. Tocca \"Nuovo contatto\" per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidは、あなたの許可なしに誰かを追加することはありません。対面またはリモートで、誰を招待するかを自分で決められます。‘新しい連絡先’をタップして開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid는 사용자의 선택 없이 누구도 추가하지 않습니다. 사용자가 직접 초대할 사람을 결정합니다. 직접 초대하거나 원격으로 초대할 수 있습니다. '새 연락처'를 탭하여 시작하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid não adiciona ninguém sem sua permissão. Você decide quem convidar, seja pessoalmente ou remotamente. Toque em \"Novo contato\" para começar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid não adiciona ninguém sem a sua permissão. Você decide quem convidar, seja pessoalmente ou remotamente. Toque em \"Novo contacto\" para começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не добавляет никого без вашего выбора. Вы решаете, кого приглашать — лично или удаленно. Нажмите «Новый контакт», чтобы начать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid ніколи не додає нікого без вашого дозволу. Ви вирішуєте, кого запрошувати – особисто чи віддалено. Натисніть «Новий контакт», щоб розпочати."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid不会在未经您同意的情况下添加任何人。您可以决定邀请谁，无论是亲自邀请还是远程邀请。点击“新联系人”开始。"
          }
        }
      }
    },
