{
  "sourceLanguage": "en",
  "strings": {
    "": {
      "shouldTranslate": false
    },
    "%@ invites you to discuss on Olvid": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte mit Ihnen auf Olvid diskutieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ would like to discuss with you on Olvid"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quisiera conversar contigo en Olvid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aimerait discuter avec vous sur Olvid"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vorrebbe discutere con te su Olvid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ さんが Olvid であなたと話したいと思っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 Olvid에서 대화를 나누고 싶어합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gostaria de conversar com você no Olvid"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gostaria de conversar consigo no Olvid"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хотел(а) бы обсудить с вами в Olvid"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хотів би/хотіла би обговорити з вами на Olvid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要在 Olvid 上与您讨论"
          }
        }
      }
    },
    "%@ invites you to discuss on Olvid. To accept, please click the link": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt Sie ein, auf Olvid zu diskutieren. Um die Einladung anzunehmen, klicken Sie bitte auf den beigefügten Link."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ invites you to discuss on Olvid. To accept, please click the link attached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te invita a conversar en Olvid. Para aceptar, por favor, haz clic en el enlace adjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aimerait discuter avec vous sur Olvid. Pour accepter, utilisez le lien ci-joint."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ti invita a discutere su Olvid. Per accettare, clicca sul link allegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がOlvidでのディスカッションにあなたを招待しました。参加するには、添付のリンクをクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 Olvid에서 대화에 참여하도록 초대합니다. 참여하려면 첨부된 링크를 클릭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está te convidando para participar de uma discussão no Olvid. Para aceitar, clique no link anexado."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ convida-o(a) a participar numa conversa no Olvid. Para aceitar, clique no link em anexo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ приглашает вас обсудить на Olvid. Чтобы принять, пожалуйста, нажмите на прикрепленную ссылку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запрошує вас обговорити це на Olvid. Щоб прийняти запрошення, натисніть на посилання нижче."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀请您在 Olvid 上进行讨论。如需接受，请点击附件中的链接。"
          }
        }
      }
    },
    "%lld_KEYCLOAK_MISSING_RESULTS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld zusätzliche Suchergebnisse sind verfügbar. Bitte verfeinern Sie Ihre Suche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld additional search results are available. Please refine your search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay %lld resultados de búsqueda adicionales disponibles. Por favor, refine tu búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld résultats supplémentaires sont disponibles. Veuillez affiner votre recherche."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono disponibili %lld ulteriori risultati di ricerca. Si prega di affinare la ricerca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の追加検索結果があります。検索条件を絞り込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld개의 추가 검색 결과가 있습니다. 검색어를 구체적으로 입력해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld resultados de pesquisa adicionais estão disponíveis. Por favor, refine sua pesquisa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Existem %lld resultados de pesquisa adicionais. Refine a sua pesquisa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно %lld дополнительных результатов поиска. Пожалуйста, уточните ваш запрос."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно %lld додаткових результатів пошуку. Будь ласка, уточніть свій запит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 个额外的搜索结果。请优化您的搜索。"
          }
        }
      }
    },
