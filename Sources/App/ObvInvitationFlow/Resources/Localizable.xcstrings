    "CANNOT_INVITE_YOURSELF_MESSAGE" : {
      "comment" : "The message displayed in an alert when the user tries to invite themselves to a group.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies ist dein persönlicher Einladungslink. Du kannst ihn mit anderen Olvid-Nutzern teilen, damit sie dich per Fernzugriff einladen können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This is your own invitation link. You can share it with other Olvid users so they can invite you remotely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este es tu enlace de invitación personal. Puedes compartirlo con otros usuarios de Olvid para que te inviten de forma remota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lien est le vôtre. Partagez-le avec d’autres utilisateurs d’Olvid pour qu’ils puissent vous inviter à distance."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo è il tuo link di invito personale. Puoi condividerlo con altri utenti Olvid in modo che possano invitarti da remoto."
          }
        }
      }
    },
