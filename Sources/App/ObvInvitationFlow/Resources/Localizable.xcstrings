    "CANNOT_INVITE_YOURSELF_MESSAGE": {
      "comment": "The message displayed in an alert when the user tries to invite themselves to a group.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist dein persönlicher Einladungslink. Du kannst ihn mit anderen Olvid-Nutzern teilen, damit sie dich per Fernzugriff einladen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is your own invitation link. You can share it with other Olvid users so they can invite you remotely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es tu enlace de invitación personal. Puedes compartirlo con otros usuarios de Olvid para que te inviten de forma remota."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien est le vôtre. Partagez-le avec d’autres utilisateurs d’Olvid pour qu’ils puissent vous inviter à distance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il tuo link di invito personale. Puoi condividerlo con altri utenti Olvid in modo che possano invitarti da remoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはあなた自身の招待リンクです。他のOlvidユーザーと共有して、遠隔から招待してもらうことができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 링크는 본인 초대 링크입니다. 다른 Olvid 사용자들과 공유하여 원격으로 초대할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o seu link de convite pessoal. Você pode compartilhá-lo com outros usuários do Olvid para que eles possam convidá-lo remotamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é o seu link de convite pessoal. Pode partilhá-lo com outros utilizadores do Olvid para que o possam convidar remotamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это ваша личная ссылка-приглашение. Вы можете поделиться ею с другими пользователями Olvid, чтобы они могли пригласить вас удаленно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це ваше особисте запрошення. Ви можете поділитися ним з іншими користувачами Olvid, щоб вони могли запросити вас віддалено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是您的专属邀请链接。您可以将其分享给其他 Olvid 用户，以便他们可以远程邀请您。"
          }
        }
      }
    },
    "CANNOT_INVITE_YOURSELF_TITLE": {
      "comment": "Title of an alert that appears when the user tries to invite themselves to a group.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst dich nicht selbst einladen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot invite yourself"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes invitarte a ti mismo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de s’inviter soi-même"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi invitare te stesso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分自身を招待することはできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인은 초대할 수 없습니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível se convidar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode convidar a si próprio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нельзя пригласить самого себя"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не можна запросити себе"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法邀请自己"
          }
        }
      }
    },
