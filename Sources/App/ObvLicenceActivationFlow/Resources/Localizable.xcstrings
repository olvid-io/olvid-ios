    "UNABLE_TO_ACTIVATE_LICENSE_EXPLANATION": {
      "comment": "A body text that explains that the license could not be activated.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Profil wird derzeit von Ihrem Unternehmens-Identitätsanbieter verwaltet. Sie können keine Olvid-Lizenz manuell aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile is currently managed by your company's identity provider. You cannot manually activate an Olvid license."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil está gestionado actualmente por el proveedor de identidad de tu empresa. No puedes activar manualmente una licencia de Olvid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil est actuellement géré par le fournisseur d'identité de votre entreprise. À ce titre, vous ne pouvez pas activer de license Olvid manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo è attualmente gestito dal provider di identità della tua azienda. Non puoi attivare manualmente una licenza Olvid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、お客様のプロファイルは会社のIDプロバイダーによって管理されています。Olvidライセンスを手動で有効にすることはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 귀하의 프로필은 회사에서 제공하는 신원 정보 공급자를 통해 관리됩니다. Olvid 라이선스를 수동으로 활성화할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualmente, seu perfil é gerenciado pelo provedor de identidade da sua empresa. Você não pode ativar manualmente uma licença Olvid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu perfil é atualmente gerido pelo fornecedor de identidade da sua empresa. Não pode ativar manualmente uma licença Olvid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В настоящее время ваш профиль управляется поставщиком удостоверений вашей компании. Вы не можете вручную активировать лицензию Olvid."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш профіль наразі управляється постачальником ідентифікації вашої компанії. Ви не можете вручну активувати ліцензію Olvid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的个人资料当前由贵公司的身份提供商管理。您无法手动激活 Olvid 许可证。"
          }
        }
      }
    },
    "UNABLE_TO_ACTIVATE_LICENSE_EXPLANATION_ALT": {
      "comment": "An explanation displayed below the title of the view, when the server and API key are incompatible with the user's own server.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Nachrichtenverteilungsserver, der mit Ihrem Profil verbunden ist, ist nicht mit dem im Lizenzschlüssel angegebenen Server kompatibel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message distribution server associated with your profile is incompatible with the server indicated within the license."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de distribución de mensajes asociado a tu perfil no es compatible con el servidor indicado en la licencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur de distribution de message spécifié dans votre profil est incompatible avec le serveur indiqué dans la licence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server di distribuzione messaggi associato al tuo profilo non è compatibile con il server indicato all'interno della licenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様のプロファイルに関連付けられているメッセージ配信サーバーは、ライセンスで指定されたサーバーと互換性がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 프로필과 연결된 메시지 배포 서버가 라이선스에 명시된 서버와 호환되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de distribuição de mensagens associado ao seu perfil é incompatível com o servidor indicado na licença."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor de distribuição de mensagens associado ao seu perfil é incompatível com o servidor indicado na licença."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер распределения сообщений, связанный с вашим профилем, несовместим с сервером, указанным в лицензии."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервер розповсюдження повідомлень, пов’язаний з вашим профілем, несумісний із сервером, зазначеним у ліцензії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与您的个人资料关联的消息分发服务器与许可证中指定的服务器不兼容。"
          }
        }
      }
    },
