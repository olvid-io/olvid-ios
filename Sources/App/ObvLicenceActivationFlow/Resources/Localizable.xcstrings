{
  "sourceLanguage": "en",
  "strings": {
    "ACTIVATE_NEW_LICENCE": {
      "comment": "A button that activates a new license.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Lizenz aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate new license"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar nueva licencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer la licence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva nuova licenza"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいライセンスを有効にする"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 라이선스 활성화"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywuj nową licencję"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar nova licença"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar nova licença"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активировать новую лицензию"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni lisansı etkinleştir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Активувати нову ліцензію"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kích hoạt giấy phép mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激活新许可证"
          }
        }
      }
    },
    "ACTIVATION_REQUEST_FAILED": {
      "comment": "A message displayed when the activation request to the server fails.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktivierung Ihrer neuen Lizenz ist im Moment nicht möglich. Bitte versuchen Sie es später erneut. Wenn das Problem weiterhin besteht, wenden Sie sich an den Support, um Hilfe zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were unable to activate your new license at this time. Please try again later. If the issue persists, contact support for assistance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos activar su nueva licencia en este momento. Por favor, inténtelo de nuevo más tarde. Si el problema persiste, póngase en contacto con el soporte técnico para obtener ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu activer votre nouvelle licence pour le moment. Veuillez réessayer ultérieurement. Si le problème persiste, contactez notre support pour obtenir de l'aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti ad attivare la tua nuova licenza in questo momento. Riprova più tardi. Se il problema persiste, contatta l'assistenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいライセンスのアクティベーションに現在失敗しました。後ほど再度お試しください。問題が解決しない場合は、サポートにお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 새 라이선스를 활성화할 수 없습니다. 잠시 후 다시 시도해 주세요. 문제가 계속되면 지원팀에 문의하여 도움을 받으세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz aktywować nowej licencji. Spróbuj ponownie później. Jeśli problem będzie się powtarzał, skontaktuj się z pomocą techniczną."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar sua nova licença neste momento. Tente novamente mais tarde. Se o problema persistir, entre em contato com o suporte para obter ajuda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar a sua nova licença neste momento. Por favor, tente novamente mais tarde. Se o problema persistir, contacte o suporte para obter ajuda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось активировать вашу новую лицензию в данный момент. Пожалуйста, попробуйте еще раз позже. Если проблема не исчезнет, обратитесь в службу поддержки за помощью."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni lisansınız şu anda etkinleştirilemedi. Lütfen daha sonra tekrar deneyin. Sorun devam ederse yardım için destek ekibiyle iletişime geçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося активувати вашу нову ліцензію наразі. Будь ласка, спробуйте ще раз пізніше. Якщо проблема не зникає, зверніться до служби підтримки за допомогою."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi không thể kích hoạt giấy phép mới của bạn vào lúc này. Vui lòng thử lại sau. Nếu sự cố vẫn tiếp diễn, hãy liên hệ với bộ phận hỗ trợ để được trợ giúp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们目前无法激活您的新许可证。请稍后重试。如果问题仍然存在，请联系支持人员寻求帮助。"
          }
        }
      }
    },
    "ANOTHER_PROFILE_HAS_VALID_API_KEY": {
      "comment": "A description of a situation where a user has a valid API key from another user's profile.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil profitiert von der Lizenz eines anderen Profils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile benefits from the license of another profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil se beneficia de la licencia de otro perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil bénéficie de la licence d'un autre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo profilo beneficia della licenza di un altro profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプロフィールは、別のプロフィールのライセンスを利用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필은 다른 프로필의 라이선스를 사용합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten profil korzysta z licencji innego profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil se beneficia da licença de outro perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil beneficia da licença de outro perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот профиль использует лицензию другого профиля."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil başka bir profilin lisansından yararlanıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей профіль використовує ліцензію іншого профілю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hồ sơ này được hưởng lợi từ giấy phép của một hồ sơ khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此资料受益于另一个资料的授权。"
          }
        }
      }
    },
