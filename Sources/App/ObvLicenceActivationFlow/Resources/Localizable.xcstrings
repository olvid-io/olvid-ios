    "UNABLE_TO_ACTIVATE_LICENSE_EXPLANATION": {
      "comment": "A body text that explains that the license could not be activated.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Profil wird derzeit von Ihrem Unternehmens-Identitätsanbieter verwaltet. Sie können keine Olvid-Lizenz manuell aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile is currently managed by your company's identity provider. You cannot manually activate an Olvid license."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil está gestionado actualmente por el proveedor de identidad de tu empresa. No puedes activar manualmente una licencia de Olvid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil est actuellement géré par le fournisseur d'identité de votre entreprise. À ce titre, vous ne pouvez pas activer de license Olvid manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo è attualmente gestito dal provider di identità della tua azienda. Non puoi attivare manualmente una licenza Olvid."
          }
        }
      }
    },
