{
  "sourceLanguage": "en",
  "strings": {
    "ACTIVATE_NEW_LICENCE": {
      "comment": "A button that activates a new license.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Lizenz aktivieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate new license"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar nueva licencia"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer la licence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva nuova licenza"
          }
        }
      }
    },
    "ACTIVATION_REQUEST_FAILED": {
      "comment": "A message displayed when the activation request to the server fails.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktivierung Ihrer neuen Lizenz ist im Moment nicht möglich. Bitte versuchen Sie es später erneut. Wenn das Problem weiterhin besteht, wenden Sie sich an den Support, um Hilfe zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We were unable to activate your new license at this time. Please try again later. If the issue persists, contact support for assistance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos activar su nueva licencia en este momento. Por favor, inténtelo de nuevo más tarde. Si el problema persiste, póngase en contacto con el soporte técnico para obtener ayuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas pu activer votre nouvelle licence pour le moment. Veuillez réessayer ultérieurement. Si le problème persiste, contactez notre support pour obtenir de l'aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti ad attivare la tua nuova licenza in questo momento. Riprova più tardi. Se il problema persiste, contatta l'assistenza."
          }
        }
      }
    },
    "ANOTHER_PROFILE_HAS_VALID_API_KEY": {
      "comment": "A description of a situation where a user has a valid API key from another user's profile.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Profil profitiert von der Lizenz eines anderen Profils."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This profile benefits from the license of another profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este perfil se beneficia de la licencia de otro perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce profil bénéficie de la licence d'un autre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo profilo beneficia della licenza di un altro profilo."
          }
        }
      }
    },
