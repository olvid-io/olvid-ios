    "COULD_NOT_QUERY_SERVER_FOR_API_KEY_ELEMENTS": {
      "comment": "An explanation displayed when the app is unable to query the server for the API key elements.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir konnten die Berechtigungen, die mit dem API-Schlüssel verbunden sind, nicht abrufen. Bitte überprüfe deine Netzwerkverbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We could not obtain the permissions associated to the API key. Please check your network connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pudimos obtener los permisos asociados a la clave API. Por favor, verifica tu conexión de red e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous n'avons pas réussi à déterminer les permissions associées à la clé d'API. Veuillez vérifier votre connexion internet et essayer à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non siamo riusciti a ottenere i permessi associati alla chiave API. Controlla la tua connessione internet e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーに関連付けられた権限を取得できませんでした。ネットワーク接続を確認してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API 키와 관련된 권한을 가져올 수 없습니다. 네트워크 연결을 확인하고 다시 시도하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter as permissões associadas à chave da API. Verifique sua conexão com a internet e tente novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter as permissões associadas à chave de API. Verifique a sua ligação à Internet e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить разрешения, связанные с ключом API. Пожалуйста, проверьте подключение к сети и попробуйте еще раз."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати дозволи, пов’язані з ключем API. Перевірте підключення до мережі та спробуйте ще раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们无法获取与 API 密钥关联的权限。请检查您的网络连接，然后重试。"
          }
        }
      }
    },
