{
  "sourceLanguage": "en",
  "strings": {
    "ALERT_VOICE_MESSAGE_FAILED_USER_DENIED_RECORDING": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine Sprachnachricht aufzunehmen, erlauben Sie Olvid den Zugriff auf Ihr Mikrofon in den Geräteeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record an audio message, allow Olvid to access your microphone in your device settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar un mensaje de voz, permite que Olvid acceda al micrófono en la configuración de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer un message vocal, autorisez Olvid à accéder à votre microphone dans les paramètres de votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per registrare un messaggio vocale, consenti a Olvid di accedere al microfono nelle impostazioni del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声メッセージを録音するには、デバイスの設定でOlvidがマイクにアクセスできるように許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메시지를 녹음하려면 기기 설정에서 Olvid가 마이크에 액세스하도록 허용하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar uma mensagem de áudio, permita que o Olvid acesse o microfone nas configurações do seu dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar uma mensagem de áudio, permita que o Olvid aceda ao seu microfone nas definições do seu dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для записи голосового сообщения разрешите Olvid доступ к микрофону в настройках вашего устройства."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб записати аудіоповідомлення, дозвольте Olvid доступ до вашого мікрофона в налаштуваннях пристрою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要录制语音消息，请在设备的设置中允许 Olvid 访问您的麦克风。"
          }
        }
      }
    },
