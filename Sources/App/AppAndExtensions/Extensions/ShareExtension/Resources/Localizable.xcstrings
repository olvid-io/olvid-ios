    "SNACK_BAR_DETAILS_BODY_GRANT_PERMISSION_TO_RECORD": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Anruf entgegenzunehmen, musst du Olvid Zugriff auf das Mikrofon gewähren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To received a call, you need to allow Olvid to access the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir una llamada, necesitas permitir que Olvid acceda al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des appels, vous devez autoriser Olvid à accéder au micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere una chiamata, devi permettere a Olvid di accedere al microfono."
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_GRANT_PERMISSION_TO_RECORD_IN_SETTINGS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Anruf entgegenzunehmen, müssen Sie Olvid den Zugriff auf das Mikrofon erlauben. Damit Sie nie wieder einen Anruf verpassen, gehen Sie bitte zu den Einstellungen und gewähren Sie Olvid Zugriff auf das Mikrofon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To received a call, you need to allow Olvid to access the microphone. To never miss a call again, please go to Settings and grant Olvid access to the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir llamadas, debes permitir que Olvid acceda al micrófono. Para no perderte nunca más una llamada, ve a Configuración y otorga a Olvid acceso al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des appels, vous devez autoriser Olvid à accéder au micro. Pour ne plus rater d'appel, allez dans les Réglages et autorisez l'accès au micro pour Olvid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere una chiamata, devi permettere a Olvid di accedere al microfono. Per non perdere mai più una chiamata, vai su Impostazioni e concedi a Olvid l'accesso al microfono."
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_INACTIVE_PROFILE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Profil ist auf diesem Gerät nicht aktiv, Sie können es aber jetzt reaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your profile is not active on this device but you can reactivate it now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu perfil no está activo en este dispositivo, pero puedes reactivarlo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre profil est inactif sur cet appareil mais vous pouvez le réactiver maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo profilo non è attivo su questo dispositivo, ma puoi riattivarlo ora."
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_IOS_VERSION_ACCEPTABLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um sicherzustellen, dass Sie die neueste Version von iOS verwenden, gehen Sie zu Einstellungen > Allgemein und tippen Sie dann auf Softwareupdate."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To make sure you use the latest version of iOS, go to Settings > General, then tap Software Update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para asegurarte de que estás usando la última versión de iOS, ve a Ajustes > General y luego toca Actualización de software."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour vous assurer que vous utilisez la dernière version d'iOS, accédez à l'App Réglages sur votre appareil. Allez dans Général puis touchez Mise à jour logicielle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per assicurarti di utilizzare l'ultima versione di iOS, vai su Impostazioni > Generali, quindi tocca Aggiornamento software."
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_IOS_VERSION_SHOULD_UPGRADE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben festgestellt, dass Sie nicht die neueste Version von iOS verwenden. Ihnen fehlen wichtige Funktionen von Olvid. Um Olvid optimal nutzen zu können, sollten Sie iOS aktualisieren.\nÖffnen Sie dazu die Einstellungen-App auf Ihrem Gerät. Gehen Sie zu „Allgemein“ und tippen Sie auf „Softwareupdate“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We detected that you are not using the latest version of iOS. You are missing out on important features of Olvid. To make the most out of Olvid, you should upgrade iOS.\nTo do so, open the Settings App on your device. Go to General and tap Software Update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos detectado que no estás utilizando la última versión de iOS. Te estás perdiendo funciones importantes de Olvid. Para aprovechar al máximo Olvid, deberías actualizar iOS.\nPara hacerlo, abre la aplicación Ajustes en tu dispositivo. Ve a General y toca en Actualización de software."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons détecté que vous n'utilisez pas la dernière version d'iOS. Vous être en train de passer à côté de fonctionnalités importantes d'Olvid. Pour profiter d'Olvid au maximum, vous devriez mettre à jour iOS.\nPour ce faire, accédez à l'App Réglages sur votre appareil. Allez dans Général puis touchez Mise à jour logicielle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo rilevato che non stai utilizzando l'ultima versione di iOS. Ti stai perdendo importanti funzionalità di Olvid. Per sfruttare al meglio Olvid, ti consigliamo di aggiornare iOS.\nPer farlo, apri l'app Impostazioni sul tuo dispositivo. Vai su Generali e tocca Aggiornamento software."
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_IOS_VERSION_WILL_BE_UNSUPPORTED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir haben festgestellt, dass Sie eine iOS-Version verwenden, die Olvid ab dem nächsten Update nicht mehr unterstützt. Wir entschuldigen uns dafür. Wenn möglich, empfehlen wir Ihnen, auf die neueste iOS-Version zu aktualisieren.\nÖffnen Sie dazu die Einstellungen-App auf Ihrem Gerät. Gehen Sie zu „Allgemein“ und tippen Sie auf „Softwareupdate“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We detected that you use an iOS version that Olvid will not support anymore, starting with the next update. We appologize for this. If possible, we recommend you upgrade to the latest iOS version.\nTo do so, open the Settings App on your device. Go to General and tap Software Update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemos detectado que estás utilizando una versión de iOS que Olvid dejará de soportar a partir de la próxima actualización. Lamentamos las molestias. Si es posible, te recomendamos que actualices a la última versión de iOS.\nPara hacerlo, abre la aplicación de Ajustes en tu dispositivo. Ve a General y toca Actualización de software."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous avons détecté que vous utilisez une version d'iOS que Olvid ne supportera plus dès la prochaine mise à jour. Nous vous présentons toutes nos excuses. Si possible, nous vous recommandons de mettre à jour iOS.\nPour ce faire, accédez à l'App Réglages sur votre appareil. Allez dans Général puis touchez Mise à jour logicielle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbiamo rilevato che stai utilizzando una versione di iOS che Olvid non supporterà più, a partire dal prossimo aggiornamento. Ci scusiamo per l'inconveniente. Se possibile, ti consigliamo di aggiornare all'ultima versione di iOS.\nPer farlo, apri l'app Impostazioni sul tuo dispositivo. Vai su Generali e tocca Aggiornamento Software."
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_NEW_APP_VERSION_AVAILABLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Version von Olvid ist im App Store verfügbar. Du verpasst tolle neue Funktionen 🤓! Wir empfehlen dir, jetzt zu aktualisieren 🚀."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version of Olvid is available from the App Store. You are missing out amazing new features 🤓! We recommend you upgrade now 🚀."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una nueva versión de Olvid disponible en la App Store. ¡Te estás perdiendo increíbles nuevas funciones 🤩! Recomendamos que actualices ahora 🚀."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle version d'Olvid est disponible dès maintenant sur l'App Store. Pour ne pas rater les dernières nouveautés d'Olvid 🤓, nous vous recommandons de mettre à jour maintenant 🚀."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una nuova versione di Olvid sull'App Store. Ti stai perdendo fantastiche nuove funzionalità 🎉! Ti consigliamo di aggiornare subito 🚀."
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_TITLE_GRANT_PERMISSION_TO_RECORD": {
