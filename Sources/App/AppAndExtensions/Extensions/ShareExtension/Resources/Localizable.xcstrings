    "EXPLANATION_FOR_CLONING_A_GROUP_V1_TO_GROUP_V2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppe unterstützt nicht mehr als einen Administrator. Sie können diese Gruppe jedoch in eine neue klonen, die 🚀 verfügen wird!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group does not support more than one administrator. But you can clone this group into a new one that will 🚀!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo no admite más de un administrador. Pero puedes clonar este grupo en uno nuevo con 🚀!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce groupe ne permet pas d'avoir plusieurs administrateurs. Mais vous pouvez le cloner en un nouveau groupe de dernière génération qui le permettra 🚀 !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gruppo non supporta più di un amministratore. Ma puoi clonare questo gruppo in uno nuovo che sarà 🚀!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループでは、管理者を複数設定することはできません。ただし、このグループを複製して新しいグループを作成することは可能です！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 그룹은 둘 이상의 관리자를 지원하지 않습니다. 하지만 이 그룹을 복제하여 새로운 그룹을 만들 수 있습니다!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta grupa nie obsługuje więcej niż jednego administratora. Możesz jednak sklonować ją do nowej grupy, która to umożliwi 🚀!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo não permite ter mais de um administrador. Mas você pode cloná-lo para criar um novo grupo! 🥳"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo não suporta mais do que um administrador. Mas pode clonar este grupo para um novo, que terá um novo administrador!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этой группе не поддерживается более одного администратора. Но вы можете клонировать эту группу в новую, где 🚀!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu grup birden fazla yöneticiyi desteklemiyor. Ancak bu grubu, bunu destekleyen yeni bir grup olarak klonlayabilirsiniz 🚀!"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ця група не підтримує більше одного адміністратора. Але ви можете клонувати цю групу в нову, де буде 🧑‍💻!"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhóm này không hỗ trợ nhiều hơn một quản trị viên. Nhưng bạn có thể sao chép nhóm này sang một nhóm mới 😃!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个群组不支持多位管理员。但您可以将此群组克隆到一个新的群组中，然后添加管理员！"
          }
        }
      }
    },
