      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid ist aufgrund zu vieler falscher Passcode-Versuche gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid is locked following too many wrong passcode attempts."
          }
