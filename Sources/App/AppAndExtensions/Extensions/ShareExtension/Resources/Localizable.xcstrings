            "value": "Bitte starte die Olvid App, um das Update abzuschließen 🚀. Sobald dies geschehen ist, kannst du Inhalte teilen 😉."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please launch the Olvid App in order to finalize its update 🚀. You will be able to share content once this is done 😉."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, abre la aplicación Olvid para finalizar su actualización 🛠️. Podrás compartir contenido una vez que esto se complete ✅."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez lancer l'app Olvid afin de terminer la mise à jour 🚀. Vous pourrez à nouveau partager du contenu une fois que ce sera fait 😉."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
