    "EXPLANATION_FOR_CLONING_A_GROUP_V1_TO_GROUP_V2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gruppe unterstützt nicht mehr als einen Administrator. Sie können diese Gruppe jedoch in eine neue klonen, die 🚀 verfügen wird!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group does not support more than one administrator. But you can clone this group into a new one that will 🚀!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo no admite más de un administrador. Pero puedes clonar este grupo en uno nuevo con 🚀!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe ne permet pas d'avoir plusieurs administrateurs. Mais vous pouvez le cloner en un nouveau groupe de dernière génération qui le permettra 🚀 !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gruppo non supporta più di un amministratore. Ma puoi clonare questo gruppo in uno nuovo che sarà 🚀!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループでは、管理者を複数設定することはできません。ただし、このグループを複製して新しいグループを作成することは可能です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹은 둘 이상의 관리자를 지원하지 않습니다. 하지만 이 그룹을 복제하여 새로운 그룹을 만들 수 있습니다!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo não permite ter mais de um administrador. Mas você pode cloná-lo para criar um novo grupo! 🥳"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo não suporta mais do que um administrador. Mas pode clonar este grupo para um novo, que terá um novo administrador!"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой группе не поддерживается более одного администратора. Но вы можете клонировать эту группу в новую, где 🚀!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця група не підтримує більше одного адміністратора. Але ви можете клонувати цю групу в нову, де буде 🧑‍💻!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个群组不支持多位管理员。但您可以将此群组克隆到一个新的群组中，然后添加管理员！"
          }
        }
      }
    },
    "EXPLANATION_PLACED_ABOVE_LIST_OF_NON_ONE_TO_ONE_CONTACTS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Nutzer sind (noch) nicht Teil Ihrer Kontakte und Sie können daher keine private Unterhaltung mit ihnen führen. Sie können sie aber ganz einfach einladen 🚀!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The following users are not part of your contacts (yet), so you cannot have a private discussion with them. But you can invite them easily 🚀!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los siguientes usuarios no están en tus contactos (todavía), por lo que no puedes tener una conversación privada con ellos. Pero puedes invitarlos fácilmente 🚀!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les utilisateurs ci-dessous ne font pas (encore) partie de vos contacts, et vous ne pouvez donc pas encore avoir de discussion privée avec eux. Mais vous pouvez les y inviter facilement 🚀 !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I seguenti utenti non sono ancora tra i tuoi contatti, quindi non puoi avviare una conversazione privata con loro. Puoi comunque invitarli facilmente 🚀!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下のユーザーはまだ連絡先に登録されていないため、プライベートなチャットを行うことはできません。ただし、簡単に招待することができます 🚀！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 사용자는 아직 연락처에 없으므로 개인적으로 대화할 수 없습니다. 하지만 쉽게 초대할 수 있습니다! 🥳"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seguintes usuários ainda não estão em seus contatos, portanto, você não pode ter uma conversa privada com eles. Mas você pode convidá-los facilmente! 😊"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seguintes utilizadores não estão ainda na sua lista de contactos, pelo que não pode iniciar uma conversa privada com eles. No entanto, pode convidá-los facilmente! 🚀"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Следующие пользователи еще не добавлены в ваши контакты, поэтому вы не можете вести с ними личную переписку. Но вы можете легко их пригласить 🤝!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наступні користувачі ще не в вашому списку контактів, тому ви не можете мати з ними приватну розмову. Але ви можете легко їх запросити 🤝!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下用户尚未添加到您的通讯录中，因此您无法与他们进行私聊。但是，您可以轻松地邀请他们！"
          }
        }
      }
    },
