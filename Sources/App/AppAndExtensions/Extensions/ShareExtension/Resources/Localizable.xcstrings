    "SNACK_BAR_DETAILS_BODY_GRANT_PERMISSION_TO_RECORD": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Anruf entgegenzunehmen, musst du Olvid Zugriff auf das Mikrofon gewähren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To received a call, you need to allow Olvid to access the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir una llamada, necesitas permitir que Olvid acceda al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des appels, vous devez autoriser Olvid à accéder au micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere una chiamata, devi permettere a Olvid di accedere al microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話を受信するには、Olvidがマイクにアクセスできるようにする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화를 받으려면 Olvid가 마이크에 접근할 수 있도록 허용해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber chamadas, você precisa permitir que o Olvid acesse o microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber chamadas, precisa de permitir que a Olvid aceda ao microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы принимать звонки, необходимо разрешить Olvid доступ к микрофону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб приймати дзвінки, Olvid потребує доступу до мікрофона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了接收来电，您需要允许 Olvid 访问麦克风。"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_GRANT_PERMISSION_TO_RECORD_IN_SETTINGS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um einen Anruf entgegenzunehmen, müssen Sie Olvid den Zugriff auf das Mikrofon erlauben. Damit Sie nie wieder einen Anruf verpassen, gehen Sie bitte zu den Einstellungen und gewähren Sie Olvid Zugriff auf das Mikrofon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To received a call, you need to allow Olvid to access the microphone. To never miss a call again, please go to Settings and grant Olvid access to the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para recibir llamadas, debes permitir que Olvid acceda al micrófono. Para no perderte nunca más una llamada, ve a Configuración y otorga a Olvid acceso al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour recevoir des appels, vous devez autoriser Olvid à accéder au micro. Pour ne plus rater d'appel, allez dans les Réglages et autorisez l'accès au micro pour Olvid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ricevere una chiamata, devi permettere a Olvid di accedere al microfono. Per non perdere mai più una chiamata, vai su Impostazioni e concedi a Olvid l'accesso al microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "着信するには、Olvid がマイクにアクセスできるようにする必要があります。今後、着信を見逃さないように、設定を開いて、Olvid がマイクにアクセスできるようにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전화를 받으려면 Olvid가 마이크에 접근할 수 있도록 허용해야 합니다. 앞으로 전화를 놓치지 않으려면 설정으로 이동하여 Olvid가 마이크에 접근하도록 허용하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber chamadas, você precisa permitir que o Olvid acesse o microfone. Para não perder mais nenhuma chamada, vá em Configurações e conceda permissão ao Olvid para acessar o microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para receber chamadas, tem de permitir que o Olvid aceda ao microfone. Para nunca mais perder uma chamada, vá a Definições e conceda ao Olvid acesso ao microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы принимать звонки, необходимо разрешить Olvid доступ к микрофону. Чтобы больше не пропускать звонки, перейдите в Настройки и предоставьте Olvid доступ к микрофону."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб прийняти виклик, Olvid потребує доступу до мікрофона. Щоб більше ніколи не пропустити виклик, перейдіть у Налаштування та надайте Olvid доступ до мікрофона."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要接收来电，您需要允许 Olvid 访问麦克风。为了不再错过任何来电，请前往设置并授予 Olvid 访问麦克风的权限。"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_BODY_NEW_APP_VERSION_AVAILABLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neue Version von Olvid ist im App Store verfügbar. Du verpasst tolle neue Funktionen 🤓! Wir empfehlen dir, jetzt zu aktualisieren 🚀."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new version of Olvid is available from the App Store. You are missing out amazing new features 🤓! We recommend you upgrade now 🚀."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una nueva versión de Olvid disponible en la App Store. ¡Te estás perdiendo increíbles nuevas funciones 🤩! Recomendamos que actualices ahora 🚀."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle version d'Olvid est disponible dès maintenant sur l'App Store. Pour ne pas rater les dernières nouveautés d'Olvid 🤓, nous vous recommandons de mettre à jour maintenant 🚀."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È disponibile una nuova versione di Olvid sull'App Store. Ti stai perdendo fantastiche nuove funzionalità 🎉! Ti consigliamo di aggiornare subito 🚀."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App StoreでOlvidの最新バージョンが利用可能です。素晴らしい新機能をお見逃しなく！今すぐアップデートすることをお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "App Store에서 Olvid의 새 버전이 출시되었습니다. 놀라운 새로운 기능을 놓치고 계시네요! 지금 업데이트하시기를 권장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova versão do Olvid está disponível na App Store. Você está perdendo recursos incríveis! Recomendamos que você atualize agora."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova versão do Olvid está disponível na App Store. Está a perder novas funcionalidades incríveis! Recomendamos que faça o upgrade agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В App Store доступна новая версия Olvid. Вы упускаете множество новых интересных функций 🤓! Рекомендуем обновиться сейчас 🚀."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступна нова версія Olvid в App Store. Ви пропускаєте дивовижні нові функції 🤓! Рекомендуємо оновити її зараз 🚀."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid 的新版本已在 App Store 上提供。您错过了许多令人惊叹的新功能！我们建议您立即更新。"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_TITLE_GRANT_PERMISSION_TO_RECORD": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast einen Anruf verpasst, da Olvid nicht auf das Mikrofon zugreifen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You missed a call because Olvid is not allowed to access the microphone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdiste una llamada porque Olvid no tiene permiso para acceder al micrófono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez raté un appel car Olvid n'a pas accès au micro"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai perso una chiamata perché Olvid non ha il permesso di accedere al microfono"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid がマイクへのアクセスを許可されていないため、着信に気づきませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid가 마이크에 접근할 수 없어서 전화가 걸려왔지만 받지 못했습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você perdeu uma chamada porque o Olvid não tem permissão para acessar o microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdeu uma chamada porque o Olvid não tem permissão para aceder ao microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пропустили вызов, потому что Olvid не имеет доступа к микрофону"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви пропустили дзвінок, оскільки Olvid не має доступу до мікрофона"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您错过了一个电话，因为 Olvid 没有被允许访问麦克风"
          }
        }
      }
    },
    "SNACK_BAR_DETAILS_TITLE_GRANT_PERMISSION_TO_RECORD_IN_SETTINGS": {
