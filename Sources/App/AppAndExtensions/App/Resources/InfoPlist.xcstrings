            "state": "translated",
            "value": "Tài liệu Microsoft Word"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Microsoft Word 文档"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - Camera Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf die Kamera ermöglicht es Ihnen, die QR-Codes Ihrer Kontakte zu scannen und direkt aus einem Chat Fotos und Videos aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Access to the camera allows you to scan the QR code of your contacts and to take pictures and videos right from within a discussion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la cámara te permite escanear el código QR de tus contactos y tomar fotos y videos directamente desde una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à l'appareil photo permet de scanner le code QR de vos contacts et de prendre des photos et des vidéos directement au sein d'une discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso alla fotocamera ti permette di scansionare il codice QR dei tuoi contatti e di scattare foto e video direttamente all'interno di una conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラへのアクセスにより、連絡先のQRコードをスキャンしたり、チャット内から写真や動画を撮影したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라 접근 권한을 통해 연락처의 QR 코드를 스캔하고, 대화 내에서 바로 사진과 비디오를 촬영할 수 있습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do aparatu pozwala skanować kody QR kontaktów oraz robić zdjęcia i nagrywać wideo bezpośrednio w dyskusji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmera permite que você escaneie o código QR de seus contatos e tire fotos e vídeos diretamente de uma conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à câmara permite-lhe digitalizar o código QR dos seus contactos e tirar fotografias e vídeos diretamente numa conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к камере позволяет сканировать QR-коды контактов и делать фотографии и видео прямо в диалоге."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kameraya erişim, kişilerinizin QR kodunu taramanızı ve doğrudan bir sohbetin içinden fotoğraf ve video çekmenizi sağlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надання доступу до камери дозволяє сканувати QR-коди ваших контактів, а також робити фотографії та відео безпосередньо в чаті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho phép truy cập vào camera để bạn có thể quét mã QR của danh bạ và chụp ảnh, quay video ngay trong cuộc trò chuyện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问相机功能可让您扫描联系人的二维码，并可以直接在对话中拍摄照片和视频。"
          }
        }
      }
    },
