    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Privacy - Location Always and When In Use Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort ist erforderlich, wenn du ihn mit anderen Benutzern teilen möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your location is necessary when you decide to share it with other users."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación es necesaria cuando decidas compartirla con otros usuarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position géographique est nécessaire si vous décidez de la partager avec d'autres utilisateurs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione è necessaria quando decidi di condividerla con altri utenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のユーザーと位置情報を共有する場合、位置情報は必須です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자와 위치를 공유하기로 결정하면 위치 정보가 필요합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja lokalizacja jest potrzebna, gdy zdecydujesz się udostępnić ją innym użytkownikom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua localização é necessária quando você decidir compartilhá-la com outros usuários."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua localização é necessária quando decidir partilhá-la com outros utilizadores."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше местоположение необходимо, когда вы решите поделиться им с другими пользователями."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuzu diğer kullanıcılarla paylaşmayı seçtiğinizde konum bilginiz gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше місцезнаходження необхідне, коли ви вирішите поділитися ним з іншими користувачами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vị trí của bạn cần thiết khi bạn quyết định chia sẻ nó với những người dùng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当您决定与他人分享位置时，您的位置信息是必需的。"
          }
        }
      }
    },
