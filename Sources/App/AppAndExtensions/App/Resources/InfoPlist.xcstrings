    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - Microphone Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff auf das Mikrofon ist erforderlich, um sichere Audioanrufe zu tätigen und Filme und Sprachnachrichten aufzunehmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Allowing access to the microphone is required to make secure audio calls and to record movies and voice messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir el acceso al micrófono es necesario para realizar llamadas de audio seguras y grabar vídeos y mensajes de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au micro est nécessaire pour passer des appels sécurisés ainsi que pour enregistrer des films et des messages audios."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono è necessario per effettuare chiamate audio sicure e registrare video e messaggi vocali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "安全な音声通話や、ビデオやボイスメッセージの録音を行うには、マイクへのアクセスを許可する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 오디오 통화를 하고 동영상 및 음성 메시지를 녹음하려면 마이크 액세스 권한을 허용해야 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu jest wymagany do prowadzenia bezpiecznych połączeń głosowych oraz nagrywania filmów i wiadomości głosowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir o acesso ao microfone é necessário para fazer chamadas de áudio seguras e gravar vídeos e mensagens de voz."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir o acesso ao microfone é necessário para efetuar chamadas de áudio seguras e para gravar vídeos e mensagens de voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для осуществления защищенных аудиозвонков и записи видео и голосовых сообщений требуется доступ к микрофону."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli sesli aramalar yapmak, video ve sesli mesaj kaydetmek için mikrofona erişim izni gereklidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Надання доступу до мікрофона необхідне для здійснення безпечних аудіо- та відеодзвінків, а також для запису відео та голосових повідомлень."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc cấp quyền truy cập vào micro là cần thiết để thực hiện các cuộc gọi thoại an toàn và để ghi lại video và tin nhắn thoại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了进行安全的语音通话以及录制视频和语音信息，需要允许访问麦克风。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Privacy - Photo Library Additions Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Speichern eines Bildes in Ihrer Fotomediathek sind Schreibzugriffsrechte erforderlich. Bitte beachten Sie, dass Olvid nicht auf Ihre anderen Fotos in der Fotomediathek zugreifen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Write access is required to save a picture to your photo library. Please note that Olvid will not have access to the other photos of your photo library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere acceso de escritura para guardar una imagen en tu biblioteca de fotos. Ten en cuenta que Olvid no tendrá acceso a las demás fotos de tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès en écriture à votre librairie de photos permet d'y sauver une image directement. Notez que Olvid n'aura pas accès aux autres photos de votre librairie de photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario l'accesso in scrittura per salvare un'immagine nella tua libreria foto. Tieni presente che Olvid non avrà accesso alle altre foto della tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に保存するには、書き込み権限が必要です。Olvidは、お客様の写真ライブラリ内の他の写真にはアクセスしないことをご了承ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사진을 사진 보관함에 저장하려면 쓰기 권한이 필요합니다. Olvid은 사진 보관함의 다른 사진에 접근할 수 없다는 점을 참고해 주시기 바랍니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do zapisu jest wymagany, aby zapisać zdjęcie w bibliotece zdjęć. Olvid nie będzie mieć dostępu do pozostałych zdjęć w twojej bibliotece."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário acesso à escrita para salvar uma imagem na sua biblioteca de fotos. Observe que o Olvid não terá acesso às outras fotos da sua biblioteca."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário acesso à escrita para guardar uma imagem na sua biblioteca de fotos. Tenha em atenção que o Olvid não terá acesso às outras fotos da sua biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для сохранения фотографии в вашу фотобиблиотеку требуется доступ к записи. Обратите внимание, что Olvid не будет иметь доступа к другим фотографиям в вашей фотобиблиотеке."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir resmi fotoğraf arşivinize kaydetmek için yazma erişimi gereklidir. Olvid'in fotoğraf arşivinizdeki diğer fotoğraflara erişimi olmayacağını lütfen unutmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для збереження зображення в бібліотеку фотографій потрібен доступ до запису. Зверніть увагу, що Olvid не матиме доступу до інших фотографій у вашій бібліотеці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền ghi là bắt buộc để lưu ảnh vào thư viện ảnh của bạn. Xin lưu ý rằng Olvid sẽ không có quyền truy cập vào các ảnh khác trong thư viện ảnh của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了将图片保存到您的照片库，需要写入权限。请注意，Olvid不会访问您照片库中的其他照片。"
          }
        }
      }
    },
    "NSSiriUsageDescription": {
      "comment": "Privacy - Siri Usage Description",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid nutzt Siri, um Nachrichten zu senden, vorzulesen und freihändig Anrufe zu tätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid uses Siri to send messages, read them aloud, and place calls hands-free."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid usa Siri para enviar mensajes, leerlos en voz alta y hacer llamadas con manos libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid utilise Siri pour envoyer des messages, vous les lire à voix haute et passer des appels en mode mains libres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid usa Siri per inviare messaggi, leggerli ad alta voce ed effettuare chiamate in vivavoce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid は Siri を使用してメッセージの送信、読み上げ、ハンズフリーでの通話を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid는 Siri를 사용하여 메시지를 보내고, 소리 내어 읽어주며, 핸즈프리로 전화를 걸 수 있도록 합니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid używa Siri do wysyłania wiadomości, odczytywania ich na głos i nawiązywania połączeń bez użycia rąk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid usa a Siri para enviar mensagens, lê-las em voz alta e fazer chamadas com as mãos livres."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid usa a Siri para enviar mensagens, lê-las em voz alta e fazer chamadas em mãos-livres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid использует Siri, чтобы отправлять сообщения, зачитывать их вслух и совершать звонки без помощи рук."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid, mesaj göndermek, mesajları sesli okumak ve eller serbest arama yapmak için Siri'yi kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid використовує Siri, щоб надсилати повідомлення, зачитувати їх уголос та здійснювати дзвінки без допомоги рук."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid sử dụng Siri để gửi tin nhắn, đọc tin nhắn và thực hiện cuộc gọi rảnh tay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid 使用 Siri 发送消息、朗读消息并免提拨打电话。"
          }
        }
      }
    },
