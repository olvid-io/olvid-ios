    "STD_MSG_OLVID_TAKES_TOO_LONG_TO_START": {
      "comment": "Body text",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid scheint länger als gewöhnlich zu starten. Dies tritt typischerweise nach der Installation einer neuen Version auf. Seien Sie versichert, dass keine Ihrer Daten verloren gegangen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid seems to take longer than usual to start. This typically occurs after installing a new version. Please be reassured, none of your data was lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid parece tardar más de lo habitual en iniciarse. Esto suele ocurrir después de instalar una nueva versión. Tenga la seguridad de que no se ha perdido ninguno de sus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid semble prendre plus de temps que d'habitude pour démarrer. Cela peut arriver après une mise à jour. Rassurez-vous, même si le problème persiste, aucune de vos données n'a été perdue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sembra che Olvid impieghi più tempo del solito per avviarsi. Questo si verifica in genere dopo aver installato una nuova versione. Ti assicuriamo che nessuno dei tuoi dati è andato perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidの起動に普段より時間がかかるようです。これは、新しいバージョンをインストールした後によく発生します。ご安心ください、データは一切失われていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid가 평소보다 시작하는 데 시간이 더 걸리는 것 같습니다. 이는 일반적으로 새 버전을 설치한 후에 발생합니다. 안심하십시오. 데이터가 손실된 것은 아닙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid parece demorar mais do que o normal para iniciar. Isso geralmente acontece após a instalação de uma nova versão. Fique tranquilo, nenhum dos seus dados foi perdido."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid parece demorar mais do que o habitual a iniciar. Isto acontece normalmente após a instalação de uma nova versão. Fique descansado, nenhum dos seus dados foi perdido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid запускается дольше обычного. Обычно это происходит после установки новой версии. Успокаиваем, ваши данные не были потеряны."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid запускається довше, ніж зазвичай. Зазвичай це відбувається після встановлення нової версії. Будь ласка, не хвилюйтеся, ваші дані не були втрачені."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid 启动似乎比平时花费更多时间。这通常在新版本安装后发生。请放心，您的数据没有丢失。"
          }
        }
      }
    },
