    "ALERT_CHOOSE_HIDDEN_PROFILE_CLOSE_POLICY_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte wähle aus, wann ein geöffnetes Profil geschlossen werden soll. Standardmäßig werden ausgeblendete Profile geschlossen, wenn du manuell zu einem anderen Profil wechselst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please choose when an open profile should be closed. By default, hidden profiles will be closed when manually switching to another profile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, elige cuándo se debe cerrar un perfil abierto. Por defecto, los perfiles ocultos se cerrarán al cambiar manualmente a otro perfil."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez choisir le bon moment pour fermer un profil masqué. Par défaut, un profil masqué est fermé quand vous basculez manuellement vers un autre profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli per quanto tempo mantenere aperto un profilo. Di default, i profili nascosti verranno chiusi quando si passa manualmente a un altro profilo."
          }
        }
      }
    },
    "ALERT_CHOOSE_HIDDEN_PROFILE_CLOSE_POLICY_TITLE" : {
