    "GLOBAL_EXPIRATION_SETTINGS_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die folgenden Einstellungen werden auf alle neuen Einzelgespräche und alle neuen Gruppenchats angewendet, die Sie erstellen. Bitte beachten Sie, dass diese Einstellungen mit allen Teilnehmern des Chats geteilt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The settings below will be applied to all new one-to-one discussions and to all new group discussions that you create. Please note that these settings will be shared among all the participant of the discussion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración a continuación se aplicará a todas las nuevas conversaciones uno a uno y a todos los nuevos grupos que cree. Tenga en cuenta que esta configuración se compartirá entre todos los participantes de la conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paramètres ci-dessous seront appliqués à toute nouvelle discussion « one-to-one » ainsi qu'à toute nouvelle discussion de groupe que vous créerez. Veuillez noter que ces paramètres de discussion seront partagés avec tous les participants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni sottostanti verranno applicate a tutte le nuove discussioni individuali e a tutti i nuovi gruppi che creerai. Tieni presente che queste impostazioni saranno condivise tra tutti i partecipanti alla discussione."
          }
        }
      }
    },
    "GLOBAL_LOCAL_EPHEMERAL_SETTINGS_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die folgenden Einstellungen ermöglichen es Ihnen, das Standardverhalten von temporären Nachrichten lokal anzupassen. Diese Einstellungen werden nicht mit anderen Gesprächsteilnehmern geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The settings below allow you to locally customize the default behavior of ephemeral messages. These settings are not shared with other discussion participants."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración a continuación te permite personalizar localmente el comportamiento predeterminado de los mensajes efímeros. Estos ajustes no se comparten con otros participantes de la conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages ci-dessous vous permettent d'ajuster localement le comportement par défaut des messages éphémères. Ces paramètres ne sont pas partagés avec les autres participants aux discussions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni seguenti ti permettono di personalizzare localmente il comportamento predefinito dei messaggi effimeri. Queste impostazioni non vengono condivise con gli altri partecipanti alla conversazione."
          }
        }
      }
    },
    "GLOBAL_RETENTION_SETTINGS_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit den folgenden Einstellungen können Sie alte Nachrichten in Ihren Chats automatisch löschen. Diese können für jeden Chat einzeln überschrieben werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The settings below allow you to automatically delete old messages in your discussions. They can be overidden in each discussion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración a continuación te permite eliminar automáticamente mensajes antiguos en tus conversaciones. Puedes anularla en cada conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages ci-dessous vous permettent de supprimer automatiquement de vieux messages dans vos discussions. Ces paramètres par défaut peuvent être modifiés indépendamment pour chaque discussion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni seguenti ti permettono di eliminare automaticamente i messaggi più vecchi nelle tue conversazioni. Possono essere sovrascritte in ciascuna conversazione."
          }
        }
      }
    },
