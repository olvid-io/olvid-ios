    "AUTO_READ_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ephemeral Nachrichten automatisch öffnen. Dies gilt nur für Nachrichten, deren Ephemerität auf Diskussionsebene festgelegt wurde und nicht für Nachrichten, bei denen der Absender eine bestimmte Ephemerität wählt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically open ephemeral messages. This only applies to messages whose ephemerality was set at the discussion level and not to messages for which the sender chooses a specific ephemerality."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir automáticamente los mensajes efímeros. Esto solo se aplica a los mensajes cuya efimeridad se estableció a nivel de la conversación y no a los mensajes para los cuales el remitente elige una efimeridad específica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrir automatiquement les messages éphémères. Cette ouverture automatique ne s'applique qu'aux messages dont l'éphémérité est due aux paramètres choisis pour la discussion entière, et pas aux messages dont l'éphémérité est spécifiquement choisie par l'envoyeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri automaticamente i messaggi effimeri. Questo si applica solo ai messaggi la cui effimerità è stata impostata a livello di discussione e non ai messaggi per i quali il mittente sceglie una specifica effimerità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時メッセージを自動的に開きます。これは、ディスカッションレベルで一時メッセージの設定がされているメッセージにのみ適用され、送信者が特定の期間を設定したメッセージには適用されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시 메시지를 자동으로 엽니다. 이 기능은 대화 수준에서 일시 메시지 설정이 적용된 메시지에만 적용되며, 보낸 사람이 특정 일시 메시지 설정을 선택한 메시지에는 적용되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra automaticamente as mensagens temporárias. Isso se aplica apenas às mensagens cuja temporariedade foi definida no nível da conversa, e não às mensagens para as quais o remetente escolhe uma temporariedade específica."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abrir automaticamente as mensagens temporárias. Isto aplica-se apenas às mensagens cuja duração foi definida ao nível da conversa e não às mensagens para as quais o remetente escolhe uma duração específica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически открывать самоуничтожающиеся сообщения. Это относится только к сообщениям, для которых самоуничтожение установлено на уровне беседы, а не к сообщениям, для которых отправитель выбирает определенное время самоуничтожения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично відкривати тимчасові повідомлення. Це стосується лише повідомлень, для яких термін життя встановлено на рівні дискусії, а не для тих, для яких відправник вибрав конкретний термін життя."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动打开阅后即焚消息。这仅适用于在对话级别设置了阅后即焚的消息，而不适用于发送者选择特定阅后即焚选项的消息。"
          }
        }
      }
    },
