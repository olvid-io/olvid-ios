    "READ_ONCE_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden Nachrichten und Anhänge nur einmal angezeigt und beim Verlassen der Diskussion gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When activated, messages and attachments are displayed only once, and are deleted when exiting the discussion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se activa, los mensajes y archivos adjuntos se muestran solo una vez y se eliminan al salir de la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce réglage est activé, les messages et leurs pièces jointes ne sont affichés qu'une seule fois. Il sont supprimés au sortir de la discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando attivata, i messaggi e gli allegati vengono visualizzati una sola volta e vengono eliminati all'uscita dalla conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、メッセージと添付ファイルは一度だけ表示され、会話を終了すると削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 메시지와 첨부 파일이 한 번만 표시되고, 대화창을 나가면 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, mensagens e anexos são exibidos apenas uma vez e são excluídos ao sair da conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, as mensagens e anexos são exibidos apenas uma vez e apagados ao sair da conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При активации сообщения и вложения отображаются только один раз и удаляются при выходе из обсуждения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після активації, повідомлення та вкладення відображаються лише один раз і видаляються після виходу з обговорення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，消息和附件将仅显示一次，并在退出对话时删除。"
          }
        }
      }
    },
