          }
        }
      }
    },
    "DIALOG_OWNED_IDENTITY_WAS_REVOKED_BY_KEYCLOAK_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Identitätsanbieter Ihres Unternehmens hat Ihre Olvid-ID widerrufen. Bitte wenden Sie sich an Ihren Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your company's identity provider revoked your Olvid ID. Please contact your administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El proveedor de identidad de su empresa ha revocado su ID de Olvid. Por favor, contacte a su administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fournisseur d'identité de votre entreprise a révoqué votre ID Olvid. Nous vous recommandons de contacter votre administrateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il provider di identità della tua azienda ha revocato il tuo ID Olvid. Contatta il tuo amministratore."
          }
        }
      }
    },
