    "DRAFT_EXPIRATION_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie die folgenden Einstellungen, um die Sichtbarkeit und die Gültigkeitsdauer Ihrer nächsten Nachricht zu ändern. Sie können nur restriktivere Einstellungen als die Standardeinstellungen der Diskussion verwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the settings below to modify the visibility and existence durations of your next message. You may only use more restrictive settings than the discussion's default."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliza la configuración a continuación para modificar la visibilidad y la duración de existencia de tu próximo mensaje. Solo puedes usar configuraciones más restrictivas que la configuración predeterminada de la conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les paramètres ci-dessous pour modifier les durées de visibilité et d'existence de votre prochain message. Vous ne pouvez pas choisir des paramètres moins restrictifs que les paramètres par défaut de la discussion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza le impostazioni seguenti per modificare la visibilità e la durata di esistenza del tuo prossimo messaggio. Puoi utilizzare solo impostazioni più restrittive rispetto a quelle predefinite della conversazione."
          }
        }
      }
    },
