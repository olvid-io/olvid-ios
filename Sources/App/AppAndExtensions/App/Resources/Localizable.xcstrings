          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を使用するには、設定アプリでFace IDまたはTouch IDを設定する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능을 사용하려면 설정 앱에서 Face ID 또는 Touch ID를 설정해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar este recurso, você precisa configurar o Face ID ou o Touch ID no aplicativo Ajustes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para utilizar esta funcionalidade, tem de configurar o Face ID ou o Touch ID nas Definições."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для использования этой функции необходимо настроить Face ID или Touch ID в приложении «Настройки»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб використовувати цю функцію, вам потрібно налаштувати Face ID або Touch ID у програмі «Налаштування»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
