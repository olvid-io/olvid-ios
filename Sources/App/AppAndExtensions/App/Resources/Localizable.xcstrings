    "ALERT_MSG_OUTGOING_CALL_FAILED_USER_DENIED_RECORDING" : {
      "comment" : "Alert message",
      "localizations" : {
        "de" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Um einen ausgehenden Anruf zu tätigen, erlaube Olvid bitte den Zugriff auf das Mikrofon. Du kannst dies in den Systemeinstellungen konfigurieren."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Um einen ausgehenden Anruf zu tätigen, erlaube Olvid bitte den Zugriff auf das Mikrofon. Du kannst dies in den Einstellungen konfigurieren."
                }
              }
            }
          }
        },
        "en" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "To initiate an outbound call, kindly grant Olvid permission to access the microphone. You can configure this in the System Settings."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "To initiate an outbound call, kindly grant Olvid permission to access the microphone. You can configure this in the Settings."
                }
              }
            }
          }
        },
        "es" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Para iniciar una llamada saliente, por favor otorga a Olvid permiso para acceder al micrófono. Puedes configurar esto en la Configuración del Sistema."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Para iniciar una llamada saliente, por favor otorga a Olvid permiso para acceder al micrófono. Puedes configurar esto en la Configuración."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pour initier un appel audio, vous devez autoriser Olvid à accéder au micro. Vous pouvez effectuer cette configuration dans réglages système."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Pour initier un appel audio, vous devez autoriser Olvid à accéder au micro. Vous pouvez effectuer cette configuration dans l'application Réglages."
                }
              }
            }
          }
        },
        "it" : {
          "variations" : {
            "device" : {
              "mac" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Per effettuare una chiamata in uscita, concedi a Olvid il permesso di accedere al microfono. Puoi configurare questa impostazione nelle Preferenze di Sistema."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Per effettuare una chiamata in uscita, concedi a Olvid il permesso di accedere al microfono. Puoi configurare questa impostazione nelle Impostazioni."
                }
              }
            }
          }
        }
      }
    },
