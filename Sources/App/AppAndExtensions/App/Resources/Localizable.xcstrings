    "HIDE_GROUP_MEMBER_CHANGE_MESSAGES_CELL_SUBTITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden Nachrichten, die angeben, dass ein Gruppenmitglied einer Gruppe beigetreten oder diese verlassen hat, in Ihren Diskussionen nicht angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When activated, messages indicating that a group member joined or left a group will not be displayed in your discussions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se activa, los mensajes que indican que un miembro se unió o abandonó un grupo no se mostrarán en tus conversaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois cette option activée, les messages indiquant qu'un membre à rejoint ou quitté un groupe ne seront plus affichés dans vos discussions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando attivata, i messaggi che indicano l'entrata o l'uscita di un membro dal gruppo non verranno visualizzati nelle tue conversazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能をオンにすると、グループのメンバーがグループに参加または退出したことを示すメッセージが、チャットに表示されなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능을 켜면 그룹에 가입하거나 나간 사용자에 대한 메시지가 대화에 표시되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, as mensagens que indicam que um membro entrou ou saiu de um grupo não serão exibidas em suas conversas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativada, as mensagens que indicam que um membro entrou ou saiu de um grupo não serão exibidas nas suas conversas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда включено, сообщения о присоединении или выходе участников из группы не будут отображаться в ваших обсуждениях."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли ввімкнено, повідомлення про те, що учасник приєднався або покинув групу, не відображатимуться у ваших розмовах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，群成员加入或退出群组的消息将不会在您的对话中显示。"
          }
        }
      }
    },
