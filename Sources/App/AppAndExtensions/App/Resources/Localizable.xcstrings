    "EDIT_NICKNAME_AND_CUSTOM_PICTURE_EXPLANATION_FOR_CONTACT": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst einen Spitznamen und ein benutzerdefiniertes Profilbild für deinen Kontakt auswählen. Diese werden nur auf deinen Geräten angezeigt und werden nicht mit anderen geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose a nickname and a custom profile picture for your contact. They will only appear on your devices, and won't be shared with anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes elegir un apodo y una foto de perfil personalizada para tu contacto. Solo aparecerán en tus dispositivos y no se compartirán con nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez choisir un surnom et une photo de profil personnalisée pour votre contact. Ils apparaîtront sur vos appareils uniquement, et ne seront partagés avec personne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scegliere un soprannome e un'immagine del profilo personalizzata per i tuoi contatti. Saranno visibili solo sui tuoi dispositivi e non verranno condivisi con nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先のニックネームとカスタムのプロフィール写真を設定できます。これらはあなたのデバイスにのみ表示され、他のユーザーと共有されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처에 사용할 닉네임과 프로필 사진을 설정할 수 있습니다. 설정한 닉네임과 프로필 사진은 사용자의 기기에서만 표시되며 다른 사람과 공유되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode escolher um apelido e uma foto de perfil personalizada para seu contato. Eles aparecerão apenas em seus dispositivos e não serão compartilhados com ninguém."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pode escolher um apelido e uma foto de perfil personalizada para o seu contacto. Estes elementos apenas serão visíveis nos seus dispositivos e não serão partilhados com mais ninguém."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете выбрать никнейм и изображение профиля для этого контакта. Они будут отображаться только на ваших устройствах и не будут передаваться никому."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете обрати псевдонім та власне зображення профілю для свого контакту. Вони відображатимуться лише на ваших пристроях і не будуть поширені нікому."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以为您的联系人选择一个昵称和自定义的个人资料图片。这些内容仅显示在您的设备上，不会与任何人共享。"
          }
        }
      }
    },
    "EDIT_NICKNAME_AND_CUSTOM_PICTURE_EXPLANATION_FOR_GROUP": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst einen Spitznamen und ein benutzerdefiniertes Profilbild für diese Gruppe auswählen. Diese werden nur auf deinen Geräten angezeigt und werden nicht mit anderen geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose a nickname and a custom profile picture for this group. They will only appear on your devices, and won't be shared with anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes elegir un apodo y una foto de perfil personalizada para este grupo. Solo aparecerán en tus dispositivos y no se compartirán con nadie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez choisir un surnom et une photo de profil personnalisée pour ce groupe. Ils apparaîtront sur vos appareils uniquement, et ne seront partagés avec personne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scegliere un nickname e un'immagine del profilo personalizzata per questo gruppo. Saranno visibili solo sui tuoi dispositivi e non verranno condivisi con nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループでは、ニックネームとカスタムのプロフィール写真を選択できます。これらはあなたのデバイスでのみ表示され、他のユーザーと共有されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹에 대한 별칭과 사용자 지정 프로필 사진을 선택할 수 있습니다. 이 설정은 본인의 기기에서만 적용되며 다른 사람과 공유되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode escolher um apelido e uma foto de perfil personalizada para este grupo. Eles só aparecerão em seus dispositivos e não serão compartilhados com ninguém."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes escolher um nome de utilizador e uma foto de perfil personalizada para este grupo. Estes elementos só serão visíveis nos teus dispositivos e não serão partilhados com mais ninguém."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете выбрать псевдоним и изображение профиля для этой группы. Они будут видны только на ваших устройствах и не будут переданы кому-либо."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете обрати псевдонім та власне зображення профілю для цієї групи. Вони будуть відображатися лише на ваших пристроях і не будуть передані нікому."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以为这个群组选择一个昵称和自定义的头像。它们只会显示在您的设备上，不会与任何人共享。"
          }
        }
      }
    },
