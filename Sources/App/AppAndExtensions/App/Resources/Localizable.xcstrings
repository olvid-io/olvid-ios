    "%@ invites you to discuss on Olvid": {
      "comment": "Subject used when inviting another user to Olvid, i.e., when sharing ones owned identity using, e.g., an email",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte mit Ihnen auf Olvid diskutieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ would like to discuss with you on Olvid"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ le gustaría hablar contigo en Olvid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aimerait discuter avec vous sur Olvid"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vorrebbe parlare con te su Olvid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんがOlvidであなたと話したいと思っています"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 Olvid에서 귀하와 대화하고 싶어합니다"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gostaria de conversar com você no Olvid"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gostaria de conversar consigo no Olvid"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хотел(а) бы обсудить с вами в Olvid"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хотів би/хотіла би обговорити з вами Olvid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要在 Olvid 上与您讨论"
          }
        }
      }
    },
    "%@ invites you to discuss on Olvid. To accept, please click the link below:\n\n%@": {
      "comment": "Body used when inviting another user to Olvid, i.e., when sharing ones owned identity using, e.g., an email or message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte mit Ihnen auf Olvid diskutieren. Um zu akzeptieren, verwenden Sie den folgenden Link:\n\n%@\n"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wants to discuss with you on Olvid. To accept, use the link below:\n\n%@\n"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ quiere hablar contigo en Olvid. Para aceptar, usa el siguiente enlace:\n\n%@\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aimerait discuter avec vous sur Olvid. Pour accepter, utilisez le lien suivant :\n\n%@\n"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuole discutere con te su Olvid. Per accettare, usa il link qui sotto:\n\n%@\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が Olvid であなたと会話をしたいと思っています。承認するには、以下のリンクを使用してください:\n\n%@\n"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 Olvid에서 당신과 대화하고 싶어합니다. 수락하려면 아래 링크를 사용하세요:\n\n%@\n"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gostaria de conversar com você no Olvid. Para aceitar, use o link abaixo:\n\n%@\n"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pretende conversar consigo no Olvid. Para aceitar, utilize o seguinte link:\n\n%@\n"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хочет обсудить с вами Olvid. Чтобы принять, используйте ссылку ниже:\n\n%@\n"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ хоче обговорити з вами Olvid. Щоб прийняти, скористайтеся посиланням нижче:\n\n%@\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 想要在 Olvid 上与您讨论。如需接受，请使用以下链接：\n\n%@\n"
          }
        }
      }
    },
