    "RETAIN_WIPED_OUTBOUND_MESSAGES_LABEL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöschte, temporäre ausgehende Nachrichten beibehalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retain wiped ephemeral outbound messages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservar los mensajes salientes efímeros borrados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver une trace des messages éphémères envoyés"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva i messaggi effimeri in uscita cancellati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除された一時的な送信メッセージを保持する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제된 임시 전송 메시지 보관"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter as mensagens efêmeras enviadas, mesmo após a exclusão"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter as mensagens efêmeras enviadas, mesmo após a eliminação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранять удаленные временные исходящие сообщения"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залишити видані тимчасові вихідні повідомлення"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已删除的临时已发送消息"
          }
        }
      }
    },
    "RETAIN_WIPED_OUTBOUND_MESSAGES_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden ausgehende, temporäre Nachrichten beim Ablauf nicht gelöscht, sondern durch einen statischen Text ersetzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When activated, outbound ephemeral messages are not deleted when they expire, but replaced by a static text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se activa, los mensajes efímeros salientes no se eliminan al caducar, sino que se reemplazan por un texto estático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce réglage est activé, les messages éphémères sortants ne sont pas supprimés à expiration, mais remplacés par un texte fixe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando attivata, i messaggi effimeri in uscita non vengono eliminati alla scadenza, ma sostituiti da un testo statico."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を有効にすると、送信された一時的なメッセージは有効期限が切れても削除されず、代わりに固定テキストに置き換えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 만료된 일회성 메시지가 삭제되는 대신 정적인 텍스트로 대체됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, as mensagens efêmeras enviadas não são excluídas após o tempo determinado, mas substituídas por um texto estático."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, as mensagens efêmeras enviadas não são eliminadas após o prazo, mas substituídas por um texto estático."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При активации, исходящие эфемерные сообщения не удаляются по истечении срока действия, а заменяются статическим текстом."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "При активації, тимчасові вихідні повідомлення не видаляються після закінчення терміну їх дії, а замінюються статичним текстом."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，即使阅后即焚的消息过期，也不会被删除，而是会被替换为静态文本。"
          }
        }
      }
    },
