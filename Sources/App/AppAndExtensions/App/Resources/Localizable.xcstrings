    },
    "INVITATION_BODY_INVITE_SENT_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte warten Sie, bis %@ zustimmt, mit Ihnen zu chatten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please wait until %@ accepts to discuss with you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, espera a que %@ acepte hablar contigo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
