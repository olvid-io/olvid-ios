                  "value": "Ви успішно представили %2$@ користувачу %3$@."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "您已成功将 %2$@ 介绍给 %3$@ 及 %1$u 位其他联系人。"
                }
              },
              "zero": {
                "stringUnit": {
                  "state": "translated",
                  "value": "您已成功将 %2$@ 介绍给 %3$@。"
                }
              }
            }
          }
        }
      }
    },
    "Your are about to leave a group.": {
      "comment": "Explanation",
