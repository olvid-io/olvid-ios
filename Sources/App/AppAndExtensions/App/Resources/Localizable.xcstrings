    "MANUAL_BACKUP_EXPLANATION_FOOTER" : {
      "comment" : "Table view section footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ermöglicht die Erstellung eines verschlüsselten Backups Ihrer Kontakte, Gruppen und Einstellungen (Nachrichten und Anhänge werden nicht gesichert). Sie können dieses Backup entweder teilen (per E-Mail versenden, in Dateien speichern,...) oder direkt in iCloud hochladen. Keine Sorge, dieses Backup ist verschlüsselt 🔒."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allows to export an encrypted backup of your contacts, groups, and settings (messages and attachments are not backuped). You can either share it (email it, save it to Files,...) or upload it directely to iCloud. Do not worry, this backup is encrypted 😇."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite exportar una copia de seguridad encriptada de tus contactos, grupos y ajustes (los mensajes y archivos adjuntos no se respaldan). Puedes compartirla (por correo electrónico, guardarla en Archivos,...) o subirla directamente a iCloud. No te preocupes, esta copia de seguridad está encriptada 🔒."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet d'exporter une sauvegarde chiffrée de vos contacts, groupes et paramètres (les messages et pièces jointes ne sont pas sauvegardés). Vous pouvez la partager (l'envoyer par mail, la sauvegarder dans Fichiers, etc.) ou la sauvegarder directement vers iCloud. Ne vous en faites pas, cette sauvegarde est chiffrée 😇."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permette di esportare un backup crittografato dei tuoi contatti, gruppi e impostazioni (messaggi e allegati non vengono salvati). Puoi condividerlo (inviarlo via email, salvarlo su File,...) oppure caricarlo direttamente su iCloud. Non preoccuparti, questo backup è crittografato 🔒."
          }
        }
      }
    },
    "MANUAL_BACKUP_TITLE" : {
      "comment" : "Table view section header",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manuelles Backup"
          }
        },
        "en" : {
