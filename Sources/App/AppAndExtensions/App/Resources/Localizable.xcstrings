          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, os seus contactos serão notificados quando tiver lido as mensagens que receberam nesta conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
