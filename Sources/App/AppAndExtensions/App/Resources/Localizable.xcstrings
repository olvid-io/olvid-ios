          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativar esta opção, esta conversa será sugerida quando partilhar a partir de outra aplicação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы включите этот параметр, этот чат будет предложен при совместном использовании контента из других приложений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви активуєте цю опцію, цю дискусію буде запропоновано під час спільного доступу з іншого додатка."
