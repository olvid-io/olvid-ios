    "PLEASE_NOTE_THAT_YOUR_CUSTOM_PASSCODE_CANNOT_BE_RECOVERED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beachte, dass dein Zugangscode nicht wiederhergestellt werden kann, wenn du ihn vergisst, und du keinen Zugriff mehr auf Olvid haben wirst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please note that if you forget your passcode, it cannot be recovered and you won't be able to access Olvid anymore."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que si olvidas tu código de acceso, no se puede recuperar y no podrás acceder a Olvid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez noter que si vous oubliez votre code personnalisé, il ne sera pas possible de le récupérer, et vous ne pourrez plus accéder à Olvid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di notare che se dimentichi il tuo codice di accesso, non potrà essere recuperato e non potrai più accedere a Olvid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードを忘れると、パスコードを復元できなくなり、Olvidにアクセスできなくなる可能性があることにご注意ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호를 잊어버리면 복구할 수 없으며 Olvid에 더 이상 액세스할 수 없다는 점에 유의하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, tenha em mente que, se você esquecer sua senha, ela não poderá ser recuperada e você não poderá mais acessar o Olvid."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha em atenção que, caso se esqueça da sua senha, esta não poderá ser recuperada e não poderá mais aceder ao Olvid."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, обратите внимание, что если вы забудете свой пароль, его нельзя будет восстановить, и вы больше не сможете получить доступ к Olvid."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, зверніть увагу, що якщо ви забудете свій пароль, його не можна буде відновити, і ви не зможете більше отримати доступ до Olvid."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请注意，如果您忘记密码，将无法找回，并且您将无法再访问 Olvid。"
          }
        }
      }
    },
