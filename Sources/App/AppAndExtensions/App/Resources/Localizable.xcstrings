    "ATTACH_PREVIEW_LABEL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge eine Vorschau der von dir gesendeten Links hinzu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach a preview of links you send"
          }
