    "STD_MSG_OLVID_TAKES_TOO_LONG_TO_START" : {
      "comment" : "Body text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid scheint länger als gewöhnlich zu starten. Dies tritt typischerweise nach der Installation einer neuen Version auf. Seien Sie versichert, dass keine Ihrer Daten verloren gegangen sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid seems to take longer than usual to start. This typically occurs after installing a new version. Please be reassured, none of your data was lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid parece tardar más de lo habitual en iniciarse. Esto suele ocurrir después de instalar una nueva versión. Tenga la seguridad de que no se ha perdido ninguno de sus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid semble prendre plus de temps que d'habitude pour démarrer. Cela peut arriver après une mise à jour. Rassurez-vous, même si le problème persiste, aucune de vos données n'a été perdue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sembra che Olvid impieghi più tempo del solito per avviarsi. Questo si verifica in genere dopo aver installato una nuova versione. Ti assicuriamo che nessuno dei tuoi dati è andato perso."
          }
        }
      }
    },
