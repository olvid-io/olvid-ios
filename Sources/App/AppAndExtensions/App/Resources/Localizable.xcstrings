    "INVITATION_BODY_ONE_TO_ONE_INVITATION_RECEIVED_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie zustimmen, wird %@ zu Ihren Kontakten hinzugefügt und Sie können eine private Unterhaltung mit dieser Person führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you accept, %@ will be added to your contacts and you will have a private discussion with them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aceptas, %@ se añadirá a tus contactos y podrás tener una conversación privada con esa persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous acceptez, %@ fera partie de vos contacts et vous aurez une discussion privée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se accetti, %@ verrà aggiunto ai tuoi contatti e potrai avviare una conversazione privata con lui/lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認すると、%@ があなたの連絡先に登録され、非公開のチャットを開始できるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수락하시면 %@이(가) 연락처에 추가되고, 비공개 대화를 시작할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você aceitar, %@ será adicionado aos seus contatos e você poderá ter uma conversa privada com essa pessoa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aceitar, %@ será adicionado aos seus contactos e poderá iniciar uma conversa privada com essa pessoa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы подтвердите, %@ будет добавлен в ваши контакты, и вы сможете вести с ним личную переписку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви приймете, %@ буде додано до ваших контактів, і ви зможете вести з ним приватне спілкування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您同意，%@将被添加到您的联系人中，并且您将可以与他们进行私聊。"
          }
        }
      }
    },
    "INVITATION_BODY_ONE_TO_ONE_INVITATION_SENT_%@": {
