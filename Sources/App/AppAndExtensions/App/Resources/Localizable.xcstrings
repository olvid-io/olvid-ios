    "INVITATION_BODY_ACCEPT_INVITE_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du diese Einladung ignorierst, wird %@ nicht benachrichtigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you ignore this invitation, %@ won't be notified."
          }
        },
