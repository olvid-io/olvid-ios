    "DISABLE_AUTOCORRECTION_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Autokorrektur hilft beim Tippen, indem sie Rechtschreibfehler beim Schreiben von Nachrichten automatisch korrigiert und dabei das Wörterbuch Ihrer Tastatur verwendet. Hinweis: Diese Einstellung funktioniert nur, wenn die Autokorrektur in den Geräteeinstellungen aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto-Correction helps you type by automatically fixing spelling mistakes as you write messages, using your keyboard dictionary. Note: This setting only works if Auto-Correction is enabled in your device settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La corrección automática te ayuda a escribir corrigiendo automáticamente los errores ortográficos mientras redactas mensajes, usando el diccionario de tu teclado. Nota: este ajuste solo funciona si la corrección automática está activada en los ajustes del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La correction automatique vous aide à taper en corrigeant automatiquement les fautes d'orthographe lorsque vous rédigez des messages, en utilisant le dictionnaire de votre clavier. Remarque : ce réglage ne fonctionne que si la correction automatique est activée dans les réglages de votre appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La correzione automatica ti aiuta a digitare correggendo automaticamente gli errori di ortografia mentre scrivi messaggi, usando il dizionario della tastiera. Nota: questa impostazione funziona solo se la correzione automatica è abilitata nelle impostazioni del dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動修正機能は、キーボードの辞書を使ってメッセージの入力中に自動的にスペルミスを修正することで、タイピングを支援します。注：この設定は、デバイスの設定で自動修正が有効になっている場合にのみ機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 수정 기능은 키보드 사전의 단어를 사용하여 메시지를 입력할 때 자동으로 오타를 수정하여 입력하는 데 도움을 줍니다. 참고: 이 설정은 장치 설정에서 자동 수정이 활성화되어 있는 경우에만 작동합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A autocorreção ajuda você a digitar corrigindo automaticamente erros de ortografia enquanto você escreve mensagens, usando o dicionário do teclado. Nota: esta configuração só funciona se a autocorreção estiver ativada nas configurações do dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A autocorreção ajuda-o a escrever corrigindo automaticamente os erros ortográficos enquanto redige mensagens, utilizando o dicionário do teclado. Nota: esta definição só funciona se a autocorreção estiver ativada nas definições do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автокоррекция помогает при наборе текста, автоматически исправляя орфографические ошибки в сообщениях с помощью словаря клавиатуры. Примечание: этот параметр работает только если автокоррекция включена в настройках устройства."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автокорекція допомагає вводити текст, автоматично виправляючи орфографічні помилки під час написання повідомлень, використовуючи словник клавіатури. Примітка: цей параметр працює лише якщо автокорекцію увімкнено в налаштуваннях пристрою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动更正通过使用键盘词典自动修正拼写错误，帮助您在撰写消息时更流畅地输入。注意：此设置仅在设备设置中启用了自动更正时才有效。"
          }
        }
      }
    },
