    "MISSING_CHANNEL_FOR_CALL_MESSAGE_%@": {
      "comment": "Alert message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können %@ anrufen, sobald eine sichere Verbindung mit dieser Person hergestellt wurde. Bitte versuchen Sie es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will be able to call %@ once a secure channel is established with them. Please try again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrás llamar a %@ una vez que se haya establecido un canal seguro con esa persona. Por favor, inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez appeler %@ dès que le canal sécurisé sera établi. Veuillez essayer à nouveau plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrai chiamare %@ una volta stabilita una connessione sicura con lui/lei. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "相手との安全な通信回線が確立されれば、%@に電話をかけることができます。しばらくしてから再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상대방과의 보안 연결이 설정되면 %@에게 전화를 걸 수 있습니다. 잠시 후 다시 시도해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você poderá ligar para %@ assim que um canal de comunicação seguro for estabelecido. Por favor, tente novamente mais tarde."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Poderá efetuar chamadas para %@ assim que for estabelecido um canal de comunicação seguro com o contacto. Por favor, tente novamente mais tarde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы сможете позвонить %@, как только с ним будет установлено безопасное соединение. Пожалуйста, попробуйте еще раз позже."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви зможете зателефонувати %@, коли буде встановлено безпечний канал зв’язку з цією особою. Будь ласка, спробуйте ще раз пізніше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在与对方建立安全连接后，您就可以拨打 %@ 了。请稍后再试。"
          }
        }
      }
    },
    "MISSING_CHANNEL_FOR_CALL_TITLE_%@": {
      "comment": "Alert title",
      "localizations": {
