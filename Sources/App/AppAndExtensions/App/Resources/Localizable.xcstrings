    "If you wish, you can help the development team by tapping the button below. This will share (only) the above message with them." : {
      "comment" : "Body text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du möchtest, kannst du dem Entwicklungsteam helfen, indem du auf die Schaltfläche unten tippst. Dadurch wird (nur) die folgende Nachricht mit ihnen geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you wish, you can help the development team by tapping the button below. This will share (only) the following message with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si lo deseas, puedes ayudar al equipo de desarrollo pulsando el botón de abajo. Esto compartirá (solo) el siguiente mensaje con ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous le désirez, vous pouvez aider l'équipe de développement via la bouton ci-dessous. Vous partagerez (uniquement) le message encadré ci-dessous avec elle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se lo desideri, puoi aiutare il team di sviluppo toccando il pulsante sottostante. In questo modo verrà condivicato (solo) il seguente messaggio con loro."
          }
        }
      }
    },
