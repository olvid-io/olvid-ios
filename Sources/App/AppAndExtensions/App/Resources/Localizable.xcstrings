    "USE_ALTERNATIVE_TURN_SERVERS_FOOTER_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivieren Sie diese Option, um TURN-Server mit rotierenden IP-Adressen zu verwenden. Wenn Sie sich nicht sicher sind, lassen Sie diese Option deaktiviert 😁."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activate this option to use TURN servers with rotating IP addresses. If unsure, keep this option off 😁."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Active esta opción para usar servidores TURN con direcciones IP rotativas. Si no está seguro, deje esta opción desactivada 😁."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez cette option pour utiliser des serveurs TURN avec des adresses IP tournantes. Si vous n'êtes pas sûr de vous, gardez cette option inactive 😁."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva questa opzione per utilizzare i server TURN con indirizzi IP variabili. Se non sei sicuro, lascia questa opzione disattivata 😁."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオプションを有効にすると、IPアドレスがローテーションされるTURNサーバーを使用できます。不明な場合は、このオプションをオフにしてください。😁"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 활성화하면 IP 주소가 변경되는 TURN 서버를 사용합니다. 확실하지 않은 경우 이 옵션을 끄세요. 😅"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative esta opção para usar servidores TURN com endereços IP rotativos. Se não tiver certeza, mantenha esta opção desativada. 🧐"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative esta opção para usar servidores TURN com endereços IP rotativos. Se não tiver a certeza, mantenha esta opção desativada. 🧐"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активируйте эту опцию, чтобы использовать TURN-серверы с вращающимися IP-адресами. Если вы не уверены, оставьте эту опцию отключенной 🤷‍♀️."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть цю опцію, щоб використовувати TURN-сервери з IP-адресами, що змінюються. Якщо ви не впевнені, залиште цю опцію вимкненою ☝️."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此选项以使用具有轮换 IP 地址的 TURN 服务器。如果不确定，请保持此选项关闭 😁。"
          }
        }
      }
    },
