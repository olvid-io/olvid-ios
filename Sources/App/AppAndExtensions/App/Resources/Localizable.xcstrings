    "ALERT_SHOULD_ACTIVATE_SCREEN_LOCK_AFTER_CREATING_HIDDEN_PROFILE_ACTION_GOTO_PRIVACY_SETTINGS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehe zu den Datenschutzeinstellungen"
          }
        },
        "en": {
          "stringUnit": {
