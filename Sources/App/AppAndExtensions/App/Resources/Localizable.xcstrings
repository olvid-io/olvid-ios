    "ALERT_CHOOSE_HIDDEN_PROFILE_CLOSE_POLICY_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte wähle aus, wann ein geöffnetes Profil geschlossen werden soll. Standardmäßig werden ausgeblendete Profile geschlossen, wenn du manuell zu einem anderen Profil wechselst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please choose when an open profile should be closed. By default, hidden profiles will be closed when manually switching to another profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, elige cuándo se debe cerrar un perfil abierto. Por defecto, los perfiles ocultos se cerrarán al cambiar manualmente a otro perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez choisir le bon moment pour fermer un profil masqué. Par défaut, un profil masqué est fermé quand vous basculez manuellement vers un autre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli per quanto tempo mantenere aperto un profilo. Di default, i profili nascosti verranno chiusi quando si passa manualmente a un altro profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているプロファイルがいつ閉じられるかを設定してください。デフォルトでは、手動で別のプロファイルに切り替えたときに、非表示のプロファイルが閉じられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 프로필이 언제 닫혀야 하는지 선택하세요. 기본적으로 숨겨진 프로필은 다른 프로필로 수동으로 전환할 때 닫힙니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, escolha quando um perfil aberto deve ser fechado. Por padrão, os perfis ocultos serão fechados quando você mudar manualmente para outro perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, escolha quando um perfil aberto deve ser fechado. Por defeito, os perfis ocultos serão fechados quando mudar manualmente para outro perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, выберите, когда должен закрываться открытый профиль. По умолчанию, скрытые профили будут закрываться при ручном переключении на другой профиль."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, оберіть, коли потрібно закривати відкритий профіль. За замовчуванням, приховані профілі будуть закриватися при ручному перемиканні на інший профіль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择公开资料应在何时关闭。默认情况下，当手动切换到其他资料时，隐藏的资料将会关闭。"
          }
        }
      }
    },
    "ALERT_CHOOSE_HIDDEN_PROFILE_CLOSE_POLICY_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann ein geöffnetes verstecktes Profil schließen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When to close an open hidden profile?"
          }
        },
        "es": {
