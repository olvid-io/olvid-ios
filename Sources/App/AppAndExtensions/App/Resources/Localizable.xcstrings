    "Archived discussions are unarchived when a notification is received.": {
      "comment": "Explanation",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Konversation wird automatisch wiederhergestellt, wenn in dieser Konversation eine Benachrichtigung empfangen wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived discussion will be automatically unarchived when a notification is received in this discussion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversación archivada se desarchivará automáticamente cuando se reciba una notificación en esta conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion archivée sera automatiquement désarchivée lors de la réception d’une notification dans cette discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una discussione archiviata verrà automaticamente riattivata quando si riceverà una notifica in questa discussione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブされたチャットで通知を受信すると、自動的にアーカイブが解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 대화에서 알림이 수신되면 자동으로 보관 해제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa arquivada será automaticamente desarquivada quando uma notificação for recebida nessa conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa arquivada será automaticamente desarquivada quando uma notificação for recebida nessa conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заархивированная переписка будет автоматически разархивирована при получении уведомления в этой переписке."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заархівована дискусія буде автоматично розархівована, коли буде отримано сповіщення в цій дискусії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当此对话收到通知时，已归档的对话将自动取消归档。"
          }
        }
      }
    },
    "Archived discussions remains archived even though a notification is received.": {
      "comment": "Explanation",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Konversation bleibt archiviert, bis Sie sie manuell wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An archived discussion stay archived until you decide to manually unarchive it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una conversación archivada permanecerá archivada hasta que decidas desarchivarla manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion archivée reste archivée jusqu'à ce que vous décidiez de la désarchiver manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una discussione archiviata rimane archiviata finché non decidi di ripristinarla manualmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブされたチャットは、手動でアーカイブ解除するまでアーカイブされたままになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보관된 대화는 사용자가 직접 보관 해제하기로 결정할 때까지 보관 상태로 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa arquivada permanece arquivada até que você decida desativar o arquivo manualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma conversa arquivada permanece arquivada até que decida reativá-la manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заархивированный диалог останется заархивированным, пока вы не решите вручную его разархивировать."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заархівована дискусія залишатиметься заархівованою, доки ви не розархівуєте її вручну."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已归档的对话将保持归档状态，直到您手动将其取消归档为止。"
          }
        }
      }
    },
    "Attachments smaller than %@ will be automatically downloaded. Larger attachments will require manual download.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge kleiner als %@ werden automatisch heruntergeladen. Größere Anhänge erfordern einen manuellen Download."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachments smaller than %@ will be automatically downloaded. Larger attachments will require manual download."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos adjuntos menores a %@ se descargarán automáticamente. Los archivos adjuntos más grandes requerirán una descarga manual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pièces jointes de taille inférieure à %@ seront téléchargées automatiquement. Les pièces jointes de plus grande taille devront être téléchargées manuellement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli allegati più piccoli di %@ verranno scaricati automaticamente. Gli allegati più grandi richiederanno il download manuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "添付ファイルが %@ より小さい場合、自動的にダウンロードされます。それより大きい添付ファイルは、手動でダウンロードする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@보다 작은 첨부 파일은 자동으로 다운로드됩니다. 더 큰 첨부 파일은 수동으로 다운로드해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexos menores que %@ serão baixados automaticamente. Anexos maiores exigirão o download manual."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexos com tamanho inferior a %@ serão automaticamente descarregados. Anexos maiores necessitarão de um download manual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вложения размером менее %@ будут скачиваться автоматически. Для более крупных вложений потребуется ручная загрузка."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкладення розміром менше ніж %@ будуть завантажуватися автоматично. Для більших вкладень знадобиться ручне завантаження."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小于 %@ 的附件将自动下载。较大的附件需要手动下载。"
          }
        }
      }
    },
