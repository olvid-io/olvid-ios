    "SHARE_MSG_OLVID_TAKES_TOO_LONG_TO_START" : {
      "comment" : "Body text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn das Problem weiterhin besteht, können Sie dem Entwicklungsteam helfen, indem Sie auf die Schaltfläche unten tippen. Dadurch wird (nur) die folgende Nachricht mit ihnen geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If the problem persists, you can help the development team by tapping the button below. This will share (only) the following message with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si el problema persiste, puedes ayudar al equipo de desarrollo tocando el botón de abajo. Esto compartirá (solo) el siguiente mensaje con ellos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si le problème persiste, vous pouvez aider l'équipe de développement à résoudre votre problème via la bouton ci-dessous. Vous partagerez (uniquement) le message encadré ci-dessous avec elle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se il problema persiste, puoi aiutare il team di sviluppo toccando il pulsante qui sotto. Questo condividerà (solo) il messaggio seguente con loro."
          }
        }
      }
    },
