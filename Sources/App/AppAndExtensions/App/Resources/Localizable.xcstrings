    "LOCKED_OUT_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid ist aufgrund zu vieler falscher Passcode-Versuche gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid is locked following too many wrong passcode attempts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid está bloqueado tras demasiados intentos fallidos de código de acceso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid est verrouillée suite à la saisie d'un nombre trop important de mauvais codes."
          }
