    "DOWNLOAD_MISSING_PROFILE_PICTURES_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie glauben, dass bestimmte Profilbilder fehlen (für Kontakte, Gruppen oder Ihre eigenen Profile), können Sie versuchen, sie (neu) herunterzuladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you believe that certain profile pictures are missing (for contacts, groups, or your own profiles), you may try to (re)download them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si crees que faltan ciertas fotos de perfil (de contactos, grupos o tu propio perfil), puedes intentar (re)descargarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous pensez que certaines photos de profils sont manquantes (que ce soit pour vos contacts, groupes ou profils personnels), vous pouvez essayer de les télécharger à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ritieni che alcune immagini del profilo manchino (per i contatti, i gruppi o i tuoi profili), puoi provare a (ri)scaricarle."
          }
        }
      }
    },
