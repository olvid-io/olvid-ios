    },
    "Olvid is not authorized to access your location due to active restrictions such as parental controls or MDM settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid ist nicht autorisiert, auf Ihren Standort zuzugreifen, da aktive Einschränkungen wie Kindersicherung oder MDM-Einstellungen vorliegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid is not authorized to access your location due to active restrictions such as parental controls or MDM settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid no está autorizado a acceder a tu ubicación debido a restricciones activas, como controles parentales o configuraciones de MDM."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid n'a pas l'autorisation d'accéder à votre position à cause d’une restriction parentale ou des paramètres imposés par un MDM."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid non è autorizzato ad accedere alla tua posizione a causa di restrizioni attive come controlli parentali o impostazioni MDM."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなペアレンタルコントロールやMDM設定などの制限により、Olvidは現在、お客様の位置情報にアクセスすることができません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 상태의 제한(예: 자녀 보호 기능 또는 MDM 설정)으로 인해 Olvid가 사용자의 위치 정보에 액세스할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid não tem permissão para acessar sua localização devido a restrições ativas, como controles parentais ou configurações de MDM."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid não tem permissão para aceder à sua localização devido a restrições ativas, como controlos parentais ou definições de MDM."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не имеет доступа к вашему местоположению из-за активных ограничений, таких как родительский контроль или настройки MDM."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не має дозволу на доступ до вашого місцезнаходження через активні обмеження, такі як батьківський контроль або налаштування MDM."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于启用了家长控制或 MDM 设置等限制，Olvid 无法访问您的位置信息。"
          }
        }
      }
    },
