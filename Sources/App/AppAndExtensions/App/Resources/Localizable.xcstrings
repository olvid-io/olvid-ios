    "DELETE_THIS_IDENTITY_QUESTION_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Löschen dieses Profils werden alle damit verbundenen Informationen von Ihrem Gerät gelöscht. Dazu gehören die Kontakte, Gruppen und der Inhalt aller Ihrer Diskussionen (Nachrichten und Anhänge) für dieses Profil. Ihre anderen Profile werden von dieser Operation nicht betroffen sein.\nWenn Sie Backups in Olvid aktiviert haben, werden zukünftige Backups keine Informationen mehr über dieses Profil enthalten und Sie können es nicht wiederherstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting this profile will delete any information related to it from your device. This includes the contacts, groups, and the content of all your discussions (messages and attachments) for this profile. Your other profiles will not be affected by this operation.\nIf you have enabled backups in Olvid, your future backups will not contain any trace of this profile and you will not be able to restore it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar este perfil eliminará cualquier información relacionada de tu dispositivo. Esto incluye los contactos, grupos y el contenido de todas tus conversaciones (mensajes y archivos adjuntos) para este perfil. Tus otros perfiles no se verán afectados por esta operación.\nSi has habilitado las copias de seguridad en Olvid, tus futuras copias de seguridad no contendrán ningún rastro de este perfil y no podrás restaurarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer un profil effacera toute information associée à ce profil de votre appareil. Cela inclut vos contacts, vos groupes et le contenu de toutes vos discussions pour ce profil. Vos autres profils ne seront pas affectés par cette opération.\nSi vous avez activé les sauvegardes Olvid, vos futures sauvegardes ne contiendront aucune trace de ce profil et vous ne serez pas en mesure de le restaurer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminando questo profilo, verranno cancellate tutte le informazioni ad esso correlate dal tuo dispositivo. Questo include i contatti, i gruppi e il contenuto di tutte le tue conversazioni (messaggi e allegati) per questo profilo. Gli altri tuoi profili non saranno interessati da questa operazione.\nSe hai abilitato i backup in Olvid, i tuoi futuri backup non conterranno alcuna traccia di questo profilo e non sarà possibile ripristinarlo."
          }
        }
      }
    },
    "DELETE_THIS_IDENTITY_QUESTION_TITLE_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil \"%@\" löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete the profile \"%@\"?"
          }
        },
        "es" : {
