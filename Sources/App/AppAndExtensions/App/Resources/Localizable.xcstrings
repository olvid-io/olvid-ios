    "DIALOG_MESSAGE_OUTDATED_VERSION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Olvid-Version ist veraltet und muss aktualisiert werden.\n\nSie verpassen möglicherweise viele neue Funktionen und wir können die Kompatibilität Ihrer Version mit neueren Versionen der App, die Ihre Kontakte verwenden, nicht garantieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your version of Olvid is outdated and needs to be updated.\n\nYou are probably missing out on many new features and we cannot guarantee the compatibility of your version with newer versions of the app that your contacts may use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu versión de Olvid está desactualizada y necesita ser actualizada.\n\nProbablemente te estés perdiendo muchas funciones nuevas y no podemos garantizar la compatibilidad de tu versión con versiones más recientes de la aplicación que puedan usar tus contactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre version d'Olvid est dépassée et doit être mise à jour.\n\nVous passez probablement à côté de nombreuses nouvelles fonctionnalités et nous ne pouvons pas vous garantir la compatibilité de votre version avec les versions plus récentes utilisées par vos contacts."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua versione di Olvid è obsoleta e necessita di un aggiornamento.\n\nPotresti perdere molte nuove funzionalità e non possiamo garantire la compatibilità della tua versione con le versioni più recenti dell'app utilizzate dai tuoi contatti."
          }
        }
      }
    },
    "DIALOG_MISSING_MESSAGES_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Indikator für fehlende Nachrichten zeigt an, dass eine Lücke in der Nummerierung der von Ihrem Kontakt empfangenen Nachrichten festgestellt wurde.\n\nDies kann entweder bedeuten, dass das Senden einer Nachricht abgebrochen wurde (die Nachricht wird Sie nicht erreichen), oder dass eine größere Nachricht (typischerweise mit Anhang) noch nicht vollständig hochgeladen wurde (Sie sollten sie bald erhalten)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This missing message indicator tells you that a gap was detected in the numbering sequence of messages received from your contact.\n\nThis can either be that the sending of a message was cancelled (the message will never reach you), or that a larger message (typically with attachment) has not finished uploading yet (you should receive it soon)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este indicador de mensaje faltante te informa que se detectó un hueco en la secuencia de numeración de los mensajes recibidos de tu contacto.\n\nEsto puede deberse a que el envío de un mensaje fue cancelado (el mensaje nunca te llegará) o a que un mensaje más grande (normalmente con un archivo adjunto) aún no ha terminado de subirse (deberías recibirlo pronto)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet indicateur de message manquant vous prévient qu'un trou a été détecté dans la séquence de numérotation des messages reçus de votre contact.\n\nCeci est soit dû à l'annulation d'envoi d'un message (vous ne recevrez jamais ce message), soit à l'envoi d'un message plus gros (en général, avec des pièces jointes) qui n'a pas encore été entièrement déposé sur le serveur (vous devriez le recevoir prochainement)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo indicatore di messaggio mancante ti avvisa che è stata rilevata un'interruzione nella sequenza numerica dei messaggi ricevuti dal tuo contatto.\n\nQuesto può significare che l'invio di un messaggio è stato annullato (il messaggio non ti arriverà mai), oppure che un messaggio più grande (solitamente con allegato) non ha ancora terminato il caricamento (dovresti riceverlo a breve)."
          }
        }
      }
    },
    "DIALOG_MISSING_MESSAGES_TITLE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlende Nachrichten"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
