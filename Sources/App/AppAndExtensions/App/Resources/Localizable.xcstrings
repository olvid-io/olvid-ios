    "ALERT_VOICE_MESSAGE_FAILED_USER_DENIED_RECORDING": {
      "comment": "Alert message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine Sprachnachricht aufzunehmen, muss Olvid Zugriff auf das Mikrofon haben. Öffne die Einstellungen und aktiviere das Mikrofon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To record a voice message, you need to allow Olvid to access the microphone. Open Settings and turn on the Microphone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para grabar un mensaje de voz, necesitas permitir que Olvid acceda al micrófono. Abre Ajustes y activa el Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour enregistrer un message vocal, vous devez autoriser Olvid à accéder au micro. Allez dans les Réglages et activez le Micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per registrare un messaggio vocale, devi permettere a Olvid di accedere al microfono. Apri Impostazioni e attiva il Microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイスメッセージを録音するには、Olvid がマイクにアクセスできるようにする必要があります。設定を開いて、マイクをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메시지를 녹음하려면 Olvid가 마이크에 접근할 수 있도록 허용해야 합니다. 설정을 열고 마이크를 켜주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar uma mensagem de voz, você precisa permitir que o Olvid acesse o microfone. Abra as Configurações e ative o Microfone."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para gravar uma mensagem de voz, precisa de autorizar o Olvid a aceder ao microfone. Abra as Definições e ative o Microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для записи голосового сообщения Olvid необходимо разрешение на доступ к микрофону. Откройте Настройки и включите Микрофон."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб записати голосове повідомлення, Olvid потрібно надати доступ до мікрофона. Відкрийте Налаштування та увімкніть Мікрофон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要录制语音消息，您需要允许 Olvid 访问麦克风。请打开“设置”并启用“麦克风”"
          }
        }
      }
    },
