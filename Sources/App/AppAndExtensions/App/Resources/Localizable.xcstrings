    "Notifications" : {
      "comment" : "Notifications word, capitalized",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notificaciones"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifiche"
          }
        }
      }
    },
    "Notifications will not preview any message content nor any invitation content. Instead, they will display the number of new messages as well as the number of new invitations." : {
      "comment" : "Cell label",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen zeigen keinen Nachrichteninhalt oder Einladungsinhalt vor. Es wird jedoch möglich sein, zwischen einer neuen Nachrichtenbenachrichtigung und einer neuen Einladung zu unterscheiden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications will not preview any message content nor any invitation content. It will be possible to distinguish between a new message notification and new invitation notification."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones no mostrarán el contenido de ningún mensaje ni invitación. Será posible distinguir entre una notificación de nuevo mensaje y una notificación de nueva invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications n'afficheront pas le contenu des nouveaux messages ni des nouvelles invitations. Il sera néanmoins possible de distinguer une notification de nouveau message d'une notification de nouvelle invitation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche non mostreranno anteprime del contenuto dei messaggi né del contenuto degli inviti. Sarà possibile distinguere tra una notifica di nuovo messaggio e una notifica di nuovo invito."
          }
        }
      }
    },
    "Notifications will not provide any information about messages nor invitations. A minimal static notification will show to indicate that Olvid requires your attention." : {
      "comment" : "Cell label",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen liefern keine Informationen über Nachrichten oder Einladungen. Eine minimale statische Benachrichtigung wird angezeigt, um darauf hinzuweisen, dass Olvid Ihre Aufmerksamkeit benötigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications will not provide any information about messages nor invitations. A minimal static notification will show to indicate that Olvid requires your attention."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones no proporcionarán ninguna información sobre mensajes o invitaciones. Se mostrará una notificación estática mínima para indicar que Olvid requiere tu atención."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications n'afficheront aucune information concernant les messages ou les invitations. À la place, elles afficheront un texte standard indiquant qu'Olvid requiert votre attention."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche non forniranno alcuna informazione sui messaggi o sugli inviti. Verrà mostrata una notifica statica minima per indicare che Olvid richiede la tua attenzione."
          }
        }
      }
    },
    "Notifications will preview new messages and new invitations content." : {
      "comment" : "Cell label",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Benachrichtigungen zeigen Vorschauen neuer Nachrichten und Einladungen an."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notifications will preview new messages and new invitations content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones mostrarán una vista previa de los nuevos mensajes y del contenido de las nuevas invitaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notifications afficheront une prévisualisation du contenu des nouveaux messages ainsi que des nouvelles invitations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le notifiche mostreranno un'anteprima dei nuovi messaggi e del contenuto dei nuovi inviti."
          }
        }
      }
    },
