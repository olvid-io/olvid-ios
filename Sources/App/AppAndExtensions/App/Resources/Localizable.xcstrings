          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 지정된 시간보다 오래된 메시지가 이 대화에서 정기적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
