    "CANNOT_FETCH_LATEST_UPLOAD": {
      "comment": "Table view section footer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neuesten Uploads konnten nicht abgerufen werden. Möglicherweise müssen Sie Ihr iCloud-Konto konfigurieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot fetch latest upload. You might need to configure your iCloud account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo obtener la última carga. Es posible que debas configurar tu cuenta de iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de récuperer la dernière sauvegarde. Avez-vous bien configuré iCloud ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile recuperare l'ultimo caricamento. Potrebbe essere necessario configurare il tuo account iCloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最新のアップロードを取得できません。iCloudアカウントの設定が必要な場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최신 업로드를 가져올 수 없습니다. iCloud 계정을 구성해야 할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível buscar o upload mais recente. Você pode precisar configurar sua conta iCloud."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível obter o upload mais recente. Poderá precisar de configurar a sua conta iCloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить последние загруженные файлы. Возможно, вам потребуется настроить свою учетную запись iCloud."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося отримати останнє завантаження. Можливо, вам потрібно налаштувати ваш обліковий запис iCloud."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取最新的上传内容。您可能需要配置您的 iCloud 帐户。"
          }
        }
      }
    },
