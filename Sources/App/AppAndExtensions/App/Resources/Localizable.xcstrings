    "Archived discussions are unarchived when a notification is received." : {
      "comment" : "Explanation",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine archivierte Konversation wird automatisch wiederhergestellt, wenn in dieser Konversation eine Benachrichtigung empfangen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An archived discussion will be automatically unarchived when a notification is received in this discussion."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una conversación archivada se desarchivará automáticamente cuando se reciba una notificación en esta conversación."
