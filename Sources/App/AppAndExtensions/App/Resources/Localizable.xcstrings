    "INVITATION_BODY_ACCEPT_MEDIATOR_INVITE_%@_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ möchte Ihnen %2$@ vorstellen. Wenn Sie zustimmen, wird %2$@ zu Ihren Kontakten hinzugefügt und Sie können eine private Unterhaltung mit ihm/ihr führen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ would like to introduce you to %2$@. If you accept, %2$@ will be part of your contacts and you will have a private discussion with them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ le gustaría presentarte a %2$@. Si aceptas, %2$@ se añadirá a tus contactos y podrás tener una conversación privada con él/ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aimerait vous présenter à %2$@. Si vous acceptez, %2$@ fera partie de vos contacts et vous aurez une discussion privée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ vorrebbe presentarti %2$@. Se accetti, %2$@ verrà aggiunto ai tuoi contatti e potrai avere una conversazione privata con lui/lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ が %2$@ さんをご紹介します。承認すると、%2$@ さんがあなたの連絡先に加わり、プライベートな会話ができるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 님이 %2$@ 님을 소개해 드립니다. 수락하시면 %2$@ 님이 연락처에 추가되고, 두 분은 개인적인 대화를 나눌 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gostaria de apresentar você a %2$@. Se você aceitar, %2$@ fará parte dos seus contatos e vocês poderão ter uma conversa particular."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ gostaria de apresentar-lhe %2$@. Se aceitar, %2$@ fará parte dos seus contactos e poderão ter uma conversa privada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ хочет познакомить вас с %2$@. Если вы примите, %2$@ будет добавлен в ваши контакты, и вы сможете вести с ним личную переписку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ хотів би познайомити вас із %2$@. Якщо ви приймете, %2$@ буде доданий до ваших контактів, і ви зможете обговорювати з ним/нею особисті питання."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 想向您介绍 %2$@。如果您同意，%2$@ 将会成为您的联系人，并且你们可以进行私聊。"
          }
        }
      }
    },
