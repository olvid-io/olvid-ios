    "HIDE_GROUP_MEMBER_CHANGE_MESSAGES_CELL_SUBTITLE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, werden Nachrichten, die angeben, dass ein Gruppenmitglied einer Gruppe beigetreten oder diese verlassen hat, in Ihren Diskussionen nicht angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When activated, messages indicating that a group member joined or left a group will not be displayed in your discussions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se activa, los mensajes que indican que un miembro se unió o abandonó un grupo no se mostrarán en tus conversaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une fois cette option activée, les messages indiquant qu'un membre à rejoint ou quitté un groupe ne seront plus affichés dans vos discussions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando attivata, i messaggi che indicano l'entrata o l'uscita di un membro dal gruppo non verranno visualizzati nelle tue conversazioni."
          }
        }
      }
    },
    "HIDE_GROUP_MEMBER_CHANGE_MESSAGES_CELL_TITLE" : {
      "localizations" : {
        "de" : {
