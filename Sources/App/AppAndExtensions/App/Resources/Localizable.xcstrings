          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez attendre que %@ accepte de discuter avec vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attendere prego finché %@ non accetta di discutere con lei."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ があなたとのチャットに同意するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 님이 대화 요청을 수락할 때까지 기다려 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, aguarde até que %@ aceite conversar com você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, aguarde até que %@ aceite conversar consigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, подождите, пока %@ примет ваше приглашение к обсуждению."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, зачекайте, поки %@ прийме вашу пропозицію обговорити це з вами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍等，等待%@同意与您进行讨论。"
          }
        }
      }
    },
    "INVITATION_BODY_MEDIATOR_INVITE_ACCEPTED_%@_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast akzeptiert, von %1$@ mit %2$@ bekannt gemacht zu werden. Bitte warte, bis %2$@ diese Einladung ebenfalls annimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You accepted to be introduced to %2$@ by %1$@. Please wait until %2$@ also accepts this invitation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptaste ser presentado a %2$@ por %1$@. Por favor, espera hasta que %2$@ también acepte esta invitación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez accepté la présentation de %1$@. Veuillez attendre que %2$@ l'accepte également."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai accettato di essere presentato a %2$@ da %1$@. Attendi che anche %2$@ accetti questo invito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@が%2$@との紹介を依頼しました。%2$@がこの招待を承諾するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@님이 %2$@님을 소개해 드리는 것에 동의했습니다. %2$@님도 이 초대를 수락할 때까지 기다려 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você aceitou ser apresentado a %2$@ por %1$@. Por favor, aguarde até que %2$@ também aceite este convite."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceitou que %1$@ o apresente a %2$@. Aguarde até que %2$@ também aceite este convite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы согласились, чтобы вас представили %2$@ от имени %1$@. Пожалуйста, подождите, пока %2$@ также примет это приглашение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви погодилися на знайомство з %2$@ від %1$@. Будь ласка, зачекайте, поки %2$@ також прийме це запрошення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已同意由 %1$@ 介绍您与 %2$@ 建立联系。请等待 %2$@ 也接受此邀请。"
          }
        }
      }
    },
