    "The core you entered is incorrect. The code you need to enter is the one displayed on your contact's device." : {
      "comment" : "Message of an alert",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der eingegebene Code ist falsch. Der Code, den Sie eingeben müssen, wird auf dem Gerät Ihres Kontakts angezeigt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The code you entered is incorrect. The one you need to enter is the displayed on your contact's device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El código que ingresaste es incorrecto. El código que necesitas ingresar es el que se muestra en el dispositivo de tu contacto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le code que vous avez entré est incorrect. Celui que vous devez entrer est affiché sur l'écran de votre contact."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il codice inserito non è corretto. Quello che devi inserire è quello visualizzato sul dispositivo del tuo contatto."
          }
        }
      }
    },
    "The scanned identity is already part of your trusted contacts 🙌. Do you still wish to proceed?" : {
      "comment" : "Alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gescannte Identität ist bereits Teil Ihrer vertrauenswürdigen Kontakte 🤝. Möchten Sie trotzdem fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The scanned identity is already part of your trusted contacts 🙌. Do you still wish to proceed?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La identidad escaneada ya forma parte de tus contactos de confianza 🤝. ¿Deseas continuar de todos modos?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'identité scannée fait déjà partie de vos contacts 🙌. Voulez-vous quand même poursuivre ?"
          }
        },
