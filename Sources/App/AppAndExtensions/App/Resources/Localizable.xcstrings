    "LOCKOUT_CLEAN_EPHEMERAL_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, führt das dreimalige Eingeben eines falschen Passcodes hintereinander dazu, dass alle einmal gelesenen und mit eingeschränkter Sichtbarkeit versehenen Nachrichten geräuschlos gelöscht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When activated, entering a wrong passcode 3 times in a row will silently erase all read once and limited visibility messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se activa, ingresar un código de acceso incorrecto 3 veces seguidas borrará silenciosamente todos los mensajes de lectura única y de visibilidad limitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand cette option est activée, saisir 3 mauvais codes d'affilée entraîne l'effacement silencieux de tous les messages à visibilité limitée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando attivata, inserire un codice di accesso errato per 3 volte consecutive cancellerà silenziosamente tutti i messaggi visualizzati una sola volta e con visibilità limitata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を有効にすると、パスコードを連続して3回間違えると、一度だけ表示されるメッセージや、閲覧制限のあるメッセージがすべて削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능이 활성화되면, 잘못된 비밀번호를 연속으로 3번 입력하면 읽은 메시지와 제한된 가시성 메시지가 모두 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, inserir uma senha incorreta três vezes seguidas apagará silenciosamente todas as mensagens de leitura única e de visibilidade limitada."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, introduzir um código de acesso incorreto 3 vezes seguidas irá apagar silenciosamente todas as mensagens de visualização única e de visibilidade limitada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При активации, ввод неверного пароля три раза подряд приведет к беззвучному удалению всех сообщений, прочитанных один раз, и сообщений с ограниченной видимостью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнення цієї функції призведе до беззвучного видалення всіх повідомлень, які можна прочитати лише один раз або мають обмежену видимість, після трьох неправильних спроб введення пароля поспіль."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此功能后，连续三次输入错误的密码，将会静默删除所有已读一次和有限可见性的消息。"
          }
        }
      }
    },
    "LOCKOUT_CLEAN_EPHEMERAL_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sensible Nachrichten nach 3 falschen Passcode-Versuchen löschen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erase sensitive messages after 3 bad passcode attempts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrar mensajes confidenciales después de 3 intentos fallidos de código de acceso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effacer les messages sensibles après 3 mauvais codes"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella i messaggi sensibili dopo 3 tentativi di passcode errati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスコードを3回間違えると、機密性の高いメッセージが削除されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘못된 비밀번호를 3번 입력하면 민감한 메시지를 삭제합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague as mensagens confidenciais após 3 tentativas incorretas de código"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Apague as mensagens confidenciais após 3 tentativas incorretas de código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить конфиденциальные сообщения после 3 неудачных попыток ввода пароля"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалити конфіденційні повідомлення після 3 невдалих спроб введення пароля"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在连续三次密码输入错误后，清除敏感信息"
          }
        }
      }
    },
