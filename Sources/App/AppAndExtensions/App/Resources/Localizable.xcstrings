          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando chiudere un profilo nascosto aperto?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示になっているプロフィールをいつ閉じるか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨겨진 프로필을 언제 닫아야 할까요?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando fechar um perfil oculto aberto?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando encerrar um perfil oculto que está aberto?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда закрыть открытый скрытый профиль?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли закрити відкритий прихований профіль?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在什么情况下关闭已打开的隐藏资料？"
          }
        }
      }
    },
    "ALERT_FIRST_ARCHIVE_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie, dass ein Gespräch automatisch wiederhergestellt wird, wenn eine Benachrichtigung eintrifft?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you want discussion to be unarchived automatically when a notification occurs?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quieres que la conversación se desarchive automáticamente cuando se reciba una notificación?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous que la discussion soit désarchivée automatiquement lorsqu’une notification est émise?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi che la discussione venga automaticamente riattivata quando arriva una notifica?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知があったときに、自動的にアーカイブを解除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 발생하면 대화를 자동으로 보관 해제하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você quer que a conversa seja automaticamente removida do arquivo quando uma notificação for recebida?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Deseja que a conversa seja automaticamente removida dos arquivos quando for recebida uma notificação?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хотите ли вы, чтобы дискуссия автоматически извлекалась из архива при получении уведомления?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чи бажаєте ви автоматично розблокувати обговорення, коли з’явиться сповіщення?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当收到通知时，您希望聊天记录是否自动取消存档？"
          }
        }
      }
    },
