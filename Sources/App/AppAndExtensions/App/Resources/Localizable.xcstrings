    },
    "INVITATION_BODY_ACCEPT_MEDIATOR_INVITE_%@_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ möchte Ihnen %2$@ vorstellen. Wenn Sie zustimmen, wird %2$@ zu Ihren Kontakten hinzugefügt und Sie können eine private Unterhaltung mit ihm/ihr führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ would like to introduce you to %2$@. If you accept, %2$@ will be part of your contacts and you will have a private discussion with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ le gustaría presentarte a %2$@. Si aceptas, %2$@ se añadirá a tus contactos y podrás tener una conversación privada con él/ella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ aimerait vous présenter à %2$@. Si vous acceptez, %2$@ fera partie de vos contacts et vous aurez une discussion privée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ vorrebbe presentarti %2$@. Se accetti, %2$@ verrà aggiunto ai tuoi contatti e potrai avere una conversazione privata con lui/lei."
          }
        }
      }
    },
    "INVITATION_BODY_FREEZE_GROUP_V2_INVITE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte warten Sie, während die Gruppe aktualisiert wird..."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please wait while the group is updated..."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, espere mientras se actualiza el grupo..."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez attendre pendant que le groupe est mis à jour..."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendere prego mentre il gruppo viene aggiornato..."
          }
        }
      }
    },
    "INVITATION_BODY_INVITATION_ACCEPTED_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte warte, bis %@ wieder online ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please wait until %@ is back online."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, espera hasta que %@ vuelva a estar en línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez attendre que %@ se connecte à nouveau..."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si prega di attendere finché %@ non torna online."
          }
        }
