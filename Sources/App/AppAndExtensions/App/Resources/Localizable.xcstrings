    "INVITATION_BODY_ONE_TO_ONE_INVITATION_RECEIVED_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie zustimmen, wird %@ zu Ihren Kontakten hinzugefügt und Sie können eine private Unterhaltung mit dieser Person führen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you accept, %@ will be added to your contacts and you will have a private discussion with them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si aceptas, %@ se añadirá a tus contactos y podrás tener una conversación privada con esa persona."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
