    "The scanned identity is already part of your trusted contacts 🙌. Do you still wish to proceed?": {
      "comment": "Alert message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gescannte Identität ist bereits Teil Ihrer vertrauenswürdigen Kontakte 🤝. Möchten Sie trotzdem fortfahren?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scanned identity is already part of your trusted contacts 🙌. Do you still wish to proceed?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La identidad escaneada ya forma parte de tus contactos de confianza 🤝. ¿Deseas continuar de todos modos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identité scannée fait déjà partie de vos contacts 🙌. Voulez-vous quand même poursuivre ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'identità scansionata è già presente tra i tuoi contatti fidati 🫂. Desideri comunque procedere?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンした身分証明書は、すでに信頼できる連絡先リストに含まれています。🙌。それでも続行しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스캔한 신원은 이미 신뢰할 수 있는 연락처 목록에 포함되어 있습니다. 그래도 계속 진행하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade escaneada já faz parte da sua lista de contatos confiáveis ​​🙌. Você ainda deseja continuar?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A identidade que foi detetada já faz parte dos seus contactos de confiança 🙌. Pretende mesmo continuar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот идентификатор уже есть в списке ваших доверенных контактов 🤝. Вы уверены, что хотите продолжить?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканований ідентифікатор вже є у вашому списку довірених контактів 🫂. Ви все ще бажаєте продовжити?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您扫描的身份信息已在您的信任联系人列表中。您是否仍要继续操作？"
          }
        }
      }
    },
