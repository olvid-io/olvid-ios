    "AUTOMATIC_BACKUP_EXPLANATION" : {
      "comment" : "Table view section footer",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie diese Option aktivieren, wird automatisch ein verschlüsseltes Backup Ihrer Kontakte, Gruppen und Einstellungen erstellt (Nachrichten und Anhänge werden nicht gesichert). Keine Sorge, dieses Backup ist verschlüsselt 🛡️."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activating this option allows to perform an automatic encrypted backup of your contacts, groups, and settings (messages and attachments are not backuped). Do not worry, this backup is encrypted 😇."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activar esta opción permite realizar una copia de seguridad automática y cifrada de tus contactos, grupos y ajustes (los mensajes y archivos adjuntos no se incluyen en la copia de seguridad). No te preocupes, esta copia de seguridad está cifrada 🔒."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activer cette option permet d'effectuer une sauvegarde automatique de vos contacts, groupes et paramètres (les messages et pièces jointes ne sont pas sauvegardés)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilitando questa opzione, verrà eseguito automaticamente un backup crittografato dei tuoi contatti, gruppi e impostazioni (messaggi e allegati non vengono salvati). Non preoccuparti, questo backup è crittografato 🛡️."
          }
        }
      }
    },
