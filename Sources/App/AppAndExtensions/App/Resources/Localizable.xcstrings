    "MODIFIED_SHARED_SETTINGS_CONFIRMATION_MESSAGE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben die Nachrichteneinstellungen für diesen Chat geändert.\n\nMöchten Sie diese Einstellungen für Sie und alle anderen Teilnehmer dieses Chats aktualisieren oder Ihre Änderungen verwerfen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You have modified the message settings for this discussion.\n\nDo you want to update these settings for you and all other discussion participants, or do you want to discard your changes?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has modificado la configuración del mensaje para esta conversación.\n\n¿Quieres actualizar esta configuración para ti y todos los demás participantes de la conversación, o quieres descartar tus cambios?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez modifié les paramètres partagés de cette discussion.\n\nVoulez-vous mettre à jour ces paramètres pour vous et tous les participants à la discussion, ou préférez-vous supprimer vos modifications ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai modificato le impostazioni dei messaggi per questa conversazione.\n\nVuoi aggiornare queste impostazioni per te e per tutti gli altri partecipanti alla conversazione, oppure vuoi scartare le modifiche?"
          }
        }
      }
    },
