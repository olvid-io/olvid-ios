    "YOUR_ID_WAS_COPIED_TO_CLIPBOARD_YOU_CAN_WRITE_EMAIL_AND_COPY_IT_THERE": {
      "comment": "Alert message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine ID wurde in die Zwischenablage kopiert. Du kannst sie jetzt in eine E-Mail oder SMS einfügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your ID was copied to the clipboard. You can now write an email or sms and copy it there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ID ha sido copiado al portapapeles. Ahora puedes escribir un correo electrónico o SMS y pegarlo allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ID a été copié dans le presse-papiers. Vous pouvez préparer un courriel ou un SMS et l'y copier directement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo ID è stato copiato negli appunti. Puoi ora scriverlo in un'email o un SMS e incollarlo lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのIDがクリップボードにコピーされました。メールやSMSでIDを送信する際に、コピー＆ペーストしてご利用ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 ID가 클립보드에 복사되었습니다. 이제 이메일이나 문자 메시지를 작성하고 해당 ID를 붙여넣을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ID foi copiado para a área de transferência. Agora você pode escrever um e-mail ou SMS e colá-lo lá."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu ID foi copiado para a área de transferência. Agora pode escrever um email ou SMS e colá-lo lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ID был скопирован в буфер обмена. Теперь вы можете написать электронное письмо или SMS и вставить его туда."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш ID скопійовано в буфер обміну. Тепер ви можете написати електронний лист або SMS та вставити його там."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 ID 已复制到剪贴板。现在您可以撰写电子邮件或短信并将其复制到其中。"
          }
        }
      }
    },
