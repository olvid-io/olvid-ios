          "stringUnit": {
            "state": "translated",
            "value": "Allega un'anteprima dei link che invii"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信するリンクのプレビューを添付"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "링크를 보낼 때 미리보기 이미지를 첨부하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe uma prévia dos links que você enviar"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexar uma pré-visualização dos links que envia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикрепите предпросмотр отправляемых ссылок"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте попередній перегляд посилань, які ви надсилаєте"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "附加您发送的链接的预览"
          }
        }
      }
    },
    "ATTACH_PREVIEW_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobald aktiviert, ruft Olvid eine Vorschau der von Ihnen gesendeten Links ab und fügt sie an die Nachricht an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once activated, Olvid will fetch a preview of links you send and attach it to the message."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez activado, Olvid obtendrá una vista previa de los enlaces que envíes y la adjuntará al mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois cette option activée, Olvid téléchargera un aperçu des liens que vous envoyez et le joindra au message."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta attivata, Olvid recupererà un'anteprima dei link che invii e la aggiungerà al messaggio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidを有効にすると、送信したリンクのプレビューを取得し、メッセージに添付します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화되면 Olvid는 사용자가 전송하는 링크의 미리보기를 가져와 메시지에 첨부합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Após ser ativado, o Olvid buscará uma prévia dos links que você enviar e a anexará à mensagem."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Assim que ativado, o Olvid irá obter uma pré-visualização dos links que envia e anexá-la à mensagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После активации Olvid будет извлекать предварительный просмотр ссылок, которые вы отправляете, и прикреплять его к сообщению."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Після активації Olvid отримуватиме попередній перегляд посилань, які ви надсилаєте, та додаватиме його до повідомлення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用后，Olvid 会提取您发送的链接的预览图，并将其附加到消息中。"
          }
        }
      }
    },
