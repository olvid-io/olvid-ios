    "EXPLANATION_FOR_CLONING_A_GROUP_V1_TO_GROUP_V2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Gruppe unterstützt nicht mehr als einen Administrator. Du kannst diese Gruppe jedoch in eine neue klonen, die 🚀!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This group does not support more than one administrator. But you can clone this group into a new one that will 🚀!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este grupo no admite más de un administrador. Pero puedes clonar este grupo en uno nuevo que tendrá 🚀!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce groupe ne permet pas d'avoir plusieurs administrateurs. Mais vous pouvez le cloner en un nouveau groupe de dernière génération qui le permettra 🚀 !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo gruppo non supporta più di un amministratore. Ma puoi clonare questo gruppo in uno nuovo che sarai tu ad amministrare!"
          }
        }
      }
    },
    "EXPLANATION_PLACED_ABOVE_LIST_OF_NON_ONE_TO_ONE_CONTACTS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die folgenden Nutzer sind noch nicht Teil deiner Kontakte und du kannst daher keine privaten Diskussionen mit ihnen führen. Du kannst sie jedoch einfach einladen! 😊"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The following users are not part of your contacts (yet), so you cannot have a private discussion with them. But you can invite them easily 🚀!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los siguientes usuarios no están en tus contactos (todavía), por lo que no puedes tener una conversación privada con ellos. Pero puedes invitarlos fácilmente 🤝!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les utilisateurs ci-dessous ne font pas (encore) partie de vos contacts, et vous ne pouvez donc pas encore avoir de discussion privée avec eux. Mais vous pouvez les y inviter facilement 🚀 !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I seguenti utenti non sono ancora tra i tuoi contatti, quindi non puoi avviare una conversazione privata con loro. Puoi però invitarli facilmente 🚀!"
          }
        }
      }
    },
