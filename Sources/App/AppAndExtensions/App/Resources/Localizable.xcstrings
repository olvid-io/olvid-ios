    "INSTALLED_APP_IS_OUTDATED_ALERT_BODY": {
      "comment": "Alert title",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aber keine Sorge 😊. Du kannst jetzt auf die neueste Version von Olvid aktualisieren und seine fantastischen neuen Funktionen 🤓 entdecken! Wir empfehlen dir, jetzt zu aktualisieren 🚀."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "But don't worry 😊. You can upgrade now to the latest version of Olvid and discover its amazing new features 🤓! We recommend you upgrade now 🚀."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pero no te preocupes 😊. Puedes actualizar ahora a la última versión de Olvid y descubrir sus increíbles nuevas funciones 🤓! Te recomendamos que actualices ahora 🚀."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais ne vous inquiétez pas 😊. Vous pouvez mettre à jour Olvid dès maintenant et ainsi découvrir les dernières nouveautés 🤓. Nous vous recommandons de mettre à jour maintenant 🚀."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ma non preoccuparti 😊. Puoi aggiornare subito all'ultima versione di Olvid e scoprire le sue fantastiche nuove funzionalità ✨! Ti consigliamo di aggiornare ora 👍."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "でも心配しないでくださいね😊。Olvidを最新バージョンにアップデートして、素晴らしい新機能をお楽しみください🎉！今すぐアップデートすることをお勧めします👍。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하지만 걱정 마세요 😉. 지금 Olvid를 최신 버전으로 업데이트하고 놀라운 새로운 기능을 경험해 보세요! 지금 업데이트하는 것을 추천합니다 👍."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas não se preocupe 😊. Você pode atualizar agora para a versão mais recente do Olvid e descobrir seus incríveis novos recursos 🤓! Recomendamos que você atualize agora 🚀."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mas não se preocupe 😊. Pode atualizar agora para a versão mais recente do Olvid e descobrir as suas incríveis novas funcionalidades 🤓! Recomendamos que atualize agora 🚀."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Но не волнуйтесь 😊. Вы можете обновиться до последней версии Olvid и открыть для себя его потрясающие новые функции 🤓! Мы рекомендуем обновиться прямо сейчас 🚀."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Але не хвилюйтеся 😌. Ви можете оновитися зараз до останньої версії Olvid і відкрити для себе її дивовижні нові функції ✨! Ми рекомендуємо оновитися зараз 👍."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "但不用担心 😊。 您可以立即升级到最新版本的 Olvid，并体验其令人惊叹的新功能 🤓！ 我们建议您立即升级 🚀。"
          }
        }
      }
    },
