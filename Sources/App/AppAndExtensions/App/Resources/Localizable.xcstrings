    "GLOBAL_EXPIRATION_SETTINGS_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Einstellungen werden auf alle neuen Einzelgespräche und alle neuen Gruppenchats angewendet, die Sie erstellen. Bitte beachten Sie, dass diese Einstellungen mit allen Teilnehmern des Chats geteilt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings below will be applied to all new one-to-one discussions and to all new group discussions that you create. Please note that these settings will be shared among all the participant of the discussion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración a continuación se aplicará a todas las nuevas conversaciones uno a uno y a todos los nuevos grupos que cree. Tenga en cuenta que esta configuración se compartirá entre todos los participantes de la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres ci-dessous seront appliqués à toute nouvelle discussion « one-to-one » ainsi qu'à toute nouvelle discussion de groupe que vous créerez. Veuillez noter que ces paramètres de discussion seront partagés avec tous les participants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni sottostanti verranno applicate a tutte le nuove discussioni individuali e a tutti i nuovi gruppi che creerai. Tieni presente che queste impostazioni saranno condivise tra tutti i partecipanti alla discussione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の設定は、今後作成するすべての1対1のチャットとグループチャットに適用されます。これらの設定は、すべての参加者で共有されることにご注意ください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 설정은 모든 새로운 일대일 대화와 새 그룹 대화에 적용됩니다. 이 설정은 대화에 참여하는 모든 사람과 공유된다는 점을 유념해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações abaixo serão aplicadas a todas as novas conversas individuais e a todos os novos grupos que você criar. Observe que essas configurações serão compartilhadas entre todos os participantes da conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições abaixo serão aplicadas a todas as novas conversas individuais e a todos os novos grupos que criar. Tenha em atenção que estas definições serão partilhadas entre todos os participantes da conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки ниже будут применены ко всем новым личным и групповым обсуждениям, которые вы создаете. Обратите внимание, что эти настройки будут общими для всех участников обсуждения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування нижче будуть застосовані до всіх нових особистих та групових розмов, які ви створюєте. Зверніть увагу, що ці налаштування будуть спільними для всіх учасників розмови."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下设置将应用于所有新的私聊和您创建的所有新的群聊。请注意，这些设置将与所有讨论参与者共享。"
          }
        }
      }
    },
    "GLOBAL_LOCAL_EPHEMERAL_SETTINGS_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Einstellungen ermöglichen es Ihnen, das Standardverhalten von temporären Nachrichten lokal anzupassen. Diese Einstellungen werden nicht mit anderen Gesprächsteilnehmern geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings below allow you to locally customize the default behavior of ephemeral messages. These settings are not shared with other discussion participants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración a continuación te permite personalizar localmente el comportamiento predeterminado de los mensajes efímeros. Estos ajustes no se comparten con otros participantes de la conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages ci-dessous vous permettent d'ajuster localement le comportement par défaut des messages éphémères. Ces paramètres ne sont pas partagés avec les autres participants aux discussions."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni seguenti ti permettono di personalizzare localmente il comportamento predefinito dei messaggi effimeri. Queste impostazioni non vengono condivise con gli altri partecipanti alla conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の設定を使用すると、一時メッセージのデフォルトの動作をローカルでカスタマイズできます。これらの設定は他の参加者と共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 설정은 일시 메시지의 기본 동작을 로컬에서 사용자 지정할 수 있도록 합니다. 이러한 설정은 다른 토론 참가자와 공유되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações abaixo permitem que você personalize localmente o comportamento padrão das mensagens temporárias. Essas configurações não são compartilhadas com outros participantes da conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições abaixo permitem personalizar localmente o comportamento predefinido das mensagens temporárias. Estas definições não são partilhadas com outros participantes da conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки ниже позволяют вам локально настроить поведение самоуничтожающихся сообщений. Эти настройки не передаются другим участникам обсуждения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування нижче дозволяють вам локально налаштувати стандартну поведінку тимчасових повідомлень. Ці налаштування не передаються іншим учасникам розмови."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下设置允许您本地自定义阅后即焚消息的默认行为。这些设置不会与讨论中的其他参与者共享。"
          }
        }
      }
    },
    "GLOBAL_RETENTION_SETTINGS_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den folgenden Einstellungen können Sie alte Nachrichten in Ihren Chats automatisch löschen. Diese können für jeden Chat einzeln überschrieben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings below allow you to automatically delete old messages in your discussions. They can be overidden in each discussion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración a continuación te permite eliminar automáticamente mensajes antiguos en tus conversaciones. Puedes anularla en cada conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages ci-dessous vous permettent de supprimer automatiquement de vieux messages dans vos discussions. Ces paramètres par défaut peuvent être modifiés indépendamment pour chaque discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni seguenti ti permettono di eliminare automaticamente i messaggi più vecchi nelle tue conversazioni. Possono essere sovrascritte in ciascuna conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の設定を使用すると、チャットで古いメッセージを自動的に削除できます。各チャットで個別に設定を上書きすることも可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 설정은 대화에서 오래된 메시지를 자동으로 삭제할 수 있도록 해줍니다. 각 대화에서 설정을 재정의할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações abaixo permitem que você exclua automaticamente mensagens antigas em suas conversas. Elas podem ser alteradas individualmente em cada conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições abaixo permitem-lhe eliminar automaticamente mensagens antigas nas suas conversas. Pode alterar estas definições para cada conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки ниже позволяют автоматически удалять старые сообщения в ваших обсуждениях. Их можно переопределить в каждом обсуждении."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування нижче дозволяють автоматично видаляти старі повідомлення у ваших розмовах. Їх можна змінити для кожної розмови."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下设置允许您自动删除对话中的旧消息。您可以针对每个对话单独设置。"
          }
        }
      }
    },
