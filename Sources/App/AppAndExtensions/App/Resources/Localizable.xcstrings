    "CUSTOM_KEYBOARD_MANAGEMENT_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Änderung dieses Parameters erfordert einen vollständigen Neustart von Olvid, bevor sie wirksam wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any change to this parameter will require a complete restart of Olvid before it can take effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier cambio en este parámetro requerirá un reinicio completo de Olvid para que surta efecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout changement de ce paramètre ne prendra effet qu'après un redémarrage complet d'Olvid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi modifica a questo parametro richiederà un riavvio completo di Olvid prima che possa avere effetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このパラメータを変更すると、変更を有効にするためにOlvidを完全に再起動する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 매개변수를 변경하면 Olvid을 완전히 재시작해야 변경 사항이 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer alteração neste parâmetro exigirá uma reinicialização completa do Olvid para que as mudanças tenham efeito."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer alteração neste parâmetro exigirá um reinício completo do Olvid para que entre em vigor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любое изменение этого параметра потребует полной перезагрузки Olvid для вступления в силу."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-які зміни цього параметра вимагатимуть повного перезапуску Olvid, щоб набули чинності."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对该参数的任何更改都需要完全重启 Olvid 才能生效。"
          }
        }
      }
    },
