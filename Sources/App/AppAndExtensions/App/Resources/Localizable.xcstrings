    "LOCAL_EPHEMERAL_SETTINGS_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Einstellungen ermöglichen es Ihnen, das Verhalten von temporären Nachrichten in dieser Unterhaltung lokal anzupassen. Diese Einstellungen werden nicht mit anderen Teilnehmern geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings below allow you to locally customize how ephemeral messages behave within this discussion. These settings are not shared with other participants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración a continuación te permite personalizar localmente cómo se comportan los mensajes efímeros dentro de esta conversación. Esta configuración no se comparte con otros participantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages ci-dessous vous permettent d'ajuster localement le comportement des messages éphémères. Ces paramètres ne sont pas partagés avec les autres participants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni seguenti ti permettono di personalizzare localmente il comportamento dei messaggi effimeri all'interno di questa conversazione. Queste impostazioni non vengono condivise con gli altri partecipanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の設定を使用すると、このチャット内での一時メッセージの動作をローカルでカスタマイズできます。これらの設定は他の参加者と共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 설정은 이 대화 내에서 일시 메시지의 동작 방식을 로컬에서 사용자 지정할 수 있도록 해줍니다. 이러한 설정은 다른 참여자와 공유되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações abaixo permitem que você personalize localmente o comportamento das mensagens temporárias nesta conversa. Essas configurações não são compartilhadas com outros participantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições abaixo permitem personalizar localmente o comportamento das mensagens temporárias nesta conversa. Estas definições não são partilhadas com os outros participantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки ниже позволяют локально настроить поведение самоуничтожающихся сообщений в этом диалоге. Эти настройки не передаются другим участникам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування нижче дозволяють вам локально налаштувати поведінку тимчасових повідомлень у цьому обговоренні. Ці налаштування не передаються іншим учасникам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下设置允许您本地自定义临时消息在此对话中的行为。这些设置不会与其他参与者共享。"
          }
        }
      }
    },
    "LOCAL_RETENTION_SETTINGS_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Einstellungen ermöglichen es Ihnen, alte Nachrichten in dieser Unterhaltung automatisch zu löschen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings below allow you to automatically delete old messages in this discussion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración a continuación te permite borrar automáticamente mensajes antiguos en esta conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réglages ci-dessous vous permettent de supprimer automatiquement de vieux messages dans cette discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni seguenti ti permettono di eliminare automaticamente i vecchi messaggi in questa conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の設定を使用すると、このチャットの古いメッセージを自動的に削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 설정에서는 이 대화에서 오래된 메시지를 자동으로 삭제할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações abaixo permitem que você exclua automaticamente mensagens antigas nesta conversa."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições abaixo permitem-lhe eliminar automaticamente mensagens antigas nesta conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки ниже позволяют автоматически удалять старые сообщения в этом диалоге."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування нижче дозволяють автоматично видаляти старі повідомлення в цій розмові."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下设置允许您自动删除此对话中的旧消息。"
          }
        }
      }
    },
