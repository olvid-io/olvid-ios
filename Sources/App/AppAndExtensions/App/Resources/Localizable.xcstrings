    "EXPIRATION_SETTINGS_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die folgenden Einstellungen werden von allen Teilnehmern dieser Diskussion gemeinsam genutzt. Änderungen wirken sich auf die Standard-Sichtbarkeit und die Aufbewahrungsdauer von Nachrichten aus, die von allen Teilnehmern gesendet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The settings below are shared between all participants in this discussion. Changing them will affect the default visibility and existence duration of messages sent by all participants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración a continuación se comparte entre todos los participantes de esta conversación. Cambiarla afectará la visibilidad predeterminada y la duración de existencia de los mensajes enviados por todos los participantes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres ci-dessous sont partagés par l'ensemble des participants à la discussion. En cas de modification, la nouvelle durée de visibilité et d'existence sera envoyée à tous les participants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni sottostanti sono condivise tra tutti i partecipanti a questa discussione. Modificandole, si influenzerà la visibilità predefinita e la durata di esistenza dei messaggi inviati da tutti i partecipanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以下の設定は、このディスカッションのすべての参加者間で共有されます。設定を変更すると、すべての参加者が送信するメッセージのデフォルトの表示設定と保存期間に影響します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아래 설정은 이 대화에 참여하는 모든 사용자에게 공유됩니다. 설정을 변경하면 모든 사용자가 보내는 메시지의 기본 공개 범위와 존재 기간에 영향을 미칩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações abaixo são compartilhadas entre todos os participantes desta conversa. Alterá-las afetará a visibilidade padrão e a duração da existência das mensagens enviadas por todos os participantes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As definições abaixo são partilhadas por todos os participantes nesta conversa. Alterá-las afetará a visibilidade predefinida e a duração de existência das mensagens enviadas por todos os participantes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки ниже применяются ко всем участникам этого обсуждения. Изменение этих настроек повлияет на видимость и время хранения сообщений, отправленных всеми участниками."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Налаштування нижче використовуються всіма учасниками цієї дискусії. Зміна їх вплине на видимість та тривалість існування повідомлень, які надсилають усі учасники."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下设置将在本次讨论的所有参与者之间共享。更改这些设置会影响所有参与者发送的消息的默认可见性和存在时长。"
          }
        }
      }
    },
