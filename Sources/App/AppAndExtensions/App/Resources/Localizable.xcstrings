    "INVITATION_BODY_SAS_EXCHANGE_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um mit %1$@ zu sprechen, müssen Sie ihnen Ihren Code geben und ihren Code eingeben. Diese Codes sind nicht geheim, aber bitte stellen Sie sicher, dass %1$@ tatsächlich die Person ist, die Ihnen den Code gibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To discuss with %1$@, you must give them your code and enter theirs. Those codes are not secret, but please make sure that %1$@ is indeed the one giving you the code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para hablar con %1$@, debes proporcionarles tu código e ingresar el suyo. Esos códigos no son secretos, pero asegúrate de que %1$@ sea realmente quien te está dando el código."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour discuter avec %1$@, vous devez lui transmettre votre code et saisir le sien. Ces codes ne sont pas secrets, mais assurez-vous que c'est bien %1$@ qui vous transmet son code."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per parlare con %1$@, devi fornire il tuo codice e inserire il loro. Questi codici non sono segreti, ma assicurati che sia effettivamente %1$@ a fornirtelo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@とメッセージをやり取りするには、相手に自分のコードを伝え、相手からコードを受け取る必要があります。これらのコードは秘密ではありませんが、%1$@が実際にコードを伝えてくれる相手であることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@와 대화하려면, 상대방에게 본인의 코드를 제공하고 상대방의 코드를 입력해야 합니다. 이 코드는 비밀 정보는 아니지만, %1$@가 실제로 코드를 제공하는 사람인지 확인해 주시기 바랍니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conversar com %1$@, você deve fornecer seu código e inserir o código dele. Esses códigos não são confidenciais, mas, por favor, certifique-se de que %1$@ é realmente a pessoa que está fornecendo o código."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para conversar com %1$@, tem de fornecer o seu código e introduzir o código dessa pessoa. Estes códigos não são secretos, mas, por favor, certifique-se de que %1$@ é realmente a pessoa que lhe está a fornecer o código."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы обсудить с %1$@, вам нужно сообщить им свой код и ввести их код. Эти коды не являются секретными, но убедитесь, что именно %1$@ предоставляет вам код."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб обговорити з %1$@, вам потрібно надати їм свій код та ввести їхній. Ці коди не є секретними, але переконайтеся, що саме %1$@ надає вам код."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要与 %1$@ 讨论，您需要提供您的代码，并输入他们的代码。这些代码不是秘密，但请确保 %1$@ 确实是提供代码的人。"
          }
        }
      }
    },
