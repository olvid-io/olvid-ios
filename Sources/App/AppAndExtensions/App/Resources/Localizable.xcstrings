    "BIOMETRY_NOT_ENROLLED_ERROR_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um diese Funktion nutzen zu können, müssen Sie entweder Face ID oder Touch ID in den Einstellungen aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To use this feature, you need to set up either Face ID or Touch ID in the Settings app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para usar esta función, debes configurar Face ID o Touch ID en la aplicación de Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour utiliser cette fonctionnalité, vous devez configurer Face ID ou Touch ID dans l'app Réglages de votre appareil."
          }
        },
        "it": {
          "stringUnit": {
