    "AUTOMATIC_BACKUP_EXPLANATION": {
      "comment": "Table view section footer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie diese Option aktivieren, wird automatisch ein verschlüsseltes Backup Ihrer Kontakte, Gruppen und Einstellungen erstellt (Nachrichten und Anhänge werden nicht gesichert). Keine Sorge, dieses Backup ist verschlüsselt 🛡️."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activating this option allows to perform an automatic encrypted backup of your contacts, groups, and settings (messages and attachments are not backuped). Do not worry, this backup is encrypted 😇."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar esta opción permite realizar una copia de seguridad automática y cifrada de tus contactos, grupos y ajustes (los mensajes y archivos adjuntos no se incluyen en la copia de seguridad). No te preocupes, esta copia de seguridad está cifrada 🔒."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer cette option permet d'effectuer une sauvegarde automatique de vos contacts, groupes et paramètres (les messages et pièces jointes ne sont pas sauvegardés)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilitando questa opzione, verrà eseguito automaticamente un backup crittografato dei tuoi contatti, gruppi e impostazioni (messaggi e allegati non vengono salvati). Non preoccuparti, questo backup è crittografato 🛡️."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオプションを有効にすると、連絡先、グループ、設定を自動的に暗号化してバックアップできます（メッセージや添付ファイルはバックアップされません）。ご安心ください。このバックアップは暗号化されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 활성화하면 연락처, 그룹 및 설정의 자동 암호화 백업을 수행할 수 있습니다(메시지와 첨부 파일은 백업되지 않음). 걱정하지 마세요. 이 백업은 암호화됩니다 🔒."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar esta opção permite realizar um backup criptografado automático dos seus contatos, grupos e configurações (mensagens e anexos não são incluídos no backup). Não se preocupe, este backup é criptografado 😇."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar esta opção permite efetuar uma cópia de segurança encriptada automática dos seus contactos, grupos e definições (as mensagens e anexos não são guardados). Não se preocupe, esta cópia de segurança é encriptada 😇."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Активация этой опции позволяет автоматически создавать зашифрованную резервную копию ваших контактов, групп и настроек (сообщения и вложения не резервируются). Не беспокойтесь, эта резервная копия зашифрована 🔒."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкнення цієї опції дозволяє автоматично створити зашифровану резервну копію ваших контактів, груп та налаштувань (повідомлення та вкладення не зберігаються). Не хвилюйтеся, ця резервна копія зашифрована 🔒."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用此选项可自动执行加密备份，备份您的联系人、群组和设置（不备份消息和附件）。请放心，此备份是加密的。😇"
          }
        }
      }
    },
