    "EXPIRATION_SETTINGS_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die folgenden Einstellungen werden von allen Teilnehmern dieser Diskussion gemeinsam genutzt. Änderungen wirken sich auf die Standard-Sichtbarkeit und die Aufbewahrungsdauer von Nachrichten aus, die von allen Teilnehmern gesendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The settings below are shared between all participants in this discussion. Changing them will affect the default visibility and existence duration of messages sent by all participants."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración a continuación se comparte entre todos los participantes de esta conversación. Cambiarla afectará la visibilidad predeterminada y la duración de existencia de los mensajes enviados por todos los participantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les paramètres ci-dessous sont partagés par l'ensemble des participants à la discussion. En cas de modification, la nouvelle durée de visibilité et d'existence sera envoyée à tous les participants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni sottostanti sono condivise tra tutti i partecipanti a questa discussione. Modificandole, si influenzerà la visibilità predefinita e la durata di esistenza dei messaggi inviati da tutti i partecipanti."
          }
        }
      }
    },
