    "LOCAL_EPHEMERAL_SETTINGS_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die folgenden Einstellungen ermöglichen es Ihnen, das Verhalten von temporären Nachrichten in dieser Unterhaltung lokal anzupassen. Diese Einstellungen werden nicht mit anderen Teilnehmern geteilt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The settings below allow you to locally customize how ephemeral messages behave within this discussion. These settings are not shared with other participants."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuración a continuación te permite personalizar localmente cómo se comportan los mensajes efímeros dentro de esta conversación. Esta configuración no se comparte con otros participantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réglages ci-dessous vous permettent d'ajuster localement le comportement des messages éphémères. Ces paramètres ne sont pas partagés avec les autres participants."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le impostazioni seguenti ti permettono di personalizzare localmente il comportamento dei messaggi effimeri all'interno di questa conversazione. Queste impostazioni non vengono condivise con gli altri partecipanti."
          }
        }
      }
    },
