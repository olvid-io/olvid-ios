    "%@ invites you to discuss on Olvid" : {
      "comment" : "Subject used when inviting another user to Olvid, i.e., when sharing ones owned identity using, e.g., an email",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte mit Ihnen auf Olvid diskutieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ would like to discuss with you on Olvid"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ le gustaría hablar contigo en Olvid"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aimerait discuter avec vous sur Olvid"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vorrebbe parlare con te su Olvid"
          }
        }
      }
    },
    "%@ invites you to discuss on Olvid. To accept, please click the link below:\n\n%@" : {
      "comment" : "Body used when inviting another user to Olvid, i.e., when sharing ones owned identity using, e.g., an email or message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ möchte mit Ihnen auf Olvid diskutieren. Um zu akzeptieren, verwenden Sie den folgenden Link:\n\n%@\n"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wants to discuss with you on Olvid. To accept, use the link below:\n\n%@\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ quiere hablar contigo en Olvid. Para aceptar, usa el siguiente enlace:\n\n%@\n"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ aimerait discuter avec vous sur Olvid. Pour accepter, utilisez le lien suivant :\n\n%@\n"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ vuole discutere con te su Olvid. Per accettare, usa il link qui sotto:\n\n%@\n"
          }
        }
      }
    },
