    "MODIFIED_SHARED_SETTINGS_CONFIRMATION_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben die Nachrichteneinstellungen für diesen Chat geändert.\n\nMöchten Sie diese Einstellungen für Sie und alle anderen Teilnehmer dieses Chats aktualisieren oder Ihre Änderungen verwerfen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have modified the message settings for this discussion.\n\nDo you want to update these settings for you and all other discussion participants, or do you want to discard your changes?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has modificado la configuración del mensaje para esta conversación.\n\n¿Quieres actualizar esta configuración para ti y todos los demás participantes de la conversación, o quieres descartar tus cambios?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez modifié les paramètres partagés de cette discussion.\n\nVoulez-vous mettre à jour ces paramètres pour vous et tous les participants à la discussion, ou préférez-vous supprimer vos modifications ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai modificato le impostazioni dei messaggi per questa conversazione.\n\nVuoi aggiornare queste impostazioni per te e per tutti gli altri partecipanti alla conversazione, oppure vuoi scartare le modifiche?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットのメッセージ設定を変更しました。\n\nあなたと他のすべてのチャット参加者に対して、これらの設定を更新しますか？それとも、変更を破棄しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화에 대한 메시지 설정을 변경했습니다.\n\n이 설정을 본인과 다른 모든 대화 참여자에게 적용하여 업데이트하시겠습니까, 아니면 변경 사항을 취소하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você modificou as configurações de mensagem para esta conversa.\n\nDeseja atualizar essas configurações para você e todos os outros participantes da conversa, ou deseja descartar suas alterações?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Alteraste as definições de mensagens para esta conversa.\n\nQueres atualizar estas definições para ti e para todos os outros participantes da conversa, ou queres descartar as tuas alterações?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы изменили настройки сообщений для этой беседы.\n\nХотите ли вы применить эти настройки и к себе, и ко всем остальным участникам беседы, или отказаться от изменений?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви змінили налаштування повідомлень для цієї розмови.\n\nЧи бажаєте ви оновити ці налаштування для себе та всіх інших учасників розмови, чи відкинути ваші зміни?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已修改了此对话的消息设置。\n\n您想将这些设置更新到您和其他所有对话参与者，还是想放弃您的更改？"
          }
        }
      }
    },
    "MODIFIED_SHARED_SETTINGS_CONFIRMATION_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einstellungen für modifizierte, temporäre Nachrichten geändert"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modified shared ephemeral message settings"
          }
        },
        "es": {
