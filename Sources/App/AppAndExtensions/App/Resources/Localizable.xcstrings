        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retirez tous les membres et membres en attente et essayez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuovi eventuali membri in sospeso/gruppo e riprova."
          }
        }
      }
    },
    "Please report this error to %1$@ so we can fix this issue as fast as possible." : {
      "comment" : "body text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Neustarten Ihres Geräts kann dieses Problem beheben. Sollte dies nicht helfen, melden Sie diesen Fehler bitte an %1$@, damit wir das Problem so schnell wie möglich beheben können."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restarting your device may fix this issue. If it does not, please report this error to %1$@ so we can fix this issue as fast as possible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reiniciar tu dispositivo podría solucionar este problema. Si no lo hace, por favor reporta este error a %1$@ para que podamos solucionarlo lo antes posible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il se peut qu'un redémarrage de votre iPhone corrige ce problème. Sinon, nous vous serions reconnaissant d'envoyer cette erreur à %1$@ pour que nous puissions la corriger le plus vite possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riavviare il dispositivo potrebbe risolvere il problema. In caso contrario, ti preghiamo di segnalare questo errore a %1$@ in modo che possiamo risolverlo il prima possibile."
          }
        }
      }
    },
    "Please sign in to your iCloud account to enable automatic backups. On the Home screen, launch Settings, tap iCloud, and enter your Apple ID. Turn iCloud Drive on. If you don't have an iCloud account, tap Create a new Apple ID." : {
      "comment" : "Alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte melden Sie sich bei Ihrem iCloud-Konto an, um automatische Backups zu aktivieren. Öffnen Sie auf dem Home-Bildschirm die Einstellungen, tippen Sie auf iCloud und geben Sie Ihre Apple-ID ein. Aktivieren Sie iCloud Drive. Wenn Sie kein iCloud-Konto haben, tippen Sie auf „Neue Apple-ID erstellen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please sign in to your iCloud account to enable automatic backups. On the Home screen, launch Settings, tap iCloud, and enter your Apple ID. Turn iCloud Drive on. If you don't have an iCloud account, tap Create a new Apple ID."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por favor, inicia sesión en tu cuenta de iCloud para habilitar las copias de seguridad automáticas. En la pantalla de inicio, abre Ajustes, toca iCloud e introduce tu ID de Apple. Activa iCloud Drive. Si no tienes una cuenta de iCloud, toca Crear un nuevo ID de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à iCloud pour activer les sauvegardes automatiques. Sur l'écran d'accueil, démarrez l'App Réglages, touchez iCloud et entrez votre Apple ID. Activez iCloud Drive. Si vous n'avez pas de compte iCloud, touchez Créer un nouvel Apple ID."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effettua l'accesso al tuo account iCloud per abilitare i backup automatici. Nella schermata Home, apri Impostazioni, tocca iCloud e inserisci il tuo Apple ID. Attiva iCloud Drive. Se non hai un account iCloud, tocca Crea un nuovo Apple ID."
          }
        }
      }
    },
    "PLEASE_NOTE_THAT_YOUR_CUSTOM_PASSCODE_CANNOT_BE_RECOVERED" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte beachte, dass dein Zugangscode nicht wiederhergestellt werden kann, wenn du ihn vergisst, und du keinen Zugriff mehr auf Olvid haben wirst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Please note that if you forget your passcode, it cannot be recovered and you won't be able to access Olvid anymore."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten en cuenta que si olvidas tu código de acceso, no se puede recuperar y no podrás acceder a Olvid."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veuillez noter que si vous oubliez votre code personnalisé, il ne sera pas possible de le récupérer, et vous ne pourrez plus accéder à Olvid."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si prega di notare che se dimentichi il tuo codice di accesso, non potrà essere recuperato e non potrai più accedere a Olvid."
          }
        }
      }
    },
