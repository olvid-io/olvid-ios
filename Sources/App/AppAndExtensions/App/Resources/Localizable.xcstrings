    "MISSING_CHANNEL_FOR_CALL_MESSAGE_%@" : {
      "comment" : "Alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können %@ anrufen, sobald eine sichere Verbindung mit dieser Person hergestellt wurde. Bitte versuchen Sie es später erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You will be able to call %@ once a secure channel is established with them. Please try again later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podrás llamar a %@ una vez que se haya establecido un canal seguro con esa persona. Por favor, inténtalo de nuevo más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez appeler %@ dès que le canal sécurisé sera établi. Veuillez essayer à nouveau plus tard."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potrai chiamare %@ una volta stabilita una connessione sicura con lui/lei. Riprova più tardi."
          }
        }
      }
