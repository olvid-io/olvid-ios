    "TIME_BASED_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden Nachrichten, die älter als die angegebene Zeit sind, regelmäßig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If activated, messages older than the specified time will be regularly deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se activa, los mensajes con una antigüedad superior al tiempo especificado se eliminarán periódicamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si ce réglage est activé, les messages plus anciens que le temps spécifié seront régulièrement supprimés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivata, i messaggi più vecchi del periodo specificato verranno eliminati regolarmente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にすると、指定した時間より古いメッセージが定期的に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하면 지정된 시간보다 오래된 메시지가 주기적으로 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativado, as mensagens com mais de um determinado tempo serão excluídas periodicamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativado, as mensagens com mais de um determinado tempo serão eliminadas automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если включено, сообщения старше указанного времени будут регулярно удаляться."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо активовано, повідомлення, старші за вказаний час, будуть регулярно видалятися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果启用，超过指定时间的消息将定期删除。"
          }
        }
      }
    },
    "TIME_BASED_SINGLE_DISCUSSION_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, werden ältere Nachrichten als der angegebene Zeitraum in dieser Konversation regelmäßig gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
