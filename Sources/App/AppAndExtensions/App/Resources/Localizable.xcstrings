    "Olvid failed to initialize with the following error message:\n\n%1$@" : {
      "comment" : "mail body text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid konnte nicht mit der folgenden Fehlermeldung initialisiert werden:\n\n%1$@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid failed to initialize with the following error message:\n\n%1$@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid no se inicializó correctamente con el siguiente mensaje de error:\n\n%1$@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid n'a pas pu démarrer correctement. Voici le message d'erreur:\n\n%1$@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid non è stato inizializzato correttamente con il seguente messaggio di errore:\n\n%1$@"
          }
        }
      }
    },
    "Olvid failed to start properly. This is a terrible experience, we deeply appologize about this." : {
      "comment" : "Body text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid konnte nicht korrekt gestartet werden. Das ist eine sehr schlechte Erfahrung, und wir entschuldigen uns aufrichtig dafür. Seien Sie versichert, dass keine Ihrer Daten verloren gegangen sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid failed to start properly. This is a terrible experience, we deeply appologize about this. Please be reassured, none of your data was lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid no pudo iniciarse correctamente. Esta es una experiencia terrible, nos disculpamos profundamente por esto. Por favor, ten la seguridad de que ninguno de tus datos se ha perdido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid n'a pas pu démarrer correctement. Nous en sommes désolés. Mais rassurez-vous, aucune de vos données n'a été perdue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid non è stato avviato correttamente. Ci scusiamo profondamente per questo terribile inconveniente. Ti assicuriamo che i tuoi dati non sono andati persi."
          }
        }
      }
    },
    "Olvid is not authorized to access the camera. Because your settings are restricted, there is nothing we can do about this. Please contact your administrator." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid hat keine Berechtigung, auf die Kamera zuzugreifen. Da Ihre Einstellungen eingeschränkt sind, können wir hier nichts ändern. Bitte wenden Sie sich an Ihren Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid is not authorized to access the camera. Because your settings are restricted, there is nothing we can do about this. Please contact your administrator."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid no está autorizado a acceder a la cámara. Debido a que su configuración está restringida, no hay nada que podamos hacer al respecto. Por favor, contacte a su administrador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid n'a pas l'autorisation d'accéder à l'appareil photo 😱. Vos paramètres étant restreints, il n'y a rien que nous ne puissions faire. Nous vous recommandons de contacter votre administrateur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid non è autorizzato ad accedere alla fotocamera. A causa delle impostazioni di restrizione, non possiamo fare nulla al riguardo. Si prega di contattare il proprio amministratore."
          }
        }
      }
    },
    "Olvid is not authorized to access the camera. You can change this setting within the Settings app." : {
      "comment" : "Body of an alert",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid hat keine Berechtigung, auf die Kamera zuzugreifen 📸. Sie können diese Einstellung in der Einstellungen-App ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid is not authorized to access the camera 😱. You can change this setting within the Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid no está autorizado a acceder a la cámara 📷. Puedes cambiar esta configuración en la aplicación de Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid n'a pas l'autorisation d'accéder à l'appareil photo 😱. Vous pouvez changer ce paramètre dans l'application Réglages."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid non è autorizzato ad accedere alla fotocamera 📸. Puoi modificare questa impostazione nell'app Impostazioni."
          }
        }
      }
    },
    "Olvid is not authorized to access your location due to active restrictions such as parental controls or MDM settings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid ist nicht autorisiert, auf Ihren Standort zuzugreifen, da aktive Einschränkungen wie Kindersicherung oder MDM-Einstellungen vorliegen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
