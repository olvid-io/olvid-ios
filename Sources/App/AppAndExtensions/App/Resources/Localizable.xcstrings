    "INSTALLED_APP_IS_OUTDATED_ALERT_BODY" : {
      "comment" : "Alert title",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aber keine Sorge 😊. Du kannst jetzt auf die neueste Version von Olvid aktualisieren und seine fantastischen neuen Funktionen 🤓 entdecken! Wir empfehlen dir, jetzt zu aktualisieren 🚀."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "But don't worry 😊. You can upgrade now to the latest version of Olvid and discover its amazing new features 🤓! We recommend you upgrade now 🚀."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pero no te preocupes 😊. Puedes actualizar ahora a la última versión de Olvid y descubrir sus increíbles nuevas funciones 🤓! Te recomendamos que actualices ahora 🚀."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais ne vous inquiétez pas 😊. Vous pouvez mettre à jour Olvid dès maintenant et ainsi découvrir les dernières nouveautés 🤓. Nous vous recommandons de mettre à jour maintenant 🚀."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma non preoccuparti 😊. Puoi aggiornare subito all'ultima versione di Olvid e scoprire le sue fantastiche nuove funzionalità ✨! Ti consigliamo di aggiornare ora 👍."
          }
        }
      }
    },
