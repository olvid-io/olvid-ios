    "PERFORM_INTERACTION_DONATION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie diese Option aktivieren, werden Ihre Olvid-Gespräche vorgeschlagen, wenn Sie von einer anderen App aus teilen. Diese Einstellung kann auf Gesprächebene überschrieben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you activate this option, your Olvid discussions will be suggested when sharing from another app. This choice can be overridden at the discussion level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si activas esta opción, tus conversaciones de Olvid se sugerirán al compartir desde otra aplicación. Esta elección se puede anular a nivel de conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous activez cette option, les discussions Olvid apparaîtront directement lorsque vous partagerez du contenu depuis une autre app. Ce paramètre peut être modifié indépendamment pour chaque discussion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se attivi questa opzione, le tue conversazioni su Olvid verranno suggerite quando condividi da un'altra app. Questa scelta può essere sovrascritta a livello di conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このオプションを有効にすると、別のアプリから共有する際に、Olvid のディスカッションが提案されます。この設定は、ディスカッションごとに変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 활성화하면 다른 앱에서 공유할 때 Olvid 대화 내용이 제안됩니다. 이 설정은 대화별로 변경할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você ativar esta opção, suas conversas no Olvid serão sugeridas quando você compartilhar conteúdo de outro aplicativo. Você pode alterar essa configuração em cada conversa individualmente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ativar esta opção, as suas conversas do Olvid serão sugeridas quando partilhar a partir de outra aplicação. Esta escolha pode ser alterada ao nível da conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если вы активируете эту опцию, ваши обсуждения в Olvid будут предлагаться при совместном использовании из другого приложения. Этот выбор можно изменить на уровне обсуждения."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ви активуєте цей параметр, ваші обговорення Olvid будуть запропоновані під час спільного доступу з іншого додатка. Цей вибір можна змінити на рівні обговорення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您启用此选项，在从其他应用程序分享内容时，您的 Olvid 对话将被建议显示。您可以在对话级别中更改此设置。"
          }
        }
      }
    },
    "PERFORM_INTERACTION_DONATION_FOR_THIS_DISCUSSION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie diese Option aktivieren, wird dieser Chat beim Teilen von Inhalten aus anderen Apps vorgeschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you activate this option, this discussion will be suggested when sharing from another app."
          }
        },
        "es": {
