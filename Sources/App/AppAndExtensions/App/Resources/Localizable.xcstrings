    "NOTIFICATION_SOUNDS_SUBTITLE_POLYPHONIC": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Nachricht empfangen wird, wird eine zufällige Note des ausgewählten Instruments abgespielt. Probieren Sie es aus, indem Sie mehrfach auf Ihre bevorzugte Option tippen 😉."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When receiving a message, a random note of the selected instrument will be played. Give it a try by tapping your preferred choice several times 😉."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al recibir un mensaje, se reproducirá una nota aleatoria del instrumento seleccionado. Pruébalo tocando tu opción preferida varias veces 😉."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsque vous recevrez un message, vous entendrez une note aléatoire de l'instrument choisi. N'hésitez pas à essayer en appuyant plusieurs fois sur votre instrument préféré 😉."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ricevi un messaggio, verrà riprodotta una nota casuale dello strumento selezionato. Provalo toccando più volte la tua scelta preferita 😉."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを受信すると、選択した楽器の中からランダムに音が再生されます。好みの楽器を数回タップして試してみてください。😉"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메시지를 받으면 선택한 악기의 임의 음이 재생됩니다. 선호하는 악기를 여러 번 탭하여 사용해 보세요. 🎶"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao receber uma mensagem, uma nota aleatória do instrumento selecionado será reproduzida. Experimente tocando repetidamente na sua opção preferida. 🎵"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando receber uma mensagem, uma nota aleatória do instrumento selecionado será reproduzida. Experimente tocando repetidamente na sua opção preferida 🎶."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При получении сообщения будет случайным образом проиграна нота выбранного инструмента. Попробуйте, несколько раз нажав на предпочитаемый вариант 😉."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "При отриманні повідомлення відтворюватиметься випадкова нота вибраного інструменту. Спробуйте, кілька разів натиснувши на свій улюблений варіант 😉."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到消息时，会播放所选乐器中随机播放的音符。请尝试点击您喜欢的乐器几次，体验一下。😉"
          }
        }
      }
    },
