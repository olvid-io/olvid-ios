    "DELETE_ALL_MSGS_ON_ALL_DEVICES__ACTION_IRREVERSIBLE": {
      "comment": "Alert message",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie alle Nachrichten auf allen Geräten aller Benutzer in dieser Diskussion löschen? Diese Aktion ist unwiderruflich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you wish to delete all the messages on all the devices of all the users of this discussion? This action is irreversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Deseas eliminar todos los mensajes en todos los dispositivos de todos los usuarios de esta conversación? Esta acción es irreversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous supprimer tous les messages des appareils de tous les participants de cette discussion ? Attention, cette opération est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi eliminare tutti i messaggi su tutti i dispositivi di tutti gli utenti in questa conversazione? Questa azione è irreversibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットに参加しているすべてのユーザーの、すべてのデバイスにあるすべてのメッセージを削除しますか？ この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화에 참여하는 모든 사용자의 모든 기기에 있는 모든 메시지를 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
