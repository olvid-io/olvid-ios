    "LOCKOUT_CLEAN_EPHEMERAL_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn aktiviert, führt das dreimalige Eingeben eines falschen Passcodes hintereinander dazu, dass alle einmal gelesenen und mit eingeschränkter Sichtbarkeit versehenen Nachrichten geräuschlos gelöscht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When activated, entering a wrong passcode 3 times in a row will silently erase all read once and limited visibility messages."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se activa, ingresar un código de acceso incorrecto 3 veces seguidas borrará silenciosamente todos los mensajes de lectura única y de visibilidad limitada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand cette option est activée, saisir 3 mauvais codes d'affilée entraîne l'effacement silencieux de tous les messages à visibilité limitée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando attivata, inserire un codice di accesso errato per 3 volte consecutive cancellerà silenziosamente tutti i messaggi visualizzati una sola volta e con visibilità limitata."
          }
        }
      }
    },
