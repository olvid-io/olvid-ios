    "The core you entered is incorrect. The code you need to enter is the one displayed on your contact's device.": {
      "comment": "Message of an alert",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingegebene Code ist falsch. Der Code, den Sie eingeben müssen, wird auf dem Gerät Ihres Kontakts angezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code you entered is incorrect. The one you need to enter is the displayed on your contact's device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código que ingresaste es incorrecto. El código que necesitas ingresar es el que se muestra en el dispositivo de tu contacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code que vous avez entré est incorrect. Celui que vous devez entrer est affiché sur l'écran de votre contact."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il codice inserito non è corretto. Quello che devi inserire è quello visualizzato sul dispositivo del tuo contatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力されたコードは正しくありません。入力する必要があるのは、相手のデバイスに表示されているコードです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력하신 코드가 정확하지 않습니다. 입력해야 하는 코드는 상대방의 기기에 표시된 코드입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O código que você inseriu está incorreto. O código que você deve inserir é o que está sendo exibido no dispositivo do seu contato."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O código que introduziu está incorreto. O código que precisa de introduzir é o que está a ser exibido no dispositivo do seu contacto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введенный вами код неверен. Вам нужно ввести код, отображаемый на устройстве вашего контакта."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Код, який ви ввели, невірний. Вам потрібно ввести код, який відображається на пристрої вашого контакту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您输入的验证码不正确。请您输入您联系人设备上显示的验证码。"
          }
        }
      }
    },
