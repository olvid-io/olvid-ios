    "COUNT_BASED_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Nachrichten werden regelmäßig gelöscht, um die Anzahl der Nachrichten pro Konversation unterhalb des von Ihnen eingegebenen Wertes zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old messages will be regularly deleted, so as to keep the number of message per discussion less than the value you enter here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes antiguos se eliminarán periódicamente para mantener el número de mensajes por conversación por debajo del valor que introduzca aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciens messages de vos discussions seront régulièrement supprimés afin que le nombre maximal de messages par discussion reste inférieur à la limite que vous indiquez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi precedenti verranno cancellati regolarmente per mantenere il numero di messaggi per conversazione inferiore al valore che inserisci qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古いメッセージは定期的に削除され、各会話のメッセージ数が、ここで設定した値を超えないように維持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화당 메시지 수를 제한하기 위해 오래된 메시지는 주기적으로 삭제됩니다. 삭제되는 메시지 수를 설정하려면 여기에 값을 입력하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens antigas serão excluídas periodicamente, para que o número de mensagens por conversa não ultrapasse o valor que você definir aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens antigas serão eliminadas regularmente, de forma a manter o número de mensagens por conversa inferior ao valor que indicar aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые сообщения будут регулярно удаляться, чтобы количество сообщений в каждой беседе не превышало указанное вами значение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старі повідомлення будуть регулярно видалятися, щоб кількість повідомлень у кожній розмові була меншою за вказане вами значення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保持每个对话中的消息数量不超过您在此处设置的限制，旧消息将定期删除。"
          }
        }
      }
    },
    "COUNT_BASED_SINGLE_DISCUSSION_SECTION_FOOTER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Nachrichten werden regelmäßig aus diesem Chat gelöscht, um die Anzahl der Nachrichten unter dem von Ihnen angegebenen Wert zu halten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old messages will be regularly deleted from this discussion, so as to keep the number of message less than the value you enter here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes antiguos se eliminarán periódicamente de esta conversación, para mantener el número de mensajes por debajo del valor que introduzcas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciens messages de cette discussion seront régulièrement supprimés afin que leur nombre reste inférieur à la limite que vous indiquez ici."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I messaggi precedenti verranno eliminati regolarmente da questa conversazione, per mantenere il numero di messaggi inferiore al valore che inserirai qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットでは、メッセージの数が指定された数を超えないように、古いメッセージが定期的に削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화에서 오래된 메시지는 정기적으로 삭제되어 메시지 수가 사용자가 입력한 값보다 적게 유지됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagens antigas serão excluídas periodicamente desta conversa, para manter o número de mensagens abaixo do valor que você inserir aqui."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As mensagens antigas serão eliminadas periodicamente desta conversa, para que o número de mensagens seja inferior ao valor que introduzir aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые сообщения будут регулярно удаляться из этой беседы, чтобы количество сообщений не превышало указанное вами значение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Старі повідомлення будуть регулярно видалятися з цієї розмови, щоб кількість повідомлень не перевищувала значення, яке ви вкажете тут."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了保持此对话中的消息数量不超过您在此处设置的值，旧消息将定期删除。"
          }
        }
      }
    },
