    },
    "INVITATION_BODY_MEDIATOR_INVITE_ACCEPTED_%@_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast akzeptiert, von %1$@ mit %2$@ bekannt gemacht zu werden. Bitte warte, bis %2$@ diese Einladung ebenfalls annimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You accepted to be introduced to %2$@ by %1$@. Please wait until %2$@ also accepts this invitation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aceptaste ser presentado a %2$@ por %1$@. Por favor, espera hasta que %2$@ también acepte esta invitación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez accepté la présentation de %1$@. Veuillez attendre que %2$@ l'accepte également."
