            "value": "Por favor, autentícate para comenzar Olvid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiez-vous pour démarrer Olvid"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Effettua l'accesso per iniziare a usare Olvid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidを開始するには、認証してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid를 시작하려면 인증해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, faça login para começar a usar o Olvid"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentique-se para começar a usar o Olvid"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, авторизуйтесь, чтобы начать работу с Olvid"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, авторизуйтеся, щоб почати користуватися Olvid"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请验证身份以启动 Olvid"
          }
        }
      }
    },
    "Please fix this serious issue with Olvid": {
      "comment": "Mail subject",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beheben Sie dieses ernste Problem mit Olvid."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please fix this serious issue with Olvid"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, soluciona este grave problema con Olvid"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merci de corriger cette erreur dans Olvid"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di risolvere questo grave problema con Olvid"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidに関するこの重大な問題を修正してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid의 이 심각한 문제를 해결해주세요."
          }
        },
        "pt-BR": {
