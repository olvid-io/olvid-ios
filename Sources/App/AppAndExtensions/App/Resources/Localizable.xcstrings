    "ALL_ATTACHMENTS_WILL_BE_AUTOMATICALLY_DOWNLOADED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Anhänge werden automatisch heruntergeladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All attachments will be automatically downloaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los archivos adjuntos se descargarán automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les pièces jointes seront téléchargées automatiquement."
          }
        },
        "it": {
