    "MANUAL_BACKUP_EXPLANATION_FOOTER": {
      "comment": "Table view section footer",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermöglicht die Erstellung eines verschlüsselten Backups Ihrer Kontakte, Gruppen und Einstellungen (Nachrichten und Anhänge werden nicht gesichert). Sie können dieses Backup entweder teilen (per E-Mail versenden, in Dateien speichern,...) oder direkt in iCloud hochladen. Keine Sorge, dieses Backup ist verschlüsselt 🔒."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allows to export an encrypted backup of your contacts, groups, and settings (messages and attachments are not backuped). You can either share it (email it, save it to Files,...) or upload it directely to iCloud. Do not worry, this backup is encrypted 😇."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite exportar una copia de seguridad encriptada de tus contactos, grupos y ajustes (los mensajes y archivos adjuntos no se respaldan). Puedes compartirla (por correo electrónico, guardarla en Archivos,...) o subirla directamente a iCloud. No te preocupes, esta copia de seguridad está encriptada 🔒."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Permet d'exporter une sauvegarde chiffrée de vos contacts, groupes et paramètres (les messages et pièces jointes ne sont pas sauvegardés). Vous pouvez la partager (l'envoyer par mail, la sauvegarder dans Fichiers, etc.) ou la sauvegarder directement vers iCloud. Ne vous en faites pas, cette sauvegarde est chiffrée 😇."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permette di esportare un backup crittografato dei tuoi contatti, gruppi e impostazioni (messaggi e allegati non vengono salvati). Puoi condividerlo (inviarlo via email, salvarlo su File,...) oppure caricarlo direttamente su iCloud. Non preoccuparti, questo backup è crittografato 🔒."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を使用すると、連絡先、グループ、設定の暗号化されたバックアップをエクスポートできます（メッセージと添付ファイルはバックアップされません）。エクスポートしたバックアップは、共有（メール送信、ファイルに保存など）したり、iCloudに直接アップロードしたりできます。ご安心ください。このバックアップは暗号化されています😇。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연락처, 그룹 및 설정을 암호화하여 백업할 수 있습니다(메시지와 첨부 파일은 백업되지 않음). 이 백업 파일을 공유하거나(이메일로 보내거나, 파일에 저장하거나...) iCloud에 직접 업로드할 수 있습니다. 걱정하지 마세요. 이 백업 파일은 암호화되어 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite exportar um backup criptografado dos seus contatos, grupos e configurações (mensagens e anexos não são incluídos no backup). Você pode compartilhá-lo (enviá-lo por e-mail, salvá-lo no Arquivos...) ou enviá-lo diretamente para o iCloud. Não se preocupe, este backup é criptografado 🔒."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite exportar uma cópia de segurança encriptada dos seus contactos, grupos e definições (as mensagens e anexos não são guardados). Pode partilhá-la (enviá-la por e-mail, guardá-la nos Ficheiros, etc.) ou carregá-la diretamente para o iCloud. Não se preocupe, esta cópia de segurança está encriptada 🔒."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяет экспортировать зашифрованную резервную копию ваших контактов, групп и настроек (сообщения и вложения не резервируются). Вы можете поделиться ею (отправить по электронной почте, сохранить в «Файлы» и т. д.) или загрузить ее непосредственно в iCloud. Не беспокойтесь, эта резервная копия зашифрована 🔒."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дозволяє експортувати зашифровану резервну копію ваших контактів, груп і налаштувань (повідомлення та вкладення не резервуються). Ви можете поділитися нею (надіслати електронною поштою, зберегти у Файли тощо) або завантажити її безпосередньо в iCloud. Не хвилюйтеся, ця резервна копія зашифрована 🔒."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许您导出包含您的联系人、群组和设置的加密备份（消息和附件不包含在备份中）。您可以选择共享备份（通过电子邮件发送、保存到“文件”等），或直接上传到 iCloud。请放心，此备份是加密的 😇。"
          }
        }
      }
    },
