    "INVITATION_BODY_SAS_CONFIRMED_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast geschafft! Bitte gib deinen Code an %@ weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost there! Please give your code to %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ya casi! Por favor, comparte tu código con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous y sommes presque ! Transmettez votre code à %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci siamo quasi! Per favore, fornisci il tuo codice a %@."
          }
        }
      }
    },
    "INVITATION_BODY_SAS_EXCHANGE_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um mit %1$@ zu sprechen, müssen Sie ihnen Ihren Code geben und ihren Code eingeben. Diese Codes sind nicht geheim, aber bitte stellen Sie sicher, dass %1$@ tatsächlich die Person ist, die Ihnen den Code gibt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To discuss with %1$@, you must give them your code and enter theirs. Those codes are not secret, but please make sure that %1$@ is indeed the one giving you the code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para hablar con %1$@, debes proporcionarles tu código e ingresar el suyo. Esos códigos no son secretos, pero asegúrate de que %1$@ sea realmente quien te está dando el código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour discuter avec %1$@, vous devez lui transmettre votre code et saisir le sien. Ces codes ne sont pas secrets, mais assurez-vous que c'est bien %1$@ qui vous transmet son code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per parlare con %1$@, devi fornire il tuo codice e inserire il loro. Questi codici non sono segreti, ma assicurati che sia effettivamente %1$@ a fornirtelo."
          }
        }
      }
    },
