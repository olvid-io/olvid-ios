    "AUTO_READ_SECTION_FOOTER" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ephemeral Nachrichten automatisch öffnen. Dies gilt nur für Nachrichten, deren Ephemerität auf Diskussionsebene festgelegt wurde und nicht für Nachrichten, bei denen der Absender eine bestimmte Ephemerität wählt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatically open ephemeral messages. This only applies to messages whose ephemerality was set at the discussion level and not to messages for which the sender chooses a specific ephemerality."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abrir automáticamente los mensajes efímeros. Esto solo se aplica a los mensajes cuya efimeridad se estableció a nivel de la conversación y no a los mensajes para los cuales el remitente elige una efimeridad específica."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrir automatiquement les messages éphémères. Cette ouverture automatique ne s'applique qu'aux messages dont l'éphémérité est due aux paramètres choisis pour la discussion entière, et pas aux messages dont l'éphémérité est spécifiquement choisie par l'envoyeur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri automaticamente i messaggi effimeri. Questo si applica solo ai messaggi la cui effimerità è stata impostata a livello di discussione e non ai messaggi per i quali il mittente sceglie una specifica effimerità."
          }
        }
      }
    },
