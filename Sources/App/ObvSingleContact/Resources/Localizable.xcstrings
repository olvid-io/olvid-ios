          }
        }
      }
    },
    "CONTACT_IS_NOT_ACTIVE_EXPLANATION_BODY" : {
      "comment" : "The body of an explanation that appears when a contact is not active.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Kontakt wurde von Ihrem Unternehmens-Identitätsanbieter widerrufen. Ihre Olvid ID könnte kompromittiert worden sein, und die Sicherheit Ihrer Kommunikation kann nicht garantiert werden.\n\nWenn Sie sicher sind, dass die Olvid ID Ihres Kontakts niemals kompromittiert wurde, können Sie ihn manuell entsperren.\nWenden Sie sich für weitere Details an Ihren Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This contact was revoked by your company's identity provider. Their Olvid ID may have been compromised and the security of your communications cannot be guaranteed.\n\nIf you are sure your contact's Olvid ID was never compromised you may manually unblock them.\nPlease contact your administrator for more details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este contacto fue revocado por el proveedor de identidad de su empresa. Su ID de Olvid podría haberse visto comprometido y no se puede garantizar la seguridad de sus comunicaciones.\n\nSi está seguro de que el ID de Olvid de su contacto nunca se vio comprometido, puede desbloquearlo manualmente.\nPóngase en contacto con su administrador para obtener más detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce contact a été révoqué par le fournisseur d'identité de votre société. Son ID Olvid a peut-être été compromis et la sécurité de vos communications ne peut être garantie.\n\nSi vous êtes certain que l'ID Olvid de votre contact n'a jamais été compromis, vous pouvez le débloquer manuellement.\nVeuillez contacter votre administrateur pour plus d'informations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo contatto è stato revocato dal tuo provider di identità aziendale. Il loro ID Olvid potrebbe essere stato compromesso e la sicurezza delle vostre comunicazioni non può essere garantita.\n\nSe sei sicuro che l'ID Olvid del tuo contatto non sia mai stato compromesso, puoi sbloccarlo manualmente.\nContatta il tuo amministratore per maggiori dettagli."
          }
        }
      }
    },
    "CONTACT_IS_NOT_ACTIVE_EXPLANATION_TITLE" : {
      "comment" : "The title of the explanation displayed when a contact is not active.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kontakt wurde von Ihrem Unternehmens-Identitätsanbieter gesperrt"
