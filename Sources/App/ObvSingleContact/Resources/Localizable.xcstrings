    "ONE_TO_ONE_INVITATION_SENT_TO_%@_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %@ zu einem privaten Gespräch eingeladen. Bitte warten Sie, bis sie es annehmen. 🤞."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You invited %@ to have a private discussion. Please wait until they accept it 🤞."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitaste a %@ a tener una conversación privada. Por favor, espera a que la acepte 🤞."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez envoyé une invitation à discuter en privé à %@, qui doit encore l'accepter 🤞."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai invitato %@ ad avere una discussione privata. Attendi che la accetti 🤝."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をプライベートなディスカッションに招待しました。相手が承諾するまでお待ちください。🤞"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하께서 %@님을 개인 대화에 초대했습니다. 상대방이 수락할 때까지 기다려 주세요. 💬"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproszono kontakt %@ do prywatnej dyskusji. Poczekaj, aż zaproszenie zostanie zaakceptowane 🤞."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você convidou %@ para ter uma conversa particular. Por favor, aguarde até que ele(a) aceite. ⏳"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Convidaste o(a) %@ para uma conversa privada. Aguarda que aceite o convite. ⏳"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пригласили %@ к приватной беседе. Пожалуйста, подождите, пока они примут приглашение 🤞."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adlı kişiyi özel bir sohbete davet ettiniz. Lütfen daveti kabul etmesini bekleyin 🤞."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви запросили %@ до приватної розмови. Будь ласка, зачекайте, поки вони приймуть запрошення 🤞."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã mời %@ tham gia một cuộc trò chuyện riêng tư. Vui lòng đợi họ chấp nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你邀请了 %@ 加入私聊。请等待对方接受邀请 🤞。"
          }
        }
      }
    },
    "ONE_TO_ONE_INVITATION_TO_%@_REQUIRED_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um eine private Unterhaltung mit %@ zu führen und diese zu Ihren Kontakten hinzuzufügen, tippen Sie auf „Einladen“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To have a private discussion with %@ and add them to your contacts, touch \"Invite\"."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tener una conversación privada con %@ y agregarlos a tus contactos, toca \"Invitar\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour discuter en privé avec %@ et l'ajouter à vos contacts, touchez « Inviter »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per avviare una conversazione privata con %@ e aggiungerlo ai tuoi contatti, tocca \"Invita\"."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@とプライベートな会話をするには、「招待」をタップして、連絡先に登録してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": " %@님과 개인적인 대화를 나누고 연락처에 추가하려면 \"초대\"를 누르세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby prowadzić prywatną dyskusję z użytkownikiem %@ i dodać go do kontaktów, stuknij „Zaproś”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para iniciar uma conversa privada com %@ e adicioná-lo(a) aos seus contatos, toque em \"Convidar\"."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ter uma conversa privada com %@ e adicioná-lo(a) aos seus contactos, toque em \"Convidar\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы начать приватную беседу с %@ и добавить их в контакты, нажмите «Пригласить»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ile özel bir sohbet başlatmak ve kişilerinize eklemek için \"Davet et\" seçeneğine dokunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб приватно поспілкуватися з %@ та додати їх до контактів, натисніть \"Запросити\"."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để có một cuộc trò chuyện riêng tư với %@ và thêm họ vào danh bạ của bạn, hãy chạm vào \"Mời\"."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要与 %@ 进行私密对话并将他们添加到您的联系人中，请点击“邀请”。"
          }
        }
      }
    },
