    "CONTACT_INTRODUCTION_EXPLANATION_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde %@ mit jemandem in deinem Netzwerk. Die Person muss die Einladung lediglich akzeptieren, um mit dem Chat zu beginnen – keine QR-Codes oder Codes erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect %@ with someone in your network. They’ll only need to accept the invitation to start chatting—no QR codes or codes needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta a %@ con alguien de tu red. Solo necesitarán aceptar la invitación para empezar a conversar, sin necesidad de códigos QR ni códigos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettez %@ en relation avec quelqu’un de votre réseau. Il leur suffira d’accepter l’invitation pour commencer à discuter — aucun QR code ou code à échanger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega %@ a qualcuno nella tua rete. Dovranno solo accettare l'invito per iniziare a chattare – niente codici QR o codici necessari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワーク内の誰かと%@を接続します。相手は招待を承認するだけで、チャットを開始できます。QRコードやコードは必要ありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네트워크에 있는 누군가와 %@을 연결하세요. 상대방은 채팅을 시작하기 위해 초대만 수락하면 됩니다. QR 코드나 코드는 필요하지 않습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przedstaw kontakt %@ komuś ze swoich kontaktów. Wystarczy, że obie osoby zaakceptują zaproszenie, aby zacząć rozmawiać — bez skanowania kodów QR ani wpisywania kodów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte %@ com alguém da sua rede. A pessoa só precisará aceitar o convite para começar a conversar — sem necessidade de códigos QR ou códigos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligue o %@ a alguém da sua rede. A pessoa apenas precisa de aceitar o convite para começar a conversar — não são necessários códigos QR nem códigos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите %@ к кому-нибудь из вашей сети. Им потребуется только принять приглашение, чтобы начать чат — не нужны QR-коды или коды."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ adlı kişiyi ağınızdaki biriyle tanıştırın. Sohbete başlamak için yalnızca daveti kabul etmeleri yeterli; QR kodu veya başka bir koda gerek yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зв’яжіть %@ з кимось у вашій мережі. Їм потрібно буде лише прийняти запрошення, щоб почати спілкування – не потрібні QR-коди чи коди."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối %@ với ai đó trong mạng lưới của bạn. Họ chỉ cần chấp nhận lời mời để bắt đầu trò chuyện—không cần mã QR hoặc mã nào cả."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将 %@ 与您网络中的某人连接。他们只需接受邀请即可开始聊天——无需二维码或代码。"
          }
        }
      }
    },
