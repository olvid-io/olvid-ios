          "stringUnit": {
            "state": "translated",
            "value": "귀하께서 %@님을 개인 대화에 초대했습니다. 상대방이 수락할 때까지 기다려 주세요. 💬"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você convidou %@ para ter uma conversa particular. Por favor, aguarde até que ele(a) aceite. ⏳"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Convidaste o(a) %@ para uma conversa privada. Aguarda que aceite o convite. ⏳"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы пригласили %@ к приватной беседе. Пожалуйста, подождите, пока они примут приглашение 🤞."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви запросили %@ до приватної розмови. Будь ласка, зачекайте, поки вони приймуть запрошення 🤞."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你邀请了 %@ 加入私聊。请等待对方接受邀请 🤞。"
          }
        }
      }
    },
    "ONE_TO_ONE_INVITATION_TO_%@_REQUIRED_EXPLANATION": {
      "localizations": {
        "de": {
