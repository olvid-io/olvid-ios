    "YOU_NEED_TO_INVITE_%@_BEFORE_HAVING_DISCUSSION_ALERT_MESSAGE": {
      "comment": "A message that appears in an alert when a user taps the chat button on a one-to-one contact that they haven't invited yet. The placeholder is replaced with the contact's nickname or short name",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können keine private Unterhaltung mit %@ führen, bis diese Person zu Ihren Kontakten gehört. Möchten Sie sie jetzt einladen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot have a private discussion with %@ until they are part of your contacts. Do you wish to invite them now?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes tener una conversación privada con %@ hasta que sean parte de tus contactos. ¿Deseas invitarlos ahora?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas discuter en privé avec %@ tant que cet utilisateur ne fait pas partie de vos contacts. Vous pouvez l'y inviter maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi avviare una discussione privata con %@ finché non è tra i tuoi contatti. Vuoi invitarlo/a ora?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先に登録されているユーザーとのみ、プライベートな会話ができます。%@を今すぐ招待しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 연락처에 추가될 때까지 비공개 대화를 할 수 없습니다. 지금 초대하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie możesz prowadzić prywatnej dyskusji z użytkownikiem %@, dopóki nie znajdzie się wśród twoich kontaktów. Czy chcesz teraz zaprosić tę osobę?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode ter uma conversa privada com %@ até que essa pessoa esteja em seus contatos. Deseja convidá-la agora?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode iniciar uma conversa privada com %@ até que essa pessoa esteja na sua lista de contactos. Deseja convidá-la agora?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не можете начать личную переписку с %@, пока он/она не будет в ваших контактах. Хотите пригласить его/её сейчас?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişileriniz arasına katılana kadar bu kişiyle özel bir sohbet başlatamazsınız. Şimdi davet etmek ister misiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не можете мати приватну розмову з %@, поки вони не будуть у вашому списку контактів. Чи бажаєте ви запросити їх зараз?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn không thể có cuộc trò chuyện riêng tư với %@ cho đến khi họ là một trong danh bạ của bạn. Bạn có muốn mời họ ngay bây giờ không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
