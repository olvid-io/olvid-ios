    "CANNOT_DELETE_USER_%@_AS_PART_OF_COMMON_GROUPS" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können den Benutzer %@ nicht löschen, da Sie beide zu einigen gemeinsamen Gruppen gehören. Sie müssen diese Gruppen verlassen, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You cannot delete the user %@ as both of you belong to some common groups. You will need to leave these groups to proceed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes eliminar al usuario %@ ya que ambos pertenecen a algunos grupos en común. Deberás abandonar estos grupos para continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas supprimer l'utilisateur %@ car vous appartenez à certains groupes en commun. Vous devrez quitter ces groupes pour pouvoir continuer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi eliminare l'utente %@ perché entrambi appartenete ad alcuni gruppi in comune. Dovrai lasciare questi gruppi per procedere."
          }
        }
      }
    },
