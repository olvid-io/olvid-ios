    "ONE_TO_ONE_INVITATION_SENT_TO_%@_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie haben %@ zu einem privaten Gespräch eingeladen. Bitte warten Sie, bis sie es annehmen. 🤞."
          }
        },
        "en": {
