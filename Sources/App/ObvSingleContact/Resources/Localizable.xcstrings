    "CANNOT_DELETE_USER_%@_AS_PART_OF_COMMON_GROUPS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können den Benutzer %@ nicht löschen, da Sie beide zu einigen gemeinsamen Gruppen gehören. Sie müssen diese Gruppen verlassen, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot delete the user %@ as both of you belong to some common groups. You will need to leave these groups to proceed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes eliminar al usuario %@ ya que ambos pertenecen a algunos grupos en común. Deberás abandonar estos grupos para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas supprimer l'utilisateur %@ car vous appartenez à certains groupes en commun. Vous devrez quitter ces groupes pour pouvoir continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi eliminare l'utente %@ perché entrambi appartenete ad alcuni gruppi in comune. Dovrai lasciare questi gruppi per procedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー %@ を削除できません。お二人ともいくつかの共通のグループに所属しているためです。削除するには、これらのグループから退出する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 분 모두 속한 공통 그룹이 있어 사용자 %@를 삭제할 수 없습니다. 진행하려면 해당 그룹에서 나가야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode excluir o usuário %@ porque ambos pertencem a alguns grupos em comum. Você precisará sair desses grupos para continuar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode eliminar o utilizador %@, pois ambos pertencem a alguns grupos em comum. Terá de abandonar estes grupos para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не можете удалить пользователя %@, так как вы оба состоите в общих группах. Вам необходимо покинуть эти группы, чтобы продолжить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не можете видалити користувача %@, оскільки ви обидва належите до спільних груп. Вам потрібно покинути ці групи, щоб продовжити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无法删除用户 %@，因为你们都属于一些共同的群组。您需要先退出这些群组才能继续操作。"
          }
        }
      }
    },
