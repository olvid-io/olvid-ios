            "value": "귀사의 ID 공급업체에서 연락처 권한을 해지했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontakt unieważniony przez dostawcę tożsamości twojej firmy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Contato revogado pelo provedor de identidade da sua empresa"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacto revogado pelo fornecedor de identidade da sua empresa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт был отозван поставщиком удостоверений вашей компании"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişi, şirketinizin kimlik sağlayıcısı tarafından geçersiz kılındı"
