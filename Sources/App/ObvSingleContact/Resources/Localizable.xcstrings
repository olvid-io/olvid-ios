    "ESTABLISHING_SECURE_CHANNEL": {
      "comment": "A title displayed in the top of the view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Gesprächsverbindung wird aufgebaut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Establishing a secure discussion channel"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estableciendo un canal de discusión seguro"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Création d'un canal de discussion sécurisé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Canale di discussione sicuro in fase di creazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュアなチャットチャンネルを確立します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안전한 대화 채널을 설정 중입니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nawiązywanie bezpiecznego kanału dyskusji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estabelecendo um canal de comunicação seguro"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A estabelecer um canal de comunicação seguro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установление защищенного канала связи"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güvenli sohbet kanalı kuruluyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлення захищеного каналу зв’язку"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang thiết lập kênh trò chuyện an toàn"
          }
        },
        "zh-Hans": {
