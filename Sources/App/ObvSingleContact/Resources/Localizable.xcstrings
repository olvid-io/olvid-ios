    "ARE_YOU_SURE_YOU_WANT_TO_DELETE_%@_FROM_YOUR_CONTACTS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie %@ aus Ihren Kontakten entfernen möchten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to remove %@ from your contacts?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar a %@ de tus contactos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez-vous vouloir retirer %@ de vos contacts ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler rimuovere %@ dai tuoi contatti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当に %@ を連絡先から削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정말로 연락처에서 %@를 삭제하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć użytkownika %@ z kontaktów?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem certeza de que deseja remover %@ de seus contatos?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que quer remover %@ dos seus contactos?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите удалить %@ из ваших контактов?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kişilerinizden kaldırılsın mı?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете видалити %@ зі своїх контактів?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn xóa %@ khỏi danh bạ của mình không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要从您的联系人中移除 %@ 吗？"
          }
        }
      }
    },
    "ARE_YOU_SURE_YOU_WANT_TO_FULLY_DELETE_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sind Sie sicher, dass Sie %@ dauerhaft von Ihrem Konto löschen möchten?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to permanently delete %@ from your account?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que quieres eliminar permanentemente a %@ de tu cuenta?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez-vous vouloir supprimer définitivement %@ de votre compte ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare definitivamente %@ dal tuo account?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本当に、アカウントから%@を完全に削除しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정에서 %@를 영구적으로 삭제하시겠습니까?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz trwale usunąć użytkownika %@ ze swojego konta?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você tem certeza de que deseja excluir permanentemente %@ da sua conta?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem a certeza de que pretende eliminar permanentemente %@ da sua conta?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы уверены, что хотите навсегда удалить %@ из своей учётной записи?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hesabınızdan kalıcı olarak silinsin mi?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви впевнені, що хочете назавжди видалити %@ зі свого облікового запису?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc muốn xóa vĩnh viễn %@ khỏi tài khoản của mình không?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您确定要永久从您的帐户中删除 %@ 吗？"
          }
        }
      }
    },
    "AT_LEAST_ONE_CHANNEL_FAILED_TO_RESTART": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindestens eine Kanalverbindung konnte nicht neu gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least one of the channel establishment failed to restart"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al menos uno de los intentos de establecer el canal falló al reiniciarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erreur lors du redémarrage de l'établissement d'un canal sécurisé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Almeno una delle connessioni di canale non è riuscita a riavviarsi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャンネルの確立に失敗し、再試行できませんでした"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채널 연결 시도 중 최소 하나가 실패하여 재시도할 수 없습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ponownie uruchomić nawiązywania co najmniej jednego kanału"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos uma das tentativas de estabelecer o canal falhou ao tentar reiniciar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelo menos uma das tentativas de estabelecer a ligação falhou e não foi possível repetir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По крайней мере, одна из попыток установить канал не удалась"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanal kurulumlarından en az biri yeniden başlatılamadı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відновити з’єднання не вдалося, оскільки виникла помилка в одному або декількох каналах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ít nhất một trong số các kênh đã không thể được thiết lập lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "至少有一个频道建立失败，无法重启"
          }
        }
      }
    },
