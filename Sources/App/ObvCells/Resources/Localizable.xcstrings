          "stringUnit": {
            "state": "translated",
            "value": "Это устройство контакта уже доступно"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей контакт вже доступний на цьому пристрої"
          }
