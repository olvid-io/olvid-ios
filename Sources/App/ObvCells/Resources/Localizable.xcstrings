        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该联系人的设备已可联系"
          }
        }
      }
    },
    "PRE_KEY_IS_NOT_AVAILABLE_FOR_CONTACT_DEVICE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die Kontaktaufnahme mit diesem Gerät ist ein sicherer Kanal erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A secure channel is required in order to reach this contact device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere un canal seguro para contactar con este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un canal sécurisé est requis pour pouvoir joindre cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È necessario un canale sicuro per raggiungere il dispositivo di questo contatto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この連絡先のデバイスに接続するには、安全なチャンネルが必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 연락처 장치에 연결하려면 보안 채널이 필요합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um canal seguro é necessário para se comunicar com este dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessário um canal de comunicação seguro para contactar este dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для связи с этим устройством контакта требуется защищенный канал."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для зв’язку з цим пристроєм потрібен захищений канал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了联系此联系人的设备，需要建立安全连接。"
          }
        }
      }
    },
