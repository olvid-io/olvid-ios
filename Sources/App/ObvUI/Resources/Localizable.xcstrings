    "HOLD_DOWN_CMD_TO_SELECT_MULTIPLE_DISCUSSIONS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Befehlstaste gedrückt, um mehrere Konversationen gleichzeitig auszuwählen."
