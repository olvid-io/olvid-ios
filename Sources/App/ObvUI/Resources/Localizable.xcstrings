    "DISCUSSIONS_LIST_SELECTION_PLACEHOLDER_CELL": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine oder mehrere Konversationen aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select one or more discussions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una o más conversaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une ou plusieurs discussions"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona una o più conversazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1つまたは複数の会話を選択"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나 이상의 대화를 선택하세요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jedną lub więcej dyskusji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma ou mais conversas"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma ou mais conversas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите одну или несколько дискуссий"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir veya daha fazla sohbet seçin"
          }
        },
        "uk": {
          "stringUnit": {
