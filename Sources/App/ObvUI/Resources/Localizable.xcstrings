    "HOLD_DOWN_CMD_TO_SELECT_MULTIPLE_DISCUSSIONS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie die Befehlstaste gedrückt, um mehrere Konversationen gleichzeitig auszuwählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please hold down the Command key to select multiple discussions at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén presionada la tecla Comando para seleccionar varias conversaciones a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez la touche Commande enfoncée pour sélectionner plusieurs conversations."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenere premuto il tasto Comando per selezionare più conversazioni contemporaneamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Commandキーを押しながら、複数のチャットを一度に選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Command 키를 길게 눌러 여러 대화 항목을 한 번에 선택하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj klawisz Command, aby zaznaczyć wiele dyskusji naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione e segure a tecla Command para selecionar várias conversas de uma vez."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha a tecla Comando pressionada para selecionar várias conversas ao mesmo tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, удерживайте клавишу Command, чтобы выбрать несколько диалогов одновременно."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda birden fazla sohbet seçmek için lütfen Command tuşunu basılı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, утримуйте клавішу Command, щоб вибрати кілька розмов одночасно."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vui lòng giữ phím Command để chọn nhiều cuộc trò chuyện cùng một lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按住 Command 键，一次选择多个对话。"
          }
        }
      }
    },
