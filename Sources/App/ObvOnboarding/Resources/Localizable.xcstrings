    "OWNED_IDENTITY_TRANSFER_ENTER_CODE_ON_OTHER_DEVICE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib diesen Code auf deinem anderen Gerät ein"
          }
        },
        "en": {
          "stringUnit": {
