          }
        }
      }
    },
    "RESTORE_BACKUP_FAILED_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung konnte nicht wiederhergestellt werden. Wenn möglich, empfehlen wir, eine andere Sicherung wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup could not be restored. If you can, we recommend you try to restore another backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar la copia de seguridad. Si es posible, recomendamos que intentes restaurar otra copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n'a malheureusement pas pu être restaurée. Si vous le pouvez, nous vous recommandons d'essayer de restaurer une autre sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup non è stato ripristinato. Se possibile, ti consigliamo di provare a ripristinare un altro backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの復元に失敗しました。別のバックアップを復元できる場合は、そちらをお試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업을 복원할 수 없습니다. 가능하다면 다른 백업을 복원해 보시는 것을 권장합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup não pôde ser restaurado. Se possível, recomendamos que você tente restaurar outro backup."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível restaurar a cópia de segurança. Se possível, recomendamos que tente restaurar outra cópia de segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервную копию не удалось восстановить. Если возможно, рекомендуем попробовать восстановить другую резервную копию."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося відновити резервну копію. Якщо можливо, рекомендуємо спробувати відновити іншу резервну копію."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法恢复备份。如果可以，我们建议您尝试恢复其他备份。"
          }
        }
      }
    },
    "RESTORING_BACKUP_PLEASE_WAIT": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherung wird wiederhergestellt. Bitte warten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restoring backup. Please Wait."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurando la copia de seguridad. Por favor, espere."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restauration en cours..."
          }
        },
