    "MISMATCH_BETWEEN_KEYCLOAK_DISTRIBUTION_SERVER_AND_EXISTING_PROFILE_DISTRIBUTION_SERVER" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Konfiguration Ihres Unternehmens-Identitätsanbieters mit Ihrem aktuellen Olvid-Profil ist nicht möglich. Ihr Profil wurde auf einem anderen Olvid-Server erstellt.\n\nWenden Sie sich für weitere Informationen an Ihren Administrator."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to configure your company's identity provider with your current Olvid profile. Your profile was generated on a different Olvid server.\n\nPlease contact your administrator for more details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo configurar el proveedor de identidad de su empresa con su perfil Olvid actual. Su perfil fue generado en un servidor Olvid diferente.\n\nPóngase en contacto con su administrador para obtener más detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de configurer le fournisseur d'identité de votre entreprise avec votre profil Olvid actuel. Votre profil a été généré sur un serveur Olvid différent.\n\nVeuillez contacter votre administrateur pour plus de détails."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile configurare il provider di identità della tua azienda con il tuo profilo Olvid attuale. Il tuo profilo è stato generato su un server Olvid differente.\n\nContatta il tuo amministratore per maggiori dettagli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のOlvidプロファイルでは、会社のIDプロバイダーを設定できません。プロファイルは別のOlvidサーバーで生成されたものです。\n詳細については、管理者にお問い合わせください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 Olvid 프로필로 회사 ID 공급자를 구성할 수 없습니다. 프로필이 다른 Olvid 서버에서 생성되었습니다.\n자세한 내용은 관리자에게 문의하십시오."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można skonfigurować dostawcy tożsamości twojej firmy z obecnym profilem Olvid. Twój profil został wygenerowany na innym serwerze Olvid.\n\nSkontaktuj się z administratorem, aby uzyskać więcej informacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível configurar o provedor de identidade da sua empresa com seu perfil Olvid atual. Seu perfil foi gerado em um servidor Olvid diferente.\n\nEntre em contato com seu administrador para obter mais detalhes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível configurar o fornecedor de identidade da sua empresa com o seu perfil Olvid atual. O seu perfil foi gerado num servidor Olvid diferente.\n\nContacte o seu administrador para mais detalhes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось настроить поставщика удостоверений вашей компании с вашим текущим профилем Olvid. Ваш профиль был создан на другом сервере Olvid.\n\nОбратитесь к вашему администратору для получения дополнительной информации."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şirketinizin kimlik sağlayıcısı mevcut Olvid profilinizle yapılandırılamıyor. Profiliniz farklı bir Olvid sunucusunda oluşturulmuş.\n\nDaha fazla bilgi için lütfen yöneticinize başvurun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося налаштувати провайдера ідентифікації вашої компанії з поточним профілем Olvid. Ваш профіль було згенеровано на іншому сервері Olvid.\n\nЗверніться до свого адміністратора для отримання додаткової інформації."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể cấu hình nhà cung cấp danh tính của công ty với cấu hình Olvid hiện tại của bạn. Cấu hình của bạn được tạo trên một máy chủ Olvid khác.\nVui lòng liên hệ với quản trị viên để biết thêm chi tiết."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法使用您当前的 Olvid 配置文件来配置您公司的身份提供程序。您的配置文件是在不同的 Olvid 服务器上生成的。\n\n请联系您的管理员以获取更多详细信息。"
          }
        }
      }
    },
