            "state": "translated",
            "value": "Les autres appareils seront désactivés dans les 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altri dispositivi verranno disattivati entro 30 giorni."
          }
        }
