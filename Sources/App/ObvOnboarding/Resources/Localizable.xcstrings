    "PROTECT_PRIVACY_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Ihre Privatsphäre zu schützen, hat Olvid **kein öffentliches oder zentrales Benutzerverzeichnis**. Ihr Profil wird nur den **Personen angezeigt, mit denen Sie sich verbinden**."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To protect your privacy, Olvid has **no public or central user directory**. Your profile will only be seen by the **people you connect with**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proteger tu privacidad, Olvid **no tiene un directorio público o central de usuarios**. Tu perfil solo será visible para **las personas con las que te conectes**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour protéger votre vie privée, Olvid n'a **pas d'annuaire centralisé des utilisateurs**. Seuls **vos contacts** verront votre profil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per proteggere la tua privacy, Olvid **non ha una directory pubblica o centralizzata di utenti**. Il tuo profilo sarà visibile solo alle **persone con cui ti connetti**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライバシー保護のため、Olvidには**公開または中央集権型のユーザーディレクトリはありません**。お客様のプロフィールは、**お客様が接続した相手**にのみ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 개인 정보를 보호하기 위해 Olvid에는 **공개되거나 중앙 집중식 사용자 디렉터리가 없습니다**. 사용자의 프로필은 **연결된 사람에게만** 표시됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby chronić twoją prywatność, Olvid **nie ma publicznego ani centralnego katalogu użytkowników**. Twój profil zobaczą tylko **osoby, z którymi nawiążesz kontakt**."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proteger sua privacidade, o Olvid **não possui um diretório público ou central de usuários**. Seu perfil só será visível para as **pessoas com quem você se conectar**."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para proteger a sua privacidade, o Olvid **não tem um diretório de utilizadores público ou centralizado**. O seu perfil só será visível para as **pessoas com quem se conectar**."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для защиты вашей конфиденциальности в Olvid **нет общедоступного или централизованного каталога пользователей**. Ваш профиль будет виден только **людям, с которыми вы общаетесь**."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizliliğinizi korumak için Olvid'in **herkese açık veya merkezi bir kullanıcı rehberi yoktur**. Profilinizi yalnızca **bağlantı kurduğunuz kişiler** görebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб захистити вашу приватність, Olvid **не має публічного або централізованого списку користувачів**. Ваш профіль буде видно лише **тим людям, з якими ви спілкуєтесь**."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để bảo vệ quyền riêng tư của bạn, Olvid **không có thư mục người dùng công khai hoặc tập trung**. Hồ sơ của bạn chỉ hiển thị cho **những người bạn kết nối**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了保护您的隐私，Olvid **没有公共或中心化的用户目录**。您的个人资料只会对您**连接的人**可见。"
          }
        }
      }
    },
    "RECORD_PERMISSION_TEXT_1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um Telefon- und Videoanrufe ohne Unterbrechung empfangen zu können, ist Mikrofonzugriff erforderlich. Dies stellt sicher, dass Sie kein wichtiges Gespräch verpassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To receive phone and video calls without interruption, microphone access is required. This ensures you never miss an important conversation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para recibir llamadas de voz y video sin interrupciones, se requiere acceso al micrófono. Esto garantiza que nunca te pierdas una conversación importante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour recevoir les appels téléphoniques et vidéo sans problème, l’accès au microphone est nécessaire. Ainsi, vous ne manquerez jamais une conversation importante."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per ricevere chiamate vocali e video senza interruzioni, è necessario l'accesso al microfono. Questo assicura che tu non perda mai una conversazione importante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話やビデオ通話を途切れることなく受信するには、マイクへのアクセスが必要です。これにより、重要な会話を見逃すことがなくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전화 및 영상 통화를 끊김 없이 받으려면 마이크 접근 권한이 필요합니다. 이렇게 하면 중요한 대화를 놓치지 않도록 할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby odbierać połączenia głosowe i wideo bez zakłóceń, wymagany jest dostęp do mikrofonu. Dzięki temu nie przegapisz żadnej ważnej rozmowy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para receber chamadas de voz e vídeo sem interrupção, é necessário conceder acesso ao microfone. Isso garante que você nunca perca uma conversa importante."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para receber chamadas de voz e vídeo sem interrupções, é necessária a permissão de acesso ao microfone. Isto garante que nunca perca uma conversa importante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для приема телефонных и видеозвонков без прерываний требуется доступ к микрофону. Это гарантирует, что вы не пропустите важный разговор."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesli ve görüntülü aramaları kesintisiz alabilmek için mikrofon erişimi gereklidir. Böylece önemli bir görüşmeyi asla kaçırmazsınız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб отримувати телефонні та відеодзвінки без перешкод, потрібен доступ до мікрофона. Це гарантує, що ви ніколи не пропустите важливу розмову."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để nhận cuộc gọi thoại và video mà không bị gián đoạn, bạn cần cấp quyền truy cập micro. Điều này đảm bảo bạn không bỏ lỡ bất kỳ cuộc trò chuyện quan trọng nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了不间断地接收语音和视频通话，需要启用麦克风权限。 这样可以确保您不会错过任何重要的对话。"
          }
        }
      }
    },
    "RECORD_PERMISSION_TEXT_2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durch das Erteilen der Mikrofonberechtigung können Sie Sprachnachrichten aufnehmen und senden – ohne zusätzliche Schritte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Granting microphone access lets you record and send voice messages—no extra steps needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otorgar acceso al micrófono te permite grabar y enviar mensajes de voz, sin pasos adicionales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès au microphone vous permet d’enregistrer et d’envoyer des messages vocaux, sans étape supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Concedendo l'accesso al microfono, potrai registrare e inviare messaggi vocali senza passaggi aggiuntivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクへのアクセスを許可すると、音声メッセージを録音して送信できます。追加の手順は必要ありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크 접근 권한을 부여하면 별도의 추가 단계 없이 음성 메시지를 녹음하고 보낼 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do mikrofonu pozwala nagrywać i wysyłać wiadomości głosowe — bez dodatkowych kroków."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao conceder acesso ao microfone, você poderá gravar e enviar mensagens de voz sem etapas adicionais."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao conceder acesso ao microfone, poderá gravar e enviar mensagens de voz, sem necessidade de passos adicionais."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Предоставление доступа к микрофону позволяет записывать и отправлять голосовые сообщения — дополнительные действия не требуются."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon erişimi vermek, ek bir adıma gerek kalmadan sesli mesaj kaydetmenizi ve göndermenizi sağlar."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надання доступу до мікрофона дозволить вам записувати та надсилати голосові повідомлення — додаткові кроки не потрібні."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cho phép ứng dụng truy cập micro để bạn có thể ghi âm và gửi tin nhắn thoại mà không cần thêm bước nào."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "授予麦克风权限后，您可以录制和发送语音消息，无需额外步骤。"
          }
        }
      }
    },
    "RECORD_PERMISSION_TEXT_3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit Anrufe und Sprachnachrichten einwandfrei funktionieren, empfehlen wir, den Zugriff auf das Mikrofon zu gewähren. Ihr Datenschutz ist jederzeit gewährleistet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For calls and voice messages to work perfectly, we recommend granting microphone access. Your privacy is always protected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que las llamadas y los mensajes de voz funcionen perfectamente, recomendamos conceder acceso al micrófono. Tu privacidad siempre está protegida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour que les appels et les messages vocaux fonctionnent parfaitement, nous vous recommandons d’autoriser l’accès au microphone. Votre vie privée est toujours protégée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per far funzionare perfettamente chiamate e messaggi vocali, ti consigliamo di concedere l'accesso al microfono. La tua privacy è sempre protetta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通話やボイスメッセージをスムーズにご利用いただくために、マイクへのアクセスを許可することをお勧めします。お客様のプライバシーは常に保護されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "통화 및 음성 메시지가 원활하게 작동하도록 마이크 접근 권한을 부여하는 것이 좋습니다. 귀하의 개인 정보는 항상 보호됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby połączenia i wiadomości głosowe działały bez zarzutu, zalecamy zezwolenie na dostęp do mikrofonu. Twoja prywatność jest zawsze chroniona."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que as chamadas e mensagens de voz funcionem perfeitamente, recomendamos conceder acesso ao microfone. Sua privacidade está sempre protegida."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para que as chamadas e mensagens de voz funcionem perfeitamente, recomendamos que conceda acesso ao microfone. A sua privacidade está sempre protegida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для корректной работы звонков и голосовых сообщений рекомендуется разрешить доступ к микрофону. Мы всегда заботимся о вашей конфиденциальности."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aramaların ve sesli mesajların sorunsuz çalışması için mikrofon erişimi vermenizi öneririz. Gizliliğiniz her zaman korunur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб дзвінки та голосові повідомлення працювали бездоганно, рекомендуємо надати доступ до мікрофона. Ваша конфіденційність завжди захищена."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để cuộc gọi và tin nhắn thoại hoạt động tốt nhất, chúng tôi khuyên bạn nên cấp quyền truy cập micro. Quyền riêng tư của bạn sẽ luôn được bảo vệ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为了确保通话和语音消息功能正常运行，我们建议您授予麦克风权限。您的隐私将始终受到保护。"
