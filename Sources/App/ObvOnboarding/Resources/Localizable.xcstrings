    "ONBOARDING_DEVICE_NAME_CHOOSER_SUBTITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies hilft Ihnen, Ihre Geräte zu unterscheiden. Gerätenamen sind nur für Sie sichtbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will help you distinguish between your devices. Device names are only visible to you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto te ayudará a distinguir entre tus dispositivos. Los nombres de los dispositivos solo son visibles para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela vous permettra de reconnaître vos appareils facilement. Les surnoms ne sont visibles que par vous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo ti aiuterà a distinguere i tuoi dispositivi. I nomi dei dispositivi sono visibili solo a te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、複数のデバイスを区別できます。デバイス名はあなただけに見えるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 통해 기기를 구분할 수 있습니다. 기기 이름은 사용자에게만 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso ajudará você a diferenciar seus dispositivos. Os nomes dos dispositivos são visíveis apenas para você."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto ajudará a diferenciar os seus dispositivos. Os nomes dos dispositivos só são visíveis para si."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это поможет вам различать ваши устройства. Названия устройств видны только вам."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це допоможе вам розрізняти ваші пристрої. Назви пристроїв видимі лише вам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这有助于您区分不同的设备。设备名称仅对您可见。"
          }
        }
      }
    },
