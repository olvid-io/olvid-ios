    "ONBOARDING_BAD_INFORMATIONS_RETURNED_BY_IDENTITY_PROVIDER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die von Ihrem Identitätsanbieter abgerufenen Informationen sind unvollständig und erlauben es nicht, ein Olvid-Profil zu erstellen. Bitte kontaktieren Sie Ihren Administrator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The informations retrieved from the identity provider are incomplete and do not allow to created an Olvid profile. Please contact your administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La información recuperada del proveedor de identidad es incompleta y no permite crear un perfil de Olvid. Por favor, contacta a tu administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations récupérées depuis le fournisseur d'identités sont incomplètes et ne permettent pas de créer de profil Olvid. Nous vous recommandons de contacter votre administrateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le informazioni recuperate dal provider di identità sono incomplete e non permettono di creare un profilo Olvid. Si prega di contattare il proprio amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ID プロバイダーから取得した情報が不完全なため、Olvid プロファイルの作成ができません。管理者に連絡してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ID 공급자에서 가져온 정보가 불완전하여 Olvid 프로필을 생성할 수 없습니다. 관리자에게 문의하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações recuperadas do provedor de identidade estão incompletas e não permitem a criação de um perfil Olvid. Entre em contato com o administrador."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As informações obtidas do provedor de identidade estão incompletas e não permitem criar um perfil Olvid. Contacte o seu administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полученная информация от провайдера идентификации неполна и не позволяет создать профиль Olvid. Пожалуйста, свяжитесь с вашим администратором."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інформація, отримана від провайдера ідентифікації, неповна та не дозволяє створити профіль Olvid. Зверніться до вашого адміністратора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从身份验证提供程序检索到的信息不完整，无法创建 Olvid 配置文件。请联系您的管理员。"
          }
        }
      }
    },
