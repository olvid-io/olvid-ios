    "OWNED_IDENTITY_TRANSFER_NETWORK_ERROR_ADMIN_FOOTNOTE" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einem verwalteten Netzwerk (z. B. in einem Unternehmen) muss der Zugriff auf transfer.olvid.io über Port 443 erlaubt sein. Dein Netzwerkadministrator kann das überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a managed network (e.g. at work), access to transfer.olvid.io on port 443 must be allowed. Your network administrator can check this."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En una red administrada (por ejemplo, en el trabajo), debe estar permitido el acceso a transfer.olvid.io por el puerto 443. Tu administrador de red puede comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur un réseau administré (par exemple en entreprise), l'accès à transfer.olvid.io sur le port 443 doit être autorisé. Votre administrateur réseau peut le vérifier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su una rete gestita (ad esempio al lavoro), l'accesso a transfer.olvid.io sulla porta 443 deve essere consentito. Il tuo amministratore di rete può verificarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理されたネットワーク（職場など）では、ポート443でtransfer.olvid.ioへのアクセスが許可されている必要があります。ネットワーク管理者に確認を依頼できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "관리되는 네트워크(예: 회사)에서는 포트 443을 통한 transfer.olvid.io 접속이 허용되어야 합니다. 네트워크 관리자가 이를 확인할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W sieci zarządzanej (np. w pracy) musi być dozwolony dostęp do transfer.olvid.io na porcie 443. Twój administrator sieci może to sprawdzić."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em uma rede gerenciada (por exemplo, no trabalho), o acesso a transfer.olvid.io na porta 443 deve ser permitido. Seu administrador de rede pode verificar isso."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numa rede gerida (por exemplo, no trabalho), o acesso a transfer.olvid.io na porta 443 deve ser permitido. O seu administrador de rede pode verificar isto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В управляемой сети (например, на работе) должен быть разрешен доступ к transfer.olvid.io через порт 443. Ваш сетевой администратор может это проверить."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yönetilen bir ağda (ör. iş yerinde) transfer.olvid.io adresine 443 numaralı bağlantı noktasından erişime izin verilmelidir. Ağ yöneticiniz bunu kontrol edebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У керованій мережі (наприклад, на роботі) має бути дозволений доступ до transfer.olvid.io через порт 443. Ваш мережевий адміністратор може це перевірити."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trên mạng được quản lý (ví dụ: tại nơi làm việc), quyền truy cập transfer.olvid.io qua cổng 443 phải được cho phép. Quản trị viên mạng của bạn có thể kiểm tra điều này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
