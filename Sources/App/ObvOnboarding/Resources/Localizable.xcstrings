    "MISMATCH_BETWEEN_KEYCLOAK_DISTRIBUTION_SERVER_AND_EXISTING_PROFILE_DISTRIBUTION_SERVER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration Ihres Unternehmens-Identitätsanbieters mit Ihrem aktuellen Olvid-Profil ist nicht möglich. Ihr Profil wurde auf einem anderen Olvid-Server erstellt.\n\nWenden Sie sich für weitere Informationen an Ihren Administrator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to configure your company's identity provider with your current Olvid profile. Your profile was generated on a different Olvid server.\n\nPlease contact your administrator for more details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo configurar el proveedor de identidad de su empresa con su perfil Olvid actual. Su perfil fue generado en un servidor Olvid diferente.\n\nPóngase en contacto con su administrador para obtener más detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de configurer le fournisseur d'identité de votre entreprise avec votre profil Olvid actuel. Votre profil a été généré sur un serveur Olvid différent.\n\nVeuillez contacter votre administrateur pour plus de détails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile configurare il provider di identità della tua azienda con il tuo profilo Olvid attuale. Il tuo profilo è stato generato su un server Olvid differente.\n\nContatta il tuo amministratore per maggiori dettagli."
          }
        }
      }
    },
