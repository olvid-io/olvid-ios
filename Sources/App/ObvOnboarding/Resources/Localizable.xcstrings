    },
    "CHOOSE_ACTIVE_DEVICE_SUBTITLE_WHEN_MULTIDEVICE_TRUE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist Ihre aktuelle Geräteliste, einschließlich des Geräts, das Sie gerade hinzufügen möchten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here is your current device list, including the device you are about to add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la lista de tus dispositivos actuales, incluyendo el dispositivo que estás a punto de agregar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici vos appareils actuels, ainsi que celui que vous vous apprêtez à ajouter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco l'elenco dei tuoi dispositivi attuali, incluso quello che stai per aggiungere."
          }
        }
      }
    },
