          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вашей компании требуется дополнительная аутентификация на вашем новом устройстве для доступа к вашему профилю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
