    "NO_DEVICE_WILL_EXPIRE_SINCE_YOUR_SUBSCRIPTION_INCLUDES_MULTIDEVICE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle deine Geräte bleiben aktiv, da dein Abonnement die Multi-Device-Funktion beinhaltet 🙌."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your devices will stay active since your subscription includes the multi-device feature 🙌."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos tus dispositivos permanecerán activos ya que tu suscripción incluye la función multi-dispositivo 🥳."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous vos appareils vont rester actifs car votre abonnement inclu la fonctionnalité multi-appareils 🙌."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i tuoi dispositivi rimarranno attivi poiché il tuo abbonamento include la funzionalità multi-dispositivo 🥳."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様のサブスクリプションには、複数のデバイスで利用できる機能が含まれているため、すべてのデバイスはアクティブな状態を維持します。🙌"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 구독에는 멀티 디바이스 기능이 포함되어 있어 모든 디바이스가 계속 활성 상태를 유지합니다. 💻"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus dispositivos permanecerão ativos, pois sua assinatura inclui o recurso multi-dispositivo 🙌."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os seus dispositivos permanecerão ativos, uma vez que a sua subscrição inclui a funcionalidade multi-dispositivo 🙌."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все ваши устройства останутся активными, так как ваша подписка включает в себя функцию поддержки нескольких устройств 🙌."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Всі ваші пристрої залишаться активними, оскільки ваша підписка включає функцію підтримки кількох пристроїв 🙌."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于您的订阅包含多设备功能，因此您的所有设备都将保持活动状态 🙌。"
          }
        }
      }
    },
