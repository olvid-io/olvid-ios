        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja firma wymaga dodatkowego uwierzytelnienia na nowym urządzeniu, aby uzyskać dostęp do twojego profilu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
