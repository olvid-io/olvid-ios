    "YOUR_OTHER_DEVICES_WILL_BE_DEACTIVATED_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre anderen Geräte werden innerhalb von 30 Tagen deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other devices will be deactivated within 30 days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus otros dispositivos se desactivarán en 30 días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres appareils seront désactivés dans les 30 jours."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli altri tuoi dispositivi verranno disattivati entro 30 giorni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスは30日以内に非アクティブ化されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기는 30일 이내에 비활성화됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus outros dispositivos serão desativados em 30 dias."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus outros dispositivos serão desativados dentro de 30 dias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши другие устройства будут деактивированы в течение 30 дней."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші інші пристрої будуть деактивовані протягом 30 днів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的其他设备将在 30 天内停用。"
          }
        }
      }
    },
    "YOUR_PROFILE_IS_TRANSFER_RESTRICTED_BODY1": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Unternehmen benötigt eine zusätzliche Authentifizierung auf Ihrem neuen Gerät, um auf Ihr Profil zuzugreifen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your company requires additional authentication on your new device to access your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu empresa requiere autenticación adicional en tu nuevo dispositivo para acceder a tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre entreprise nécessite une authentification supplémentaire sur votre nouvel appareil pour accéder à votre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua azienda richiede un'autenticazione aggiuntiva sul tuo nuovo dispositivo per accedere al tuo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様の会社では、新しいデバイスからお客様のプロフィールにアクセスする際に、追加の認証が必要となります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀사는 귀하의 프로필에 접근하기 위해 새 기기에서 추가 인증을 요구합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para acessar seu perfil no novo dispositivo, sua empresa exige uma autenticação adicional."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua empresa exige autenticação adicional no seu novo dispositivo para aceder ao seu perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашей компании требуется дополнительная аутентификация на вашем новом устройстве для доступа к вашему профилю."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашій компанії потрібна додаткова автентифікація на вашому новому пристрої для доступу до вашого профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了访问您的个人资料，您的公司要求在新设备上进行额外的身份验证。"
          }
        }
      }
    },
    "YOUR_PROFILE_IS_TRANSFER_RESTRICTED_BODY2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie müssen sich direkt auf diesem neuen Gerät bei ihrem Verzeichnis authentifizieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll need to authenticate with their directory directly on this new device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesitarás autenticarte con su directorio directamente en este nuevo dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous devrez vous authentifier directement sur le nouvel appareil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dovrai autenticarti direttamente con la loro directory su questo nuovo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この新しいデバイスでは、直接そのディレクトリに認証する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 기기에서 해당 디렉터리에 직접 인증해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você precisará se autenticar diretamente no diretório deles neste novo dispositivo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Terá de autenticar-se no diretório deles diretamente neste novo dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам потребуется повторно аутентифицироваться в их каталоге непосредственно на этом новом устройстве."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вам потрібно буде пройти автентифікацію безпосередньо в їхньому каталозі на цьому новому пристрої."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您需要在该新设备上直接使用他们的目录进行身份验证。"
          }
        }
      }
    },
    "YOUR_PROFILE_IS_TRANSFER_RESTRICTED_BODY3": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies stellt sicher, dass nur autorisierte Geräte auf Ihr Profil zugreifen können."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This ensures that only authorized devices can access your profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto asegura que solo los dispositivos autorizados puedan acceder a tu perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela garantit que seuls les appareils autorisés peuvent accéder à votre profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo assicura che solo i dispositivi autorizzati possano accedere al tuo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、承認されたデバイスのみがお客様のプロフィールにアクセスできるようになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 통해 승인된 장치만 사용자의 프로필에 접근할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso garante que apenas dispositivos autorizados possam acessar seu perfil."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto garante que apenas dispositivos autorizados possam aceder ao seu perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это гарантирует, что доступ к вашему профилю имеют только авторизованные устройства."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це гарантує, що лише авторизовані пристрої можуть отримати доступ до вашого профілю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这可确保只有授权设备才能访问您的个人资料。"
          }
        }
      }
    },
