            "state": "translated",
            "value": "Но, пожалуйста, попробуйте еще раз"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Але, будь ласка, спробуйте ще раз"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "但请再次尝试"
          }
        }
      }
    },
    "OWNED_IDENTITY_TRANSFER_FAILED_TITLE": {
      "localizations": {
