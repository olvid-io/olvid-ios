    "DIALOG_MESSAGE_FAILED_TO_UPLOAD_IDENTITY_TO_KEYCLOAK": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid konnte Ihre Olvid-ID nicht mit dem Identitätsanbieter Ihres Unternehmens hochladen. Der Vorgang wird im Hintergrund wiederholt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid was unable to upload your Olvid ID to your company's identity provider. It will be retried in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid no pudo cargar tu ID de Olvid al proveedor de identidad de tu empresa. Se reintentará en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid n'a pas réussi à transmettre votre ID Olvid au fournisseur d'identité de votre entreprise. De nouveaux essais seront réalisés en tâche de fond."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid non è stato in grado di caricare il tuo ID Olvid sul provider di identità della tua azienda. Il tentativo verrà riproposto in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidは、お客様のOlvid IDを会社のIDプロバイダーにアップロードできませんでした。バックグラウンドで再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid가 귀하의 Olvid ID를 회사 ID 공급업체에 업로드하지 못했습니다. 백그라운드에서 다시 시도합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid não conseguiu enviar seu ID Olvid para o provedor de identidade da sua empresa. A operação será repetida em segundo plano."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid não conseguiu enviar o seu ID do Olvid para o fornecedor de identidade da sua empresa. A operação será repetida em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не смог загрузить ваш Olvid ID в поставщик идентификации вашей компании. Повторная попытка будет выполнена в фоновом режиме."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не зміг завантажити ваш Olvid ID до провайдера ідентифікації вашої компанії. Спроба буде повторена у фоновому режимі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid 无法将您的 Olvid ID 上传到您公司的身份提供程序。系统将在后台重试。"
          }
        }
      }
    },
