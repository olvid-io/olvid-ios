    "MAIL_BODY_COULD_NOT_TRANSFER_PROFILE_ERROR$@": {
      "comment": "mail body text",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo Olvid!\n\nIch konnte mein Profil nicht übertragen. Könntest du dir dieses Problem bitte ansehen? Hier ist der Fehler:\n\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello Olvid!\n\nI could not transfer my profile. Could you please look into this issue? Here is the error:\n\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hola Olvid!\n\nNo pude transferir mi perfil. ¿Podrías revisar este problema? Aquí está el error:\n\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
