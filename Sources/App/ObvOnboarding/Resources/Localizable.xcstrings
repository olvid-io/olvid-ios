    "RESTORE_BACKUP_FAILED_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sicherung konnte nicht wiederhergestellt werden. Wenn möglich, empfehlen wir, eine andere Sicherung wiederherzustellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The backup could not be restored. If you can, we recommend you try to restore another backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo restaurar la copia de seguridad. Si es posible, recomendamos que intentes restaurar otra copia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n'a malheureusement pas pu être restaurée. Si vous le pouvez, nous vous recommandons d'essayer de restaurer une autre sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup non è stato ripristinato. Se possibile, ti consigliamo di provare a ripristinare un altro backup."
          }
        }
      }
    },
