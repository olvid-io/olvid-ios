          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé de sauvegarde est correcte"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave di backup è corretta"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
