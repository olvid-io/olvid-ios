            "value": "Möchten Sie ein Profil erstellen, das den Server %@ und den API-Schlüssel %@ verwendet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you wish to create a profile configured to use the server %@ and the API Key %@?"
          }
        },
        "es": {
