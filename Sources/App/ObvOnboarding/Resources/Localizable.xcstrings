    "COULD_NOT_PERFORM_OWNED_IDENTITY_TRANSFER_ALERT_%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil konnte nicht übertragen werden. Bitte versuche es erneut. Wenn das Problem weiterhin besteht, wende dich bitte an %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile could not be transfered. Please try again. If the problem persists, please contact %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo transferir el perfil. Por favor, inténtalo de nuevo. Si el problema persiste, ponte en contacto con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil n'a pas pu être transféré. Si ce problème persisted, contactez %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trasferire il profilo. Riprova. Se il problema persiste, contatta %@."
          }
        }
      }
    },
    "COULD_NOT_PERFORM_OWNED_IDENTITY_TRANSFER_ALERT_%@_%@": {
