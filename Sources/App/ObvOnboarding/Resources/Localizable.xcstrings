    "OWNED_IDENTITY_TRANSFER_TARGET_LAST_STEP" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast geschafft! Die restlichen Schritte werden auf Ihrem zweiten Gerät ausgeführt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Almost there! The remaining steps are perfomed on your second device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Casi listo! Los pasos restantes se realizarán en tu segundo dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous y sommes presque ! Les dernières étapes se passent sur votre deuxième appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
