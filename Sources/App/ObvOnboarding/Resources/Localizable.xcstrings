    "DO_YOU_HAVE_OTHER_PROFILES_TO_ADD": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie auf Ihrem anderen Gerät mehrere Profile haben, möchten Sie diese auch hinzufügen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you have multiple profiles on your other device, would you like to add them too?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Si tienes múltiples perfiles en tu otro dispositivo, ¿te gustaría agregarlos también?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si vous avez plusieurs profils sur votre deuxième appareil, voulez-vous les ajouter aussi ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se hai più profili sul tuo altro dispositivo, desideri aggiungerli anche qui?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のデバイスで複数のプロフィールをお持ちの場合、それらも追加しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에 여러 개의 프로필이 있는 경우, 이 프로필도 추가하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se você tiver vários perfis em outro dispositivo, gostaria de adicioná-los também?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tiver vários perfis no seu outro dispositivo, gostaria de adicioná-los também?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если на вашем другом устройстве у вас несколько профилей, вы хотите добавить их тоже?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо у вас є декілька профілів на іншому пристрої, чи бажаєте ви додати їх також?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的其他设备上有多个个人资料，您是否想也添加它们？"
          }
        }
      }
    },
