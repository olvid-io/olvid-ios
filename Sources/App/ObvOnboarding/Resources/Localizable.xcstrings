    "COULD_NOT_PERFORM_OWNED_IDENTITY_TRANSFER_ALERT_%@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Profil konnte nicht übertragen werden. Bitte versuche es erneut. Wenn das Problem weiterhin besteht, wende dich bitte an %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The profile could not be transfered. Please try again. If the problem persists, please contact %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo transferir el perfil. Por favor, inténtalo de nuevo. Si el problema persiste, ponte en contacto con %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le profil n'a pas pu être transféré. Si ce problème persisted, contactez %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trasferire il profilo. Riprova. Se il problema persiste, contatta %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロファイルの転送に失敗しました。もう一度お試しください。問題が解決しない場合は、%@までご連絡ください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로필 전송에 실패했습니다. 다시 시도해 주세요. 문제가 계속되면 %@으로 문의해 주세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się przenieść profilu. Spróbuj ponownie. Jeśli problem będzie się powtarzał, skontaktuj się z %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível transferir o perfil. Tente novamente. Se o problema persistir, entre em contato com %@."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível transferir o perfil. Tente novamente. Se o problema persistir, entre em contacto com o suporte em %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить профиль. Пожалуйста, попробуйте еще раз. Если проблема не исчезнет, обратитесь в %@."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profil aktarılamadı. Lütfen tekrar deneyin. Sorun devam ederse lütfen %@ ile iletişime geçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося завантажити профіль. Будь ласка, спробуйте ще раз. Якщо проблема не зникає, зверніться до %@."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể chuyển hồ sơ. Vui lòng thử lại. Nếu sự cố vẫn tiếp diễn, vui lòng liên hệ %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法传输个人资料。请重试。如果问题仍然存在，请联系 %@。"
          }
        }
      }
    },
