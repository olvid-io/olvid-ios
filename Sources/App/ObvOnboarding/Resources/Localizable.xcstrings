    "ENABLE_AUTOMATIC_BACKUP_EXPLANATION" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sicherung wurde erfolgreich wiederhergestellt. Um sicherzustellen, dass Sie beim nächsten Mal problemlos eine aktuelle Sicherung wiederherstellen können, empfehlen wir, automatische iCloud-Sicherungen zu aktivieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The backup was successfully restored. To make sure you can restore a fresh backup the next time you need to, we recommend to activate automatic iCloud backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia de seguridad se restauró correctamente. Para asegurarte de poder restaurar una copia de seguridad reciente la próxima vez que lo necesites, te recomendamos activar las copias de seguridad automáticas de iCloud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sauvegarde a été restaurée avec succès. Pour vous assurer de pouvoir restaurer à nouveau une sauvegarde la prochaine fois que vous en aurez besoin, nous vous recommandons d'activer les sauvegardes automatiques vers iCloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il backup è stato ripristinato con successo. Per assicurarti di poter ripristinare un backup aggiornato la prossima volta che ne avrai bisogno, ti consigliamo di attivare i backup automatici su iCloud."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バックアップの復元に成功しました。次回以降も問題なくバックアップを復元できるように、自動iCloudバックアップを有効にすることをお勧めします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "백업이 성공적으로 복원되었습니다. 다음에 백업을 복원할 때 문제가 없도록 자동 iCloud 백업을 활성화하는 것이 좋습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopia zapasowa została przywrócona. Aby następnym razem móc przywrócić aktualną kopię zapasową, zalecamy włączenie automatycznych kopii zapasowych w iCloud."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O backup foi restaurado com sucesso. Para garantir que você possa restaurar um novo backup na próxima vez que precisar, recomendamos ativar os backups automáticos do iCloud."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia de segurança foi restaurada com sucesso. Para garantir que pode restaurar uma cópia de segurança nova na próxima vez que precisar, recomendamos que ative as cópias de segurança automáticas do iCloud."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервная копия успешно восстановлена. Чтобы убедиться, что в следующий раз вы сможете восстановить свежую резервную копию, мы рекомендуем включить автоматическое резервное копирование в iCloud."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yedek başarıyla geri yüklendi. Bir dahaki sefere güncel bir yedeği geri yükleyebilmeniz için otomatik iCloud yedeklemelerini etkinleştirmenizi öneririz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервна копія була успішно відновлена. Щоб переконатися, що ви зможете відновити свіжу резервну копію наступного разу, коли це буде потрібно, рекомендуємо активувати автоматичне створення резервних копій iCloud."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình khôi phục bản sao lưu đã hoàn tất. Để đảm bảo bạn có thể khôi phục bản sao lưu mới nhất vào lần sau, chúng tôi khuyên bạn nên bật tính năng sao lưu iCloud tự động."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备份已成功恢复。为了确保下次需要时可以恢复最新的备份，我们建议您启用自动 iCloud 备份。"
          }
        }
      }
    },
