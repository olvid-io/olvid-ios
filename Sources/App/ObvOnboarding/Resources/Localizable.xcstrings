    "OWNED_IDENTITY_TRANSFER_ENTER_CODE_FROM_NEW_DEVICE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib den auf deinem neuen Gerät angezeigten Code ein"
          }
        },
        "en": {
