          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップからの復元中です。しばらくお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 복원 중입니다. 잠시 기다려 주세요."
          }
        },
        "pt-BR": {
