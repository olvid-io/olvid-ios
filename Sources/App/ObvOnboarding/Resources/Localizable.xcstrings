    "IDENTITY_PROVIDER_CONFIGURED_FAILURE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Identitätsanbieter Ihres Unternehmens scheint nicht verfügbar zu sein. Bitte wenden Sie sich an Ihren Administrator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity provider of your company does not seem to be available. Please contact your administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor de identidad de tu empresa no parece estar disponible. Por favor, contacta a tu administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur d'identité de votre société ne semble pas disponible. Veuillez contacter votre administrateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il provider di identità della tua azienda sembra non essere disponibile. Contatta il tuo amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様の会社のIDプロバイダーが利用できないようです。管理者にお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀사의 ID 공급자가 현재 사용할 수 없는 것 같습니다. 관리자에게 문의해 주세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor de identidade da sua empresa parece não estar disponível. Entre em contato com o administrador."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor de identidade da sua empresa parece não estar disponível. Contacte o seu administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Похоже, что провайдер идентификации вашей компании недоступен. Пожалуйста, свяжитесь с вашим администратором."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постачальник ідентифікаційних даних вашої компанії, здається, недоступний. Зверніться до вашого адміністратора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的公司的身份验证提供程序似乎无法使用。请联系您的管理员。"
          }
        }
      }
    },
    "IDENTITY_PROVIDER_CONFIGURED_SUCCESS": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Identitätsanbieter Ihres Unternehmens wurde erfolgreich konfiguriert. Bitte authentifizieren Sie sich, um Ihre persönlichen Informationen abzurufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The identity provider of your company was successfully configured. Please authenticate to retrieve your personal information."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor de identidad de tu empresa se configuró correctamente. Por favor, autentícate para obtener tu información personal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur d'identité de votre société a été configuré avec succès. Veuillez vous authentifier pour récupérer vos informations personnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il provider di identità della tua azienda è stato configurato correttamente. Autenticati per recuperare le tue informazioni personali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会社のIDプロバイダーの設定が正常に完了しました。認証を行って、個人情報にアクセスしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀사의 ID 공급자가 성공적으로 구성되었습니다. 개인 정보를 가져오려면 인증하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O provedor de identidade da sua empresa foi configurado com sucesso. Por favor, autentique-se para obter suas informações pessoais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O fornecedor de identidade da sua empresa foi configurado com sucesso. Por favor, autentique-se para obter as suas informações pessoais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставщик идентификационных данных вашей компании успешно настроен. Пожалуйста, выполните аутентификацию для получения личной информации."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Постачальник ідентифікаційних даних вашої компанії успішно налаштовано. Будь ласка, пройдіть аутентифікацію для отримання вашої особистої інформації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的公司身份验证提供程序已成功配置。请进行身份验证以检索您的个人信息。"
          }
        }
      }
    },
    "IDENTITY_PROVIDER_OPTION_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Bildschirm können Sie die Identitätsprovider Ihres Unternehmens manuell konfigurieren. Wenn Sie einen Konfigurationslink (oder QR-Code) erhalten haben, tippen Sie bitte auf \"Zurück\" und tippen Sie auf den Link oder scannen Sie den Code. Dies erleichtert den Onboarding-Prozess erheblich 😇.\n\nBitte wenden Sie sich an Ihren Administrator, um weitere Informationen zu erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This screen lets you to manually configure your company's identity provider. If you received a configuration link (or QR code), please tap on \"Back\" and tap the link or scan the code. This will make the onboarding process much easier 😇.\n\nPlease contact your administrator for more details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta pantalla te permite configurar manualmente el proveedor de identidad de tu empresa. Si recibiste un enlace de configuración (o un código QR), por favor, toca en \"Atrás\" y toca el enlace o escanea el código. Esto hará que el proceso de incorporación sea mucho más fácil 😇.\n\nPonte en contacto con tu administrador para obtener más detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet écran vous permet de configurer manuellement le fournisseur d'identité de votre entreprise. Si vous avez reçu un lien (ou un code QR) de configuration, appuyez sur « Retour » et appuyez sur le lien ou scannez le code. Le processus de démarrage n'en sera que plus simple 😇.\n\nVeuillez contacter votre administrateur pour plus de détails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa schermata ti permette di configurare manualmente il provider di identità della tua azienda. Se hai ricevuto un link di configurazione (o un codice QR), ti preghiamo di toccare \"Indietro\" e toccare il link o scansionare il codice. Questo renderà il processo di onboarding molto più semplice 😇.\n\nContatta il tuo amministratore per maggiori dettagli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この画面では、お客様の会社のIDプロバイダーを手動で構成できます。設定リンク（またはQRコード）を受け取った場合は、「戻る」をタップしてリンクをタップするか、コードをスキャンしてください。これにより、オンボーディングプロセスが大幅に簡単になります。\n詳細については、管理者にお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 화면에서는 회사 ID 공급자를 수동으로 구성할 수 있습니다. 구성 링크(또는 QR 코드)를 받은 경우 \"뒤로\"를 탭한 다음 링크를 탭하거나 코드를 스캔하세요. 그러면 온보딩 프로세스가 훨씬 쉬워집니다.\n\n자세한 내용은 관리자에게 문의하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta tela permite que você configure manualmente o provedor de identidade da sua empresa. Se você recebeu um link de configuração (ou código QR), toque em \"Voltar\" e, em seguida, toque no link ou escaneie o código. Isso tornará o processo de configuração muito mais fácil 😇.\n\nEntre em contato com o administrador para obter mais detalhes."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ecrã permite-lhe configurar manualmente o fornecedor de identidade da sua empresa. Se recebeu um link de configuração (ou código QR), toque em \"Voltar\" e, em seguida, toque no link ou leia o código. Isto tornará o processo de integração muito mais fácil 😇.\n\nContacte o seu administrador para obter mais detalhes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот экран позволяет вручную настроить поставщика удостоверений вашей компании. Если вы получили ссылку конфигурации (или QR-код), пожалуйста, нажмите «Назад» и нажмите на ссылку или отсканируйте код. Это значительно упростит процесс адаптации 😇.\n\nОбратитесь к вашему администратору для получения более подробной информации."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей екран дозволяє вручну налаштувати провайдера ідентифікації вашої компанії. Якщо ви отримали посилання налаштування (або QR-код), будь ласка, натисніть «Назад» і виберіть посилання або скануйте код. Це значно спростить процес налаштування 😇.\n\nЗверніться до адміністратора для отримання додаткової інформації."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此界面允许您手动配置您公司的身份提供程序。如果您收到了配置链接（或二维码），请点击“返回”，然后点击链接或扫描二维码。这将使入职过程更加容易。\n\n请联系您的管理员以获取更多详细信息。"
          }
        }
      }
    },
    "INVALID_MAGIC_LINK_ALERT_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Magic-Link ist nicht mehr gültig. Jeder Magic-Link kann nur einmal verwendet werden — wenn Sie ihn bereits verwendet haben, wenden Sie sich bitte an Ihren Administrator, um einen neuen anzufordern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This magic link is no longer valid. Each magic link can only be used once — if you have already used it, please contact your administrator to request a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este enlace mágico ya no es válido. Cada enlace mágico solo puede usarse una vez — si ya lo has utilizado, ponte en contacto con tu administrador para solicitar uno nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce lien magique n'est plus valide. Chaque lien magique ne peut être utilisé qu'une seule fois — si vous l'avez déjà utilisé, veuillez contacter votre administrateur pour en demander un nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo magic link non è più valido. Ogni magic link può essere utilizzato una sola volta — se lo hai già utilizzato, contatta il tuo amministratore per richiederne uno nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマジックリンクは有効期限が切れています。各マジックリンクは1回のみ使用できます。すでに使用済みの場合は、管理者にお問い合わせの上、新しいリンクをリクエストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 매직 링크는 더 이상 유효하지 않습니다. 각 매직 링크는 한 번만 사용할 수 있습니다. 이미 사용한 경우 관리자에게 연락하여 새 링크를 요청하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link mágico não é mais válido. Cada link mágico só pode ser usado uma vez — se você já o usou, entre em contato com seu administrador para solicitar um novo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este link mágico já não é válido. Cada link mágico só pode ser utilizado uma vez — se já o utilizou, contacte o seu administrador para solicitar um novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта magic-ссылка больше не действительна. Каждая magic-ссылка может быть использована только один раз — если вы её уже использовали, обратитесь к администратору для получения новой."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це magic-посилання більше не є дійсним. Кожне magic-посилання можна використати лише один раз — якщо ви вже використали його, зверніться до адміністратора для отримання нового."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此魔法链接已失效。每个魔法链接只能使用一次——如果您已经使用过此链接，请联系管理员申请新的链接。"
          }
        }
      }
    },
