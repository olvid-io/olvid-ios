    "LOCAL_NOTIFICATIONS_TEXT_1" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid funktioniert am besten, wenn du über neue Nachrichten benachrichtigt wirst. Bleibe auf dem Laufenden und antworte schnell auf wichtige Unterhaltungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid works best when you’re notified about new messages. Stay updated and respond quickly to important conversations."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid funciona mejor cuando recibes notificaciones de nuevos mensajes. Mantente al día y responde rápidamente a las conversaciones importantes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid fonctionne mieux avec les notifications pour les nouveaux messages activées. Ainsi, il est possible de répondre rapidement aux conversations importantes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid funziona meglio quando ricevi notifiche sui nuovi messaggi. Rimani aggiornato e rispondi rapidamente alle conversazioni importanti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいメッセージの通知を受け取ると、Olvidが最も効果的に機能します。最新情報を入手し、重要な会話に迅速に対応しましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새 메시지에 대한 알림을 받으면 Olvid를 가장 효과적으로 사용할 수 있습니다. 최신 정보를 확인하고 중요한 대화에 신속하게 응답하세요."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid działa najlepiej, gdy otrzymujesz powiadomienia o nowych wiadomościach. Bądź na bieżąco i szybko odpowiadaj w ważnych rozmowach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Olvid funciona melhor quando você recebe notificações sobre novas mensagens. Mantenha-se atualizado e responda rapidamente às conversas importantes."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Olvid funciona melhor quando recebe notificações sobre novas mensagens. Mantenha-se atualizado e responda rapidamente às conversas importantes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid работает лучше всего, когда вы получаете уведомления о новых сообщениях. Будьте в курсе и быстро отвечайте на важные разговоры."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid, yeni mesajlardan haberdar edildiğinizde en iyi şekilde çalışır. Güncel kalın ve önemli konuşmalara hızlıca yanıt verin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid найкраще працює, коли вас сповіщають про нові повідомлення. Будьте в курсі та швидко відповідайте на важливі розмови."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvid hoạt động tốt nhất khi bạn nhận được thông báo về tin nhắn mới. Luôn cập nhật và phản hồi nhanh chóng cho các cuộc trò chuyện quan trọng."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您收到新消息通知时，Olvid 的效果最佳。及时了解并快速回复重要对话。"
          }
        }
      }
    },
    "LOCAL_NOTIFICATIONS_TEXT_2" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhalte Benachrichtigungen über neue Kontaktanfragen, damit du nie eine Gelegenheit verpasst, dich mit Freunden oder Kollegen zu vernetzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get alerts for new contact invitations, so you never miss a chance to connect with friends or colleagues."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recibe alertas para nuevas invitaciones de contacto, para que nunca pierdas la oportunidad de conectar con amigos o compañeros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les alertes pour les nouvelles invitations permettent de ne jamais rater une opportunité de connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ricevi notifiche per nuovi inviti di contatto, così non perderai mai l'opportunità di connetterti con amici o colleghi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい連絡先からの招待を通知で受け取り、友人や同僚とのつながりを見逃さないようにしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 연락처 초대 알림을 받으면 친구나 동료와 연결할 기회를 놓치지 않을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otrzymuj powiadomienia o nowych zaproszeniach, aby nie przegapić żadnej okazji do kontaktu ze znajomymi czy współpracownikami."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba alertas sobre novos convites de contato, para que você nunca perca a oportunidade de se conectar com amigos ou colegas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Receba notificações sobre novos convites de contacto, para que nunca perca a oportunidade de se conectar com amigos ou colegas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Получайте уведомления о новых приглашениях контактов, чтобы не упустить возможность общаться с друзьями или коллегами."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni kişi davetleri için uyarı alın, böylece arkadaşlarınızla veya iş arkadaşlarınızla bağlantı kurma fırsatını asla kaçırmazsınız."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отримуйте сповіщення про нові запрошення контактів, щоб ніколи не пропустити можливість зв’язатися з друзями чи колегами."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhận thông báo khi có lời mời kết bạn mới, để bạn không bỏ lỡ cơ hội kết nối với bạn bè hoặc đồng nghiệp."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接收新联系人邀请的提醒，这样您就不会错过与朋友或同事建立联系的机会。"
          }
        }
      }
    },
    "LOCAL_NOTIFICATIONS_TEXT_3" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deine Benachrichtigungseinstellungen später jederzeit in der Einstellungen-App deines Geräts ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can always change your notification settings later in your device’s Settings app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siempre puedes cambiar la configuración de notificaciones más tarde en la aplicación de Ajustes de tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pourrez toujours ajuster les notifications plus tard dans les paramètres de votre appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi sempre modificare le impostazioni delle notifiche in seguito dall'app Impostazioni del tuo dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知設定は、いつでもデバイスの「設定」アプリから変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "나중에 기기의 설정 앱에서 알림 설정을 언제든지 변경할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustawienia powiadomień możesz zawsze zmienić później w aplikacji Ustawienia na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sempre pode alterar suas configurações de notificação mais tarde, no aplicativo de Configurações do seu dispositivo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode sempre alterar as suas definições de notificação mais tarde na aplicação Definições do seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы всегда сможете изменить настройки уведомлений позже в приложении «Настройки» на вашем устройстве."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildirim ayarlarınızı daha sonra istediğiniz zaman cihazınızın Ayarlar uygulamasından değiştirebilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви завжди можете змінити налаштування сповіщень пізніше в додатку «Налаштування» на вашому пристрої."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bạn luôn có thể thay đổi cài đặt thông báo của mình sau này trong ứng dụng Cài đặt của thiết bị."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以稍后在设备的“设置”应用中随时更改您的通知设置。"
          }
        }
      }
    },
    "MAIL_BODY_COULD_NOT_TRANSFER_PROFILE_ERROR$@" : {
      "comment" : "mail body text",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hallo Olvid!\n\nIch konnte mein Profil nicht übertragen. Könntest du dir dieses Problem bitte ansehen? Hier ist der Fehler:\n\n%@"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hello Olvid!\n\nI could not transfer my profile. Could you please look into this issue? Here is the error:\n\n%@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hola Olvid!\n\nNo pude transferir mi perfil. ¿Podrías revisar este problema? Aquí está el error:\n\n%@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bonjour Olvid !\n\nJe n'ai pas pu transférer mon profil. Pourriez-vous étudier la question ? Voici l'erreur :\n\n%@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciao Olvid!\n\nNon sono riuscito a trasferire il mio profilo. Potresti per favore controllare questo problema? Ecco l'errore:\n\n%@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "こんにちは、オルビッド様。\n\n私のプロファイルを転送できませんでした。この問題について調べていただけますでしょうか？エラーメッセージは以下のとおりです。\n\n%@"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안녕하세요, 올비드!\n\n제 프로필을 전송할 수 없었습니다. 이 문제를 확인해 주시겠어요? 오류 내용은 다음과 같습니다:\n\n%@"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Witaj, Olvid!\n\nNie udało mi się przenieść profilu. Czy możecie przyjrzeć się temu problemowi? Oto błąd:\n\n%@"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, Olvid!\n\nNão consegui transferir meu perfil. Você poderia verificar este problema? Aqui está o erro:\n\n%@"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olá, Olvid!\n\nNão consegui transferir o meu perfil. Poderias, por favor, verificar este problema? Aqui está o erro:\n\n%@"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привет, Олвид!\n\nЯ не смог перенести свой профиль. Не могли бы вы посмотреть эту проблему? Вот ошибка:\n\n%@"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Merhaba Olvid!\n\nProfilimi aktaramadım. Bu sorunu inceleyebilir misiniz? Hata şu:\n\n%@"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Привіт, Olvid!\n\nЯ не зміг перенести свій профіль. Чи не могли б ви поглянути на цю проблему? Ось помилка:\n\n%@"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chào Olvid!\n\nTôi không thể chuyển thông tin hồ sơ của mình. Bạn có thể xem xét vấn đề này giúp tôi được không? Đây là lỗi:\n\n%@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你好，Olvid！\n\n我无法转移我的个人资料。您能帮忙查看一下这个问题吗？错误信息如下：\n\n%@"
          }
        }
      }
    },
