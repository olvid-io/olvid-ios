    "CHOOSE_ACTIVE_DEVICE_SUBTITLE_WHEN_MULTIDEVICE_FALSE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Geräte werden innerhalb von 30 Tagen deaktiviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other devices will be deactivated within 30 days."
          }
        },
