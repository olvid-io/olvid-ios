    "ONBOARDING_SWIPE_TEXT" : {
      "comment" : "Contacts suggestions onboarding, first step: explains the gesture on the cards",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wische die Karte nach rechts, um den Nutzer einzuladen, und nach links, um zum nächsten zu gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
