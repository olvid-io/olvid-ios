    "THE_USERS_BELOW_ARE_NOT_PART_OF_YOUR_CONTACTS" : {
      "comment" : "Explanation at the top of the list of the other known users: the users who are not one-to-one contacts. Same text as on Android.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die unten aufgeführten Benutzer sind nicht in Ihren Kontakten enthalten, und Sie können noch keine privaten Diskussionen mit ihnen führen. Aber Sie können sie ganz einfach einladen! 🚀"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The users below are not part of your contacts, and you cannot have a private discussion with them yet. But you can easily invite them 🚀!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los usuarios que se muestran a continuación no están en tu lista de contactos y aún no puedes tener una conversación privada con ellos. ¡Pero puedes invitarlos fácilmente! 🚀"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les utilisateurs ci-dessous ne font pas partie de vos contacts, et vous ne pouvez pas encore avoir de discussion privée avec eux. Mais vous pouvez les y inviter facilement 🚀 !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli utenti elencati di seguito non sono presenti nella tua rubrica e al momento non puoi avviare una conversazione privata con loro. Tuttavia, puoi facilmente invitarli ad aggiungersi! 🚀"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下のユーザーはあなたの連絡先に含まれていないため、まだプライベートなディスカッションをすることはできません。しかし、簡単に招待することができます！🚀"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아래 사용자는 연락처에 없으므로 아직 비공개 대화를 나눌 수 없습니다. 하지만 쉽게 초대하여 대화할 수 있습니다! 🚀"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poniżej znajdują się użytkownicy, którzy nie są w Twoich kontaktach i z którymi na razie nie możesz prowadzić prywatnej rozmowy. Możesz ich jednak łatwo zaprosić! 🚀"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os usuários abaixo não estão na sua lista de contatos e você ainda não pode ter uma conversa privada com eles. Mas você pode convidá-los facilmente! 🚀"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os utilizadores abaixo não fazem parte dos seus contactos e, por isso, ainda não pode ter conversas privadas com eles. Mas pode convidá-los facilmente! 🚀"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пользователи в списке ниже не входят в ваш список контактов, и пока вы не можете вести с ними личные обсуждения. Но вы можете легко пригласить их! 🚀"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aşağıdaki kullanıcılar kişileriniz arasında değil ve henüz onlarla özel bir sohbet başlatamazsınız. Ancak onları kolayca davet edebilirsiniz! 🚀"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Користувачі, перелічені нижче, не входять до вашого списку контактів, і ви поки що не можете мати з ними приватну розмову. Але ви можете легко запросити їх! 🚀"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Những người dùng được liệt kê bên dưới không có trong danh bạ của bạn và hiện tại bạn chưa thể trò chuyện riêng tư với họ. Nhưng bạn có thể dễ dàng mời họ tham gia! 🚀"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以下用户不在您的联系人列表中，因此您目前无法与他们进行私密对话。但您可以轻松地邀请他们加入！🚀"
          }
        }
      }
    },
