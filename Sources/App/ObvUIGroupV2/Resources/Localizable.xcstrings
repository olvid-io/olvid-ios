    "SINGLE_GROUP_V2_VIEW_ALERT_CANNOT_LEAVE_GROUP_AS_KEYCLOAK_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da diese Gruppe von Ihrem Unternehmensserver verwaltet wird, können Sie sie nicht verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Since this group a managed by your company's server, you cannot leave it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dado que este grupo es administrado por el servidor de tu empresa, no puedes abandonarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme ce groupe et géré par le serveur de votre entreprise, il ne vous est pas possible de le quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiché questo gruppo è gestito dal server della tua azienda, non puoi abbandonarlo."
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_ALERT_CANNOT_LEAVE_GROUP_AS_KEYCLOAK_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Gruppe nicht verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot leave the group"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes abandonar el grupo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas quitter le groupe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non puoi lasciare il gruppo"
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_ALERT_CANNOT_LEAVE_GROUP_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da Sie der einzige Administrator dieser Gruppe sind, können Sie diese momentan nicht verlassen (Sie würden die Gruppe ohne Administrator verlassen). Sie können einen anderen Administrator unter den anderen Gruppenmitgliedern benennen und es erneut versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Since you are the only administrator of this group, you cannot leave it now (you would leave the group with no administrator). You can name another administrator among the other group members and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dado que eres el único administrador de este grupo, no puedes abandonarlo ahora (dejarías el grupo sin administrador). Puedes nombrar a otro administrador entre los demás miembros del grupo e intentarlo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme vous êtes le seul administrateur de ce groupe, il vous est impossible de le quitter (vous laisseriez le groupe sans administrateur). Une fois que vous aurez nommé un autre administrateur, vous pourrez essayer à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Essendo l'unico amministratore di questo gruppo, non puoi abbandonarlo ora (lasceresti il gruppo senza un amministratore). Puoi nominare un altro amministratore tra gli altri membri del gruppo e riprovare."
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_ALERT_CANNOT_LEAVE_GROUP_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Gruppe im Moment nicht verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot leave the group for now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes abandonar el grupo por ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez pas quitter le groupe pour le moment"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora non puoi lasciare il gruppo"
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_SHEET_CONFIRM_DISBAND_GROUP_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beachten Sie, dass diese Aktion nicht rückgängig gemacht werden kann. Wenn Sie bestätigen, wird diese Gruppe für alle Mitglieder gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please note that this action is irreversible. If you confirm, this group will be deleted for all members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que esta acción es irreversible. Si confirmas, este grupo se eliminará para todos los miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un groupe est une opération irréversible. Si vous continuez, le groupe sera supprimé chez tous les membres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di notare che questa azione è irreversibile. Se confermi, questo gruppo verrà eliminato per tutti i membri."
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_SHEET_CONFIRM_DISBAND_GROUP_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung! Möchtest du diese Gruppe wirklich auflösen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heads-up! Do you really wish to disband this group?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Atención! ¿De verdad quieres disolver este grupo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention ! Voulez-vous vraiment supprimer ce groupe ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione! Sei sicuro di voler sciogliere questo gruppo?"
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_SHEET_CONFIRM_LEAVE_GROUP_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beachten Sie, dass diese Aktion unwiderruflich ist (es sei denn, ein Gruppenadministrator beschließt, Sie später erneut einzuladen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please note that this action is irreversible (unless a group administrator decides to invite you again later on)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que esta acción es irreversible (a menos que un administrador del grupo decida invitarte nuevamente más tarde)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention, cette action est irréversible (sauf si un administrateur du groupe vous y invite à nouveau après que vous l'ayez quitté)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di notare che questa azione è irreversibile (a meno che un amministratore del gruppo non decida di invitarti nuovamente in seguito)."
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_SHEET_CONFIRM_LEAVE_GROUP_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie diese Gruppe wirklich verlassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really wish to leave this group?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿De verdad quieres salir de este grupo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment quitter le groupe ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuoi davvero lasciare questo gruppo?"
          }
        }
      }
    },
