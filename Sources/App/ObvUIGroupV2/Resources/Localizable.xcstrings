    "DISCUSSION_MODERATION_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer kann \"überall löschen\"-Nachrichten von anderen Nutzern löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can \"delete everywhere\" messages from other users?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién puede eliminar mensajes de otros usuarios en todas partes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui peut « supprimer partout » les messages d'autres utilisateurs ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi può cancellare i messaggi \"ovunque\" da altri utenti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のユーザーのメッセージを「完全に削除」できるのは誰ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 사용자의 메시지를 '모두 삭제'할 수 있는 사람은 누구입니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem pode excluir mensagens de outros usuários em todos os dispositivos?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem pode \"eliminar em todos os dispositivos\" as mensagens de outros utilizadores?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кто может удалять сообщения других пользователей «везде»?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хто може видаляти повідомлення інших користувачів \"всюди\"?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谁可以“彻底删除”其他用户的消息？"
          }
        }
      }
    },
