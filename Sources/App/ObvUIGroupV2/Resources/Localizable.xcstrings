    "DISCUSSION_MODERATION_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wer kann \"überall löschen\"-Nachrichten von anderen Nutzern löschen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who can \"delete everywhere\" messages from other users?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quién puede eliminar mensajes de otros usuarios en todas partes?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui peut « supprimer partout » les messages d'autres utilisateurs ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi può cancellare i messaggi \"ovunque\" da altri utenti?"
          }
        }
      }
    },
