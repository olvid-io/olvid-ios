    "SINGLE_GROUP_V2_VIEW_ALERT_CANNOT_LEAVE_GROUP_AS_KEYCLOAK_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Da diese Gruppe von Ihrem Unternehmensserver verwaltet wird, können Sie sie nicht verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Since this group a managed by your company's server, you cannot leave it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dado que este grupo es administrado por el servidor de tu empresa, no puedes abandonarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme ce groupe et géré par le serveur de votre entreprise, il ne vous est pas possible de le quitter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiché questo gruppo è gestito dal server della tua azienda, non puoi abbandonarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループは会社のサーバーによって管理されているため、グループを退出することはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹은 귀사의 서버에서 관리되므로 그룹을 나가실 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como este grupo é gerenciado pelo servidor da sua empresa, você não pode sair dele."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Como este grupo é gerido pelo servidor da sua empresa, não pode sair dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поскольку эта группа управляется сервером вашей компании, вы не можете её покинуть."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Оскільки ця група управляється сервером вашої компанії, ви не можете її покинути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于此群组由您公司的服务器管理，因此您无法离开该群组。"
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_ALERT_CANNOT_LEAVE_GROUP_AS_KEYCLOAK_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst die Gruppe nicht verlassen."
          }
        },
        "en": {
          "stringUnit": {
