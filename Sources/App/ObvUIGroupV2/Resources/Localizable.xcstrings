    "SINGLE_GROUP_V2_VIEW_SHEET_CONFIRM_DISBAND_GROUP_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beachten Sie, dass diese Aktion nicht rückgängig gemacht werden kann. Wenn Sie bestätigen, wird diese Gruppe für alle Mitglieder gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please note that this action is irreversible. If you confirm, this group will be deleted for all members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que esta acción es irreversible. Si confirmas, este grupo se eliminará para todos los miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un groupe est une opération irréversible. Si vous continuez, le groupe sera supprimé chez tous les membres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di notare che questa azione è irreversibile. Se confermi, questo gruppo verrà eliminato per tutti i membri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は元に戻せません。確認すると、このグループはすべてのメンバーに対して削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없다는 점을 유념해 주세요. 확인하시면 이 그룹은 모든 구성원에게 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, observe que esta ação é irreversível. Se confirmar, este grupo será excluído para todos os membros."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha em atenção que esta ação é irreversível. Ao confirmar, este grupo será eliminado para todos os membros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, обратите внимание, что это действие необратимо. Если вы подтвердите, эта группа будет удалена для всех участников."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, зверніть увагу, що ця дія незворотна. Якщо ви підтвердите, ця група буде видалена для всіх учасників."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请注意，此操作不可撤销。如果您确认，此群组将被删除，所有成员都将无法再访问。"
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_SHEET_CONFIRM_DISBAND_GROUP_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung! Möchtest du diese Gruppe wirklich auflösen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heads-up! Do you really wish to disband this group?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Atención! ¿De verdad quieres disolver este grupo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention ! Voulez-vous vraiment supprimer ce groupe ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione! Sei sicuro di voler sciogliere questo gruppo?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "警告：このグループを本当に解散しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림! 정말 이 그룹을 해체하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenção! Você realmente deseja encerrar este grupo?"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Atenção! Tem a certeza de que quer encerrar este grupo?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Внимание! Вы действительно хотите распустить эту группу?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увага! Ви дійсно хочете розпустити цю групу?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请注意！您真的要解散此群组吗？"
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_SHEET_CONFIRM_LEAVE_GROUP_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beachten Sie, dass diese Aktion unwiderruflich ist (es sei denn, ein Gruppenadministrator beschließt, Sie später erneut einzuladen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please note that this action is irreversible (unless a group administrator decides to invite you again later on)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que esta acción es irreversible (a menos que un administrador del grupo decida invitarte nuevamente más tarde)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention, cette action est irréversible (sauf si un administrateur du groupe vous y invite à nouveau après que vous l'ayez quitté)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di notare che questa azione è irreversibile (a meno che un amministratore del gruppo non decida di invitarti nuovamente in seguito)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作は元に戻すことができません（グループの管理者が後であなたを招待し直す場合を除く）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 되돌릴 수 없다는 점에 유의하십시오(나중에 그룹 관리자가 다시 초대하기로 결정하는 경우 제외)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por favor, observe que esta ação é irreversível (a menos que um administrador do grupo decida convidá-lo novamente mais tarde)."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenha em atenção que esta ação é irreversível (a menos que um administrador do grupo decida convidá-lo novamente mais tarde)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пожалуйста, обратите внимание, что это действие необратимо (если только администратор группы не решит пригласить вас снова позже)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь ласка, зверніть увагу, що ця дія незворотна (якщо тільки адміністратор групи не вирішить запросити вас пізніше)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请注意，此操作不可逆（除非群组管理员稍后决定再次邀请您）。"
          }
        }
      }
    },
    "SINGLE_GROUP_V2_VIEW_SHEET_CONFIRM_LEAVE_GROUP_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie diese Gruppe wirklich verlassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really wish to leave this group?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿De verdad quieres salir de este grupo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment quitter le groupe ?"
          }
