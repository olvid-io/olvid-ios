    "NO_ADMIN_IN_KEYCLOAK_GROUP": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist eine vom System verwaltete Gruppe. Mitglieder können die Gruppe nicht direkt bearbeiten. Wenden Sie sich für Änderungen bitte an Ihren Administrator."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a directory-managed group. Members cannot edit the group directly. For any modifications, please contact your administrator."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un grupo administrado por el sistema. Los miembros no pueden editar el grupo directamente. Para cualquier modificación, por favor contacta a tu administrador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un groupe géré par l'annuaire. Les membres ne peuvent pas éditer le groupe directement. Pour tout changement, veuillez contacter votre administrateur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è un gruppo gestito dall'amministratore. I membri non possono modificare direttamente il gruppo. Per qualsiasi modifica, contattare l'amministratore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これはディレクトリによって管理されるグループです。メンバーはグループを直接編集できません。変更が必要な場合は、管理者にお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 디렉터리에서 관리하는 그룹입니다. 구성원은 그룹을 직접 수정할 수 없습니다. 변경 사항이 필요하면 관리자에게 문의하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um grupo gerenciado por um administrador. Os membros não podem editar o grupo diretamente. Para quaisquer modificações, entre em contato com o administrador."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este é um grupo gerido pelo administrador. Os membros não podem editar o grupo diretamente. Para qualquer alteração, contacte o seu administrador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это групповой чат, управляемый администратором. Участники не могут редактировать группу напрямую. Пожалуйста, свяжитесь с вашим администратором для любых изменений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це групу, якою керує система. Учасники не можуть редагувати групу безпосередньо. З будь-якими змінами звертайтеся до адміністратора."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一个由管理员管理的群组。成员不能直接编辑群组。如有任何修改需求，请联系您的管理员。"
          }
        }
      }
    },
