    "LOCATION_UNAVAILABLE_ALERT_MESSAGE": {
      "comment": "Body of that alert: why nothing can be shared, and where the permission lives",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid hat den Standort Ihres Geräts nicht erhalten. Prüfen Sie, ob die Ortungsdienste aktiviert sind und ob Olvid auf Ihren Standort zugreifen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid has not received your device's location. Check that Location Services are turned on and that Olvid is allowed to access your location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid no ha recibido la ubicación de tu dispositivo. Comprueba que la localización esté activada y que Olvid tenga permiso para acceder a tu ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid n'a pas reçu la position de votre appareil. Vérifiez que le service de localisation est activé et qu'Olvid est autorisé à accéder à votre position."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid non ha ricevuto la posizione del tuo dispositivo. Verifica che la localizzazione sia attiva e che Olvid sia autorizzato ad accedere alla tua posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvidはこの端末の位置情報を取得できませんでした。位置情報サービスがオンになっていること、およびOlvidに位置情報へのアクセスが許可されていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid가 이 기기의 위치를 받지 못했습니다. 위치 서비스가 켜져 있고 Olvid에 위치 접근 권한이 허용되어 있는지 확인하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja Olvid nie otrzymała lokalizacji twojego urządzenia. Sprawdź, czy usługi lokalizacji są włączone i czy Olvid ma dostęp do twojej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid não recebeu a localização do seu dispositivo. Verifique se os serviços de localização estão ativados e se o Olvid tem permissão para acessar sua localização."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O Olvid não recebeu a localização do seu dispositivo. Verifique se os serviços de localização estão ativados e se o Olvid tem permissão para aceder à sua localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не получил геопозицию вашего устройства. Проверьте, включены ли службы геолокации и разрешён ли Olvid доступ к вашей геопозиции."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid, cihazınızın konumunu alamadı. Konum Servisleri'nin açık olduğunu ve Olvid'in konumunuza erişmesine izin verildiğini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid не отримав геопозицію вашого пристрою. Перевірте, чи ввімкнено служби геолокації та чи надано Olvid доступ до вашої геопозиції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid chưa nhận được vị trí của thiết bị. Hãy kiểm tra xem Dịch vụ định vị đã bật chưa và Olvid có được phép truy cập vị trí của bạn không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvid 未能获取本设备的位置。请检查是否已开启定位服务，并允许 Olvid 访问你的位置。"
          }
        }
      }
    },
