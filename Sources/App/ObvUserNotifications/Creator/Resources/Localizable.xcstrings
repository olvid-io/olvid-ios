    "You are invited to join a group created by %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurden eingeladen, einer Gruppe beizutreten, die von %@ erstellt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are invited to join a group created by %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has sido invitado a unirte a un grupo creado por %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes invité à rejoindre un groupe créé par %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato invitato a partecipare a un gruppo creato da %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@さんが作成したグループへの招待です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에서 생성한 그룹에 초대되었습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otrzymujesz zaproszenie do grupy utworzonej przez: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você foi convidado(a) a participar de um grupo criado por %@."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi-lhe enviado um convite para participar num grupo criado por %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас пригласили присоединиться к группе, созданной пользователем %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tarafından oluşturulan bir gruba katılmaya davet edildiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас запрошено долучитися до групи, створеної користувачем %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn được mời tham gia một nhóm do %@ tạo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您被邀请加入由 %@ 创建的群组。"
          }
        }
      }
    },
    "You now appear in %@'s contacts list. A secure channel is being established. When this is done, you will be able to exchange confidential messages and more!": {
