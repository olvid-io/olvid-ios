          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно из ваших других устройств может перенести историю ваших чатов на это устройство. Нажмите, чтобы узнать больше."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
