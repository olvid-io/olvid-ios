    "HISTORY_TRANSFER_REQUEST_NOTIFICATION_BODY": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eines Ihrer anderen Geräte kann Ihren Chatverlauf auf dieses Gerät übertragen. Tippen Sie hier, um mehr zu erfahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another of your devices can transfer your chat history to this device. Tap to learn more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro de tus dispositivos puede transferir el historial de tus chats a este dispositivo. Toca para obtener más información."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre de vos appareils peut transférer votre historique de discussions vers cet appareil. Appuyez pour en savoir plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro dei tuoi dispositivi può trasferire la cronologia delle chat su questo dispositivo. Tocca per maggiori informazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスから、このデバイスにチャット履歴を転送できます。詳細はこちらをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 현재 기기로 채팅 기록을 전송할 수 있습니다. 자세한 내용은 여기를 탭하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro de seus dispositivos pode transferir o histórico de conversas para este dispositivo. Toque para saber mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro dos seus dispositivos pode transferir o histórico de conversas para este dispositivo. Toque para saber mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно из ваших других устройств может перенести историю ваших чатов на это устройство. Нажмите, чтобы узнать больше."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інший ваш пристрій може перенести історію ваших розмов на цей пристрій. Торкніться, щоб дізнатися більше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的其他设备可以将聊天记录传输到此设备。点击了解更多信息。"
          }
        }
      }
    },
    "HISTORY_TRANSFER_REQUEST_NOTIFICATION_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragen Sie Ihren Chatverlauf auf dieses Gerät."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfer your chat history to this device"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfiere el historial de tus conversaciones a este dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférez votre historique des discussions vers cet appareil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasferisci la cronologia delle chat su questo dispositivo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスにチャット履歴を転送"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치로 채팅 기록을 전송하세요"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfira o histórico de suas conversas para este dispositivo"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Transfira o seu histórico de conversas para este dispositivo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесите историю ваших чатов на это устройство"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перенесіть історію ваших розмов на цей пристрій"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将您的聊天记录转移到此设备"
          }
        }
      }
    },
