        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otro de tus dispositivos puede transferir el historial de tus chats a este dispositivo. Toca para obtener más información."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre de vos appareils peut transférer votre historique de discussions vers cet appareil. Appuyez pour en savoir plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro dei tuoi dispositivi può trasferire la cronologia delle chat su questo dispositivo. Tocca per maggiori informazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別のデバイスから、このデバイスにチャット履歴を転送できます。詳細はこちらをタップしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 기기에서 현재 기기로 채팅 기록을 전송할 수 있습니다. 자세한 내용은 여기를 탭하세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno z twoich innych urządzeń może przenieść historię czatów na to urządzenie. Stuknij, aby dowiedzieć się więcej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro de seus dispositivos pode transferir o histórico de conversas para este dispositivo. Toque para saber mais."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
