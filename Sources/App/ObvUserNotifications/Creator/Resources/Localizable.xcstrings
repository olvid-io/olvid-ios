    "REACTED_WITH_%@_TO_ONE_OF_YOUR_SENT_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat auf eine deiner Nachrichten mit %1$@ reagiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reacted %1$@ to one of your messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reaccionó %1$@ a uno de tus mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A réagi %1$@ à l’un de vos messages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ha reagito a uno dei tuoi messaggi con %1$@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのメッセージのいずれかに%1$@というリアクションがされました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 메시지 중 하나에 %1$@로 반응했습니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reakcja %1$@ na jedną z twoich wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reagiu %1$@ a uma das suas mensagens."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Reagiu %1$@ a uma das suas mensagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Реагировал(а) %1$@ на одно из ваших сообщений."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlarınızdan birine %1$@ tepkisi verdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відреагував %1$@ на одне з ваших повідомлень."
