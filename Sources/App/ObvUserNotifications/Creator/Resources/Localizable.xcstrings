    "You receive a new invitation from %@. You can accept or silently discard it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ möchte mit Ihnen sprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ would like to discuss with you."
          }
        },
        "es": {
          "stringUnit": {
