          "stringUnit": {
            "state": "translated",
            "value": "Foi-lhe enviado um convite para participar num grupo criado por %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас пригласили присоединиться к группе, созданной пользователем %@."
