    "You are invited to join a group created by %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurden eingeladen, einer Gruppe beizutreten, die von %@ erstellt wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are invited to join a group created by %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has sido invitado a unirte a un grupo creado por %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes invité à rejoindre un groupe créé par %@."
          }
        },
