{
  "sourceLanguage": "en",
  "strings": {
    "%@_INVITES_YOU_TO_ONE_TO_ONE_DISCUSSION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt dich zu einem privaten Gespräch ein. Wenn du annimmst, wird dieser Benutzer zu deinen Kontakten hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ invites you to have a private discussion. If you accept, this user will be added to your contacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te invita a tener una conversación privada. Si aceptas, este usuario se agregará a tus contactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous invite à discuter en privé. Si vous acceptez, cet utilisateur sera ajouté à vos contacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ti invita ad una conversazione privata. Se accetti, questo utente verrà aggiunto ai tuoi contatti."
          }
        }
      }
    },
