    "REACTED_WITH_%@_TO_ONE_OF_YOUR_SENT_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hat auf eine deiner Nachrichten mit %1$@ reagiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reacted %1$@ to one of your messages."
          }
        },
        "es": {
