{
  "sourceLanguage": "en",
  "strings": {
    "%@_INVITES_YOU_TO_ONE_TO_ONE_DISCUSSION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lädt dich zu einem privaten Gespräch ein. Wenn du annimmst, wird dieser Benutzer zu deinen Kontakten hinzugefügt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ invites you to have a private discussion. If you accept, this user will be added to your contacts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ te invita a tener una conversación privada. Si aceptas, este usuario se agregará a tus contactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vous invite à discuter en privé. Si vous acceptez, cet utilisateur sera ajouté à vos contacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ti invita ad una conversazione privata. Se accetti, questo utente verrà aggiunto ai tuoi contatti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ があなたをプライベートな会話に招待しました。承諾すると、このユーザーがあなたの連絡先に登録されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@님이 비공개 대화에 초대합니다. 수락하시면 해당 사용자가 연락처에 추가됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está convidando você para uma conversa privada. Se você aceitar, este usuário será adicionado aos seus contatos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ convida-o(a) a participar numa conversa privada. Se aceitar, este utilizador será adicionado aos seus contactos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ приглашает вас в личную беседу. Если вы примите, этот пользователь будет добавлен в ваши контакты."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запрошує вас до приватної розмови. Якщо ви приймете, цей користувач буде доданий до ваших контактів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 邀请您进行私聊。如果您接受，此用户将被添加到您的联系人中。"
          }
        }
      }
    },
