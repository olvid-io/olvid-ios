    "AUTHENTICATION_REQUIRED_TOKEN_EXPIRED_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Olvid-Identität wird von Ihrem Unternehmens-Identitätsanbieter verwaltet. Sie müssen sich erneut bei diesem Identitätsanbieter authentifizieren, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Olvid identity is managed by your company's identity provider. You need to re-authenticate with this identity provider to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu identidad de Olvid está gestionada por el proveedor de identidad de tu empresa. Necesitas volver a autenticarte con este proveedor para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identité Olvid est gérée par le fournisseur d'identité de votre entreprise. Il faut vous réauthentifier auprès de ce fournisseur d'identité pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua identità Olvid è gestita dal provider di identità della tua azienda. Devi riautenticarti con questo provider di identità per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様のOlvidアカウントは、会社のIDプロバイダーによって管理されています。続行するには、このIDプロバイダーで再度認証する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 Olvid 계정은 회사에서 제공하는 신원 공급자를 통해 관리됩니다. 계속하려면 해당 신원 공급자로 다시 인증해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua identidade Olvid é gerenciada pelo provedor de identidade da sua empresa. Você precisa se autenticar novamente com este provedor de identidade para continuar."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A sua identidade Olvid é gerida pelo fornecedor de identidade da sua empresa. Tem de autenticar-se novamente neste fornecedor de identidade para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша личность в Olvid управляется поставщиком удостоверений вашей компании. Вам необходимо повторно аутентифицироваться с помощью этого поставщика, чтобы продолжить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша особистість Olvid управляється постачальником ідентифікації вашої компанії. Вам потрібно повторно автентифікуватися з цим постачальником ідентифікації, щоб продовжити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Olvid 身份由您的公司身份提供程序管理。您需要使用此身份提供程序重新进行身份验证才能继续。"
          }
        }
      }
    },
    "AUTHENTICATION_REQUIRED_USER_ID_CHANGED_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Olvid ID wird von Ihrem Unternehmens-Identitätsanbieter verwaltet. Es scheint, dass Sie sich als ein anderer Benutzer als gewöhnlich authentifiziert haben. Dies wird nicht unterstützt.\n\nWenden Sie sich bitte an Ihren Administrator oder authentifizieren Sie sich erneut als der richtige Benutzer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You Olvid ID is managed by your company's identity provider. It seems you authenticated as a different user than usual. This is not supported.\n\nPlease contact your administrator or re-authenticate as the correct user."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ID de Olvid es gestionado por el proveedor de identidad de tu empresa. Parece que has autenticado como un usuario diferente al habitual. Esto no está soportado.\n\nPor favor, contacta a tu administrador o vuelve a autenticarte como el usuario correcto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ID Olvid est géré par le fournisseur d'identité de votre entreprise. Il semblerait que vous vous soyez authentifié avec un compte différent du compte habituel. Ceci n'est pas supporté.\n\nContactez votre adminisrateur ou réauthentifiez-vous avec le compte habituel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Olvid ID è gestito dal provider di identità della tua azienda. Sembra che tu ti sia autenticato con un utente diverso dal solito. Questa operazione non è supportata.\n\nContatta il tuo amministratore o riautenticati con l'utente corretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様のOlvid IDは、会社のIDプロバイダーによって管理されています。普段とは異なるユーザーとして認証されたようです。この操作はサポートされていません。\n管理者にお問い合わせいただくか、正しいユーザーとして再認証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀사의 ID 공급업체에서 Olvid ID를 관리합니다. 평소와 다른 사용자로 인증하신 것 같습니다. 이 기능은 지원되지 않습니다.\n관리자에게 문의하거나 올바른 사용자로 다시 인증해 주십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu ID Olvid é gerenciado pelo provedor de identidade da sua empresa. Parece que você fez login como um usuário diferente do habitual. Isso não é suportado.\n\nEntre em contato com seu administrador ou faça login novamente com o usuário correto."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu ID Olvid é gerido pelo fornecedor de identidade da sua empresa. Parece que efetuou a autenticação como um utilizador diferente do habitual. Isto não é suportado.\n\nContacte o seu administrador ou volte a autenticar-se como o utilizador correto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Olvid ID управляется поставщиком удостоверений вашей компании. Похоже, вы вошли в систему под другим пользователем, чем обычно. Это не поддерживается.\n\nПожалуйста, обратитесь к вашему администратору или повторно аутентифицируйтесь под правильным пользователем."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш Olvid ID керується постачальником ідентифікації вашої компанії. Здається, ви авторизувалися як інший користувач, ніж зазвичай. Це не підтримується.\n\nЗверніться до адміністратора або повторно авторизуйтеся як правильний користувач."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的 Olvid ID 由您公司的身份提供程序管理。您似乎使用了与平时不同的用户身份进行身份验证。这不受支持。\n\n请联系您的管理员或使用正确的用户身份重新进行身份验证。"
          }
        }
      }
    },
