          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не можете отменить подтверждение своей личности"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не можете відкликати свою особистість"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无法撤销您的身份验证"
          }
        }
      }
    },
    "KEYCLOAK_REVOCATION_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Olvid-ID ist mit Ihrem Konto bei Ihrem Unternehmens-Identitätsanbieter verknüpft. Wenn Sie eine neue ID generiert haben, müssen Sie die vorherige widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Olvid ID is associated with your account on your company's identity provider. If you generated a new ID you need to revoke the previous one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha asociado otro ID de Olvid a tu cuenta en el proveedor de identidad de tu empresa. Si generaste un nuevo ID, debes revocar el anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre ID Olvid est associé avec le compte géré par le fournisseur d'identité de votre entreprise. Si vous avez généré un nouvel ID Olvid, il vous faut révoquer le précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro ID Olvid è associato al tuo account sul provider di identità della tua azienda. Se hai generato un nuovo ID, devi revocare quello precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様の会社のIDプロバイダーで、お客様のアカウントに別のOlvid IDが関連付けられています。新しいIDを生成した場合は、以前のIDを無効にする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 회사 ID 공급자에 귀하의 계정과 연결된 다른 Olvid ID가 있습니다. 새 ID를 생성한 경우 이전 ID를 해지해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro ID Olvid está associado à sua conta no provedor de identidade da sua empresa. Se você gerou um novo ID, precisará revogar o anterior."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está associado outro ID Olvid à sua conta no fornecedor de identidade da sua empresa. Se tiver gerado um novo ID, tem de revogar o anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "К вашей учетной записи на сервере идентификации вашей компании привязан другой Olvid ID. Если вы сгенерировали новый ID, необходимо отозвать предыдущий."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До вашого облікового запису на провайдері ідентифікації вашої компанії прив’язано інший Olvid ID. Якщо ви згенерували новий ID, вам потрібно відкликати попередній."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的公司身份验证服务中已关联了另一个 Olvid ID。如果您已生成新的 ID，则需要撤销之前的 ID。"
          }
        }
      }
    },
