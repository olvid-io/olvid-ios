    "KEYCLOAK_REVOCATION_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine andere Olvid-ID ist mit Ihrem Konto bei Ihrem Unternehmens-Identitätsanbieter verknüpft. Wenn Sie eine neue ID generiert haben, müssen Sie die vorherige widerrufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another Olvid ID is associated with your account on your company's identity provider. If you generated a new ID you need to revoke the previous one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha asociado otro ID de Olvid a tu cuenta en el proveedor de identidad de tu empresa. Si generaste un nuevo ID, debes revocar el anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre ID Olvid est associé avec le compte géré par le fournisseur d'identité de votre entreprise. Si vous avez généré un nouvel ID Olvid, il vous faut révoquer le précédent."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un altro ID Olvid è associato al tuo account sul provider di identità della tua azienda. Se hai generato un nuovo ID, devi revocare quello precedente."
          }
        }
      }
    },
