    "AUTHENTICATION_REQUIRED_TOKEN_EXPIRED_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Olvid-Identität wird von Ihrem Unternehmens-Identitätsanbieter verwaltet. Sie müssen sich erneut bei diesem Identitätsanbieter authentifizieren, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Olvid identity is managed by your company's identity provider. You need to re-authenticate with this identity provider to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu identidad de Olvid está gestionada por el proveedor de identidad de tu empresa. Necesitas volver a autenticarte con este proveedor para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre identité Olvid est gérée par le fournisseur d'identité de votre entreprise. Il faut vous réauthentifier auprès de ce fournisseur d'identité pour continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua identità Olvid è gestita dal provider di identità della tua azienda. Devi riautenticarti con questo provider di identità per continuare."
          }
        }
      }
    },
    "AUTHENTICATION_REQUIRED_USER_ID_CHANGED_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Olvid ID wird von Ihrem Unternehmens-Identitätsanbieter verwaltet. Es scheint, dass Sie sich als ein anderer Benutzer als gewöhnlich authentifiziert haben. Dies wird nicht unterstützt.\n\nWenden Sie sich bitte an Ihren Administrator oder authentifizieren Sie sich erneut als der richtige Benutzer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You Olvid ID is managed by your company's identity provider. It seems you authenticated as a different user than usual. This is not supported.\n\nPlease contact your administrator or re-authenticate as the correct user."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ID de Olvid es gestionado por el proveedor de identidad de tu empresa. Parece que has autenticado como un usuario diferente al habitual. Esto no está soportado.\n\nPor favor, contacta a tu administrador o vuelve a autenticarte como el usuario correcto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ID Olvid est géré par le fournisseur d'identité de votre entreprise. Il semblerait que vous vous soyez authentifié avec un compte différent du compte habituel. Ceci n'est pas supporté.\n\nContactez votre adminisrateur ou réauthentifiez-vous avec le compte habituel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo Olvid ID è gestito dal provider di identità della tua azienda. Sembra che tu ti sia autenticato con un utente diverso dal solito. Questa operazione non è supportata.\n\nContatta il tuo amministratore o riautenticati con l'utente corretto."
          }
        }
      }
    },
    "BUTTON_LABEL_UPDATE_KEY": {
