    "REJECTED_INCOMING_CALL_AS_RECEIVE_CALL_SETTINGS_IS_FALSE": {
      "localizations": {
        "de": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ein eingehender sicherer Anruf wurde automatisch abgewiesen, da Sie entschieden haben, auf diesem Gerät keine Anrufe zu empfangen. Klicken Sie auf diese Nachricht, um die Einstellung anzuzeigen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Ein eingehender sicherer Anruf wurde automatisch abgewiesen, da Sie entschieden haben, auf diesem Gerät keine Anrufe zu empfangen. Tippen Sie auf diese Nachricht, um die Einstellung anzuzeigen."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "An incoming secure call was automatically rejected as you chose not to receive calls on this device. Click this message to show the setting."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "An incoming secure call was automatically rejected as you chose not to receive calls on this device. Tap this message to show the setting."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una llamada segura entrante se rechazó automáticamente porque elegiste no recibir llamadas en este dispositivo. Haz clic en este mensaje para ver la configuración."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una llamada segura entrante se rechazó automáticamente porque elegiste no recibir llamadas en este dispositivo. Toca este mensaje para ver la configuración."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un appel entrant a été automatiquement refusé puisque vous avez choisi de ne pas recevoir d'appel sur cet appareil. Cliquez ce message pour afficher le paramètre."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un appel entrant a été automatiquement refusé puisque vous avez choisi de ne pas recevoir d'appel sur cet appareil. Touchez cette notification pour afficher le paramètre."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una chiamata sicura in arrivo è stata rifiutata automaticamente poiché hai scelto di non ricevere chiamate su questo dispositivo. Clicca su questo messaggio per visualizzare l'impostazione."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una chiamata sicura in arrivo è stata rifiutata automaticamente poiché hai scelto di non ricevere chiamate su questo dispositivo. Tocca questo messaggio per visualizzare l'impostazione."
                }
              }
            }
          }
        }
      }
    },
    "REJECTED_INCOMING_CALL_BECAUSE_RECORD_PERMISSION_IS_DENIED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingehende Anruf wurde abgelehnt, da Olvid keinen Zugriff auf das Mikrofon hat. Um zukünftige Anrufe nicht mehr zu verpassen, gehen Sie bitte zu den Einstellungen und erteilen Sie Olvid Zugriff auf das Mikrofon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The incoming call was rejected because Olvid is not allowed to access the Microphone. To never miss a call again, please go to Settings and grant Olvid access to the microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llamada entrante fue rechazada porque Olvid no tiene permiso para acceder al micrófono. Para no perder más llamadas, ve a Ajustes y otorga a Olvid acceso al micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appel entrant n'a pas abouti car Olvid n'a pas l'autorisation d'accéder au micro. Pour ne plus rater d'appel, allez dans les Réglages et autorisez l'accès au micro pour Olvid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiamata in arrivo è stata rifiutata perché Olvid non ha il permesso di accedere al Microfono. Per non perdere mai più una chiamata, vai su Impostazioni e concedi a Olvid l'accesso al microfono."
          }
        }
      }
    },
    "REJECTED_INCOMING_CALL_BECAUSE_RECORD_PERMISSION_IS_GRANTED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingehende Anruf wurde abgelehnt, da Olvid keinen Zugriff auf das Mikrofon hatte. Glücklicherweise wurde diese Berechtigung inzwischen erteilt. Sie werden keinen Anruf mehr verpassen 🥳!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The incoming call was rejected because Olvid was not allowed to access the Microphone. Fortunately, since then, this autorisation was granted. You won't miss a call again 🥳!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llamada entrante fue rechazada porque Olvid no tenía permiso para acceder al micrófono. Afortunadamente, desde entonces, se otorgó este permiso. ¡No volverás a perder una llamada! 🥳!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appel entrant n'a pas abouti car Olvid n'avait pas l'autorisation d'accéder au micro. Fort heureusement, l'autorisation a été accordée. Vous ne raterez plus aucun appel 🥳 !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiamata in arrivo è stata rifiutata perché Olvid non aveva il permesso di accedere al microfono. Fortunatamente, da allora, l'autorizzazione è stata concessa. Non perderai più nessuna chiamata 🥳!"
          }
        }
      }
    },
    "REJECTED_INCOMING_CALL_BECAUSE_RECORD_PERMISSION_IS_UNDETERMINED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingehende Anruf wurde abgelehnt, da Olvid nicht auf das Mikrofon zugreifen darf. Bitte tippen Sie auf diese Nachricht, um Olvid den Zugriff auf das Mikrofon zu erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The incoming call was rejected because Olvid is not allowed to access the microphone. Please tap on this message to allow Olvid to access the Microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La llamada entrante fue rechazada porque Olvid no tiene permiso para acceder al micrófono. Por favor, pulsa en este mensaje para permitir que Olvid acceda al Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'appel entrant n'a pas abouti car Olvid n'a pas l'autorisation d'accéder au micro. Cliquez sur ce message pour autoriser l'accès au micro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiamata in arrivo è stata rifiutata perché Olvid non ha il permesso di accedere al microfono. Tocca questo messaggio per consentire a Olvid di accedere al microfono."
          }
        }
      }
    },
