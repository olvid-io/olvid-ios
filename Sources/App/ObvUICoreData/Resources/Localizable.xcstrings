                "stringUnit": {
                  "state": "translated",
                  "value": "보안 통화가 들어왔지만 이 장치에서 통화를 받지 않도록 설정했으므로 자동으로 거부되었습니다. 이 메시지를 탭하여 설정을 확인하세요."
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uma chamada segura de entrada foi rejeitada automaticamente porque você optou por não receber chamadas neste dispositivo. Clique nesta mensagem para exibir a configuração."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Uma chamada segura de entrada foi rejeitada automaticamente porque você optou por não receber chamadas neste dispositivo. Toque nesta mensagem para exibir a configuração."
                }
