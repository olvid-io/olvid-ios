        "uk": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вхідний захищений дзвінок було автоматично відхилено, оскільки ви не вибрали отримання дзвінків на цьому пристрої. Натисніть це повідомлення, щоб переглянути налаштування."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Вхідний захищений дзвінок було автоматично відхилено, оскільки ви не вибрали отримання дзвінків на цьому пристрої. Торкніться цього повідомлення, щоб переглянути налаштування."
