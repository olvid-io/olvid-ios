        },
        "it": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una chiamata sicura in arrivo è stata rifiutata automaticamente poiché hai scelto di non ricevere chiamate su questo dispositivo. Clicca su questo messaggio per visualizzare l'impostazione."
                }
              },
              "other": {
