        "ru": {
          "variations": {
            "device": {
              "mac": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Входящий защищенный вызов был автоматически отклонен, так как вы не включили прием вызовов на этом устройстве. Нажмите на это сообщение, чтобы открыть настройки."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Входящий защищенный вызов был автоматически отклонен, так как вы не включили прием вызовов на этом устройстве. Коснитесь этого сообщения, чтобы открыть настройки."
                }
