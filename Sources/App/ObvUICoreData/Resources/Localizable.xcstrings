        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este contacto fue eliminado de tus contactos de Olvid, ya sea porque lo eliminaste tú o porque este contacto te eliminó de sus propios contactos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce contact a été supprimé de vos contacts Olvid, soit par vous-même, soit parce que ce contact vous a supprimé de ses propres contacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo contatto è stato eliminato dai tuoi contatti Olvid, o perché l'hai fatto tu o perché questo contatto ti ha eliminato dai suoi."
          }
        }
      }
    },
