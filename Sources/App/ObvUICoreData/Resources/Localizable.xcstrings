    "This contact was deleted from your contacts, either because you did or because this contact deleted you.": {
      "comment": "System message displayed within a group discussion",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Kontakt wurde aus deinen Olvid-Kontakten gelöscht, entweder von dir selbst oder weil dieser Kontakt dich aus seinen eigenen Kontakten entfernt hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This contact was deleted from your Olvid contacts, either because you did or because this contact deleted you from their own contacts."
