    "NOT_PART_OF_THE_GROUP_ANYMORE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist nicht mehr Teil dieser Gruppe, entweder weil du sie verlassen hast, weil ein Administrator dich entfernt hat oder weil die Gruppe gelöscht wurde 🥲."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are not part of this group anymore, either because you left it, because an administrator removed you, or because the group was deleted 🥲."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya no formas parte de este grupo, ya sea porque lo abandonaste, porque un administrador te eliminó o porque el grupo fue eliminado 😔."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne faites plus partie de ce groupe, parce que vous l'avez quitté, parce qu'un administrateur vous a retiré du groupe, ou tout simplement parce que le groupe a été supprimé 🥲."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non fai più parte di questo gruppo, perché lo hai lasciato tu, un amministratore ti ha rimosso, oppure perché il gruppo è stato eliminato 🥲."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたはもうこのグループのメンバーではありません。理由は、あなたがグループを離れたか、管理者があなたを削除したか、またはグループが削除されたかのいずれかです。🥲"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 이상 이 그룹에 속해 있지 않습니다. 그룹을 나갔거나, 관리자가 사용자를 제거했거나, 그룹이 삭제되었기 때문일 수 있습니다. 😥"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não faz mais parte deste grupo, seja porque você o deixou, porque um administrador o removeu ou porque o grupo foi excluído 😥."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Já não faz parte deste grupo, seja porque saiu, porque um administrador o removeu ou porque o grupo foi eliminado. 😥"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы больше не являетесь участником этой группы, либо потому что вы покинули ее, либо потому что вас удалил администратор, либо потому что группа была удалена 😔."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас більше немає в цій групі, або ви покинули її, або адміністратор вас виключив, або групу було видалено 😔."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您不再是此群组的成员，原因可能是您已退出、管理员已将您移除，或者群组已被删除。🥲"
          }
        }
      }
    },
