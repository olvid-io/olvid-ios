    "CONTACT_%@_IS_ONE_TO_ONE_AGAIN": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist wieder in Ihren Kontakten, Sie können Ihre Diskussion dort fortsetzen, wo Sie aufgehört haben 🥳."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is part of your contacts again, you can continue your discussion where you left off 🤗."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vuelve a estar en tus contactos, puedes continuar tu conversación donde la dejaste 🤗."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fait à nouveau partie de vos contacts, vous pouvez reprendre la discussion là où vous l'aviez laissée 🤗."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è di nuovo tra i tuoi contatti, puoi riprendere la discussione da dove l'avevi interrotta 🤗."
          }
        }
      }
    },
