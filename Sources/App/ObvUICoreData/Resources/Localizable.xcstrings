    "Messages are protected with end-to-end authentication and end-to-end encryption.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Unterhaltung ist Ende-zu-Ende authentifiziert und Ende-zu-Ende verschlüsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This discussion is end-to-end authenticated and end-to-end encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación está autenticada de extremo a extremo y cifrada de extremo a extremo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette discussion est authentifiée de bout en bout et chiffrée de bout en bout."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa discussione è autenticata end-to-end e crittografata end-to-end."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットは、エンドツーエンド認証とエンドツーエンド暗号化が適用されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화는 종단 간 인증 및 종단 간 암호화가 적용됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa possui autenticação e criptografia de ponta a ponta."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversa tem autenticação e encriptação de ponta a ponta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот диалог аутентифицирован и зашифрован сквозным шифрованием."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця розмова має кінцеву аутентифікацію та кінцеве шифрування."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
