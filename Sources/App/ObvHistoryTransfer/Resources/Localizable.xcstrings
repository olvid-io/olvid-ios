    "HISTORY_TRANSFER_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dieser Funktion können Sie Ihren Chatverlauf **sicher zwischen zwei Ihrer Geräte übertragen**.\n\nBevor Sie beginnen, muss Ihr Profil **auf beiden Geräten vorhanden sein**."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This feature allows you to **securely transfer** your chat history between two of your devices.\n\nBefore you start, your profile needs to **exist on both of these devices**."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta función te permite **transferir de forma segura** el historial de tus chats entre dos de tus dispositivos.\n\nAntes de empezar, tu perfil debe **existir en ambos dispositivos**."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fonctionnalité vous permet de transférer **en toute sécurité** votre historique de discussion entre deux de vos appareils.\n\nAvant de commencer, assurez-vous que votre **profil existe sur les deux appareils**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa funzionalità ti consente di **trasferire in modo sicuro** la cronologia delle tue chat tra due dei tuoi dispositivi.\n\nPrima di iniziare, il tuo profilo deve essere **presente su entrambi i dispositivi**."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この機能を使用すると、**安全に**チャット履歴を2つのデバイス間で**転送**できます。\n\n始める前に、プロファイルが**両方のデバイスに存在すること**を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능을 사용하면 채팅 기록을 두 기기 간에 **안전하게 전송**할 수 있습니다.\n\n시작하기 전에, 프로필이 **두 기기에 모두 존재해야 합니다**."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este recurso permite que você **transfira com segurança** o histórico de suas conversas entre dois de seus dispositivos.\n\nAntes de começar, seu perfil precisa **existir em ambos os dispositivos**."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta funcionalidade permite-lhe **transferir o histórico das suas conversas de forma segura** entre dois dos seus dispositivos.\n\nAntes de começar, o seu perfil tem de **existir em ambos os dispositivos**."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта функция позволяет **безопасно переносить** историю ваших чатов между двумя вашими устройствами.\n\nПрежде чем начать, ваш профиль должен **существовать на обоих этих устройствах**."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця функція дозволяє **безпечно переносити** історію ваших чатів між двома вашими пристроями.\n\nПерш ніж почати, переконайтеся, що ваш профіль **існує на обох цих пристроях**."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此功能可让您**安全地**在您的两个设备之间**传输**聊天记录。\n\n在开始操作之前，您的个人资料需要在这两个设备上都**存在**。"
          }
        }
      }
    },
