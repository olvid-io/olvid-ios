    "IMPORT_ZIP_EXPLANATION": {
      "comment": "A description of the import process of a ZIP file.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Importieren Sie Ihren Chatverlauf aus einer ZIP-Datei. Das von Ihnen ausgewählte Profil muss mit dem Profil der Chatverlaufsdatei übereinstimmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import your chat history from a zip file. The profile you chose must match the one of the zip file’s chat history. "
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa tu historial de chat desde un archivo ZIP. El perfil que elijas debe coincidir con el del historial de chat del archivo ZIP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez votre historique de discussion depuis un fichier zip. Le profil sélectionné doit correspondre à celui de l’historique contenu dans le fichier zip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa la cronologia delle tue chat da un file zip. Il profilo che hai scelto deve corrispondere a quello della cronologia delle chat contenuta nel file zip."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "zipファイルからチャット履歴をインポートします。選択したプロファイルは、zipファイルのチャット履歴と一致している必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "zip 파일에서 채팅 기록을 가져옵니다. 선택한 프로필은 zip 파일의 채팅 기록과 일치해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe seu histórico de conversas de um arquivo zip. O perfil que você escolher deve corresponder ao do histórico de conversas no arquivo zip."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe o seu histórico de conversas a partir de um ficheiro zip. O perfil que escolher deve corresponder ao do histórico de conversas do ficheiro zip."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте историю своих чатов из ZIP-файла. Выбранный вами профиль должен соответствовать профилю, из которого была взята история чатов в ZIP-файле."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпортуйте історію ваших чатів із ZIP-файлу. Обраний вами профіль має відповідати профілю, з якого було створено ZIP-файл із історією чатів."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从zip文件中导入您的聊天记录。您选择的个人资料必须与zip文件中聊天记录的个人资料匹配。"
          }
        }
      }
    },
