    "WIFIAWARE_FOUND_PAIRED_DEVICES_EXPLANATION_DESTINATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn das Gerät, nach dem Sie suchen, nicht in der Liste angezeigt wird, tippen Sie auf die Schaltfläche unten, um es zuerst zu koppeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If the device your are looking for does not appear in the list, tap the button below to pair it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el dispositivo que buscas no aparece en la lista, pulsa el botón de abajo para emparejarlo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si l’appareil recherché n’apparaît pas dans la liste, appuyez sur le bouton ci-dessous pour l’appairer d’abord."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il dispositivo che stai cercando non compare nell'elenco, tocca il pulsante qui sotto per associarlo in primo luogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索対象のデバイスがリストに表示されない場合は、まず以下のボタンをタップしてペアリングしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색 중인 기기가 목록에 표시되지 않으면 아래 버튼을 탭하여 먼저 페어링하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o dispositivo que você está procurando não aparecer na lista, toque no botão abaixo para emparelhá-lo primeiro."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o dispositivo que procura não aparecer na lista, toque no botão abaixo para o emparelhar primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если нужное устройство отсутствует в списке, сначала нажмите кнопку ниже, чтобы установить с ним соединение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо пристрій, який ви шукаєте, не відображається в списку, спочатку натисніть кнопку нижче, щоб встановити пару."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果列表中没有找到您要连接的设备，请先点击下面的按钮进行配对。"
          }
        }
      }
    },
