    "CURRENT_DEVICE_IS_INACTIVE_VIEW_DESCRIPTION": {
      "comment": "Description of the \"Current device is inactive\" view.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die von Ihnen ausgewählte Übertragungsmethode kann nicht verwendet werden, aber Sie können weiterhin Nachrichten von diesem Gerät übertragen, indem Sie eine Zip-Datei verwenden oder eine Übertragung zwischen iPhones oder iPads durchführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cannot use the selected transfer method, but you can still transfer messages from this device using a zip file or a transfer between iPhones or iPads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No puedes usar el método de transferencia seleccionado, pero aún puedes transferir mensajes desde este dispositivo usando un archivo ZIP o una transferencia entre iPhones o iPads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La méthode de transfert sélectionnée n’est pas disponible, mais vous pouvez toujours transférer vos messages depuis cet appareil à l’aide d’un fichier zip ou d’un transfert entre iPhone ou iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile utilizzare il metodo di trasferimento selezionato, ma è comunque possibile trasferire i messaggi da questo dispositivo utilizzando un file zip o effettuando il trasferimento tra iPhone o iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した転送方法を使用できません。ただし、このデバイスからメッセージを ZIP ファイルで転送したり、iPhone または iPad 間の転送を実行したりすることは可能です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 전송 방법을 사용할 수 없습니다. 대신 이 장치에서 메시지를 압축 파일로 전송하거나 iPhone 또는 iPad 간에 전송할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você não pode usar o método de transferência selecionado, mas ainda pode transferir mensagens deste dispositivo usando um arquivo zip ou uma transferência entre iPhones ou iPads."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Não pode utilizar o método de transferência selecionado, mas ainda pode transferir mensagens deste dispositivo utilizando um ficheiro zip ou uma transferência entre iPhones ou iPads."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы не можете использовать выбранный метод передачи, но вы все еще можете передавать сообщения с этого устройства, используя ZIP-файл или передавая их между iPhone или iPad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви не можете використовувати обраний метод передачі даних, але ви все ще можете передавати повідомлення з цього пристрою, використовуючи zip-файл або передачу даних між iPhone або iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您无法使用所选的传输方式，但您仍然可以使用压缩文件或在 iPhone 或 iPad 之间进行传输来从此设备传输消息。"
          }
        }
      }
    },
