    "ZIP_PASSWORD_PROTECT_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Ihre Sicherheit empfehlen wir, Ihre exportierte Datei mit einem Passwort zu schützen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For your security, we recommend protecting your export with a password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por su seguridad, le recomendamos proteger su exportación con una contraseña."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour des raisons de sécurité, nous vous recommandons de protéger votre export avec un mot de passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per la tua sicurezza, ti consigliamo di proteggere l'esportazione dei tuoi dati con una password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セキュリティのため、エクスポート時にパスワードを設定することをお勧めします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보안을 위해 내보낸 데이터를 비밀번호로 보호하는 것이 좋습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sua segurança, recomendamos proteger seu arquivo de exportação com uma senha."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Para sua segurança, recomendamos proteger o seu ficheiro de exportação com uma palavra-passe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В целях вашей безопасности мы рекомендуем защитить ваши экспортированные данные паролем."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для вашої безпеки ми рекомендуємо захищати ваші експортовані дані паролем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了您的安全，我们建议您使用密码保护您的导出内容。"
          }
        }
      }
    },
