    "ZIP_PASSWORD_COPIED_CONFIRMATION_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hast du es aufgeschrieben oder kopiert? Das ist deine letzte Chance, es noch einmal anzusehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Did you write it down or copy it? This is your last chance to see it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Lo anotaste o lo copiaste? Esta es tu última oportunidad para verlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’avez-vous noté ou copié ? C’est votre dernière occasion de le voir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'hai scritto o copiato? Questa è l'ultima possibilità che hai per vederlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモしましたか、それともコピーしましたか？　これが最後の確認の機会です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모했거나 복사했나요? 이 메시지를 다시 볼 마지막 기회입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você anotou ou copiou? Esta é a sua última chance de vê-lo."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotou ou copiou? Esta é a sua última oportunidade para o ver."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы записали это или скопировали? Это ваш последний шанс увидеть это."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви записали або скопіювали це? Це ваш останній шанс це побачити."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你有没有把它记下来或者复制下来？这是你最后一次可以查看的机会了。"
