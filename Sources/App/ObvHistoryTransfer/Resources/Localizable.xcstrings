    "NO_PAIRED_DEVICE_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie Ihr Gerät mit einem anderen in der Nähe, um Ihren Chatverlauf drahtlos zu übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair with a nearby device to wirelessly transfer your chat history between the two."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empareja el dispositivo con otro cercano para transferir de forma inalámbrica el historial de tus chats entre ambos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appairez un appareil à proximité pour transférer votre historique de discussion entre les deux, sans fil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Associa un dispositivo nelle vicinanze per trasferire in modalità wireless la cronologia delle tue chat tra i due dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのデバイスとペアリングして、チャット履歴をワイヤレスで両方のデバイス間で転送します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "근처 장치와 페어링하여 채팅 기록을 무선으로 전송하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe com um dispositivo próximo para transferir sem fio o histórico de suas conversas entre os dois."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Emparelhe com um dispositivo próximo para transferir sem fios o seu histórico de conversas entre os dois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь к ближайшему устройству, чтобы беспроводным способом перенести историю ваших чатов между ними."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З’єднайтеся з найближчим пристроєм, щоб бездротово передати історію ваших чатів між ними."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与附近的设备配对，以便无线传输聊天记录。"
          }
        }
      }
    },
