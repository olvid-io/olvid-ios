    "DONE_IMPORT_VIEW_SUBTITLE_EXPORT_CANCELLED_BY_USER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung wurde unterbrochen. Sie können sie jederzeit fortsetzen. Bereits gesendete Elemente müssen nicht erneut übertragen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer was interrupted. You can resume it anytime. Already sent items won’t need to be transferred again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia se ha interrumpido. Puedes reanudarla en cualquier momento. Los elementos que ya se enviaron no tendrán que transferirse de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert a été interrompu. Vous pouvez le reprendre quand vous le souhaitez. Les éléments déjà transférés ne seront pas transférés à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento è stato interrotto. Puoi riprenderlo in qualsiasi momento. Gli elementi già inviati non dovranno essere trasferiti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送が中断されました。いつでも再開できます。すでに送信済みの項目は、再度転送する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송이 중단되었습니다. 언제든지 다시 시작할 수 있습니다. 이미 전송된 항목은 다시 전송할 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência foi interrompida. Você pode retomá-la a qualquer momento. Os itens já enviados não precisarão ser transferidos novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência foi interrompida. Pode retomá-la quando quiser. Os itens já enviados não precisam de ser transferidos novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача была прервана. Вы можете возобновить ее в любое время. Элементы, которые уже были отправлены, не нужно будет передавать повторно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передачу було перервано. Ви можете відновити її в будь-який час. Елементи, які вже були надіслані, не потрібно передавати повторно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输已中断。您可以随时恢复。已发送的项目无需再次传输。"
          }
        }
      }
    },
    "DONE_IMPORT_VIEW_SUBTITLE_EXPORT_FAILED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung ist fehlgeschlagen. Sie können sie jederzeit fortsetzen. Bereits gesendete Elemente müssen nicht erneut übertragen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer failed. You can resume it anytime. Already sent items won’t need to be transferred again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia falló. Puedes reintentarla en cualquier momento. Los elementos que ya se enviaron no necesitarán ser transferidos nuevamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert a échoué. Vous pouvez le reprendre à tout moment. Les éléments déjà transférés ne seront pas transférés à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento non è andato a buon fine. Puoi riprenderlo in qualsiasi momento. Gli elementi già inviati non dovranno essere trasferiti nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送に失敗しました。いつでも再開できます。すでに送信済みの項目は、再度転送する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송에 실패했습니다. 언제든지 다시 시도할 수 있습니다. 이미 전송된 항목은 다시 전송할 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência falhou. Você pode retomá-la a qualquer momento. Os itens já enviados não precisarão ser transferidos novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência falhou. Pode retomá-la quando quiser. Os itens que já foram enviados não precisam de ser transferidos novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача не удалась. Вы можете возобновить ее в любое время. Элементы, которые уже были отправлены, не нужно будет передавать повторно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача не вдалася. Ви можете відновити її будь-якої миті. Вже надіслані елементи не потрібно буде передавати повторно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输失败。您可以随时恢复。已发送的项目将不再需要重新传输。"
          }
        }
      }
    },
    "DONE_IMPORT_VIEW_SUBTITLE_EXPORT_IDENTITY_MISMATCH": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das von Ihnen ausgewählte Profil stimmt nicht mit dem überein, das zum Erstellen dieses Chats verwendet wurde. Bitte stellen Sie sicher, dass Sie auf beiden Geräten dasselbe Profil auswählen, oder wählen Sie beim Importieren einer Chat-Datei das richtige Profil aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile you selected does not match the one used to create this history. Please make sure you select the same profile on both devices, or choose the correct profile when  importing a history file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil que seleccionaste no coincide con el que se utilizó para crear este historial. Asegúrate de seleccionar el mismo perfil en ambos dispositivos o elige el perfil correcto al importar un archivo de historial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil sélectionné ne correspond pas à celui utilisé pour créer cet historique. Veuillez vous assurer de sélectionner le même profil sur les deux appareils, ou de choisir le bon profil lors de l’importation d’un fichier d’historique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo selezionato non corrisponde a quello utilizzato per creare questa cronologia. Assicurati di selezionare lo stesso profilo su entrambi i dispositivi oppure scegli il profilo corretto quando importi un file di cronologia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したプロファイルは、この履歴を作成するために使用されたプロファイルと一致しません。両方のデバイスで同じプロファイルを選択しているか、履歴ファイルをインポートする際に正しいプロファイルを選択していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택하신 프로필은 이 대화 기록을 생성하는 데 사용된 프로필과 일치하지 않습니다. 두 장치에서 동일한 프로필을 선택했는지 확인하거나 대화 기록 파일을 가져올 때 올바른 프로필을 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil que você selecionou não corresponde ao perfil usado para criar este histórico. Certifique-se de selecionar o mesmo perfil em ambos os dispositivos ou escolha o perfil correto ao importar um arquivo de histórico."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil que selecionou não corresponde ao perfil utilizado para criar este histórico. Certifique-se de que seleciona o mesmo perfil em ambos os dispositivos ou escolha o perfil correto ao importar um ficheiro de histórico."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбранный вами профиль не соответствует тому, который использовался для создания этой истории. Пожалуйста, убедитесь, что вы выбрали один и тот же профиль на обоих устройствах, или выберите правильный профиль при импорте файла истории."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Обраний вами профіль не відповідає тому, який використовувався для створення цієї історії. Переконайтеся, що ви вибрали один і той самий профіль на обох пристроях або оберіть правильний профіль під час імпорту файлу історії."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您选择的个人资料与用于创建此聊天记录的个人资料不匹配。请确保在两台设备上都选择相同的个人资料，或者在导入聊天记录文件时选择正确的个人资料。"
          }
        }
      }
    },
