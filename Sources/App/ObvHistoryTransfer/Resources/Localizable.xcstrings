    "NO_ACTIVE_DEVICE_FOUND_EXPLANATION": {
      "comment": "A description displayed below the title of a view that indicates that no device is currently connected.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Ihr Profil auf einem anderen (inaktiven) Gerät vorhanden ist, können Sie die Nachrichten von diesem Gerät weiterhin mit einer ZIP-Datei übertragen oder zwischen iPhones oder iPads übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your profile exists on another (inactive) device, you can still transfer messages from this device using a zip file or transfer between iPhones or iPads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si tu perfil existe en otro dispositivo (inactivo), aún puedes transferir los mensajes de este dispositivo utilizando un archivo ZIP o transfiriéndolos entre iPhones o iPads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si votre profil existe sur un autre appareil (inactif), vous pouvez toujours transférer vos messages depuis cet appareil à l’aide d’un fichier zip ou d’un transfert entre iPhone ou iPad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il tuo profilo è presente su un altro dispositivo (inattivo), puoi comunque trasferire i messaggi da questo dispositivo utilizzando un file ZIP o effettuando il trasferimento tra iPhone o iPad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "別の（非アクティブな）デバイスにプロフィールが存在する場合でも、このデバイスからメッセージをzipファイルを使用して転送したり、iPhoneまたはiPad間で転送したりすることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필이 다른(비활성) 기기에 있는 경우, zip 파일이나 iPhone 또는 iPad 간의 전송을 사용하여 이 기기에서 메시지를 전송할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu perfil estiver ativo em outro dispositivo (inativo), você ainda pode transferir mensagens desse dispositivo usando um arquivo ZIP ou transferindo os dados entre iPhones ou iPads."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Se o seu perfil existir noutro dispositivo (inativo), ainda pode transferir mensagens desse dispositivo utilizando um ficheiro ZIP ou transferindo entre iPhones ou iPads."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если ваш профиль существует на другом (неактивном) устройстве, вы все равно можете перенести сообщения с этого устройства, используя ZIP-файл или перенеся их между iPhone или iPad."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Якщо ваш профіль існує на іншому (неактивному) пристрої, ви все ще можете перенести повідомлення з цього пристрою за допомогою zip-файлу або здійснити передачу між iPhone або iPad."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果您的个人资料在另一台（已停用）设备上存在，您仍然可以使用 zip 文件或在 iPhone 或 iPad 之间进行传输，从而将消息从该设备传输过来。"
          }
        }
      }
    },
