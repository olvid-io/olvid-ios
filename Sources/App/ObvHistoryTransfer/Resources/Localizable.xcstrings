    "WEBRTC_INSTRUCTIONS_STEP_NAVIGATE_TO_TRANSFER_SETTINGS_ON_REMOTE_DEVICE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigieren Sie zu den Einstellungen “Chatverlauf übertragen” und wählen Sie “Exportieren”."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Navigate to the “Transfer your chat history” setting, and choose “Export”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirígete a la configuración de \"Transferir tu historial de chat\" y selecciona \"Exportar\"."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Naviguez vers les paramètres de **Transfert d’historique des discussions** et choisissez **Export**."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vai alle impostazioni di “Trasferisci la cronologia chat” e scegli “Esporta”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「チャット履歴の転送」設定に移動し、「エクスポート」を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“채팅 기록 전송” 설정으로 이동하여 “내보내기”를 선택하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesse a configuração \"Transferir seu histórico de conversas\" e escolha \"Exportar\"."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceda à definição \"Transferir o seu histórico de conversas\" e escolha \"Exportar\"."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдите в раздел «Перенос истории чатов» в настройках и выберите «Экспорт»."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перейдіть до налаштування «Експортуйте історію чату» та виберіть «Експорт»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
