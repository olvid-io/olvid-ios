    "DONE_EXPORT_VIEW_SUBTITLE_EXPORT_CANCELLED_BY_USER": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung wurde unterbrochen. Sie können sie jederzeit fortsetzen. Bereits gesendete Elemente müssen nicht erneut übertragen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer was interrupted. You can resume it anytime. Already sent items won’t need to be transferred again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia se interrumpió. Puedes reanudarla en cualquier momento. Los elementos que ya se enviaron no necesitarán ser transferidos de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert a été interrompu. Vous pouvez le reprendre à tout moment. Les éléments déjà envoyés ne seront pas transférés à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento è stato interrotto. Puoi riprenderlo in qualsiasi momento. Gli elementi già inviati non dovranno essere trasferiti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送が中断されました。いつでも再開できます。すでに送信済みの項目は、再度転送する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송이 중단되었습니다. 언제든지 다시 시작할 수 있습니다. 이미 전송된 항목은 다시 전송할 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência foi interrompida. Você pode retomá-la a qualquer momento. Os itens já enviados não precisarão ser transferidos novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência foi interrompida. Pode retomar a transferência a qualquer momento. Os itens já enviados não precisarão de ser transferidos novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача была прервана. Вы можете возобновить ее в любое время. Элементы, которые уже были отправлены, не будут передаваться повторно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передачу було перервано. Ви можете відновити її в будь-який момент. Елементи, які вже були відправлені, не потрібно буде передавати повторно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输中断。您可以随时恢复。已发送的项目无需再次传输。"
          }
        }
      }
    },
    "DONE_EXPORT_VIEW_SUBTITLE_EXPORT_FAILED": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übertragung ist fehlgeschlagen. Sie können sie jederzeit fortsetzen. Bereits gesendete Elemente müssen nicht erneut übertragen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transfer failed. You can resume it anytime. Already sent items won’t need to be transferred again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia falló. Puedes reintentarla en cualquier momento. Los elementos que ya se enviaron no tendrán que volver a transferirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert a échoué. Vous pouvez le reprendre à tout moment. Les éléments déjà envoyés ne seront pas transférés à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento non è andato a buon fine. Puoi riprenderlo in qualsiasi momento. Gli elementi già inviati non dovranno essere trasferiti di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送に失敗しました。いつでも再開できます。すでに送信されたアイテムは、再度転送する必要はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송에 실패했습니다. 언제든지 다시 시도할 수 있습니다. 이미 전송된 항목은 다시 전송할 필요가 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência falhou. Você pode retomá-la a qualquer momento. Os itens que já foram enviados não precisarão ser transferidos novamente."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência falhou. Pode retomar a qualquer momento. Os itens já enviados não precisarão de ser transferidos novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача данных не удалась. Вы можете возобновить ее в любое время. Элементы, которые уже были отправлены, повторно передавать не нужно."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передача не вдалася. Ви можете відновити її в будь-який час. Вже відправлені елементи не потрібно буде передавати повторно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "传输失败。您可以随时重新开始。已发送的项目无需再次传输。"
          }
        }
      }
    },
    "DONE_EXPORT_VIEW_SUBTITLE_EXPORT_WAS_SUCCESSFUL": {
      "localizations": {
