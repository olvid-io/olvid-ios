    },
    "WEBRTC_INSTRUCTIONS_STEP_SAME_WIFI": {
      "comment": "Text displayed in a row of a view that instructs the user to confirm that the destination device is on the same Wi-Fi network.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie sicher, dass dieses Gerät und Ihr anderes Gerät mit demselben Wi-Fi-Netzwerk verbunden sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make sure this device and your other device are connected to the same Wi-Fi network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asegúrate de que este dispositivo y el otro dispositivo al que quieres conectarte estén conectados a la misma red Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que cet appareil et votre autre appareil sont tous les deux connectés au même réseau Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assicurati che questo dispositivo e l'altro dispositivo a cui sei connesso siano collegati alla stessa rete Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスと他のデバイスが、同じWi-Fiネットワークに接続されていることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 장치와 다른 장치가 동일한 Wi-Fi 네트워크에 연결되어 있는지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que este dispositivo e o outro dispositivo estejam conectados à mesma rede Wi-Fi."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Certifique-se de que este dispositivo e o seu outro dispositivo estão ligados à mesma rede Wi-Fi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что это устройство и другое ваше устройство подключены к одной и той же сети Wi-Fi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переконайтеся, що цей пристрій і ваш інший пристрій підключені до однієї й тієї ж мережі Wi-Fi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请确保此设备和您的其他设备连接到同一 Wi-Fi 网络。"
          }
        }
      }
    },
