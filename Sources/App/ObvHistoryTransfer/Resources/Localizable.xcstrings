    "WIFI_AWARE_NOT_AVAILABLE_ALERT_MESSAGE": {
      "comment": "The message displayed in the alert when the user tries to export their history using WiFi-aware transfer.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die direkte Geräteübertragung ist auf beiden Geräten iOS 26 oder iPadOS 26 (oder neuer) erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device-to-device transfer requires iOS 26 or iPadOS 26 (or later) on both devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transferencia de dispositivo a dispositivo requiere iOS 26 o iPadOS 26 (o versiones posteriores) en ambos dispositivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le transfert direct entre appareils nécessite iOS 26 ou iPadOS 26 (ou une version ultérieure) sur les deux appareils."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il trasferimento diretto tra dispositivi richiede iOS 26 o iPadOS 26 (o versioni successive) su entrambi i dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイス間の転送には、両方のデバイスで iOS 26 または iPadOS 26 (またはそれ以降のバージョン) が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 간 전송을 하려면 양쪽 기기에 iOS 26 또는 iPadOS 26(또는 그 이후 버전)이 설치되어 있어야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência de dados entre dispositivos requer iOS 26 ou iPadOS 26 (ou versões mais recentes) em ambos os dispositivos."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "A transferência direta entre dispositivos requer o iOS 26 ou iPadOS 26 (ou posterior) em ambos os dispositivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для передачи данных напрямую между устройствами требуется iOS 26 или iPadOS 26 (или более поздней версии) на обоих устройствах."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для передачі даних між пристроями потрібна iOS 26 або iPadOS 26 (або новіша версія) на обох пристроях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备间传输需要在两台设备上都安装 iOS 26 或 iPadOS 26（或更高版本）。"
          }
        }
      }
    },
