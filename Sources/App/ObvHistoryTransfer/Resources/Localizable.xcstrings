    "WAITING_FOR_DESTINATION_DEVICE_%@_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie Olvid auf Ihrem %@ und befolgen Sie die Anweisungen, um die Übertragung zu bestätigen. Sobald die Bestätigung erfolgt ist, beginnt die Übertragung Ihrer Nachrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Olvid on your %@ and follow the instructions to approve the transfer. Once confirmed, your messages will begin transferring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Olvid en tu %@ y sigue las instrucciones para aprobar la transferencia. Una vez confirmada, tus mensajes comenzarán a transferirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez Olvid sur votre %@ et suivez les instructions pour approuver le transfert. Vos messages seront transférés une fois la confirmation faite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Olvid sul tuo %@ e segui le istruzioni per approvare il trasferimento. Una volta confermato, i tuoi messaggi inizieranno a essere trasferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お客様の %@ で Olvid を開き、指示に従って転送を承認してください。確認が完了すると、メッセージの転送が開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하의 %@에서 Olvid 앱을 열고 안내에 따라 전송 승인을 진행하십시오. 승인이 완료되면 메시지 전송이 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Olvid no seu %@ e siga as instruções para aprovar a transferência. Assim que for confirmada, suas mensagens começarão a ser transferidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Olvid no seu %@ e siga as instruções para aprovar a transferência. Após a confirmação, as suas mensagens começarão a ser transferidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Olvid на своем %@ и следуйте инструкциям для подтверждения переноса. После подтверждения ваши сообщения начнут переноситься."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Olvid на вашому пристрої %@ та дотримуйтесь інструкцій, щоб підтвердити передачу. Після підтвердження ваші повідомлення почнуть передаватися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在您的 %@ 上打开 Olvid，并按照说明操作以批准传输。确认后，您的消息将开始传输。"
          }
        }
      }
    },
    "WAITING_FOR_DESTINATION_DEVICE_EXPLANATION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Olvid auf dem Zielgerät und befolge die Anweisungen, um die Übertragung zu bestätigen. Sobald dies geschehen ist, beginnt die Übertragung deiner Nachrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Olvid on the destination device and follow the instructions to approve the transfer. Once confirmed, your messages will begin transferring."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Olvid en el dispositivo de destino y sigue las instrucciones para aprobar la transferencia. Una vez confirmada, tus mensajes comenzarán a transferirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez Olvid sur l’appareil de destination et suivez les instructions pour approuver le transfert. Vos messages seront transférés une fois la confirmation faite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri Olvid sul dispositivo di destinazione e segui le istruzioni per approvare il trasferimento. Una volta confermato, i tuoi messaggi inizieranno a essere trasferiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "転送先のデバイスでOlvidを開き、指示に従って転送を承認してください。承認が完了すると、メッセージの転送が開始されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대상 기기에서 Olvid를 열고 전송 승인에 대한 안내를 따르세요. 확인되면 메시지 전송이 시작됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Olvid no dispositivo de destino e siga as instruções para aprovar a transferência. Após a confirmação, suas mensagens começarão a ser transferidas."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Olvid no dispositivo de destino e siga as instruções para aprovar a transferência. Após a confirmação, as suas mensagens começarão a ser transferidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Olvid на целевом устройстве и следуйте инструкциям, чтобы подтвердить передачу. После подтверждения начнется передача ваших сообщений."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте Olvid на пристрої, на який потрібно перенести дані, і дотримуйтесь інструкцій, щоб підтвердити передачу. Після підтвердження почнеться перенесення ваших повідомлень."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在目标设备上打开 Olvid，然后按照说明批准传输。确认后，您的消息将开始传输。"
          }
        }
      }
    },
