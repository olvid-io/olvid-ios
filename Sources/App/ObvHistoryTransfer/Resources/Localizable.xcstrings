          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте целевое устройство, чтобы убедиться, что все сообщения успешно доставлены."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
