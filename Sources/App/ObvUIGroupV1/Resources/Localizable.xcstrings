    "EXPLANATION_FOR_CLONING_A_GROUP_V1_TO_GROUP_V2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gruppe unterstützt nicht mehr als einen Administrator. Du kannst diese Gruppe jedoch in eine neue klonen, die 🚀!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group does not support more than one administrator. But you can clone this group into a new one that will 🚀!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo no admite más de un administrador. Pero puedes clonar este grupo en uno nuevo que tendrá 🚀!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe ne permet pas d'avoir plusieurs administrateurs. Mais vous pouvez le cloner en un nouveau groupe de dernière génération qui le permettra 🚀 !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gruppo non supporta più di un amministratore. Ma puoi clonare questo gruppo in uno nuovo che sarai tu ad amministrare!"
          }
        }
      }
    },
    "GROUP_ADMINISTRATION_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gruppenverwaltung"
          }
        },
        "en": {
