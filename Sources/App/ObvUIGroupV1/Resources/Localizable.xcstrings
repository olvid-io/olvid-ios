    "SINGLE_GROUP_V1_VIEW_SHEET_CONFIRM_DISBAND_GROUP_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beachten Sie, dass diese Aktion nicht rückgängig gemacht werden kann. Wenn Sie bestätigen, wird diese Gruppe für alle Mitglieder gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please note that this action is irreversible. If you confirm, this group will be deleted for all members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que esta acción es irreversible. Si confirmas, este grupo se eliminará para todos los miembros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer un groupe est une opération irréversible. Si vous continuez, le groupe sera supprimé chez tous les membres."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di notare che questa azione è irreversibile. Se confermi, questo gruppo verrà eliminato per tutti i membri."
          }
        }
      }
    },
    "SINGLE_GROUP_V1_VIEW_SHEET_CONFIRM_DISBAND_GROUP_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Achtung! Möchtest du diese Gruppe wirklich auflösen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heads-up! Do you really wish to disband this group?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Atención! ¿De verdad quieres disolver este grupo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention ! Voulez-vous vraiment supprimer ce groupe ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attenzione! Sei sicuro di voler sciogliere questo gruppo?"
          }
        }
      }
    },
    "SINGLE_GROUP_V1_VIEW_SHEET_CONFIRM_LEAVE_GROUP_MESSAGE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitte beachten Sie, dass diese Aktion unwiderruflich ist (es sei denn, ein Gruppenadministrator beschließt, Sie später erneut einzuladen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please note that this action is irreversible (unless a group administrator decides to invite you again later on)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten en cuenta que esta acción es irreversible (a menos que un administrador del grupo decida invitarte nuevamente más tarde)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attention, cette action est irréversible (sauf si un administrateur du groupe vous y invite à nouveau après que vous l'ayez quitté)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si prega di notare che questa azione è irreversibile (a meno che un amministratore del gruppo non decida di invitarti nuovamente in seguito)."
          }
        }
      }
    },
    "SINGLE_GROUP_V1_VIEW_SHEET_CONFIRM_LEAVE_GROUP_TITLE": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie diese Gruppe wirklich verlassen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do you really wish to leave this group?"
          }
        },
        "es": {
