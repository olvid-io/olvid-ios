    "GROUP_WAS_DELETED_DESCRIPTION": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wurden aus dieser Gruppe entfernt. Falls Sie der Meinung sind, dass dies ein Fehler ist, wenden Sie sich bitte an einen der Gruppen-Administratoren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have been removed from this group. If you believe this is a mistake, please reach out to one of the group admins for assistance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has sido eliminado de este grupo. Si crees que se trata de un error, ponte en contacto con alguno de los administradores del grupo para obtener ayuda.\n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez été retiré de ce groupe. Si vous pensez qu’il s’agit d’une erreur, veuillez contacter un administrateur du groupe pour obtenir de l’aide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei stato rimosso da questo gruppo. Se ritieni che si tratti di un errore, contatta uno degli amministratori del gruppo per assistenza.\n\n"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループから削除されました。もし誤りであると思われる場合は、グループの管理者にお問い合わせください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "귀하가 이 그룹에서 제거되었습니다. 만약 이것이 실수라고 생각하시면 그룹 관리자 중 한 명에게 문의하여 도움을 요청하십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você foi removido deste grupo. Se você acredita que isso é um erro, entre em contato com um dos administradores do grupo para obter ajuda."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi-lhe retirado o acesso a este grupo. Se considera que isto foi um erro, contacte um dos administradores do grupo para obter ajuda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас удалили из этой группы. Если вы считаете, что это ошибка, обратитесь к одному из администраторов группы за помощью."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вас було видалено з цієї групи. Якщо ви вважаєте, що це помилка, зверніться до одного з адміністраторів групи за допомогою."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您已被从该群组中移除。如果您认为这是一个错误，请联系群组管理员寻求帮助。"
          }
        }
      }
    },
