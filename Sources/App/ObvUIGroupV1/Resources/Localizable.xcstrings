    "EXPLANATION_FOR_CLONING_A_GROUP_V1_TO_GROUP_V2": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Gruppe unterstützt nicht mehr als einen Administrator. Du kannst diese Gruppe jedoch in eine neue klonen, die 🚀!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This group does not support more than one administrator. But you can clone this group into a new one that will 🚀!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo no admite más de un administrador. Pero puedes clonar este grupo en uno nuevo que tendrá 🚀!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe ne permet pas d'avoir plusieurs administrateurs. Mais vous pouvez le cloner en un nouveau groupe de dernière génération qui le permettra 🚀 !"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gruppo non supporta più di un amministratore. Ma puoi clonare questo gruppo in uno nuovo che sarai tu ad amministrare!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このグループでは複数の管理者に対応していません。ただし、このグループを複製して新しいグループを作成することは可能です！"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 그룹은 여러 관리자를 지원하지 않습니다. 하지만 이 그룹을 복제하여 새로운 그룹을 만들 수 있습니다!"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo não permite ter mais de um administrador. Mas você pode duplicar este grupo e criar um novo! 🥳"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo não suporta mais do que um administrador. Mas pode duplicar este grupo para criar um novo! 🥳"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой группе не поддерживается более одного администратора. Но вы можете клонировать эту группу в новую, в которой 🚀!"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця група не підтримує більше одного адміністратора. Але ви можете клонувати цю групу в нову, де ви зможете призначити більше адміністраторів! 🚀"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此群组不支持设置多位管理员。但是，您可以将此群组克隆到一个新的群组，然后设置新的管理员！"
          }
        }
      }
    },
